# clang-tidy over the C Nelua generates (tools/ci/static.sh tidy). The checks
# that find real defects stay on; the ones below are off because generated
# code cannot satisfy them (reserved identifiers, its own naming and casts).
Checks: >
  -*,bugprone-*,cert-*,clang-analyzer-*,
  -bugprone-reserved-identifier,-cert-dcl37-c,-cert-dcl51-cpp,
  -bugprone-easily-swappable-parameters,-bugprone-macro-parentheses,
  -bugprone-narrowing-conversions,-bugprone-multi-level-implicit-pointer-conversion,-bugprone-implicit-widening-of-multiplication-result,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -cert-err33-c,-cert-err34-c
WarningsAsErrors: ''
