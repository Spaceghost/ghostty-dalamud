#!/bin/sh
# The repository has one credited author; keep the trailer-free, single-identity
# history that way. Contributors keep their own attribution in a fork.
set -eu
for kind in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
  [ "$(git var "$kind" | sed 's/>.*/>/')" = 'Johnneylee Jack Rollins <git@spacegho.st>' ] || {
    echo 'Set user.name and user.email to the repository author before committing.' >&2
    exit 1
  }
done
