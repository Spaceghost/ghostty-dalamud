-- ghostty-agent: a small PTY server for Linux/macOS and Windows hosts.
--
-- The GhosttyDalamud plugin (running inside FFXIV, natively or under Wine/Proton)
-- connects over TCP and opens shells, ssh clients, or anything else as
-- persistent sessions. Sessions outlive client disconnects; the last
-- 256 KiB of output is replayed on ATTACH so libghostty on the client can
-- rebuild the screen, the same way Superlogical streams raw bytes.
--
-- Platform code lives beside this file: agent/pty_posix.nelua (forkpty) and
-- agent/sys_posix.nelua (wl-copy / xclip), or agent/pty_windows.nelua
-- (ConPTY over overlapped named pipes), agent/sys_windows.nelua (Win32
-- clipboard, token file under %APPDATA%) and agent/winloop.nelua (one wait
-- on socket, process and pipe events). agent/logic.nelua holds the pure parts.
-- Remote desktop windows (protocol version 3) are agent/windows.nelua, over a
-- capture backend from agent/capture.nelua (--windows). Raw jobs (protocol
-- version 4, docs/JOBS.md) are agent/jobs.nelua over agent/job_posix.nelua:
-- a process on pipes whose output a client parses, with the Claude Code
-- command line built in agent/claude.nelua. Jobs run as this user.
--
-- Usage: ghostty-agent [--listen 127.0.0.1:7777] [--iroh] [--token-file PATH]
--                      [--clipboard-file PATH] [--replay-bytes N] [--term xterm-256color]
--                      [--windows auto|off|test|wayland|win32|mac]
--                      [--wayland-socket NAME] [--xkb-layout LAYOUT] [--wayland-render-node PATH|auto|gpu|none]
--                      [--wayland-browser CMD] [--wayland-browser-profile NAME]
--                      [--iroh [--iroh-secret PATH] [--iroh-allowlist PATH]]
--                      [--wireguard-config PATH]
--        ghostty-agent [--listen HOST:PORT] [--token-file PATH] --open-url URL
--
-- --iroh adds a second listener beside the TCP one, over iroh/QUIC
-- (docs/IROH.md). It does not replace --listen: the Wayland capture helper
-- connects back over the loopback listen spec, and the tests bind real
-- sockets. A client that arrives over iroh is an ordinary Client -- same
-- token handshake, same frames. iroh authenticates the machine, the token
-- authorises the connection (docs/MULTI_AGENT.md).
--
-- --wireguard-config starts the embedded WireGuard (docs/WIREGUARD.md,
-- agent/wg_service.nelua) from that wireguard.conf: a tunnel whose own
-- address forwards this agent's port, and whatever else the file forwards.
require 'string'
require 'vector'
require 'stringbuilder'
require 'io'
require 'os'
require 'arg'
require 'math'
require 'memory'
require 'core.sys.net'
require 'core.protocol'
require 'agent.logic'
require 'agent.windows'
require 'agent.jobs'
require 'agent.clips'
require 'agent.wg_service'
require 'agent.wg_cli'
require 'agent.tailscale'
## if ccinfo.is_windows then
require 'agent.pty_windows'
require 'agent.sys_windows'
require 'agent.winloop'
## else
require 'agent.pty_posix'
require 'agent.sys_posix'
## cinclude '<poll.h>'
local pollfd <cimport, nodecl, ctypedef> = @record{ fd: cint, events: cshort, revents: cshort }
local function poll(fds: *[0]pollfd, n: culong, timeout: cint): cint <cimport, nodecl> end
local POLLIN: cshort <cimport, nodecl, const>
local POLLOUT: cshort <cimport, nodecl, const>
## end

-- crates/ghostty-iroh, behind -D IROH (tools/build-common.sh IROH=1). Off, the
-- whole backend vanishes at comptime and this file is what it was.
--
-- POSIX only, deliberately: the listener here is driven by gi_wakeup_fd(), a
-- read end of a pipe that goes into the same poll() array as everything else.
-- The Windows loop waits on HANDLEs and would need gi_wakeup_handle() plumbed
-- through agent/winloop.nelua; that is not done, so --iroh is refused there.
--
-- NOTHING BELOW HAS BEEN COMPILED OR RUN. The declarations are transcribed by
-- hand from crates/ghostty-iroh/include/ghostty_iroh.h; a mistake in one of
-- them is a link error at best and a corrupt handle at worst. gi_abi_version()
-- is checked at startup for the version skew it cannot catch.
## local IROH_BUILT = (IROH and not ccinfo.is_windows) and true or false
## if IROH_BUILT then
local IROH_ABI_VERSION: int32 <comptime> = 1

local function gi_abi_version(): int32 <cimport, nodecl> end
local function gi_init(secret_key_path: cstring): int32 <cimport, nodecl> end
local function gi_shutdown(): void <cimport, nodecl> end
local function gi_node_id(out: cstring, cap: csize): int32 <cimport, nodecl> end
local function gi_listen(allowlist_path: cstring): uint32 <cimport, nodecl> end
local function gi_accept(listener: uint32): uint32 <cimport, nodecl> end
local function gi_peer_id(h: uint32, out: cstring, cap: csize): int32 <cimport, nodecl> end
local function gi_peer_caps(h: uint32): int32 <cimport, nodecl> end
local function gi_recv(h: uint32, buf: pointer, cap: csize): int32 <cimport, nodecl> end
local function gi_send(h: uint32, buf: pointer, len: csize): int32 <cimport, nodecl> end
local function gi_close(h: uint32): void <cimport, nodecl> end
local function gi_wakeup_fd(): int32 <cimport, nodecl> end
local function gi_wakeup_drain(): void <cimport, nodecl> end
local function gi_wait_ms(cap_ms: int32): int32 <cimport> end
local function gi_last_error(out: cstring, cap: csize): int32 <cimport> end

local iroh_listener: uint32 = 0  -- gi_listen handle, 0 when --iroh was not given
local iroh_wake: cint = -1       -- gi_wakeup_fd(), -1 when the library has none

-- The library's human text for one log line. Never parsed.
local function iroh_last_error(): string
  local buf: [256]uint8
  local n = gi_last_error((@cstring)((@pointer)(&buf)), 256)
  if n <= 0 then return 'no detail' end
  if (@usize)(n) > 255 then n = 255 end
  return string{data = (@*[0]byte)(&buf), size = (@usize)(n)}
end

-- A NUL-terminated copy of a path for the C ABI. An empty path is NULL, which
-- both gi_init and gi_listen document as "the default": an ephemeral key, and
-- no allowlist. The copy is made rather than handing over s.data because
-- nothing here guarantees a Nelua string is NUL-terminated.
local function iroh_path_c(s: string, buf: *[4096]uint8): cstring
  local c: cstring  -- zero-initialised: NULL
  if #s == 0 or #s >= 4095 then return c end
  memory.copy(buf, s.data, s.size)
  buf[s.size] = 0
  return (@cstring)((@pointer)(buf))
end
## end

-- Output this session had queued for a client when it detached: that much
-- still reaches the client, so a later ATTACH does not replay it again.
local DetachMark = @record{ client: usize, total: uint64 }

local Session = @record{
  id: uint32,
  pty: AgentPty,
  cols: uint16,
  rows: uint16,
  command: string,
  replay: vector(uint8),   -- ring buffer of recent output
  replay_head: usize,
  total_out: uint64,       -- output bytes ever read (the ring holds the last #replay of them)
  inbuf: ByteQueue,        -- input the PTY could not take yet (a large paste)
  attached: vector(usize), -- client indexes
  detached: vector(DetachMark), -- clients that detached, and how far their output went
  exited: boolean,
  exit_status: int32,
}

-- What this client may ask for. Mirrors GI_CAP_* in
-- crates/ghostty-iroh/include/ghostty_iroh.h; the agent is the only thing that
-- enforces them, so they are checked in one place (handle_frame) rather than
-- spread through the modules that would otherwise each have to remember.
local CAP_RUN: uint32 <comptime> = 1
local CAP_SHELL: uint32 <comptime> = 2
local CAP_CLIP_READ: uint32 <comptime> = 4
local CAP_CLIP_WRITE: uint32 <comptime> = 8
local CAP_WINDOWS: uint32 <comptime> = 16
local CAP_ALL: uint32 <comptime> = 31

local Client = @record{
  sock: NetSocket,
  inq: ByteQueue,
  outq: ByteQueue,
  authed: boolean,
  alive: boolean,
  ev: pointer,             -- Windows: the socket's event for the event loop
  ih: uint32,              -- iroh connection handle; 0 means this client is a socket
  caps: uint32,            -- CAP_*: what the allowlist grants this peer
}

local Agent = @record{
  listen_sock: NetSocket,
  clients: vector(Client),
  sessions: vector(Session),
  next_id: uint32,
  token: string,
  clip_file: string,   -- tests: use this file instead of the desktop clipboard
  replay_bytes: usize,
  term: string,
  hello: string,       -- "ghostty-agent <version> <nonce>": the nonce tells clients a restart happened
}

local INBUF_MAX: usize <comptime> = 8 * 1024 * 1024  -- input waiting for a PTY, per session
local OUTQ_HIGH: usize <comptime> = 1024 * 1024      -- a client this far behind stops its sessions' reads

local agent: Agent
local windows: AgentWindows
local jobs: AgentJobs
local clips: AgentClips
local wg: WgService

local function log(msg: string): void
  io.stderr:write('[ghostty-agent] ', msg, '\n')
end

local function send_frame(c: *Client, typ: uint8, payload: *[0]uint8, len: usize): void
  proto.write_frame(&c.outq, typ, payload, len)
end

local function send_text(c: *Client, typ: uint8, text: string): void
  proto.write_frame(&c.outq, typ, (@*[0]uint8)(text.data), text.size)
end

local function find_session(id: uint32): *Session
  for i = 0, < #agent.sessions do
    if agent.sessions[i].id == id then return &agent.sessions[i] end
  end
  return nilptr
end

local function session_append_replay(s: *Session, data: *[0]uint8, n: usize): void
  s.total_out = s.total_out + n
  local cap = agent.replay_bytes
  if n == 0 or cap == 0 then return end
  local off: usize = 0
  local size = (@usize)(#s.replay)
  if size < cap then
    -- filling up: the oldest byte stays at index 0
    if s.replay:capacity() == 0 then s.replay:reserve(cap) end
    local take = math.min(n, cap - size)
    s.replay:resize(size + take)
    memory.copy(&s.replay[size], data, take)
    off = take
  end
  -- full: overwrite the oldest bytes, which start at replay_head
  while off < n do
    local take = math.min(n - off, cap - s.replay_head)
    memory.copy(&s.replay[s.replay_head], &data[off], take)
    s.replay_head = (s.replay_head + take) % cap
    off = off + take
  end
end

-- Send `count` bytes of the ring, starting `start` bytes after its oldest.
local function send_replay_range(s: *Session, c: *Client, start: usize, count: usize): void
  local size = (@usize)(#s.replay)
  local first = agent_ring_index(size, agent.replay_bytes, s.replay_head, start)
  local n1 = math.min(count, size - first)
  if n1 > 0 then proto.write_frame_id(&c.outq, PROTO_SDATA, s.id, (@*[0]uint8)(&s.replay[first]), n1) end
  if count > n1 then proto.write_frame_id(&c.outq, PROTO_SDATA, s.id, (@*[0]uint8)(&s.replay[0]), count - n1) end
end

-- ATTACH: only what the client misses, or a reset and all the ring holds
-- (agent_replay_plan).
local function session_replay_to(s: *Session, c: *Client, has_fed: boolean, fed: uint64): void
  local plan = agent_replay_plan((@uint64)(#s.replay), s.total_out, has_fed, fed)
  if plan.reset then
    -- reset the terminal first so stale state from another client doesn't leak
    local reset: string = '\27c'
    proto.write_frame_id(&c.outq, PROTO_SDATA, s.id, (@*[0]uint8)(reset.data), reset.size)
  end
  if plan.count > 0 then send_replay_range(s, c, plan.start, plan.count) end
end

-- Input for the PTY: what it cannot take now waits in `inbuf` (the main loop
-- polls for POLLOUT and drains it), so a large paste arrives whole and in order.
local function session_queue_input(s: *Session, p: *[0]uint8, n: usize): void
  if s.inbuf:len() + n > INBUF_MAX then
    local sb: stringbuilder
    sb:writef('session %d: input backlog over %d bytes, dropped %d', s.id, INBUF_MAX, n)
    local msg = sb:promote()
    log(msg)
    msg:destroy()
    return
  end
  s.inbuf:push(p, n)
end

local function session_drain_input(s: *Session): void
  while s.inbuf:len() > 0 do
    local w = s.pty:write(s.inbuf:peek(), s.inbuf:len())
    if w > 0 then
      s.inbuf:consume((@usize)(w))
    elseif w == 0 then
      break -- the PTY takes no more now
    else
      s.inbuf:consume(s.inbuf:len()) -- the PTY is gone (EIO): nobody reads this any more
    end
  end
end

local function session_write_input(s: *Session, p: *[0]uint8, n: usize): void
  if s.inbuf:len() > 0 then session_queue_input(s, p, n) return end -- behind older input
  local off: usize = 0
  while off < n do
    local w = s.pty:write(&p[off], n - off)
    if w > 0 then
      off = off + (@usize)(w)
    elseif w == 0 then
      session_queue_input(s, &p[off], n - off) -- PTY input buffer full
      return
    else
      return
    end
  end
end

-- Some attached client is far behind on output: stop reading the shell (it
-- blocks on its own writes) instead of queueing without bound.
local function session_blocked(s: *Session): boolean
  for i = 0, < #s.attached do
    local ci = s.attached[i]
    if ci < #agent.clients and agent.clients[ci].alive and agent.clients[ci].outq:len() > OUTQ_HIGH then return true end
  end
  return false
end

local function session_is_attached(s: *Session, ci: usize): boolean
  for i = 0, < #s.attached do if s.attached[i] == ci then return true end end
  return false
end

local function session_detach(s: *Session, ci: usize): void
  for i = 0, < #s.attached do
    if s.attached[i] == ci then s.attached:remove(i) return end
  end
end

-- A client detached: everything read so far is queued for it (or already sent).
local function session_mark_detach(s: *Session, ci: usize): void
  for i = 0, < #s.detached do
    if s.detached[i].client == ci then s.detached[i].total = s.total_out return end
  end
  s.detached:push(DetachMark{ client = ci, total = s.total_out })
end

-- How far the output queued for client `ci` went before it detached (false: it never did).
local function session_take_mark(s: *Session, ci: usize): (boolean, uint64)
  for i = 0, < #s.detached do
    if s.detached[i].client == ci then
      local total = s.detached[i].total
      s.detached:remove(i)
      return true, total
    end
  end
  return false, 0
end

local function session_set_size(s: *Session, cols: uint16, rows: uint16): void
  s.cols = cols
  s.rows = rows
  s.pty:resize(cols, rows)
end

-- The host's system clipboard -------------------------------------------------
-- Copies inside the game land on the desktop clipboard and pastes come from
-- it (agent/sys_*.nelua). --clipboard-file swaps in a plain file for tests.
local CLIP_MAX: usize <comptime> = AGENT_CLIP_MAX

local function clipboard_set(data: *[0]uint8, len: usize): boolean
  if #agent.clip_file > 0 then
    local f = io.open(agent.clip_file, 'wb')
    if not f:isopen() then return false end
    f:write(string{data=(@*[0]byte)(data), size=len})
    f:close()
    return true
  end
  return agent_clipboard_set(data, len)
end

local function clipboard_get(): (boolean, string)
  if #agent.clip_file > 0 then
    local f = io.open(agent.clip_file, 'rb')
    if not f:isopen() then return true, string.copy('') end
    local content = f:read('a')
    f:close()
    return true, content
  end
  return agent_clipboard_get()
end

-- Does this WOPEN ask the agent to START something, rather than show a window
-- that is already up? The match text after the 13-byte head is `run:CMD`,
-- `app:ID` or `desktop:ID` for a launch (docs/REMOTE_WINDOWS.md); anything
-- else is a wid or a title to match. Checked here rather than in
-- agent/windows.nelua so every refusal this agent makes is in one function.
local WOPEN_HEAD: usize <comptime> = 13
local function wopen_starts_program(payload: *[0]uint8, len: usize): boolean
  if len <= WOPEN_HEAD then return false end
  local text = string{ data = (@*[0]byte)(&payload[WOPEN_HEAD]), size = len - WOPEN_HEAD }
  return text:subview(1, 4) == 'run:' or text:subview(1, 4) == 'app:' or text:subview(1, 8) == 'desktop:'
end

local function send_opened_error(c: *Client, why: string): void
  proto.write_frame_id(&c.outq, PROTO_OPENED, 0, (@*[0]uint8)(why.data), why.size)
end

local function handle_frame(ci: usize, typ: uint8, payload: *[0]uint8, len: usize): void
  local c = &agent.clients[ci]
  if not c.authed then
    if typ == PROTO_HELLO then
      local tok = string{data=(@*[0]byte)(payload), size=len}
      if tok == agent.token then
        c.authed = true
        send_text(c, PROTO_OK, agent.hello)
      else
        send_text(c, PROTO_ERR, 'bad token')
        c.alive = false
      end
    else
      send_text(c, PROTO_ERR, 'hello first')
      c.alive = false
    end
    return
  end

  if typ == PROTO_OPEN then
    -- a failed open still answers with OPENED (id 0): clients match OPENED to OPEN in order
    if len < 5 then send_opened_error(c, 'bad open') return end
    local cols = proto.get_u16(payload)
    local rows = proto.get_u16((@*[0]uint8)(&payload[2]))
    local argv, env = agent_split_nul((@*[0]uint8)(&payload[4]), len - 4)
    if #argv == 0 then
      argv:destroy()
      local comspec = os.getenv('COMSPEC')
      argv = agent_default_argv(#[ccinfo.is_windows and true or false]#, comspec)
      comspec:destroy()
    end
    local ok, pty, why = AgentPty.spawn(agent.term, &argv, &env, cols, rows)
    if not ok then
      send_opened_error(c, why)
      log('open failed: ' .. why)
      for i = 0, < #argv do argv[i]:destroy() end
      for i = 0, < #env do env[i]:destroy() end
      argv:destroy()
      env:destroy()
      return
    end
    local s: Session = { id = agent.next_id, pty = pty, cols = cols, rows = rows }
    agent.next_id = agent.next_id + 1
    local sb: stringbuilder
    for i = 0, < #argv do
      if i > 0 then sb:write(' ') end
      sb:write(argv[i])
    end
    s.command = sb:promote()
    s.attached:push(ci)
    agent.sessions:push(s)
    local idb: [4]uint8
    proto.put_u32(&idb, s.id)
    send_frame(c, PROTO_OPENED, &idb, 4)
    log('opened session ' .. tostring(s.id) .. ': ' .. s.command)
    for i = 0, < #argv do argv[i]:destroy() end
    for i = 0, < #env do env[i]:destroy() end
    argv:destroy()
    env:destroy()
  elseif typ == PROTO_DATA then
    if len < 4 then return end
    local s = find_session(proto.get_u32(payload))
    if s == nilptr or s.exited then return end
    session_write_input(s, (@*[0]uint8)(&payload[4]), len - 4)
  elseif typ == PROTO_RESIZE then
    if len < 8 then return end
    local s = find_session(proto.get_u32(payload))
    if s == nilptr then return end
    session_set_size(s, proto.get_u16((@*[0]uint8)(&payload[4])), proto.get_u16((@*[0]uint8)(&payload[6])))
  elseif typ == PROTO_CLOSE then
    if len < 4 then return end
    local s = find_session(proto.get_u32(payload))
    if s == nilptr then return end
    if not s.exited then s.pty:hangup() end
  elseif typ == PROTO_ATTACH then
    if len < 4 then return end
    local id = proto.get_u32(payload)
    local s = find_session(id)
    if s == nilptr or s.exited then
      -- gone (it exited while nobody was attached): EXIT lets the client close it
      local st: [4]uint8
      proto.put_u32(&st, s ~= nilptr and (@uint32)(s.exit_status) or PROTO_NO_SESSION)
      proto.write_frame_id(&c.outq, PROTO_EXIT, id, &st, 4)
      return
    end
    if not session_is_attached(s, ci) then
      s.attached:push(ci)
      local has_fed = len >= 12
      local fed: uint64 = has_fed and proto.get_u64((@*[0]uint8)(&payload[4])) or 0
      -- `fed` counts only what the client has read. What this connection queued
      -- before its DETACH is still on the way: replaying it too would feed it twice.
      local marked, queued = session_take_mark(s, ci)
      if has_fed and marked and queued > fed then fed = queued end
      session_replay_to(s, c, has_fed, fed)
    end -- already attached: it has every byte, nothing to replay
    local tb: [8]uint8
    proto.put_u64(&tb, s.total_out)
    proto.write_frame_id(&c.outq, PROTO_ATTACHED, id, &tb, 8)
  elseif typ == PROTO_DETACH then
    if len < 4 then return end
    local s = find_session(proto.get_u32(payload))
    if s ~= nilptr and session_is_attached(s, ci) then
      session_detach(s, ci)
      session_mark_detach(s, ci)
    end
  elseif typ == PROTO_LIST then
    local sb: stringbuilder
    for i = 0, < #agent.sessions do
      local s = &agent.sessions[i]
      sb:writef('%d\t%d\t%d\t%d\t%s\n', s.id, s.cols, s.rows, #s.attached, s.command)
    end
    local text = sb:promote()
    send_text(c, PROTO_LISTR, text)
    text:destroy()
  elseif typ == PROTO_CLIP_SET and (c.caps & CAP_CLIP_WRITE) == 0 then
    -- CLIP_SET writes the host's clipboard; CLIP_GET reads it. They are
    -- separate grants because letting a peer paste into this machine and
    -- letting it read what is on this machine are different things to agree
    -- to, and `clipboard=read` is the common one.
    send_text(c, PROTO_ERR, 'not permitted: this peer may not set the clipboard')
  elseif typ == PROTO_CLIP_GET and (c.caps & CAP_CLIP_READ) == 0 then
    send_text(c, PROTO_ERR, 'not permitted: this peer may not read the clipboard')
  elseif typ == PROTO_CLIP_SET then
    if len <= CLIP_MAX and clipboard_set(payload, len) then
      ## if CAPTURE_BUILT.wayland and ccinfo.is_linux then
      capture_wayland_clipboard_changed() -- apps in the compositor paste the game's copy
      ## end
      send_text(c, PROTO_OK, 'clipboard set')
    else
      send_text(c, PROTO_ERR, 'clipboard unavailable')
    end
  elseif typ == PROTO_CLIP_GET then
    local ok, text = clipboard_get()
    if ok then send_text(c, PROTO_CLIP, text) else send_text(c, PROTO_ERR, 'clipboard unavailable') end
    text:destroy()
  elseif typ == PROTO_HELLO then
    send_text(c, PROTO_OK, 'already authenticated')
  elseif typ == PROTO_OPEN and (c.caps & CAP_SHELL) == 0 then
    -- `shell=no`: the line docs/MULTI_AGENT.md calls the difference between a
    -- window server and a remote shell service.
    send_opened_error(c, 'not permitted: this peer may not open a shell')
  elseif typ == PROTO_WOPEN and (c.caps & CAP_WINDOWS) == 0 then
    send_text(c, PROTO_ERR, 'not permitted: this peer may not see windows')
  elseif typ == PROTO_WOPEN and (c.caps & CAP_RUN) == 0 and wopen_starts_program(payload, len) then
    send_text(c, PROTO_ERR, 'not permitted: this peer may not start programs')
  elseif jobs:handle(ci, &c.outq, typ, payload, len) then
    -- a raw job frame (agent/jobs.nelua)
  elseif windows:handle(ci, &c.outq, typ, payload, len) then
    -- a window frame (agent/windows.nelua)
  elseif clips:handle(ci, &c.outq, typ, payload, len) then
    -- a clip frame (agent/clips.nelua)
  else
    send_text(c, PROTO_ERR, 'unknown frame')
  end
end

-- The two places in the agent that touch a transport. Everything above and
-- below them -- handle_frame, the sessions, windows, jobs, clips, reap -- sees
-- a Client and nothing else.
--
-- The return contract is the same for both transports because gi_recv/gi_send
-- were specified to match net.recv/net.send: >0 bytes, 0 "nothing right now,
-- retry", <0 gone. That equivalence is the load-bearing detail; if gi_send
-- ever returned an error for a full stream window, flush_client would tear
-- down a healthy connection (docs/IROH.md, "Error model").
local function client_recv(c: *Client, buf: pointer, cap: usize): integer
  ## if IROH_BUILT then
  if c.ih ~= 0 then return (@integer)(gi_recv(c.ih, buf, (@csize)(cap))) end
  ## end
  return net.recv(c.sock, buf, cap)
end

local function client_send(c: *Client, buf: pointer, len: usize): integer
  ## if IROH_BUILT then
  if c.ih ~= 0 then return (@integer)(gi_send(c.ih, buf, (@csize)(len))) end
  ## end
  return net.send(c.sock, buf, len)
end

local function client_close(c: *Client): void
  ## if IROH_BUILT then
  if c.ih ~= 0 then gi_close(c.ih) c.ih = 0 end
  ## end
  net.close(c.sock)  -- a no-op on net.invalid(), which is what an iroh client holds
end

local function pump_client(ci: usize): void
  local c = &agent.clients[ci]
  if not c.alive then return end
  local buf: [16384]uint8
  for _ = 1, 32 do
    local n = client_recv(c, &buf, 16384)
    if n > 0 then c.inq:push(&buf, (@usize)(n))
    elseif n == 0 then break
    else c.alive = false break end
  end
  while c.alive do
    local ok, typ, payload, len = proto.read_frame(&c.inq)
    if not ok then break end
    handle_frame(ci, typ, payload, len)
    c = &agent.clients[ci]  -- vector may have been touched
    proto.frame_consume(&c.inq, len)
  end
end

local function flush_client(ci: usize): void
  local c = &agent.clients[ci]
  while c.outq:len() > 0 do
    local n = client_send(c, c.outq:peek(), c.outq:len())
    if n < 0 then c.alive = false break end
    if n == 0 then break end
    c.outq:consume((@usize)(n))
  end
end

local function broadcast(s: *Session, typ: uint8, data: *[0]uint8, len: usize): void
  for i = 0, < #s.attached do
    local ci = s.attached[i]
    if ci < #agent.clients and agent.clients[ci].alive then
      proto.write_frame_id(&agent.clients[ci].outq, typ, s.id, data, len)
    end
  end
end

local function pump_session(si: usize): void
  local s = &agent.sessions[si]
  if s.exited then return end
  session_drain_input(s)
  local buf: [32768]uint8
  if not session_blocked(s) then
    for _ = 1, 16 do
      local n = s.pty:read(&buf, 32768)
      if n <= 0 then break end -- nothing now, or the PTY closed (the exit shows below)
      session_append_replay(s, &buf, (@usize)(n))
      broadcast(s, PROTO_SDATA, &buf, (@usize)(n))
    end
  end
  local done, status = s.pty:poll_exit()
  if done then
    s.exited = true
    s.exit_status = status
    -- drain any final output
    while true do
      local n = s.pty:read(&buf, 32768)
      if n <= 0 then break end
      session_append_replay(s, &buf, (@usize)(n))
      broadcast(s, PROTO_SDATA, &buf, (@usize)(n))
    end
    local st: [4]uint8
    proto.put_u32(&st, (@uint32)(s.exit_status))
    broadcast(s, PROTO_EXIT, &st, 4)
    s.pty:close()
    log('session ' .. tostring(s.id) .. ' exited with ' .. tostring(s.exit_status))
  end
end

local function reap(): void
  agent_sys_reap()
  -- drop dead clients (from the back so indexes stay valid) and detach them
  local i: integer = #agent.clients - 1
  while i >= 0 do
    if not agent.clients[i].alive then
      windows:client_gone((@usize)(i))
      jobs:client_gone((@usize)(i))
      clips:client_gone((@usize)(i))
      for si = 0, < #agent.sessions do
        session_detach(&agent.sessions[si], (@usize)(i))
        -- shift indexes above i
        local s = &agent.sessions[si]
        for k = 0, < #s.attached do
          if s.attached[k] > (@usize)(i) then s.attached[k] = s.attached[k] - 1 end
        end
        session_take_mark(s, (@usize)(i)) -- its queue is gone with it
        for k = 0, < #s.detached do
          if s.detached[k].client > (@usize)(i) then s.detached[k].client = s.detached[k].client - 1 end
        end
      end
      ## if ccinfo.is_windows then
        winloop_forget_socket(agent.clients[i].ev)
      ## end
      client_close(&agent.clients[i])
      agent.clients[i].inq:destroy()
      agent.clients[i].outq:destroy()
      agent.clients:remove(i)
    end
    i = i - 1
  end
  -- drop exited sessions
  local j: integer = #agent.sessions - 1
  while j >= 0 do
    if agent.sessions[j].exited then
      agent.sessions[j].replay:destroy()
      agent.sessions[j].inbuf:destroy()
      agent.sessions[j].attached:destroy()
      agent.sessions[j].detached:destroy()
      agent.sessions[j].command:destroy()
      agent.sessions:remove(j)
    end
    j = j - 1
  end
end

local function read_token_file(path: string): string
  local f = io.open(path, 'rb')
  if f:isopen() then
    local content = f:read('a')
    f:close()
    return agent_trim(content)
  end
  -- generate
  local raw = agent_random(24)
  if #raw < 24 then log('WARNING: no random source for a new token') end
  local tok = agent_hex(raw)
  raw:destroy()
  if agent_write_private(path, tok .. '\n') then
    log('wrote new token to ' .. path)
  else
    log('WARNING: could not write token file ' .. path)
  end
  return tok
end

-- Where agent/windows.nelua queues frames for connection `ci`.
local function client_queue(ci: usize): *ByteQueue
  if ci < #agent.clients and agent.clients[ci].alive then return &agent.clients[ci].outq end
  return nilptr
end

-- The main loop's sleep, capped by what the window streams and the jobs need (ms).
local function windows_cap(ms: integer): integer
  local w = windows:wait_ms(os.now())
  if w >= 0 and w < ms then ms = w end
  local j = jobs:wait_ms()
  if j >= 0 and j < ms then ms = j end
  local g = wg:wait_ms(os.now())
  if g >= 0 and g < ms then ms = g end
  return ms
end

## if IROH_BUILT then
-- How long the loop may sleep once iroh is listening (ms). Never raises the
-- sleep it is handed, only lowers it, and never lowers it to zero.
--
-- gi_wakeup_fd() is endpoint-wide and level-triggered: "something, somewhere".
-- That is exactly the signal this loop wants, because the loop pumps
-- everything every pass and reads no revents -- an iroh connection is correct
-- with no fd at all, only slower. So when the fd exists, inbound data and
-- pending accepts wake poll() by themselves and the sleep stays long.
--
-- Two things the fd does not cover, so the sleep is capped anyway:
--   * Send-side readiness. gi_send returning 0 is a full stream window; the
--     ABI does not say the wakeup fires when that window reopens. So a client
--     with bytes still in outq caps the sleep at IROH_OUT_CAP_MS, and the
--     next pass retries the write. UNVERIFIED -- if the crate does signal a
--     reopened window, this cap is pure waste and should be deleted.
--   * No fd at all (gi_wakeup_fd() returned -1). Then sweeping is the only
--     way to notice anything, so the sleep is capped at IROH_NOFD_CAP_MS.
-- gi_wait_ms() shortens it further whenever the library wants it shorter.
--
-- IROH_MIN_MS is the busy-loop guard, and it is the reason this function
-- exists rather than a min() at the call site: gi_wait_ms() is allowed to
-- return 0, and a 0 timeout in this poll() with a level-triggered fd that
-- nothing has drained yet is a 100%-CPU spin. The floor is only applied to a
-- value iroh lowered, so a 2 ms cap asked for by a window stream still wins.
--
-- UNVERIFIED: none of these three numbers were measured. They bound a worst
-- case; they are not tuned, and 20 ms was picked because it is well under the
-- 250 ms the loop already sleeps and well over a syscall.
local IROH_MIN_MS: integer <comptime> = 5
local IROH_OUT_CAP_MS: integer <comptime> = 20
local IROH_NOFD_CAP_MS: integer <comptime> = 20

local function iroh_cap(ms: integer): integer
  if iroh_listener == 0 then return ms end
  if iroh_wake < 0 and ms > IROH_NOFD_CAP_MS then ms = IROH_NOFD_CAP_MS end
  for ci = 0, < #agent.clients do
    local c = &agent.clients[ci]
    if c.ih ~= 0 and c.alive and c.outq:len() > 0 then
      if ms > IROH_OUT_CAP_MS then ms = IROH_OUT_CAP_MS end
      break
    end
  end
  local w = (@integer)(gi_wait_ms((@int32)(ms)))
  if w >= 0 and w < ms then
    if w < IROH_MIN_MS then w = IROH_MIN_MS end
    if w < ms then ms = w end
  end
  return ms
end

-- Take every connection the listener has waiting. Called once per pass, after
-- the drain. gi_accept returns 0 when there is nothing, the same loop
-- termination as net.accept, so the shape here matches the TCP accept below.
local function iroh_accept_all(): void
  if iroh_listener == 0 then return end
  local h = gi_accept(iroh_listener)
  while h ~= 0 do
    -- sock is net.invalid() so that anything still reaching for a socket --
    -- net.close in client_close, socket_fd in the poll build-up -- is a
    -- no-op rather than a wrong fd. Unauthenticated like any other client:
    -- the PROTO_HELLO token still has to arrive (docs/MULTI_AGENT.md).
    -- The allowlist's grants for this key. A negative answer means the
    -- library cannot say, and the header is explicit that a caller which
    -- cannot tell must refuse rather than assume: no capabilities at all.
    local caps: uint32 = 0
    ## if IROH_BUILT then
    local rc = gi_peer_caps(h)
    if rc >= 0 then caps = (@uint32)(rc) end
    ## end
    local cl: Client = { sock = net.invalid(), alive = true, ih = h, caps = caps }
    agent.clients:push(cl)
    local pbuf: [80]uint8
    local pn = gi_peer_id(h, (@cstring)((@pointer)(&pbuf)), #pbuf)
    if pn > 0 then
      log('iroh: connection from ' .. string{data = (@*[0]byte)(&pbuf), size = (@usize)(pn)})
    else
      log('iroh: connection from an unnamed peer')
    end
    h = gi_accept(iroh_listener)
  end
end
## end


-- `ghostty-agent --open-url URL`: ask the running agent (--listen, else
-- $GHOSTTY_AGENT_LISTEN, else 127.0.0.1:7777; its token file likewise with
-- $GHOSTTY_AGENT_TOKEN_FILE) to open URL in its compositor's browser
-- (WOPEN "url:URL"), and wait for the answer. 0 when the browser has it, else
-- 1 and one line on stderr saying why. $BROWSER of the compositor's apps
-- (docs/REMOTE_WINDOWS.md "Opening URLs").
local function open_url_fail(why: string): integer
  io.stderr:write('ghostty-agent --open-url: ', why, '\n')
  return 1
end

local function open_url_client(listen_spec: string, token_path: string, url: string): integer
  ## if ccinfo.is_windows then
  return open_url_fail('links open in the Linux compositor only')
  ## else
  if #listen_spec == 0 then listen_spec = os.getenv('GHOSTTY_AGENT_LISTEN') end
  if #listen_spec == 0 then listen_spec = '127.0.0.1:7777' end
  if #token_path == 0 then token_path = os.getenv('GHOSTTY_AGENT_TOKEN_FILE') end
  if #token_path == 0 then token_path = agent_default_token_path() end
  local token: string
  do
    local f = io.open(token_path, 'rb')
    if not f:isopen() then return open_url_fail('no token file ' .. token_path .. ' (is the agent running?)') end
    token = agent_trim(f:read('a'))
    f:close()
  end
  local host, port = agent_parse_hostport(listen_spec)
  local conn = net.connect(host, port)
  if not net.is_valid(conn.sock) then return open_url_fail('cannot connect to ' .. listen_spec) end
  local fds: [1]pollfd
  local deadline = os.now() + 5.0
  while true do
    local st = net.connect_poll(&conn)
    if st == 1 then break end
    if st < 0 or os.now() > deadline then net.close(conn.sock) return open_url_fail('no agent at ' .. listen_spec) end
    fds[0] = { fd = net.socket_fd(conn.sock), events = POLLOUT }
    poll(&fds, 1, 100)
  end
  local outq: ByteQueue
  local inq: ByteQueue
  proto.write_frame(&outq, PROTO_HELLO, (@*[0]uint8)(token.data), token.size)
  local req: uint32 = 1
  do
    local match = 'url:' .. url
    local body: vector(uint8)
    body:resize(13 + match.size)
    local b = (@*[0]uint8)(&body[0])
    proto.put_u32(b, req)
    proto.put_u32((@*[0]uint8)(&b[4]), 0)
    proto.put_u16((@*[0]uint8)(&b[8]), 64) -- a small picture: nobody looks at it
    proto.put_u16((@*[0]uint8)(&b[10]), 64)
    body[12] = 1
    for i = 0, < match.size do body[13 + i] = (@uint8)(match.data[i]) end
    proto.write_frame(&outq, PROTO_WOPEN, b, #body)
    body:destroy()
    match:destroy()
  end
  -- a browser that has to start first may take a while to show its window
  deadline = os.now() + 45.0
  local buf: [16384]uint8
  local result: integer = -1
  while result < 0 do
    while outq:len() > 0 do
      local n = net.send(conn.sock, outq:peek(), outq:len())
      if n < 0 then net.close(conn.sock) return open_url_fail('the agent closed the connection') end
      if n == 0 then break end
      outq:consume((@usize)(n))
    end
    local n = net.recv(conn.sock, &buf, 16384)
    if n < 0 then net.close(conn.sock) return open_url_fail('the agent closed the connection') end
    if n > 0 then inq:push(&buf, (@usize)(n)) end
    while result < 0 do
      local ok, typ, payload, len = proto.read_frame(&inq)
      if not ok then break end
      if typ == PROTO_ERR then
        local view = string{data=(@*[0]byte)(payload), size=len}
        net.close(conn.sock)
        return open_url_fail(view)
      elseif typ == PROTO_WOPENED and len >= 12 and proto.get_u32(payload) == req then
        local sid = proto.get_u32((@*[0]uint8)(&payload[4]))
        if sid == 0 then
          local view = string{data=(@*[0]byte)(&payload[12]), size=len - 12}
          net.close(conn.sock)
          return open_url_fail(view)
        end
        result = 0
      end
      proto.frame_consume(&inq, len)
    end
    if result >= 0 then break end
    if os.now() > deadline then net.close(conn.sock) return open_url_fail('the browser showed no window in time') end
    local ev: cshort = POLLIN
    if outq:len() > 0 then ev = ev | POLLOUT end
    fds[0] = { fd = net.socket_fd(conn.sock), events = ev }
    poll(&fds, 1, 200)
  end
  net.close(conn.sock) -- the window stays in the compositor; the game shows it (raise:)
  return 0
  ## end
end

-- --allow-insecure-listen: every connection is logged with where it came from.
local function log_connection(c: NetSocket): void
  local from = net.peer_address(c)
  local sb: stringbuilder
  sb:write('connection in the clear from ', #from > 0 and from or 'an unknown address')
  local msg = sb:promote()
  log(msg)
  msg:destroy()
  from:destroy()
end

local function main(): integer
  agent_sys_init()
  if #arg >= 1 and arg[1] == 'wg' then -- `ghostty-agent wg ...` (agent/wg_cli.nelua)
    local default_token = agent_default_token_path()
    local r = wg_cli(2, default_token)
    default_token:destroy()
    return r
  end
  local listen_spec: string = '127.0.0.1:7777'
  local token_path: string = ''
  local windows_name: string = 'auto'
  local wayland_socket: string = '' -- empty: GHOSTTY_WAYLAND_SOCKET, else ffxiv-0, ffxiv-1, ...
  local xkb_layout: string = ''     -- empty: GHOSTTY_XKB_LAYOUT, else us
  local render_node: string = ''    -- empty: GHOSTTY_WAYLAND_RENDER_NODE, else auto
  local browser: string = ''        -- empty: GHOSTTY_WAYLAND_BROWSER, else the desktop's default browser
  local browser_profile: string = '' -- empty: GHOSTTY_WAYLAND_BROWSER_PROFILE, else the browser's own profile
  local open_url: string = ''       -- --open-url: a client of the running agent, not an agent
  local has_open_url = false
  local listen_given = false
  local iroh_on = false             -- --iroh: listen over iroh as well as TCP
  local iroh_secret: string = ''    -- --iroh-secret PATH: empty means an ephemeral key
  local iroh_allowlist: string = '' -- --iroh-allowlist PATH: empty means any peer, token only
  local wg_config: string = ''      -- --wireguard-config: the file (default: wireguard.conf beside the token)
  local wg_mode: string = 'auto'    -- --wireguard: auto, on, off or always (docs/WIREGUARD.md)
  local insecure_listen = false     -- --allow-insecure-listen
  agent.replay_bytes = 256 * 1024
  agent.term = 'xterm-256color'
  agent.next_id = 1
  local i = 1
  while i <= #arg do
    local a = arg[i]
    if a == '--listen' and i < #arg then listen_spec = arg[i+1] listen_given = true i = i + 1
    elseif a == '--open-url' and i < #arg then open_url = arg[i+1] has_open_url = true i = i + 1
    elseif a == '--wayland-browser' and i < #arg then browser = arg[i+1] i = i + 1
    elseif a == '--wayland-browser-profile' and i < #arg then browser_profile = arg[i+1] i = i + 1
    elseif a == '--iroh' then iroh_on = true
    elseif a == '--iroh-secret' and i < #arg then iroh_secret = arg[i+1] i = i + 1
    elseif a == '--iroh-allowlist' and i < #arg then iroh_allowlist = arg[i+1] i = i + 1
    elseif a == '--token-file' and i < #arg then token_path = arg[i+1] i = i + 1
    elseif a == '--clipboard-file' and i < #arg then agent.clip_file = arg[i+1] i = i + 1
    elseif a == '--replay-bytes' and i < #arg then agent.replay_bytes = (@usize)(tointeger(arg[i+1])) i = i + 1
    elseif a == '--term' and i < #arg then agent.term = arg[i+1] i = i + 1
    elseif a == '--windows' and i < #arg then windows_name = arg[i+1] i = i + 1
    elseif a == '--wayland-socket' and i < #arg then wayland_socket = arg[i+1] i = i + 1 -- Linux compositor only
    elseif a == '--xkb-layout' and i < #arg then xkb_layout = arg[i+1] i = i + 1
    elseif a == '--wayland-render-node' and i < #arg then render_node = arg[i+1] i = i + 1 -- PATH, auto, gpu or none
    elseif a == '--wireguard-config' and i < #arg then wg_config = arg[i+1] i = i + 1
    elseif a == '--wireguard' and i < #arg then wg_mode = arg[i+1] i = i + 1
    elseif a == '--allow-insecure-listen' then insecure_listen = true
    elseif a == '--help' or a == '-h' then
      io.write('usage: ghostty-agent [--listen HOST:PORT] [--token-file PATH] [--clipboard-file PATH] [--replay-bytes N] [--term NAME] [--windows NAME] [--wayland-socket NAME] [--xkb-layout LAYOUT] [--wayland-render-node PATH|auto|gpu|none] [--wayland-browser CMD] [--wayland-browser-profile NAME] [--wireguard auto|on|off|always] [--wireguard-config PATH] [--allow-insecure-listen]\n',
               '                     [--iroh] [--iroh-secret PATH] [--iroh-allowlist PATH]\n',
               '       ghostty-agent [--listen HOST:PORT] [--token-file PATH] --open-url URL\n',
               '       ghostty-agent wg add NAME [--endpoint HOST[:PORT]] | list | show | remove NAME | forward ... | unforward ...\n')
      return 0
    else
      io.stderr:write('unknown argument: ', a, '\n')
      return 2
    end
    i = i + 1
  end
  if has_open_url then return open_url_client(listen_given and listen_spec or '', token_path, open_url) end
  if #token_path == 0 then token_path = agent_default_token_path() end
  if wg_mode ~= 'auto' and wg_mode ~= 'on' and wg_mode ~= 'off' and wg_mode ~= 'always' then
    io.stderr:write('--wireguard takes auto, on, off or always\n')
    return 2
  end
  local host, port = agent_parse_hostport(listen_spec)
  -- The protocol is not encrypted: loopback, or a tailnet address with
  -- Tailscale running, and nothing else unless someone insists
  -- (docs/WIREGUARD.md "Selection").
  local ts: Tailscale
  ts:detect()
  do
    local ok, why = listen_allowed(host, &ts)
    if not ok then
      if not insecure_listen then
        io.stderr:write('ghostty-agent: refusing to listen on ', listen_spec, ': ', why, '.\n',
          'Listen on loopback and reach it through the built-in WireGuard (ghostty-agent wg add NAME),\n',
          'through your tailnet address if this machine runs Tailscale, or through ssh -L.\n',
          '--allow-insecure-listen listens there anyway.\n')
        return 2
      end
      log('WARNING: listening on ' .. listen_spec .. ' in the clear (--allow-insecure-listen): ' .. why ..
          '. Anyone who can reach it and read the token has a shell as you.')
    end
  end
  agent.token = read_token_file(token_path)
  agent.listen_sock = net.listen(host, port)
  if not net.is_valid(agent.listen_sock) then
    log('cannot listen on ' .. listen_spec)
    return 1
  end
  local pid = agent_pid()
  log('listening on ' .. listen_spec .. ' (pid ' .. tostring(pid) .. ')')
  if iroh_on then
    ## if IROH_BUILT then
    local v = gi_abi_version()
    if v ~= IROH_ABI_VERSION then
      log('iroh: ABI mismatch, this agent speaks ' .. tostring(IROH_ABI_VERSION) .. ' and the library reports ' .. tostring(v))
      return 1
    end
    local sbuf: [4096]uint8
    local abuf: [4096]uint8
    if gi_init(iroh_path_c(iroh_secret, &sbuf)) < 0 then
      log('iroh: cannot start the endpoint: ' .. iroh_last_error())
      return 1
    end
    iroh_listener = gi_listen(iroh_path_c(iroh_allowlist, &abuf))
    if iroh_listener == 0 then
      log('iroh: cannot listen: ' .. iroh_last_error())
      gi_shutdown()
      return 1
    end
    do -- the NodeId is the address clients dial, so it is logged like the listen spec
      local idbuf: [80]uint8
      local idn = gi_node_id((@cstring)((@pointer)(&idbuf)), #idbuf)
      if idn > 0 then
        log('iroh: listening as ' .. string{data = (@*[0]byte)(&idbuf), size = (@usize)(idn)})
      else
        log('iroh: listening, but the node id is unavailable: ' .. iroh_last_error())
      end
      if #iroh_allowlist > 0 then
        log('iroh: allowlist ' .. iroh_allowlist)
      else
        log('iroh: no allowlist -- any peer may connect, and the PROTO_HELLO token is the only authorisation')
      end
      if #iroh_secret == 0 then
        log('iroh: ephemeral key -- this NodeId changes on restart; pass --iroh-secret PATH to keep it')
      end
    end
    iroh_wake = (@cint)(gi_wakeup_fd())
    if iroh_wake < 0 then
      log('iroh: no wakeup fd; the loop sweeps the endpoint on its own timer instead')
    end
    ## elseif ccinfo.is_windows then
    log('--iroh: the iroh listener is POSIX only here -- it needs gi_wakeup_fd() in poll(), and the Windows loop waits on HANDLEs (docs/IROH.md)')
    return 1
    ## else
    log('--iroh: this build has no iroh backend; rebuild with IROH=1 (docs/IROH.md)')
    return 1
    ## end
  end
  -- a different nonce per agent process: a reconnecting client learns whether
  -- its session ids still mean the same shells
  local nonce: int64 = ((@int64)(os.time()) & 0xffffffff) << 20 | (pid & 0xfffff)
  if nonce == 0 then nonce = 1 end
  do
    local sb: stringbuilder
    -- The platform is the agent's, and the client cannot infer it: under Wine
    -- the plugin is Windows while the agent it talks to is the Linux or macOS
    -- host, so anything chosen from the plugin's own platform runs the wrong
    -- command here (tools that did picked cmd.exe and got status 127).
    ## if ccinfo.is_windows then
    local plat: string <comptime> = 'windows'
    ## elseif ccinfo.is_apple then
    local plat: string <comptime> = 'macos'
    ## else
    local plat: string <comptime> = 'linux'
    ## end
    sb:writef('ghostty-agent %d %d %s', PROTO_VERSION, nonce, plat)
    agent.hello = sb:promote()
  end
  ## if CAPTURE_BUILT.wayland and ccinfo.is_linux then
  capture_wayland_configure(wayland_socket, xkb_layout)
  capture_wayland_set_render_node(render_node)
  capture_wayland_set_browser(browser, browser_profile)
  capture_wayland_set_agent(listen_spec, token_path)
  capture_wayland_set_clipboard(clipboard_get, clipboard_set) -- the compositor's apps share the host clipboard
  ## end
  do
    local ok, why = windows:init(windows_name, client_queue)
    if ok then log('windows: ' .. windows.backend.name) else log('windows unavailable: ' .. why) end
  end
  jobs:init(client_queue, log) -- raw jobs (docs/JOBS.md); they run as this user
  clips.queue_of, clips.log_fn, clips.next_cid = client_queue, log, 1 -- clips of the game (docs/CAPTURE.md)
  -- the embedded WireGuard (docs/WIREGUARD.md "Selection"): only when
  -- Tailscale is not here, unless always
  if #wg_config > 0 and wg_mode == 'auto' then wg_mode = 'on' end -- naming the file asks for it
  local wg_path = #wg_config > 0 and wg_config:copy() or wg_default_config_path(token_path)
  local wg_start = false
  if wg_mode == 'always' then
    wg_start = true
    if ts.detected then log('wireguard: starting although Tailscale is here (' .. ts.why .. '), as --wireguard always asks') end
  elseif wg_mode ~= 'off' then
    local have, text = wg_read_file(wg_path)
    local peers = have and text:find('[Peer]', 1, true) > 0
    crypto.wipe(text.data, text.size)
    text:destroy()
    if ts.detected and (wg_mode == 'on' or peers) then
      local addr = ts:address()
      log('Tailscale detected (' .. ts.why .. '): WireGuard not started. To reach this agent from another machine, listen on your tailnet address: --listen ' ..
          (#addr > 0 and addr or 'YOUR-TAILNET-ADDRESS') .. ':' .. tostring(port) .. ' (or --wireguard always)')
      addr:destroy()
    elseif wg_mode == 'on' then
      wg_start = true
      if not have then -- a key and addresses to start from; `ghostty-agent wg add` adds peers
        local fresh: WgConfig
        if not wg_init_config(&fresh, WG_DEFAULT_PORT) or not fresh:save(wg_path) then
          log('wireguard: cannot make ' .. wg_path) return 2
        end
        fresh:destroy()
        log('wireguard: made ' .. wg_path .. '; add a peer with `ghostty-agent wg add NAME`')
      end
    elseif peers then
      wg_start = true
    end
  end
  if wg_start then
    -- refuse to start rather than run without the tunnel someone asked for
    local cfg: WgConfig
    local ok, why = cfg:load(wg_path)
    if not ok then log(wg_path .. ': ' .. why) return 2 end
    wg.log = log
    local started, err = wg:start(&cfg, port)
    cfg:destroy()
    if not started then log('wireguard: ' .. err) return 2 end
    wg:watch(wg_path) -- peers and forwards follow the file
  end
  wg_path:destroy()
  ts:destroy()

  ## if ccinfo.is_windows then
  local listen_ev = winloop_watch(agent.listen_sock, true)
  if listen_ev == nilptr then
    log('cannot watch the listening socket')
    return 1
  end
  local handles: [WINLOOP_MAX_HANDLES]pointer
  local overflow_logged = false
  while true do
    local n: usize = 0
    local wanted: usize = 1
    handles[0] = listen_ev
    n = 1
    for ci = 0, < #agent.clients do
      wanted = wanted + 1
      if n < WINLOOP_MAX_HANDLES and agent.clients[ci].ev ~= nilptr then handles[n] = agent.clients[ci].ev n = n + 1 end
    end
    local exiting = false
    for si = 0, < #agent.sessions do
      local s = &agent.sessions[si]
      if not s.exited then
        wanted = wanted + s.pty:wait_handles(&handles, &n, WINLOOP_MAX_HANDLES, not session_blocked(s))
        if s.pty:exiting() then exiting = true end
      end
    end
    wanted = wanted + wg:wait_handles(&handles, &n, WINLOOP_MAX_HANDLES) -- the tunnel and its forwards
    if wanted > WINLOOP_MAX_HANDLES and not overflow_logged then
      overflow_logged = true
      log('more handles than one wait takes; polling every 50 ms while that lasts')
    end
    winloop_wait(&handles, n, (@uint32)(windows_cap((@integer)(agent_wait_ms(wanted, WINLOOP_MAX_HANDLES, exiting)))))
    -- everything is pumped below: events from now on signal again
    winloop_reset(listen_ev)
    for ci = 0, < #agent.clients do winloop_reset(agent.clients[ci].ev) end
    wg:reset_events()

    local c = net.accept(agent.listen_sock)
    while net.is_valid(c) do
      if insecure_listen then log_connection(c) end
      local cl: Client = { sock = c, alive = true, ev = winloop_watch(c, false) }
      if cl.ev == nilptr then
        log('cannot watch a new connection; closing it')
        net.close(c)
      else
        agent.clients:push(cl)
      end
      c = net.accept(agent.listen_sock)
    end
    wg:pump(os.now())
    for ci = 0, < #agent.clients do pump_client(ci) end
    for si = 0, < #agent.sessions do pump_session(si) end
    windows:pump()
    windows:tick(os.now())
    jobs:pump(os.now())
    clips:tick(os.now())
    for ci = 0, < #agent.clients do flush_client(ci) end
    reap()
  end
  ## else
  local fds: [512]pollfd
  while not agent_stop_requested() do
    local n: usize = 0
    fds[n] = { fd = net.socket_fd(agent.listen_sock), events = POLLIN }
    n = n + 1
    for ci = 0, < #agent.clients do
      ## if IROH_BUILT then
      -- An iroh client has no fd of its own; the endpoint's one wakeup fd
      -- below stands in for all of them, and pump_client sweeps it regardless.
      -- Skipped rather than passed as -1 so it does not spend a slot of the
      -- 512 (the cap drops entries silently, docs/IROH.md).
      if agent.clients[ci].ih ~= 0 then continue end
      ## end
      local ev = POLLIN
      if agent.clients[ci].outq:len() > 0 then ev = ev | POLLOUT end -- wake when it can take more
      if n < 512 then fds[n] = { fd = net.socket_fd(agent.clients[ci].sock), events = ev } n = n + 1 end
    end
    for si = 0, < #agent.sessions do
      local s = &agent.sessions[si]
      local ev: cshort = 0
      if not s.exited and not session_blocked(s) then ev = POLLIN end
      if not s.exited and s.inbuf:len() > 0 then ev = ev | POLLOUT end
      if n < 512 and ev ~= 0 then fds[n] = { fd = s.pty.fd, events = ev } n = n + 1 end
    end
    do -- the capture backend's descriptors (D-Bus, PipeWire, a compositor)
      local wfds: [16]cint
      local wn = windows:poll_fds(&wfds, 16)
      for k = 0, < wn do
        if n < 512 then fds[n] = { fd = wfds[k], events = POLLIN } n = n + 1 end
      end
    end
    do -- the jobs' stdout and stderr pipes (agent/jobs.nelua)
      local jfds: [128]cint
      local jn = jobs:poll_fds(&jfds, 128)
      for k = 0, < jn do
        if n < 512 then fds[n] = { fd = jfds[k], events = POLLIN } n = n + 1 end
      end
    end
    do -- a camera frame still going into its fifo (agent/clips.nelua)
      local cfds: [8]cint
      local cn = clips:poll_fds(&cfds, 8)
      for k = 0, < cn do
        if n < 512 then fds[n] = { fd = cfds[k], events = POLLOUT } n = n + 1 end
      end
    end
    do -- the embedded WireGuard: its UDP socket and its forwards' sockets
      local gfds: [256]WgPollFd
      local gn = wg:poll_fds((@*[0]WgPollFd)(&gfds[0]), 256)
      for k = 0, < gn do
        local ev: cshort = 0
        if gfds[k].read then ev = POLLIN end
        if gfds[k].write then ev = ev | POLLOUT end
        if n < 512 and ev ~= 0 then fds[n] = { fd = gfds[k].fd, events = ev } n = n + 1 end
      end
    end
    ## if IROH_BUILT then
    -- One fd for the whole endpoint. Nothing dispatches on it: it only keeps
    -- poll() from sleeping through an arrival, and the sweep below runs every
    -- pass whether it fired or not.
    if iroh_wake >= 0 and n < 512 then fds[n] = { fd = iroh_wake, events = POLLIN } n = n + 1 end
    poll(&fds, n, iroh_cap(windows_cap(250)))
    -- Drained before the sweep, not after: the signal is level-triggered, so
    -- anything that arrives while the pumps below are running re-raises it and
    -- the next poll() returns at once instead of sleeping on unread bytes.
    if iroh_listener ~= 0 then gi_wakeup_drain() end
    iroh_accept_all()
    ## else
    poll(&fds, n, windows_cap(250))
    ## end

    local c = net.accept(agent.listen_sock)
    while net.is_valid(c) do
      -- No allowlist on the socket path: the token is the whole
      -- authorisation there, as it was before grants existed.
      if insecure_listen then log_connection(c) end
      local cl: Client = { sock = c, alive = true, caps = CAP_ALL }
      agent.clients:push(cl)
      c = net.accept(agent.listen_sock)
    end
    wg:pump(os.now())
    for ci = 0, < #agent.clients do pump_client(ci) end
    for si = 0, < #agent.sessions do pump_session(si) end
    windows:pump()
    windows:tick(os.now())
    jobs:pump(os.now())
    clips:tick(os.now())
    for ci = 0, < #agent.clients do flush_client(ci) end
    reap()
  end
  log('stopping')
  ## if IROH_BUILT then
  -- Before the endpoint goes, so the peers see a close rather than a timeout.
  -- gi_shutdown joins the runtime threads; it is the last iroh call.
  for ci = 0, < #agent.clients do
    if agent.clients[ci].ih ~= 0 then gi_close(agent.clients[ci].ih) agent.clients[ci].ih = 0 end
  end
  if iroh_listener ~= 0 then
    gi_close(iroh_listener)
    iroh_listener = 0
    gi_shutdown()
  end
  ## end
  wg:stop() -- keys wiped, forwards closed
  jobs:shutdown() -- jobs are not orphaned behind the agent, kept or not
  ## if CAPTURE_BUILT.wayland and ccinfo.is_linux then
  capture_wayland_shutdown() -- apps launched into the compositor are ended, not orphaned
  ## end
  ## end
  return 0
end

os.exit(main())
