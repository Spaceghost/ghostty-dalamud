local WL_KEYBOARD_KEY_STATE_RELEASED: uint32 <cimport, nodecl, const>

-- wlroots 0.20
local wlr_box <cimport, nodecl, ctypedef> = @record{ x: cint, y: cint, width: cint, height: cint }
local wlr_backend <cimport, nodecl, ctypedef> = @record{}
local wlr_renderer <cimport, nodecl, ctypedef> = @record{}
local wlr_allocator <cimport, nodecl, ctypedef> = @record{}
local wlr_buffer <cimport, nodecl, ctypedef> = @record{}
local wlr_surface <cimport, nodecl, ctypedef> = @record{
  resource: *wl_resource,
  mapped: boolean,
  events: record{ commit: wl_signal, map: wl_signal, unmap: wl_signal, destroy: wl_signal },
}
local wlr_output <cimport, nodecl, ctypedef> = @record{ width: int32, height: int32, frame_pending: boolean }
local wlr_output_state <cimport, nodecl, ctypedef> = @record{ committed: uint32, buffer: *wlr_buffer }
local wlr_scene_node <cimport, nodecl, ctypedef> = @record{ type: cint }
local wlr_scene_tree <cimport, nodecl, ctypedef> = @record{ node: wlr_scene_node }
local wlr_scene <cimport, nodecl, ctypedef> = @record{ tree: wlr_scene_tree }
local wlr_scene_output <cimport, nodecl, ctypedef> = @record{}
local wlr_scene_buffer <cimport, nodecl, ctypedef> = @record{}
local wlr_scene_surface <cimport, nodecl, ctypedef> = @record{ surface: *wlr_surface }
local wlr_compositor <cimport, nodecl, ctypedef> = @record{}
local wlr_xdg_shell <cimport, nodecl, ctypedef> = @record{
  events: record{ new_surface: wl_signal, new_toplevel: wl_signal, new_popup: wl_signal },
}
local wlr_xdg_toplevel <cimport, nodecl, forwarddecl, ctypedef> = @record{}
local wlr_xdg_popup <cimport, nodecl, forwarddecl, ctypedef> = @record{}
local wlr_xdg_surface <cimport, nodecl, ctypedef> = @record{
  resource: *wl_resource,
  surface: *wlr_surface,
  role: cint,
  toplevel: *wlr_xdg_toplevel, -- member of an anonymous union with `popup`
  popup: *wlr_xdg_popup,
  initialized: boolean,
  initial_commit: boolean,
  geometry: wlr_box,
  data: pointer,
}
wlr_xdg_toplevel = @record{
  resource: *wl_resource,
  base: *wlr_xdg_surface,
  title: cstring,
  app_id: cstring,
  events: record{ destroy: wl_signal, request_maximize: wl_signal, request_fullscreen: wl_signal },
}
wlr_xdg_popup = @record{
  base: *wlr_xdg_surface,
  parent: *wlr_surface,
  events: record{ destroy: wl_signal },
}
local wlr_xdg_decoration_manager_v1 <cimport, nodecl, ctypedef> = @record{
  events: record{ new_toplevel_decoration: wl_signal },
}
local wlr_xdg_toplevel_decoration_v1 <cimport, nodecl, ctypedef> = @record{
  toplevel: *wlr_xdg_toplevel,
  events: record{ destroy: wl_signal, request_mode: wl_signal },
}
local wlr_seat <cimport, nodecl, ctypedef> = @record{}
local wlr_keyboard_modifiers <cimport, nodecl, ctypedef> = @record{ depressed: uint32, latched: uint32, locked: uint32, group: uint32 }
local wlr_keyboard <cimport, nodecl, ctypedef> = @record{
  keycodes: [32]uint32,
  num_keycodes: usize,
  modifiers: wlr_keyboard_modifiers,
}
local wlr_keyboard_impl <cimport, nodecl, ctypedef> = @record{ name: cstring, led_update: pointer }
local wlr_keyboard_key_event <cimport, nodecl, ctypedef> = @record{ time_msec: uint32, keycode: uint32, update_state: boolean, state: uint32 }
local WLR_ERROR: cint <comptime> = 1
local WLR_DEBUG: cint <comptime> = 3
local WLR_OUTPUT_STATE_BUFFER: uint32 <comptime> = 1
local WLR_BUFFER_DATA_PTR_ACCESS_READ: uint32 <comptime> = 1
local WLR_SCENE_NODE_BUFFER: cint <comptime> = 2
local WLR_XDG_SURFACE_ROLE_TOPLEVEL: cint <comptime> = 1
