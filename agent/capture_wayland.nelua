local WLR_XDG_TOPLEVEL_DECORATION_V1_MODE_SERVER_SIDE: cint <comptime> = 2
local DRM_FORMAT_XRGB8888: uint32 <comptime> = 0x34325258 -- 'XR24': B G R X in memory
local DRM_FORMAT_ARGB8888: uint32 <comptime> = 0x34325241 -- 'AR24'
local DRM_FORMAT_XBGR8888: uint32 <comptime> = 0x34324258 -- 'XB24': R G B X
local DRM_FORMAT_ABGR8888: uint32 <comptime> = 0x34324241 -- 'AB24'

