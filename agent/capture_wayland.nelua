-- libwayland-server. Records declare only the fields used here; their C
-- layouts come from the real headers (vendor/wayland-sdk).
local wl_list <cimport, nodecl, ctypedef> = @record{ prev: *wl_list, next: *wl_list }
local wl_listener <cimport, nodecl, ctypedef> = @record{ link: wl_list, notify: function(*wl_listener, pointer): void }
local wl_signal <cimport, nodecl, ctypedef> = @record{ listener_list: wl_list }
local wl_display <cimport, nodecl, ctypedef> = @record{}
local wl_event_loop <cimport, nodecl, ctypedef> = @record{}
local wl_client <cimport, nodecl, ctypedef> = @record{}
local wl_resource <cimport, nodecl, ctypedef> = @record{}
local function wl_display_create(): *wl_display <cimport, nodecl> end
local function wl_display_destroy(d: *wl_display): void <cimport, nodecl> end
local function wl_display_destroy_clients(d: *wl_display): void <cimport, nodecl> end
local function wl_display_get_event_loop(d: *wl_display): *wl_event_loop <cimport, nodecl> end
local function wl_display_add_socket(d: *wl_display, name: cstring): cint <cimport, nodecl> end
local function wl_display_add_socket_auto(d: *wl_display): cstring <cimport, nodecl> end
local function wl_display_flush_clients(d: *wl_display): void <cimport, nodecl> end
local function wl_event_loop_dispatch(l: *wl_event_loop, timeout: cint): cint <cimport, nodecl> end
local function wl_event_loop_get_fd(l: *wl_event_loop): cint <cimport, nodecl> end
local function wl_signal_add(s: *wl_signal, l: *wl_listener): void <cimport, nodecl> end
local function wl_list_remove(l: *wl_list): void <cimport, nodecl> end
local function wl_resource_get_client(r: *wl_resource): *wl_client <cimport, nodecl> end
local function wl_client_get_credentials(c: *wl_client, pid: *cint, uid: *cuint, gid: *cuint): void <cimport, nodecl> end
local WL_SEAT_CAPABILITY_POINTER: uint32 <cimport, nodecl, const>
local WL_SEAT_CAPABILITY_KEYBOARD: uint32 <cimport, nodecl, const>
local WL_POINTER_BUTTON_STATE_PRESSED: uint32 <cimport, nodecl, const>
local WL_POINTER_BUTTON_STATE_RELEASED: uint32 <cimport, nodecl, const>
local WL_POINTER_AXIS_VERTICAL_SCROLL: uint32 <cimport, nodecl, const>
local WL_POINTER_AXIS_HORIZONTAL_SCROLL: uint32 <cimport, nodecl, const>
