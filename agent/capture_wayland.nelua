-- Xwayland (wlroots' XWM): X11 windows are wlr_xwayland_surfaces whose
-- wl_surface Xwayland commits like any client's.
local wlr_xwayland_server <cimport, nodecl, ctypedef> = @record{
  pid: cint,
  events: record{ start: wl_signal, ready: wl_signal, destroy: wl_signal },
}
local wlr_xwayland <cimport, nodecl, ctypedef> = @record{
  server: *wlr_xwayland_server,
  display_name: cstring,
  events: record{ destroy: wl_signal, ready: wl_signal, new_surface: wl_signal },
}
local wlr_xwayland_surface <cimport, nodecl, forwarddecl, ctypedef> = @record{}
wlr_xwayland_surface = @record{
  window_id: uint32,
  surface: *wlr_surface,
  x: int16, y: int16, width: uint16, height: uint16,
  override_redirect: boolean,
  title: cstring,
  class: cstring,
  instance: cstring,
  pid: cint,
  parent: *wlr_xwayland_surface,
  events: record{
    destroy: wl_signal, request_configure: wl_signal, request_activate: wl_signal,
    associate: wl_signal, dissociate: wl_signal,
  },
  data: pointer,
}
local wlr_xwayland_surface_configure_event <cimport, nodecl, ctypedef> = @record{
  surface: *wlr_xwayland_surface, x: int16, y: int16, width: uint16, height: uint16, mask: uint16,
}
local function wlr_xwayland_create(d: *wl_display, c: *wlr_compositor, lazy: boolean): *wlr_xwayland <cimport, nodecl> end
local function wlr_xwayland_destroy(x: *wlr_xwayland): void <cimport, nodecl> end
local function wlr_xwayland_set_seat(x: *wlr_xwayland, s: *wlr_seat): void <cimport, nodecl> end
local function wlr_xwayland_surface_configure(s: *wlr_xwayland_surface, x: int16, y: int16, w: uint16, h: uint16): void <cimport, nodecl> end
local function wlr_xwayland_surface_activate(s: *wlr_xwayland_surface, on: boolean): void <cimport, nodecl> end
local function wlr_xwayland_surface_close(s: *wlr_xwayland_surface): void <cimport, nodecl> end
local function wlr_xwayland_surface_restack(s: *wlr_xwayland_surface, sibling: *wlr_xwayland_surface, mode: cint): void <cimport, nodecl> end
local XCB_STACK_MODE_ABOVE: cint <comptime> = 0

global WAYLAND_DEFAULT_W: integer <comptime> = 1280
global WAYLAND_DEFAULT_H: integer <comptime> = 800
local WAYLAND_OPEN_TIMEOUT: float64 <comptime> = 30.0 -- s, for a launched app or a match to show up
local WAYLAND_HANDOFF_WAIT: float64 <comptime> = 5.0 -- s, after a launched app exits 0 without a window
local X11_SCREEN_W: integer <comptime> = 3840 -- the X screen Xwayland sees (see start_xwayland)
local X11_SCREEN_H: integer <comptime> = 2160
local POPUP_MARGIN: integer <comptime> = 600 -- logical px popups may reach beyond their window
-- Outputs advertise 60 Hz: a refresh of 0 makes GTK4 divide by zero timing its
-- frames (SIGFPE, seen with GNOME Calculator and Text Editor 1.6 s after mapping)
local WAYLAND_REFRESH_MHZ: int32 <comptime> = 60000
local BTN_LEFT: uint32 <comptime> = 0x110 -- then BTN_RIGHT 0x111, BTN_MIDDLE 0x112
local AXIS_PER_NOTCH: float64 <comptime> = 15.0 -- wl_pointer.axis units per wheel notch (libinput's)

-- A wl_listener with a way back to what it belongs to: the listener is the
-- first field, so the pointer a signal hands over is the Hook's.
local Hook = @record{ l: wl_listener, owner: pointer, on: boolean }

local function hook(h: *Hook, sig: *wl_signal, fn: function(*wl_listener, pointer): void, owner: pointer): void
  h.owner = owner
  h.l.notify = fn
  wl_signal_add(sig, &h.l)
  h.on = true
end

-- Every listener comes off its signal before its owner goes: a listener left
-- on a destroyed object's list is the classic wlroots crash.
local function unhook(h: *Hook): void
  if h.on then wl_list_remove(&h.l.link) h.on = false end
end

local function owner_of(l: *wl_listener): pointer
  return (@*Hook)(l).owner
end

local Top <forwarddecl> = @record{}
local XSurf <forwarddecl> = @record{}

-- Something drawn into a window's output beside the window itself: an
-- xdg_popup (menus, tooltips, combo lists) or an X11 override-redirect window.
local Popup = @record{
  p: *wlr_xdg_popup,         -- an xdg popup, or
  x: *XSurf,                 -- an X11 override-redirect window
  top: *Top,                 -- the window it shows in (nilptr: none)
  tree: *wlr_scene_tree,     -- its node in that window's scene
  on_commit: Hook, on_destroy: Hook,
}

-- One window: an xdg_toplevel, or an X11 toplevel through Xwayland (`x11`).
-- Its scene, its output, its latest pixels.
Top = @record{
  id: uint32,
  xdg: *wlr_xdg_toplevel,    -- xdg windows (nilptr for X11)
  x11: *XSurf,               -- X11 windows (nilptr for xdg)
  pid: cint,                 -- the client process (X11: _NET_WM_PID)
  scale: integer,            -- the output scale the window renders at
  scene: *wlr_scene,
  output: *wlr_output,       -- made on the first map, sized to the window
  sout: *wlr_scene_output,
  deco: pointer,             -- *Deco while the client has one
  mapped: boolean,
  sized: boolean,            -- asked for the default size once already
  pixels: vector(uint8),     -- BGRA top-down, w*4 a row
  w: integer, h: integer,
  serial: uint64,
  popups: vector(*Popup),
  launch: string,            -- the launch id when a launch of ours opened it
  ox: integer, oy: integer,  -- the picture's corner relative to the window's (logical; <= 0)
  lay: vector(CaptureBox),   -- the window and its shown popups, logical, window-relative
  boxes: vector(CaptureBox), -- the same in the latest picture's pixels (CaptureFrame.boxes)
  on_commit: Hook, on_map: Hook, on_unmap: Hook, on_destroy: Hook,
  on_maximize: Hook, on_fullscreen: Hook,
}

-- One Xwayland surface, from creation to destruction. While its wl_surface
-- is mapped it is a window (`top`) or, override-redirect, a popup (`pop`).
XSurf = @record{
  xs: *wlr_xwayland_surface,
  top: *Top,
  pop: *Popup,
  on_destroy: Hook, on_associate: Hook, on_dissociate: Hook,
  on_configure: Hook, on_activate: Hook,
  on_map: Hook, on_unmap: Hook,
}

-- A client's text input (text-input-v3).
local TI = @record{
  ti: *wlr_text_input_v3,
  on_destroy: Hook,
}

local Deco = @record{
  d: *wlr_xdg_toplevel_decoration_v1,
  top: *Top,
  on_destroy: Hook, on_mode: Hook,
}

-- A capture handle: one WOPEN.
local Cap = @record{
  top: *Top,               -- nilptr while pending and after the window went
  state: integer,
  why: string,             -- owned
  title: string,           -- owned, refreshed by title()
  match: string,           -- owned, lower case: wid 0 + text
  pid: cint,               -- the app launched for this open, 0 for none
  deadline: float64,       -- os.now() by which a pending open must settle
  first_new: uint32,       -- run: windows with this id or later appeared after the launch
  name: string,            -- owned, lower case: the launched program's base name
  handed_off: boolean,     -- the launched process exited 0 without a window of its own
  flatpak: string,         -- owned: the Flatpak app id a `flatpak run` launch starts, else ''
  launch: string,          -- owned: the launch id of the app started for this open
  key: string,             -- owned: "key:..." match text, re-attaching a saved window
}

local Child = @record{ pid: cint, done: boolean, status: cint }

-- The virtual keyboard sits outside `wc`: Nelua only knows the fields
-- declared above, not the C size, so it cannot be a record member.
local keyboard: wlr_keyboard
local kb_impl: wlr_keyboard_impl

local wc: record{
  started: boolean,
  display: *wl_display,
  loop: *wl_event_loop,
  backend: *wlr_backend,
  renderer: *wlr_renderer,
  allocator: *wlr_allocator,
  seat: *wlr_seat,
  compositor: *wlr_compositor,
  xdg_shell: *wlr_xdg_shell,
  xwayland: *wlr_xwayland,    -- nilptr: no X11 apps (no Xwayland binary, or GHOSTTY_XWAYLAND=off)
  x_display: string,          -- ":N" once Xwayland listens
  x_link: string,             -- $XDG_RUNTIME_DIR/<socket>-x11 -> /tmp/.X11-unix/XN
  x_started: float64,         -- os.now() when the first X11 client made Xwayland start (0: not yet)
  deco_mgr: *wlr_xdg_decoration_manager_v1,
  instance: string,           -- this agent run, in launch ids (hex of start time and pid)
  launches: integer,          -- launches so far
  icon_pids: vector(cint),    -- icon cache jobs still running (WLIST "apps")
  icon_queued: vector(string), -- the icons they make
  xkb_ctx: *xkb_context,
  keymap: *xkb_keymap,
  socket: string,
  runtime_dir: string,
  tops: vector(*Top),
  caps: vector(*Cap),
  children: vector(Child),
  focused: *Top,             -- keyboard focus
  held_mods: uint8,          -- WIN_MOD_* pressed by us
  next_id: uint32,
  list_serial: uint64,     -- moves when a window maps or unmaps (WLIST "watch")
  scale: integer,          -- output scale apps render at (GHOSTTY_WAYLAND_SCALE, default 2)
  on_new_toplevel: Hook, on_new_popup: Hook, on_new_deco: Hook,
  on_x_surface: Hook, on_x_ready: Hook, on_x_start: Hook,
  on_new_ti: Hook, on_req_sel: Hook, on_req_psel: Hook, on_set_sel: Hook,
  tis: vector(*TI),          -- text inputs (text-input-v3) of the clients
  kb_surface: *wlr_surface,   -- the surface with the keyboard focus
  warned_format: boolean,
  gpu: string,                -- the render node rendering, empty for pixman
  drm_fd: cint,
  stat_frames: integer,       -- frames rendered, and the time it took (s): compose, read back
  stat_render: float64,
  stat_grab: float64,
  warned_text: boolean,
  -- links (WOPEN "url:", docs/REMOTE_WINDOWS.md "Opening URLs")
  browser_launch: string,     -- the launch id of the browser the last url: started
  open_url_cmd: string,       -- $BROWSER for apps in the compositor: `ghostty-agent --open-url`
  path_env: string,           -- $PATH for them: the xdg-open shim's directory first
}

-- Options the agent may set before capture_wayland_backend (flags
-- --wayland-socket NAME and --xkb-layout LAYOUT); the environment variables
-- GHOSTTY_WAYLAND_SOCKET and GHOSTTY_XKB_LAYOUT are the fallback.
local opt_socket: string
local opt_layout: string
local opt_render_node: string
local opt_browser: string          -- --wayland-browser CMD (GHOSTTY_WAYLAND_BROWSER)
local opt_browser_profile: string  -- --wayland-browser-profile NAME (GHOSTTY_WAYLAND_BROWSER_PROFILE)
local opt_listen: string           -- the agent's --listen and token file, for `--open-url` in its apps
local opt_token_file: string

-- The browser links open in (--wayland-browser CMD, --wayland-browser-profile NAME).
global function capture_wayland_set_browser(cmd: string, profile: string): void
  opt_browser = cmd
  opt_browser_profile = profile
end

-- Where apps in the compositor reach this agent (`ghostty-agent --open-url`).
global function capture_wayland_set_agent(listen: string, token_file: string): void
  opt_listen = listen
  opt_token_file = token_file
end

-- --wayland-render-node PATH|auto|none (default auto; GHOSTTY_WAYLAND_RENDER_NODE).
global function capture_wayland_set_render_node(opt: string): void
  opt_render_node = opt
end

-- Frames rendered so far, the average milliseconds a frame spent composing
-- and reading back, and the render node (empty: pixman).
global function capture_wayland_stats(): (integer, float64, float64, string)
  if wc.stat_frames == 0 then return 0, 0, 0, wc.gpu end
  return wc.stat_frames, wc.stat_render * 1000.0 / wc.stat_frames, wc.stat_grab * 1000.0 / wc.stat_frames, wc.gpu
end

global function capture_wayland_configure(socket: string, layout: string): void
  opt_socket = socket
  opt_layout = layout
end

local function log(msg: string): void
  io.stderr:write('[ghostty-agent] wayland: ', msg, '\n')
end

local function now_ms(): uint32
  local ts: timespec
  clock_gettime(CLOCK_MONOTONIC, &ts)
  return (@uint32)(((@int64)(ts.tv_sec) * 1000 + ts.tv_nsec // 1000000) & 0xffffffff)
end

local function set_why(c: *Cap, state: integer, why: string): void
  c.state = state
  c.why:destroy()
  c.why = string.copy(why)
end

--------------------------------------------------------------------------------
-- Pure helpers (tests/test_capture_wayland.nelua)

-- "run:CMD ARGS" -> true and "CMD ARGS" (trimmed); false for anything else
-- or an empty command. The command runs through `sh -c`.
global function wayland_parse_run(match: string): (boolean, string)
  if #match < 4 or match:byte(1) ~= 0x72 or match:byte(2) ~= 0x75 or match:byte(3) ~= 0x6E or match:byte(4) ~= 0x3A then -- 'run:'
    return false, (@string){}
  end
  local i, j = 5, #match
  while i <= j and (match:byte(i) == 32 or match:byte(i) == 9) do i = i + 1 end
  while j >= i and (match:byte(j) == 32 or match:byte(j) == 9 or match:byte(j) == 10 or match:byte(j) == 13) do j = j - 1 end
  if j < i then return false, (@string){} end
  return true, match:sub(i, j)
end

-- "PREFIX:REST" -> true and REST without surrounding blanks; false when the
-- text does not start with the prefix or nothing follows it ("app:",
-- "desktop:" match forms of WOPEN).
global function wayland_match_form(match: string, prefix: string): (boolean, string)
  if #match < #prefix or match:subview(1, #prefix) ~= prefix then return false, (@string){} end
  local i, j = #prefix + 1, #match
  while i <= j and (match:byte(i) == 32 or match:byte(i) == 9) do i = i + 1 end
  while j >= i and (match:byte(j) == 32 or match:byte(j) == 9 or match:byte(j) == 10 or match:byte(j) == 13) do j = j - 1 end
  if j < i then return false, (@string){} end
  return true, match:sub(i, j)
end

-- The renderer (--wayland-render-node / GHOSTTY_WAYLAND_RENDER_NODE).
-- A DRM render node, the GPU behind it and what is known about it.
global RenderNode = @record{
  path: string,        -- /dev/dri/renderD128
  pci: string,         -- 0000:03:00.0
  driver: string,      -- nvidia, amdgpu, i915, ...
  display: boolean,    -- one of its card's connectors is connected
  free_mb: integer,    -- free VRAM in MiB, -1 unknown
  total_mb: integer,
}

-- Auto takes a GPU only with this much VRAM free (MiB): the renderer's
-- buffers are small, but a GPU that is nearly full (a local LLM) must not
-- be pushed over.
global WAYLAND_GPU_MIN_FREE_MB: integer <comptime> = 1024

-- The render node for option `opt` ('' for the software pixman renderer) and
-- why, in a few words for the log:
--   'none', 'pixman', 'off'  software rendering
--   '/dev/dri/...'           that node, as given
--   'auto' (or '')           the GPU with the most free VRAM among those
--                            driving no display and with at least
--                            WAYLAND_GPU_MIN_FREE_MB free; pixman when there
--                            is none, or when VRAM cannot be read
global function wayland_pick_render_node(opt: string, nodes: *vector(RenderNode)): (string, string)
  if opt == 'none' or opt == 'pixman' or opt == 'off' then return (@string){}, string.copy('software rendering asked for') end
  if #opt > 0 and opt:byte(1) == 47 then return string.copy(opt), string.copy('as configured') end
  if #opt > 0 and opt ~= 'auto' then return (@string){}, string.format('unknown render node "%s": software rendering', opt) end
  local best = -1
  local why: stringbuilder
  for i = 0, < #nodes do
    local n = &nodes[i]
    if n.display then
      why:writef('%s (%s) drives a display; ', n.pci, n.driver)
    elseif n.free_mb < 0 then
      why:writef('%s (%s): free VRAM unknown; ', n.pci, n.driver)
    elseif n.free_mb < WAYLAND_GPU_MIN_FREE_MB then
      why:writef('%s (%s) has %d MiB free (needs %d); ', n.pci, n.driver, n.free_mb, WAYLAND_GPU_MIN_FREE_MB)
    elseif best < 0 or n.free_mb > nodes[best].free_mb then
      best = i
    end
  end
  if best >= 0 then
    why:destroy()
    local n = &nodes[best]
    return string.copy(n.path), string.format('%s (%s), no display, %d of %d MiB free', n.pci, n.driver, n.free_mb, n.total_mb)
  end
  if #nodes == 0 then why:write('no render node; ') end
  why:write('software rendering')
  return (@string){}, why:promote()
end

-- The number in `s`, blanks around it ignored; -1 for none.
local function digits_of(s: string): integer
  local v, any = 0, false
  for i = 1, #s do
    local c = s:byte(i)
    if c >= 48 and c <= 57 then v = v * 10 + (c - 48) any = true
    elseif any then break end
  end
  return any and v or -1
end

-- nvidia-smi's "00000000:03:00.0, 953, 8188" lines -> free and total MiB
-- for sysfs address `pci` ("0000:03:00.0"), -1 when not there.
global function wayland_nvidia_vram(csv: string, pci: string): (integer, integer)
  local want = pci:lower()
  local pos = 1
  while pos <= #csv do
    local nl = csv:find('\n', pos, true)
    local stop = nl > 0 and nl - 1 or #csv
    local line = csv:subview(pos, stop)
    pos = stop + 2
    local c1 = line:find(',', 1, true)
    if c1 > 0 then
      local bus = line:subview(1, c1 - 1):lower() -- 8 hex digits of domain
      local short = #bus > 4 and bus:subview(5) or bus
      if short == want or bus == want then
        local c2 = line:find(',', c1 + 1, true)
        if c2 > 0 then
          return digits_of(line:subview(c1 + 1, c2 - 1)), digits_of(line:subview(c2 + 1))
        end
      end
    end
  end
  return -1, -1
end

-- Nested desktops ("desktop:NAME [ARGS]"): a whole Wayland compositor as
-- one client of ours, its output one window. Tried in this order when no
-- name is given; cage runs one app and needs to be told which.
global WAYLAND_DESKTOPS: [6]string = { 'labwc', 'sway', 'wayfire', 'river', 'weston', 'Hyprland' }

-- The command for "desktop:SPEC" (SPEC is NAME ARGS or empty), given which
-- programs are installed. False and why when none fits.
global function wayland_desktop_command(spec: string, installed: function(string): boolean): (boolean, string, string)
  if #spec == 0 then
    for i = 0, < #WAYLAND_DESKTOPS do
      if installed(WAYLAND_DESKTOPS[i]) then return true, string.copy(WAYLAND_DESKTOPS[i]), (@string){} end
    end
    return false, (@string){}, string.copy('no nested desktop is installed (labwc, sway, wayfire, river, weston, Hyprland)')
  end
  local sp = spec:find(' ', 1, true)
  local name = sp > 0 and spec:subview(1, sp - 1) or spec
  local args = sp > 0 and spec:subview(sp + 1) or (@string){}
  if not installed(name) then return false, (@string){}, name .. ' is not installed on the agent\'s machine' end
  local sb: stringbuilder
  if name == 'cage' then
    -- cage runs exactly one app, after `--`
    while #args > 0 and args:byte(1) == 32 do args = args:subview(2) end
    if #args == 0 then return false, (@string){}, string.copy('cage runs one app: desktop:cage APP') end
    sb:write('cage')
    if #args < 2 or args:subview(1, 2) ~= '--' then sb:write(' --') end
    sb:write(' ', args)
  else
    sb:write(spec)
  end
  return true, sb:promote(), (@string){}
end

-- The launched program's base name, lower case, for finding its window when
-- the process hands off to another one ("gnome-disks" from
-- "env FOO=1 /usr/bin/gnome-disks --x"). Empty when there is none.
global function wayland_launch_name(cmd: string): string
  local i, n = 1, #cmd
  while i <= n do
    while i <= n and (cmd:byte(i) == 32 or cmd:byte(i) == 9) do i = i + 1 end
    local j = i
    while j <= n and cmd:byte(j) ~= 32 and cmd:byte(j) ~= 9 do j = j + 1 end
    if j > i then
      local word = cmd:sub(i, j - 1)
      if word ~= 'env' and word:find('=', 1, true) == 0 then -- find gives 0, not nil, when absent
        local slash = 0
        for k = 1, #word do if word:byte(k) == 47 then slash = k end end
        local base = word:sub(slash + 1)
        word:destroy()
        local lower = base:lower()
        base:destroy()
        return lower
      end
      word:destroy()
    end
    i = j
  end
  return (@string){}
end

-- The app id of a `flatpak run [options] APP.ID [args]` command line, else
-- '' (for telling "already running on the desktop" apart).
global function wayland_flatpak_id(cmd: string): string
  local at = cmd:find('flatpak run ', 1, true)
  if at == 0 then return (@string){} end
  local i, n = at + 12, #cmd
  while i <= n do
    while i <= n and cmd:byte(i) == 32 do i = i + 1 end
    local j = i
    while j <= n and cmd:byte(j) ~= 32 do j = j + 1 end
    if j > i and cmd:byte(i) ~= 45 then -- the first word that is not an --option
      local word = cmd:sub(i, j - 1)
      local dots = 0
      for k = 1, #word do if word:byte(k) == 46 then dots = dots + 1 end end
      if dots >= 2 then return word end
      word:destroy()
      return (@string){}
    end
    i = j
  end
  return (@string){}
end

-- A Flatpak app with an instance running outside this compositor, from
-- `flatpak ps` (its single-instance copy on the desktop took the launch).
local function flatpak_running(id: string): boolean
  if #id == 0 then return false end
  local f = io.popen('flatpak ps --columns=application 2>/dev/null', 'r')
  if not f:isopen() then return false end
  local out = f:read('a')
  f:close()
  local found = false
  local start = 1
  for pos = 1, #out + 1 do
    if pos > #out or out:byte(pos) == 10 then
      if pos - start == #id and out:subview(start, pos - 1) == id then found = true end
      start = pos + 1
    end
  end
  out:destroy()
  return found
end

-- A WLIST field: tabs and newlines would break the line format.
local function write_field(sb: *stringbuilder, s: string): void
  for i = 1, #s do
    local b = s:byte(i)
    if b == 9 or b == 10 or b == 13 then b = 32 end
    sb:writebyte(b)
  end
end

-- One WLISTR line: "wid\tw\th\tapp\ttitle\tlaunch\n"; `launch` is the
-- window's launch id (empty when the agent did not start it).
global function wayland_list_line(sb: *stringbuilder, wid: uint32, w: integer, h: integer, app: string, title: string, launch: string): void
  sb:writef('%d\t%d\t%d\t', wid, w, h)
  write_field(sb, app)
  sb:writebyte(9)
  write_field(sb, title)
  sb:writebyte(9)
  write_field(sb, launch)
  sb:writebyte(10)
end

-- A window's key, as a plugin saves it with its panel: the launch id (empty
-- when unknown), the app and the title. WOPEN "key:LAUNCH\tAPP\tTITLE".
global WindowKey = @record{ launch: string, app: string, title: string }

-- "key:LAUNCH\tAPP\tTITLE" -> true and the key (views into `match`).
-- "key:LAUNCH" alone (the WLISTR column as is) is a key of the launch id
-- only; "key:LAUNCH\tAPP" has no title. An empty key is not one.
global function wayland_parse_key(match: string): (boolean, WindowKey)
  local k: WindowKey
  if #match < 4 or match:subview(1, 4) ~= 'key:' then return false, k end
  local rest = match:subview(5)
  while #rest > 0 and (rest:byte(#rest) == 10 or rest:byte(#rest) == 13 or rest:byte(#rest) == 32) do rest = rest:subview(1, #rest - 1) end
  local t1 = rest:find('\t', 1, true)
  if t1 == 0 then
    k.launch = rest
    return #rest > 0, k
  end
  local t2 = rest:find('\t', t1 + 1, true)
  k.launch = rest:subview(1, t1 - 1)
  if t2 == 0 then
    k.app = rest:subview(t1 + 1)
    return true, k
  end
  k.app = rest:subview(t1 + 1, t2 - 1)
  k.title = rest:subview(t2 + 1)
  while #k.title > 0 and (k.title:byte(#k.title) == 10 or k.title:byte(#k.title) == 13) do k.title = k.title:subview(1, #k.title - 1) end
  return true, k
end

-- How well window `c` fits saved key `k`, 0 for not at all. A window already
-- streamed never fits (two panels would fight over it). The same launch id
-- fits whatever the title became; otherwise the app must be equal when the
-- key has one (a key without one needs the title), and the same title
-- weighs more than one that contains the other.
global function wayland_key_score(k: WindowKey, c: WindowKey, streamed: boolean): integer
  if streamed then return 0 end
  if #k.launch > 0 and c.launch == k.launch then return 100 end
  local title_eq = #k.title > 0 and c.title == k.title
  local title_near = #k.title > 0 and #c.title > 0 and (c.title:find(k.title, 1, true) > 0 or k.title:find(c.title, 1, true) > 0)
  local score = 0
  if #k.app > 0 then
    if c.app ~= k.app then return 0 end
    score = 10
  elseif title_eq or title_near then
    score = 5
  else
    return 0
  end
  if title_eq then score = score + 20 elseif title_near then score = score + 5 end
  return score
end

global WAYLAND_LAUNCH_LINE: string <comptime> = '0\t0\t0\tlaunch\trun:COMMAND or app:NAME to start an app in the game\n'

-- Case-insensitive (ASCII) "haystack contains needle"; an empty needle matches.
global function wayland_contains(hay: string, needle_lower: string): boolean
  if #needle_lower == 0 then return true end
  local low = hay:lower()
  local found = low:find(needle_lower, 1, true) > 0
  low:destroy()
  return found
end

--------------------------------------------------------------------------------
-- Processes

-- `pid` or one of its ancestors (a few levels up, through /proc) is `root`:
-- the app may be a child of the `sh -c` it was started with.
local function descends_from(pid: cint, root: cint): boolean
  local p = pid
  for _ = 1, 8 do
    if p == root then return true end
    if p <= 1 then return false end
    local path: stringbuilder
    path:writef('/proc/%d/stat', p)
    local ps = path:promote()
    local f = io.open(ps, 'r')
    ps:destroy()
    if not f:isopen() then return false end
    local line = f:read('l')
    f:close()
    -- "pid (comm) state ppid ...": comm may hold spaces, so start after the last ')'
    local close_at = 0
    for i = #line, 1, -1 do if line:byte(i) == 41 then close_at = i break end end
    if close_at == 0 then line:destroy() return false end
    local rest = line:sub(close_at + 2)
    local sp1 = rest:find(' ', 1, true)
    if sp1 == 0 then rest:destroy() line:destroy() return false end
    local sp2 = rest:find(' ', sp1 + 1, true)
    if sp2 == 0 then sp2 = #rest + 1 end
    local ppid_s = rest:sub(sp1 + 1, sp2 - 1)
    p = (@cint)(tointeger(ppid_s))
    ppid_s:destroy() rest:destroy() line:destroy()
  end
  return false
end

-- Start `cmd` through `sh -c` as a client of our display only: its own
-- session (so shutdown can end the whole group), no DISPLAY, toolkits told
-- to use Wayland. Returns the pid, or -1.
local function spawn(cmd: string): cint
  local pid = fork()
  if pid ~= 0 then return pid end
  -- child: only async-signal-safe-ish work from here to exec
  setsid()
  local null = open('/dev/null', O_RDWR)
  if null >= 0 then dup2(null, 0) end
  for fd = 3, 1023 do close(fd) end
  unsetenv('WAYLAND_SOCKET')
  -- X11 apps reach our Xwayland; nothing reaches the host's X server
  if #wc.x_display > 0 then setenv('DISPLAY', (@cstring)(wc.x_display.data), 1) else unsetenv('DISPLAY') end
  setenv('WAYLAND_DISPLAY', (@cstring)(wc.socket.data), 1)
  if #wc.runtime_dir > 0 then setenv('XDG_RUNTIME_DIR', (@cstring)(wc.runtime_dir.data), 1) end
  setenv('XDG_SESSION_TYPE', 'wayland', 1)
  setenv('GDK_BACKEND', 'wayland', 1)
  setenv('QT_QPA_PLATFORM', 'wayland', 1)
  setenv('SDL_VIDEODRIVER', 'wayland', 1)
  setenv('MOZ_ENABLE_WAYLAND', '1', 1)
  setenv('ELECTRON_OZONE_PLATFORM_HINT', 'wayland', 1)
  -- links they open come back to this agent (docs/REMOTE_WINDOWS.md "Opening URLs")
  if #wc.open_url_cmd > 0 then setenv('BROWSER', (@cstring)(wc.open_url_cmd.data), 1) end
  if #wc.path_env > 0 then setenv('PATH', (@cstring)(wc.path_env.data), 1) end
  if #opt_listen > 0 then setenv('GHOSTTY_AGENT_LISTEN', (@cstring)(opt_listen.data), 1) end
  if #opt_token_file > 0 then setenv('GHOSTTY_AGENT_TOKEN_FILE', (@cstring)(opt_token_file.data), 1) end
  execl('/bin/sh', 'sh', '-c', (@cstring)(cmd.data), (@cstring)(nilptr))
  _exit(127)
  return -1
end

-- Collect our own children (never the agent's PTY shells: by pid only).
local function reap_children(): void
  for i = 0, < #wc.children do
    local ch = &wc.children[i]
    if not ch.done then
      local st: cint = 0
      if waitpid(ch.pid, &st, WNOHANG) == ch.pid then
        ch.done = true
        ch.status = WIFEXITED(st) and WEXITSTATUS(st) or 128 + WTERMSIG(st)
      end
    end
  end
end

local function child_of(pid: cint): *Child
  for i = 0, < #wc.children do
    if wc.children[i].pid == pid then return &wc.children[i] end
  end
  return nilptr
end

--------------------------------------------------------------------------------
-- Text input (text-input-v3): TEXT as committed strings to a client that
-- takes them, so any character arrives, not only what the keymap can type

local function same_client(a: *wl_resource, b: *wl_resource): boolean
  return a ~= nilptr and b ~= nilptr and wl_resource_get_client(a) == wl_resource_get_client(b)
end

-- Keyboard focus moved to `surf` (nilptr: nowhere): text inputs follow it,
-- entering the surface for its own client's and leaving the others'.
local function ti_focus(surf: *wlr_surface): void
  for i = 0, < #wc.tis do
    local ti = wc.tis[i].ti
    if ti.focused_surface ~= surf then
      if ti.focused_surface ~= nilptr then wlr_text_input_v3_send_leave(ti) end
      if surf ~= nilptr and same_client(ti.resource, surf.resource) then wlr_text_input_v3_send_enter(ti, surf) end
    end
  end
end

-- The enabled text input on the focused surface, or nilptr.
local function ti_active(surf: *wlr_surface): *wlr_text_input_v3
  if surf == nilptr then return nilptr end
  for i = 0, < #wc.tis do
    local ti = wc.tis[i].ti
    if ti.focused_surface == surf and ti.current_enabled then return ti end
  end
  return nilptr
end

local function on_ti_destroy(l: *wl_listener, data: pointer): void
  local x = (@*TI)(owner_of(l))
  unhook(&x.on_destroy)
  for i = 0, < #wc.tis do
    if wc.tis[i] == x then wc.tis:remove(i) break end
  end
  delete(x)
end

local function on_new_ti(l: *wl_listener, data: pointer): void
  local x = new(@TI)
  x.ti = (@*wlr_text_input_v3)(data)
  hook(&x.on_destroy, &x.ti.events.destroy, on_ti_destroy, x)
  wc.tis:push(x)
  local surf = wc.kb_surface
  if surf ~= nilptr and same_client(x.ti.resource, surf.resource) then wlr_text_input_v3_send_enter(x.ti, surf) end
end

--------------------------------------------------------------------------------
-- Clipboard. Apps set and read the seat's selection as on any desktop
-- (request_set_selection granted). Bridged to the host clipboard (which the
-- game's copies and pastes already go through, CLIP_SET/CLIP_GET) with
-- functions the agent hands in (capture_wayland_set_clipboard):
--   * When nothing else owns it, the selection is our "host" source, which
--     reads the host clipboard when an app pastes: pastes get whatever was
--     copied last in the game, on the desktop or in another app.
--   * When an app copies text, it is read from the app, put on the host
--     clipboard, and our host source takes the selection back (it serves
--     the same text from then on).
-- X11 apps take part through Xwayland's selection bridge. The primary
-- selection (middle click) works between apps but is not bridged.

local ClipGet = @function(): (boolean, string)
local ClipSet = @function(*[0]uint8, usize): boolean
local clip_get_fn: ClipGet
local clip_set_fn: ClipSet

local CLIP_MIMES: [5]string = { 'text/plain;charset=utf-8', 'text/plain', 'UTF8_STRING', 'TEXT', 'STRING' }
local CLIP_READ_MAX: usize <comptime> = 1024 * 1024

-- One transfer between a pipe and a buffer: writing our text to an app that
-- pastes, or reading an app's copied text.
local Xfer = @record{
  fd: cint,
  src: *wl_event_source,
  buf: vector(uint8),
  off: usize,
}

local proxy_src: wlr_data_source
local proxy_impl: wlr_data_source_impl
local proxy_live = false

local function xfer_end(x: *Xfer): void
  if x.src ~= nilptr then wl_event_source_remove(x.src) end
  close(x.fd)
  x.buf:destroy()
  delete(x)
end

local function on_xfer_write(fd: cint, mask: uint32, data: pointer): cint
  local x = (@*Xfer)(data)
  while x.off < #x.buf do
    local n = write(fd, &x.buf[x.off], #x.buf - x.off)
    if n < 0 then
      if errno == EAGAIN then return 0 end
      if errno ~= EINTR then break end
    else
      x.off = x.off + (@usize)(n)
    end
  end
  xfer_end(x)
  return 0
end

-- An app pastes from our host source: the host clipboard, now.
local function proxy_send(src: *wlr_data_source, mime: cstring, fd: int32): void
  local ok, text: string = false, (@string){}
  if clip_get_fn ~= nilptr then ok, text = clip_get_fn() end
  local x = new(@Xfer)
  x.fd = fd
  if ok and #text > 0 then
    x.buf:resize((@usize)(#text))
    memory.copy(&x.buf[0], text.data, (@usize)(#text))
  end
  text:destroy()
  fcntl(fd, F_SETFL, O_NONBLOCK)
  x.src = wl_event_loop_add_fd(wc.loop, fd, WL_EVENT_WRITABLE, on_xfer_write, x)
  if x.src == nilptr then xfer_end(x) end
end

local function proxy_destroy(src: *wlr_data_source): void
  proxy_live = false -- replaced; wlroots freed its mime types, the struct is ours
end

-- Our host source takes the selection (nothing else owns it, or an app's
-- text has gone to the host).
local function proxy_install(): void
  if proxy_live or clip_get_fn == nilptr then return end
  proxy_impl.send = proxy_send
  proxy_impl.destroy = proxy_destroy
  wlr_data_source_init(&proxy_src, &proxy_impl)
  for i = 0, < #CLIP_MIMES do
    local slot = (@*cstring)(wl_array_add(&proxy_src.mime_types, #@cstring))
    if slot ~= nilptr then $slot = strdup((@cstring)(CLIP_MIMES[i].data)) end
  end
  proxy_live = true
  wlr_seat_set_selection(wc.seat, &proxy_src, wl_display_next_serial(wc.display))
end

-- The agent's host clipboard (agent.nelua: wl-copy/wl-paste, or the
-- --clipboard-file). Without it the selection stays among the apps.
global function capture_wayland_set_clipboard(get: ClipGet, set: ClipSet): void
  clip_get_fn, clip_set_fn = get, set
  if wc.started and wc.seat.selection_source == nilptr then proxy_install() end
end

local function on_xfer_read(fd: cint, mask: uint32, data: pointer): cint
  local x = (@*Xfer)(data)
  local done = false
  local chunk: [16384]uint8
  while true do
    local n = read(fd, &chunk, 16384)
    if n > 0 then
      if #x.buf + (@usize)(n) <= CLIP_READ_MAX then
        local at = #x.buf
        x.buf:resize(at + (@usize)(n))
        memory.copy(&x.buf[at], &chunk, (@usize)(n))
      else
        x.off = 1 -- too big to bridge
      end
    elseif n == 0 then
      done = true
      break
    elseif errno ~= EINTR then
      if errno ~= EAGAIN then done = true end
      break
    end
  end
  if done then
    if x.off == 0 and #x.buf > 0 and clip_set_fn ~= nilptr then
      clip_set_fn(&x.buf[0], #x.buf)
      log('clipboard: ' .. tostring(#x.buf) .. ' bytes copied in an app went to the host clipboard')
    end
    xfer_end(x)
    proxy_install()
  end
  return 0
end

-- An app set the selection: read its text (the best text type it offers).
-- Not text (an image, files): it stays the app's, among the apps.
local function clip_read_app(src: *wlr_data_source): void
  local mime: cstring = nilptr
  local n = src.mime_types.size // #@cstring
  local arr = (@*[0]cstring)(src.mime_types.data)
  for k = 0, < #CLIP_MIMES do
    for i = 0, < (@integer)(n) do
      if (@string)(arr[i]) == CLIP_MIMES[k] then mime = arr[i] break end
    end
    if mime ~= nilptr then break end
  end
  if mime == nilptr then return end
  local fds: [2]cint
  if pipe2(&fds, O_CLOEXEC | O_NONBLOCK) ~= 0 then return end
  wlr_data_source_send(src, mime, fds[1]) -- the source owns (and closes) the write end
  local x = new(@Xfer)
  x.fd = fds[0]
  x.src = wl_event_loop_add_fd(wc.loop, fds[0], WL_EVENT_READABLE, on_xfer_read, x)
  if x.src == nilptr then xfer_end(x) end
  wl_display_flush_clients(wc.display)
end

local function on_set_selection(l: *wl_listener, data: pointer): void
  if clip_get_fn == nilptr then return end
  local src = wc.seat.selection_source
  if src == &proxy_src then return end
  if src == nilptr then proxy_install() return end -- its app went: back to the host's
  clip_read_app(src)
end

-- Apps copy as on any desktop: granted.
local function on_request_selection(l: *wl_listener, data: pointer): void
  local ev = (@*wlr_seat_request_set_selection_event)(data)
  wlr_seat_set_selection(wc.seat, ev.source, ev.serial)
end

local function on_request_primary(l: *wl_listener, data: pointer): void
  local ev = (@*wlr_seat_request_set_primary_selection_event)(data)
  wlr_seat_set_primary_selection(wc.seat, ev.source, ev.serial)
end

-- The game copied (CLIP_SET, already on the host clipboard): an app's own
-- selection gives way to our host source, so pastes here get the new text.
global function capture_wayland_clipboard_changed(): void
  if wc.started and wc.seat.selection_source ~= &proxy_src then proxy_install() end
end

--------------------------------------------------------------------------------
-- Toplevels (xdg and X11)

local function top_title(t: *Top): string
  local s: cstring = nilptr
  if t.x11 ~= nilptr then s = t.x11.xs.title else s = t.xdg.title end
  if s ~= nilptr then return (@string)(s) end
  return ''
end

-- The app: the xdg app id, or the X11 WM_CLASS class (else its instance).
local function top_app(t: *Top): string
  local s: cstring = nilptr
  if t.x11 ~= nilptr then
    s = t.x11.xs.class
    if s == nilptr then s = t.x11.xs.instance end
  else
    s = t.xdg.app_id
  end
  if s ~= nilptr then return (@string)(s) end
  return ''
end

local function top_surface(t: *Top): *wlr_surface
  if t.x11 ~= nilptr then return t.x11.xs.surface end
  return t.xdg.base.surface
end

-- Ask the app to close the window (xdg close, X11 WM_DELETE_WINDOW).
local function top_close(t: *Top): void
  if t.x11 ~= nilptr then wlr_xwayland_surface_close(t.x11.xs)
  else wlr_xdg_toplevel_send_close(t.xdg) end
end

-- Give `t` the keyboard (and xdg "activated", X11 focus and top of the
-- stack). One toplevel has it at a time.
local function focus(t: *Top): void
  if wc.focused == t or not t.mapped then return end
  local prev = wc.focused
  if prev ~= nilptr and prev.x11 ~= nilptr then wlr_xwayland_surface_activate(prev.x11.xs, false) end
  wc.focused = t
  if t.x11 ~= nilptr then
    wlr_xwayland_surface_activate(t.x11.xs, true)
    wlr_xwayland_surface_restack(t.x11.xs, nilptr, XCB_STACK_MODE_ABOVE)
  end
  wlr_seat_keyboard_notify_enter(wc.seat, top_surface(t), (@*[0]uint32)(&keyboard.keycodes), keyboard.num_keycodes, &keyboard.modifiers)
  wc.kb_surface = top_surface(t)
  ti_focus(wc.kb_surface)
end

-- The window's size: its xdg geometry (the surface's extent when unset), or
-- the X11 window's size.
local function top_size(t: *Top): (integer, integer)
  if t.x11 ~= nilptr then
    return math.max(1, (@integer)(t.x11.xs.width)), math.max(1, (@integer)(t.x11.xs.height))
  end
  local g = t.xdg.base.geometry
  return math.max(1, (@integer)(g.width)), math.max(1, (@integer)(g.height))
end

local function end_caps_of(t: *Top, why: string): void
  for i = 0, < #wc.caps do
    local c = wc.caps[i]
    if c.top == t then
      c.top = nilptr
      set_why(c, CAPTURE_ENDED, why)
    end
  end
end

-- A new window, not mapped yet, with its own scene.
local function top_new(pid: cint): *Top
  local t = new(@Top)
  t.id = wc.next_id
  wc.next_id = wc.next_id + 1
  t.pid = pid
  t.scale = wc.scale
  -- No direct scan-out: with one surface covering the output, the scene would
  -- hand the client's own buffer (shadows and all) to the output instead of
  -- rendering, and that is not the window's pixels. wlroots reads this
  -- variable when the scene is created.
  setenv('WLR_SCENE_DISABLE_DIRECT_SCANOUT', '1', 1)
  t.scene = wlr_scene_create()
  unsetenv('WLR_SCENE_DISABLE_DIRECT_SCANOUT')
  wc.tops:push(t)
  return t
end

-- The window shows: its output, sized to it, on the first map.
local function top_mapped(t: *Top): void
  t.mapped = true
  wc.list_serial = wc.list_serial + 1
  local w, h = top_size(t)
  if t.xdg ~= nilptr and (w <= 1 or h <= 1) and not t.sized then
    -- a client that commits no size of its own gets the default
    t.sized = true
    wlr_xdg_toplevel_set_size(t.xdg, WAYLAND_DEFAULT_W, WAYLAND_DEFAULT_H)
    w, h = WAYLAND_DEFAULT_W, WAYLAND_DEFAULT_H
  end
  if t.output == nilptr then
    t.output = wlr_headless_add_output(wc.backend, (@cuint)(w * t.scale), (@cuint)(h * t.scale))
    if t.output == nilptr then log('cannot add an output for window ' .. tostring(t.id)) return end
    wlr_output_init_render(t.output, wc.allocator, wc.renderer)
    local st: wlr_output_state
    wlr_output_state_init(&st)
    wlr_output_state_set_enabled(&st, true)
    wlr_output_state_set_custom_mode(&st, (@int32)(w * t.scale), (@int32)(h * t.scale), WAYLAND_REFRESH_MHZ)
    -- apps render at this scale: crisp text on a panel seen up close
    wlr_output_state_set_scale(&st, (@float32)(t.scale))
    wlr_output_commit_state(t.output, &st)
    wlr_output_state_finish(&st)
    wlr_output_create_global(t.output, wc.display)
    t.sout = wlr_scene_output_create(t.scene, t.output)
  end
  if wc.focused == nilptr then focus(t) end
  log('window ' .. tostring(t.id) .. (t.x11 ~= nilptr and ' (X11)' or '') .. ' mapped: ' .. top_app(t) .. ' "' .. top_title(t) .. '"')
end

local function top_unmapped(t: *Top): void
  t.mapped = false
  wc.list_serial = wc.list_serial + 1
  end_caps_of(t, 'window closed')
  if wc.focused == t then wc.focused = nilptr end
end

-- Forget `t`: its streams end, its output and scene go. Popups still shown
-- in it lose their place and show nowhere.
local function top_free(t: *Top): void
  end_caps_of(t, 'window closed')
  if wc.focused == t then wc.focused = nilptr end
  for i = 0, < #t.popups do
    local pp = t.popups[i]
    pp.top = nilptr
    pp.tree = nilptr -- goes with the scene below
    if pp.p ~= nilptr then pp.p.base.data = nilptr end
  end
  t.popups:destroy()
  t.lay:destroy() t.boxes:destroy() t.launch:destroy()
  if t.deco ~= nilptr then (@*Deco)(t.deco).top = nilptr end
  if t.output ~= nilptr then wlr_output_destroy(t.output) end -- takes the scene output along
  wlr_scene_node_destroy(&t.scene.tree.node)
  for i = 0, < #wc.tops do
    if wc.tops[i] == t then wc.tops:remove(i) break end
  end
  t.pixels:destroy()
  delete(t)
end

local function on_commit(l: *wl_listener, data: pointer): void
  local t = (@*Top)(owner_of(l))
  local base = t.xdg.base
  if base.initial_commit then
    -- first configure: the client picks its size (0x0), no maximize/minimize
    -- buttons (the game's panel has the chrome), always shown as active
    wlr_xdg_toplevel_set_size(t.xdg, 0, 0)
    wlr_xdg_toplevel_set_activated(t.xdg, true)
    -- tiled on every edge: GTK and Qt then draw no shadow and no rounded
    -- corners, so the picture is the window and nothing around it
    wlr_xdg_toplevel_set_tiled(t.xdg, WLR_EDGE_TOP | WLR_EDGE_BOTTOM | WLR_EDGE_LEFT | WLR_EDGE_RIGHT)
    wlr_xdg_toplevel_set_wm_capabilities(t.xdg, 0)
    if t.deco ~= nilptr then
      wlr_xdg_toplevel_decoration_v1_set_mode((@*Deco)(t.deco).d, WLR_XDG_TOPLEVEL_DECORATION_V1_MODE_SERVER_SIDE)
    end
  end
  -- later commits: wlr_scene_xdg_surface_create's tree already puts the
  -- window geometry's corner at (0,0); CSD shadows fall outside the output
end

local function on_map(l: *wl_listener, data: pointer): void
  top_mapped((@*Top)(owner_of(l)))
end

local function on_unmap(l: *wl_listener, data: pointer): void
  top_unmapped((@*Top)(owner_of(l)))
end

-- A state request must be answered with a configure, even when nothing changes.
local function on_state_request(l: *wl_listener, data: pointer): void
  local t = (@*Top)(owner_of(l))
  if t.xdg.base.initialized then wlr_xdg_surface_schedule_configure(t.xdg.base) end
end

local function on_top_destroy(l: *wl_listener, data: pointer): void
  local t = (@*Top)(owner_of(l))
  unhook(&t.on_commit) unhook(&t.on_map) unhook(&t.on_unmap) unhook(&t.on_destroy)
  unhook(&t.on_maximize) unhook(&t.on_fullscreen)
  t.xdg.base.data = nilptr
  top_free(t)
end

local function on_new_toplevel(l: *wl_listener, data: pointer): void
  local xdg = (@*wlr_xdg_toplevel)(data)
  local pid: cint = 0
  local uid: cuint, gid: cuint = 0, 0
  wl_client_get_credentials(wl_resource_get_client(xdg.resource), &pid, &uid, &gid)
  local t = top_new(pid)
  t.xdg = xdg
  -- popups find their parent's tree through wlr_xdg_surface.data
  xdg.base.data = wlr_scene_xdg_surface_create(&t.scene.tree, xdg.base)
  hook(&t.on_commit, &xdg.base.surface.events.commit, on_commit, t)
  hook(&t.on_map, &xdg.base.surface.events.map, on_map, t)
  hook(&t.on_unmap, &xdg.base.surface.events.unmap, on_unmap, t)
  hook(&t.on_destroy, &xdg.events.destroy, on_top_destroy, t)
  hook(&t.on_maximize, &xdg.events.request_maximize, on_state_request, t)
  hook(&t.on_fullscreen, &xdg.events.request_fullscreen, on_state_request, t)
end

--------------------------------------------------------------------------------
-- Popups: into their window's scene

-- The toplevel a popup chain hangs off, or nilptr.
local function popup_root(p: *wlr_xdg_popup): *wlr_xdg_toplevel
  local parent = p.parent
  for _ = 1, 16 do
    if parent == nilptr then return nilptr end
    local xs = wlr_xdg_surface_try_from_wlr_surface(parent)
    if xs == nilptr then return nilptr end
    if xs.role == WLR_XDG_SURFACE_ROLE_TOPLEVEL then return xs.toplevel end
    if xs.role ~= WLR_XDG_SURFACE_ROLE_POPUP or xs.popup == nilptr then return nilptr end
    parent = xs.popup.parent
  end
  return nilptr
end

local function top_of_xdg(x: *wlr_xdg_toplevel): *Top
  if x == nilptr then return nilptr end
  for i = 0, < #wc.tops do
    if wc.tops[i].xdg == x then return wc.tops[i] end
  end
  return nilptr
end

local function popup_detach(pp: *Popup): void
  if pp.top == nilptr then return end
  for i = 0, < #pp.top.popups do
    if pp.top.popups[i] == pp then pp.top.popups:remove(i) break end
  end
  pp.top = nilptr
end

local function on_popup_commit(l: *wl_listener, data: pointer): void
  local pp = (@*Popup)(owner_of(l))
  if not pp.p.base.initial_commit then return end
  local root = popup_root(pp.p)
  if root ~= nilptr then
    -- the window and a margin around it, in the toplevel surface's
    -- coordinates: menus may reach outside the window (the picture grows)
    local g = root.base.geometry
    local box: wlr_box = { x = g.x - POPUP_MARGIN, y = g.y - POPUP_MARGIN, width = g.width + 2 * POPUP_MARGIN, height = g.height + 2 * POPUP_MARGIN }
    wlr_xdg_popup_unconstrain_from_box(pp.p, &box)
  end
  wlr_xdg_surface_schedule_configure(pp.p.base)
end

local function on_popup_destroy(l: *wl_listener, data: pointer): void
  local pp = (@*Popup)(owner_of(l))
  unhook(&pp.on_commit) unhook(&pp.on_destroy)
  popup_detach(pp)
  delete(pp)
end

local function on_new_popup(l: *wl_listener, data: pointer): void
  local p = (@*wlr_xdg_popup)(data)
  local parent = wlr_xdg_surface_try_from_wlr_surface(p.parent)
  if parent == nilptr or parent.data == nilptr then return end -- e.g. a layer surface: not ours
  p.base.data = wlr_scene_xdg_surface_create((@*wlr_scene_tree)(parent.data), p.base)
  local pp = new(@Popup)
  pp.p = p
  pp.tree = (@*wlr_scene_tree)(p.base.data)
  pp.top = top_of_xdg(popup_root(p))
  if pp.top ~= nilptr then pp.top.popups:push(pp) end
  hook(&pp.on_commit, &p.base.surface.events.commit, on_popup_commit, pp)
  hook(&pp.on_destroy, &p.events.destroy, on_popup_destroy, pp)
end

--------------------------------------------------------------------------------
-- X11 windows through Xwayland: a mapped X11 toplevel is a window like an
-- xdg one (its own scene and output, at scale 1: X11 apps draw at 1x); an
-- override-redirect one (menu, tooltip, drag icon) is drawn into the window
-- it belongs to, at its root position relative to that window's.

-- The window an override-redirect X11 window belongs to: its X11 parent's
-- (transient-for), else the X11 window of its process it lies over, else
-- one of its process, else the focused X11 window.
local function x11_owner(xs: *wlr_xwayland_surface): *Top
  local p = xs.parent
  for _ = 1, 16 do
    if p == nilptr then break end
    local xp = (@*XSurf)(p.data)
    if xp ~= nilptr then
      if xp.top ~= nilptr then return xp.top end
      if xp.pop ~= nilptr and xp.pop.top ~= nilptr then return xp.pop.top end
    end
    p = p.parent
  end
  local px, py = (@integer)(xs.x), (@integer)(xs.y)
  local same_pid: *Top = nilptr
  for i = 0, < #wc.tops do
    local t = wc.tops[i]
    if t.x11 ~= nilptr and t.mapped then
      local o = t.x11.xs
      local ox, oy = (@integer)(o.x), (@integer)(o.y)
      local inside = px >= ox and py >= oy and px < ox + (@integer)(o.width) and py < oy + (@integer)(o.height)
      local mine = xs.pid ~= 0 and xs.pid == o.pid
      if inside and (mine or xs.pid == 0) then return t end
      if mine and same_pid == nilptr then same_pid = t end
    end
  end
  if same_pid ~= nilptr then return same_pid end
  if wc.focused ~= nilptr and wc.focused.x11 ~= nilptr then return wc.focused end
  return nilptr
end

-- An X11 popup's node follows its root position (X11 coordinates are the
-- root window's, one space for all windows).
local function x11_place(pp: *Popup): void
  if pp.x == nilptr or pp.top == nilptr or pp.tree == nilptr or pp.top.x11 == nilptr then return end
  local o = pp.top.x11.xs
  local xs = pp.x.xs
  wlr_scene_node_set_position(&pp.tree.node, (@cint)(xs.x) - (@cint)(o.x), (@cint)(xs.y) - (@cint)(o.y))
end

local function x_unmapped(x: *XSurf): void
  if x.pop ~= nilptr then
    local pp = x.pop
    if pp.tree ~= nilptr then wlr_scene_node_destroy(&pp.tree.node) end
    popup_detach(pp)
    delete(pp)
    x.pop = nilptr
  end
  if x.top ~= nilptr then
    top_free(x.top)
    x.top = nilptr
  end
end

local function on_x_map(l: *wl_listener, data: pointer): void
  local x = (@*XSurf)(owner_of(l))
  local xs = x.xs
  if x.top ~= nilptr or x.pop ~= nilptr then return end
  if xs.override_redirect then
    local t = x11_owner(xs)
    if t == nilptr then return end -- no window to show it in
    local pp = new(@Popup)
    pp.x = x
    pp.top = t
    pp.tree = wlr_scene_subsurface_tree_create(&t.scene.tree, xs.surface)
    t.popups:push(pp)
    x.pop = pp
    x11_place(pp)
    return
  end
  local t = top_new(xs.pid)
  t.x11 = x
  t.scale = 1 -- X11 apps draw at 1x; an output scale would only stretch them
  wlr_scene_subsurface_tree_create(&t.scene.tree, xs.surface)
  x.top = t
  top_mapped(t)
end

local function on_x_unmap(l: *wl_listener, data: pointer): void
  x_unmapped((@*XSurf)(owner_of(l)))
end

local function on_x_associate(l: *wl_listener, data: pointer): void
  local x = (@*XSurf)(owner_of(l))
  hook(&x.on_map, &x.xs.surface.events.map, on_x_map, x)
  hook(&x.on_unmap, &x.xs.surface.events.unmap, on_x_unmap, x)
end

local function on_x_dissociate(l: *wl_listener, data: pointer): void
  local x = (@*XSurf)(owner_of(l))
  x_unmapped(x)
  unhook(&x.on_map) unhook(&x.on_unmap)
end

-- X11 windows place and size themselves: granted as asked.
local function on_x_configure(l: *wl_listener, data: pointer): void
  local ev = (@*wlr_xwayland_surface_configure_event)(data)
  wlr_xwayland_surface_configure(ev.surface, ev.x, ev.y, ev.width, ev.height)
end

local function on_x_activate(l: *wl_listener, data: pointer): void
  local x = (@*XSurf)(owner_of(l))
  if x.top ~= nilptr then focus(x.top) end
end

local function on_x_destroy(l: *wl_listener, data: pointer): void
  local x = (@*XSurf)(owner_of(l))
  x_unmapped(x)
  unhook(&x.on_map) unhook(&x.on_unmap)
  unhook(&x.on_destroy) unhook(&x.on_associate) unhook(&x.on_dissociate)
  unhook(&x.on_configure) unhook(&x.on_activate)
  x.xs.data = nilptr
  delete(x)
end

local function on_x_surface(l: *wl_listener, data: pointer): void
  local xs = (@*wlr_xwayland_surface)(data)
  local x = new(@XSurf)
  x.xs = xs
  xs.data = x
  hook(&x.on_destroy, &xs.events.destroy, on_x_destroy, x)
  hook(&x.on_associate, &xs.events.associate, on_x_associate, x)
  hook(&x.on_dissociate, &xs.events.dissociate, on_x_dissociate, x)
  hook(&x.on_configure, &xs.events.request_configure, on_x_configure, x)
  hook(&x.on_activate, &xs.events.request_activate, on_x_activate, x)
end

-- Xwayland runs from the first X11 client on (lazy) and stops 10 s after the
-- last one leaves; each start is logged with how long it took.
local function on_x_start(l: *wl_listener, data: pointer): void
  wc.x_started = os.now()
end

local function on_x_ready(l: *wl_listener, data: pointer): void
  if wc.x_started > 0 then
    log(string.format('Xwayland ready on DISPLAY=%s after %.0f ms', wc.x_display, (os.now() - wc.x_started) * 1000.0))
  else
    log('Xwayland ready on DISPLAY=' .. wc.x_display)
  end
end

--------------------------------------------------------------------------------
-- Decorations: always server side (that is, none: the game panel has chrome)

local function deco_apply(d: *Deco): void
  if d.d.toplevel ~= nilptr and d.d.toplevel.base.initialized then
    wlr_xdg_toplevel_decoration_v1_set_mode(d.d, WLR_XDG_TOPLEVEL_DECORATION_V1_MODE_SERVER_SIDE)
  end
end

local function on_deco_mode(l: *wl_listener, data: pointer): void
  deco_apply((@*Deco)(owner_of(l)))
end

local function on_deco_destroy(l: *wl_listener, data: pointer): void
  local d = (@*Deco)(owner_of(l))
  unhook(&d.on_destroy) unhook(&d.on_mode)
  if d.top ~= nilptr then d.top.deco = nilptr end
  delete(d)
end

local function on_new_deco(l: *wl_listener, data: pointer): void
  local d = new(@Deco)
  d.d = (@*wlr_xdg_toplevel_decoration_v1)(data)
  for i = 0, < #wc.tops do
    if wc.tops[i].xdg == d.d.toplevel then d.top = wc.tops[i] d.top.deco = d break end
  end
  hook(&d.on_destroy, &d.d.events.destroy, on_deco_destroy, d)
  hook(&d.on_mode, &d.d.events.request_mode, on_deco_mode, d)
  deco_apply(d) -- before the initial commit this waits for on_commit
end

--------------------------------------------------------------------------------
-- Rendering: each mapped window's output, when its scene has damage

-- The rendered buffer, into t.pixels as BGRA top-down.
-- With a GPU renderer the buffer lives in video memory: read it back through
-- a texture (BGRA; RGBA swapped when the driver offers only that).
local function grab_gpu(t: *Top, buf: *wlr_buffer, w: integer, h: integer): void
  local tex = wlr_texture_from_buffer(wc.renderer, buf)
  if tex == nilptr then
    if not wc.warned_format then wc.warned_format = true log('cannot read a GPU frame back (no texture)') end
    return
  end
  local row = (@usize)(w) * 4
  t.pixels:resize(row * (@usize)(h))
  local o: wlr_texture_read_pixels_options = { data = &t.pixels[0], format = DRM_FORMAT_ARGB8888, stride = (@uint32)(row) }
  local ok = wlr_texture_read_pixels(tex, &o)
  local swap = false
  if not ok then
    o.format = DRM_FORMAT_ABGR8888
    ok = wlr_texture_read_pixels(tex, &o)
    swap = ok
  end
  wlr_texture_destroy(tex)
  if not ok then
    if not wc.warned_format then wc.warned_format = true log('cannot read a GPU frame back (read_pixels failed)') end
    return
  end
  if swap then
    for i = 0, < w * h do
      local k = (@usize)(i) * 4
      t.pixels[k], t.pixels[k + 2] = t.pixels[k + 2], t.pixels[k]
    end
  end
  t.w, t.h = w, h
  t.serial = t.serial + 1
end

local function grab(t: *Top, buf: *wlr_buffer, w: integer, h: integer): void
  if #wc.gpu > 0 then grab_gpu(t, buf, w, h) return end
  local data: pointer
  local fmt: uint32 = 0
  local stride: usize = 0
  if not wlr_buffer_begin_data_ptr_access(buf, WLR_BUFFER_DATA_PTR_ACCESS_READ, &data, &fmt, &stride) then return end
  local swap = fmt == DRM_FORMAT_XBGR8888 or fmt == DRM_FORMAT_ABGR8888
  if not swap and fmt ~= DRM_FORMAT_XRGB8888 and fmt ~= DRM_FORMAT_ARGB8888 then
    if not wc.warned_format then wc.warned_format = true log('unexpected output format ' .. tostring(fmt)) end
    wlr_buffer_end_data_ptr_access(buf)
    return
  end
  local row = (@usize)(w) * 4
  t.pixels:resize(row * (@usize)(h))
  local src = (@*[0]uint8)(data)
  for y = 0, < h do
    local s = (@*[0]uint8)(&src[(@usize)(y) * stride])
    local d = (@*[0]uint8)(&t.pixels[(@usize)(y) * row])
    memory.copy(d, s, row)
    if swap then
      for x = 0, < w do
        local o = x * 4
        d[o], d[o + 2] = d[o + 2], d[o]
      end
    end
  end
  wlr_buffer_end_data_ptr_access(buf)
  t.w, t.h = w, h
  t.serial = t.serial + 1
end

-- The window and its shown popups (t.lay, logical, the window's corner at
-- 0,0; popups kept within POPUP_MARGIN of it) and the rectangle around all
-- of them: the picture.
local function top_layout(t: *Top): (integer, integer, integer, integer)
  local w, h = top_size(t)
  t.lay:clear()
  t.lay:push(CaptureBox{ x = 0, y = 0, w = w, h = h })
  local x0, y0, x1, y1 = 0, 0, w, h
  for i = 0, < #t.popups do
    local pp = t.popups[i]
    if pp.x ~= nilptr then x11_place(pp) end
    if pp.tree ~= nilptr then
      local surf: *wlr_surface = nilptr
      local pw, ph = 0, 0
      if pp.p ~= nilptr then
        surf, pw, ph = pp.p.base.surface, (@integer)(pp.p.base.geometry.width), (@integer)(pp.p.base.geometry.height)
      else
        surf, pw, ph = pp.x.xs.surface, (@integer)(pp.x.xs.width), (@integer)(pp.x.xs.height)
      end
      if surf ~= nilptr and surf.mapped and pw > 0 and ph > 0 then
        local lx: cint, ly: cint = 0, 0
        wlr_scene_node_coords(&pp.tree.node, &lx, &ly)
        local bx0, by0 = math.max((@integer)(lx), -POPUP_MARGIN), math.max((@integer)(ly), -POPUP_MARGIN)
        local bx1, by1 = math.min((@integer)(lx) + pw, w + POPUP_MARGIN), math.min((@integer)(ly) + ph, h + POPUP_MARGIN)
        if bx1 > bx0 and by1 > by0 then
          t.lay:push(CaptureBox{ x = bx0, y = by0, w = bx1 - bx0, h = by1 - by0 })
          x0, y0 = math.min(x0, bx0), math.min(y0, by0)
          x1, y1 = math.max(x1, bx1), math.max(y1, by1)
        end
      end
    end
  end
  return x0, y0, x1 - x0, y1 - y0
end

local function render(t: *Top): void
  if not t.mapped or t.sout == nilptr or t.output.frame_pending then return end
  local ux, uy, uw, uh = top_layout(t)
  local w, h = uw * t.scale, uh * t.scale -- output pixels
  local resize = w ~= t.output.width or h ~= t.output.height
  local moved = ux ~= t.ox or uy ~= t.oy
  if moved then
    -- the output shows the scene from the picture's corner on
    wlr_scene_output_set_position(t.sout, (@cint)(ux), (@cint)(uy))
    t.ox, t.oy = ux, uy
  end
  if not resize and not moved and not wlr_scene_output_needs_frame(t.sout) then return end
  local st: wlr_output_state
  wlr_output_state_init(&st)
  if resize then wlr_output_state_set_custom_mode(&st, (@int32)(w), (@int32)(h), WAYLAND_REFRESH_MHZ) end
  local t0 = os.now()
  if wlr_scene_output_build_state(t.sout, &st, nilptr) then
    if (st.committed & WLR_OUTPUT_STATE_BUFFER) ~= 0 and st.buffer ~= nilptr then
      local t1 = os.now()
      grab(t, st.buffer, w, h)
      wc.stat_frames = wc.stat_frames + 1
      wc.stat_render = wc.stat_render + (t1 - t0)
      wc.stat_grab = wc.stat_grab + (os.now() - t1)
      t.boxes:clear()
      for i = 0, < #t.lay do
        local b = t.lay[i]
        t.boxes:push(CaptureBox{ x = (b.x - ux) * t.scale, y = (b.y - uy) * t.scale, w = b.w * t.scale, h = b.h * t.scale })
      end
    end
    wlr_output_commit_state(t.output, &st)
  end
  wlr_output_state_finish(&st)
  local ts: timespec
  clock_gettime(CLOCK_MONOTONIC, &ts)
  wlr_scene_output_send_frame_done(t.sout, &ts)
end

--------------------------------------------------------------------------------
-- Input

local function key(code: uint32, down: boolean): void
  local t = now_ms()
  local st = down and WL_KEYBOARD_KEY_STATE_PRESSED or WL_KEYBOARD_KEY_STATE_RELEASED
  local ev: wlr_keyboard_key_event = { time_msec = t, keycode = code, update_state = true, state = st }
  wlr_keyboard_notify_key(&keyboard, &ev) -- xkb state and pressed keys
  wlr_seat_keyboard_notify_key(wc.seat, t, code, st)
  wlr_seat_keyboard_notify_modifiers(wc.seat, &keyboard.modifiers)
end

local mod_keys: [4]uint32 = { WL_KEY_LEFTCTRL, WL_KEY_LEFTSHIFT, WL_KEY_LEFTALT, WL_KEY_LEFTMETA }

-- Press and release modifier keys until the held set is `mods` (WIN_MOD_*).
local function sync_mods(mods: uint8): void
  for i = 0, < 4 do
    local bit: uint8 = 1 << i
    if (mods & bit) ~= (wc.held_mods & bit) then key(mod_keys[i], (mods & bit) ~= 0) end
  end
  wc.held_mods = mods
end

-- Pointer onto window pixel (x, y): whatever surface is there gets it.
local function pointer_to(t: *Top, x: integer, y: integer, time: uint32): void
  local sx: float64, sy: float64 = 0, 0
  -- frames are output pixels; the scene is in logical coordinates
  -- picture pixels -> the scene's logical coordinates (the window's corner at 0,0)
  local lx, ly = t.ox + (x + 0.5) / t.scale, t.oy + (y + 0.5) / t.scale
  local node = wlr_scene_node_at(&t.scene.tree.node, lx, ly, &sx, &sy)
  local surf: *wlr_surface = nilptr
  if node ~= nilptr and node.type == WLR_SCENE_NODE_BUFFER then
    local ss = wlr_scene_surface_try_from_buffer(wlr_scene_buffer_from_node(node))
    if ss ~= nilptr then surf = ss.surface end
  end
  if surf == nilptr and t.x11 ~= nilptr then
    -- over nothing: X11 still wants it (a click outside ends a menu's grab)
    surf, sx, sy = top_surface(t), lx, ly
  end
  if surf == nilptr then wlr_seat_pointer_notify_clear_focus(wc.seat) return end
  wlr_seat_pointer_notify_enter(wc.seat, surf, sx, sy)
  wlr_seat_pointer_notify_motion(wc.seat, time, sx, sy)
end

-- UTF-8 -> keys through the keymap; characters the layout cannot type at
-- level 1 or 2 are dropped (logged once).
local function type_keys(text: string): void
  sync_mods(0)
  local i = 1
  while i <= #text do
    local b = text:byte(i)
    local cp: uint32 = b
    local n = 1
    if b >= 0xF0 then cp, n = b & 0x07, 4
    elseif b >= 0xE0 then cp, n = b & 0x0F, 3
    elseif b >= 0xC0 then cp, n = b & 0x1F, 2 end
    for k = 1, n - 1 do
      if i + k <= #text then cp = (cp << 6) | (text:byte(i + k) & 0x3F) end
    end
    i = i + n
    local ok, code, shift = wayland_key_for_codepoint(wc.keymap, cp)
    if ok then
      if shift then key(WL_KEY_LEFTSHIFT, true) end
      key(code, true)
      key(code, false)
      if shift then key(WL_KEY_LEFTSHIFT, false) end
    elseif not wc.warned_text then
      wc.warned_text = true
      log('the keymap cannot type U+' .. tostring(cp) .. ' (and maybe more); dropped')
    end
  end
end

-- TEXT: committed as strings through the focused client's enabled text
-- input (any character), newlines and tabs as the Enter and Tab keys; a
-- client without one gets keys through the keymap.
local function type_text(text: string): void
  local ti = ti_active(wc.kb_surface)
  if ti == nilptr then type_keys(text) return end
  local start = 1
  for i = 1, #text + 1 do
    local b: uint8 = i <= #text and text:byte(i) or 0
    if i > #text or b == 10 or b == 13 or b == 9 then
      if i > start then
        local run = text:sub(start, i - 1)
        wlr_text_input_v3_send_commit_string(ti, (@cstring)(run.data))
        wlr_text_input_v3_send_done(ti)
        run:destroy()
      end
      if i <= #text then
        sync_mods(0)
        local code = b == 9 and WL_KEY_TAB or WL_KEY_ENTER
        key(code, true) key(code, false)
      end
      start = i + 1
    end
  end
end

--------------------------------------------------------------------------------
-- The backend

local function wl_list(): string
  local sb: stringbuilder
  sb:write(WAYLAND_LAUNCH_LINE)
  for i = 0, < #wc.tops do
    local t = wc.tops[i]
    if t.mapped then
      local w, h = top_size(t)
      wayland_list_line(&sb, t.id, w, h, top_app(t), top_title(t), t.launch)
      -- a dialog names its window, so the game can put it beside that one
      if t.xdg ~= nilptr and t.xdg.parent ~= nilptr then
        for k = 0, < #wc.tops do
          if wc.tops[k].xdg == t.xdg.parent and wc.tops[k].mapped then
            sb.size = sb.size - 1 -- before the line's newline
            sb:writef('\tparent:%d\n', wc.tops[k].id)
            break
          end
        end
      end
    end
  end
  return sb:promote()
end

local function wl_list_serial(): uint64 return wc.list_serial end

local function wl_wid_of(h: pointer): uint32
  local c = (@*Cap)(h)
  return c.top ~= nilptr and c.top.id or 0
end

local function find_top(id: uint32): *Top
  for i = 0, < #wc.tops do
    if wc.tops[i].id == id and wc.tops[i].mapped then return wc.tops[i] end
  end
  return nilptr
end

local function owned(t: *Top): boolean
  for i = 0, < #wc.caps do
    if wc.caps[i].top == t then return true end
  end
  return false
end

-- A pending open finds its window. A launched app's is its own (by client
-- pid, or a descendant of it), else the first window nobody streams that
-- appeared after the launch (apps started through D-Bus activation run in
-- another process), else, once the launched process has exited 0 without a
-- window (a single-instance app handing over to its running copy), one whose
-- app id or title contains the program's name. Without run:, the first
-- window whose title or app id contains the match.
local function settle(c: *Cap, now: float64): void
  if #c.key > 0 then
    -- a saved window: the best fit nobody streams, waiting briefly for it
    local _, k = wayland_parse_key(c.key)
    local best: *Top, best_score = nilptr, 0
    for i = 0, < #wc.tops do
      local t = wc.tops[i]
      if t.mapped then
        local cand: WindowKey = { launch = t.launch, app = top_app(t), title = top_title(t) }
        local sc = wayland_key_score(k, cand, owned(t))
        if sc > best_score then best, best_score = t, sc end
      end
    end
    if best ~= nilptr then
      c.top = best
      set_why(c, CAPTURE_LIVE, '')
      focus(best)
    elseif now >= c.deadline then
      set_why(c, CAPTURE_ENDED, 'no such window (the app is not running: launch it again)')
    end
    return
  end
  for pass = 1, 3 do
    for i = 0, < #wc.tops do
      local t = wc.tops[i]
      if t.mapped then
        local hit = false
        if c.pid == 0 then
          hit = pass == 1 and (wayland_contains(top_title(t), c.match) or wayland_contains(top_app(t), c.match))
        elseif pass == 1 then
          hit = descends_from(t.pid, c.pid)
        elseif pass == 2 then
          hit = t.id >= c.first_new and not owned(t)
        elseif c.handed_off and #c.name > 0 then
          hit = wayland_contains(top_app(t), c.name) or wayland_contains(top_title(t), c.name)
        end
        if hit then
          c.top = t
          set_why(c, CAPTURE_LIVE, '')
          if #c.launch > 0 and #t.launch == 0 then t.launch = string.copy(c.launch) end
          focus(t)
          return
        end
      end
    end
  end
  if c.pid ~= 0 then
    local ch = child_of(c.pid)
    if ch ~= nilptr and ch.done then
      if ch.status == 0 and not c.handed_off then
        -- it may have handed over: give the other process a moment to show a window
        c.handed_off = true
        c.deadline = math.min(c.deadline, now + WAYLAND_HANDOFF_WAIT)
        settle(c, now)
        return
      elseif ch.status ~= 0 or now >= c.deadline then
        local sb: stringbuilder
        if ch.status == 0 and flatpak_running(c.flatpak) then
          sb:writef('%s is already running on your desktop and took the launch; quit it there to open it in the game', c.flatpak)
        elseif ch.status == 0 then
          sb:writef('the app exited without opening a window here (a copy already running on the desktop may have taken it)')
        else
          sb:writef('the app exited (status %d) without opening a window here', ch.status)
        end
        local why = sb:promote()
        set_why(c, CAPTURE_ENDED, why)
        why:destroy()
        return
      end
    end
  end
  if now >= c.deadline then
    set_why(c, CAPTURE_ENDED, c.pid ~= 0 and 'the app opened no window' or 'no such window')
  end
end

local function on_path(name: string): boolean
  local p = desktop_which(name)
  local found = #p > 0
  p:destroy()
  return found
end

--------------------------------------------------------------------------------
-- Links (WOPEN "url:URL", docs/REMOTE_WINDOWS.md "Opening URLs")

-- A command's output without the blanks around it ('' when it fails).
local function read_cmd(cmd: string): string
  local f = io.popen(cmd, 'r')
  if not f:isopen() then return (@string){} end
  local out = f:read('a')
  f:close()
  local i, j = 1, #out
  while i <= j and (out:byte(i) == 32 or out:byte(i) == 9 or out:byte(i) == 10 or out:byte(i) == 13) do i = i + 1 end
  while j >= i and (out:byte(j) == 32 or out:byte(j) == 9 or out:byte(j) == 10 or out:byte(j) == 13) do j = j - 1 end
  local t = out:sub(i, j)
  out:destroy()
  return t
end

-- The browser's command line for `url`: --wayland-browser CMD (or
-- GHOSTTY_WAYLAND_BROWSER), else the Exec of the desktop's default browser
-- (`xdg-settings get default-web-browser`, else `xdg-mime query default
-- x-scheme-handler/https`); with --wayland-browser-profile its own profile.
-- Empty and why when there is none.
local function browser_command(url: string): (string, string)
  local tmpl = #opt_browser > 0 and string.copy(opt_browser) or os.getenv('GHOSTTY_WAYLAND_BROWSER')
  local name: string, icon: string
  if #tmpl == 0 then
    local id = read_cmd('xdg-settings get default-web-browser 2>/dev/null')
    if #id == 0 then id:destroy() id = read_cmd('xdg-mime query default x-scheme-handler/https 2>/dev/null') end
    if #id == 0 then
      id:destroy()
      return (@string){}, string.copy('no default web browser (xdg-settings get default-web-browser); set --wayland-browser CMD')
    end
    local dirs = desktop_data_dirs()
    local es = desktop_scan(&dirs)
    for i = 0, < #es do
      if es[i].id == id then
        tmpl:destroy()
        tmpl, name, icon = string.copy(es[i].exec_raw), string.copy(es[i].name), string.copy(es[i].icon)
        break
      end
    end
    for i = 0, < #es do es[i]:destroy() end
    es:destroy()
    for i = 0, < #dirs do dirs[i]:destroy() end
    dirs:destroy()
    if #tmpl == 0 then
      local why = 'the default browser ' .. id .. ' is not an installed app here; set --wayland-browser CMD'
      id:destroy()
      return (@string){}, why
    end
    id:destroy()
  end
  local cmd = browser_expand(tmpl, url, name, icon)
  tmpl:destroy() name:destroy() icon:destroy()
  local profile = #opt_browser_profile > 0 and string.copy(opt_browser_profile) or os.getenv('GHOSTTY_WAYLAND_BROWSER_PROFILE')
  if #profile == 0 then profile:destroy() return cmd, (@string){} end
  if not browser_profile_ok(profile) then
    profile:destroy() cmd:destroy()
    return (@string){}, string.copy('--wayland-browser-profile: a name of letters, digits, . _ -')
  end
  local prog = browser_program(cmd)
  local family = browser_family(prog)
  local flatpak = wayland_flatpak_id(cmd)
  local home, data_home = os.getenv('HOME'), os.getenv('XDG_DATA_HOME')
  local dir = browser_profile_dir(family, flatpak, profile, home, data_home)
  local ok, out = browser_with_profile(cmd, family, dir)
  if ok then
    local sb: stringbuilder
    sb:write('mkdir -p ') desktop_sh_quote(&sb, dir) sb:write(' 2>/dev/null; ')
    local mk = sb:promote()
    os.execute(mk)
    mk:destroy()
  end
  prog:destroy() flatpak:destroy() home:destroy() data_home:destroy() dir:destroy() profile:destroy() cmd:destroy()
  if not ok then return (@string){}, out end
  return out, (@string){}
end

-- The value of NAME in a /proc/PID/environ (NUL separated), as a view; empty when unset.
local function environ_value(env: string, name: string): string
  local start = 1
  for pos = 1, #env + 1 do
    if pos > #env or env:byte(pos) == 0 then
      local entry = env:subview(start, pos - 1)
      if #entry > #name and entry:byte(#name + 1) == 61 and entry:subview(1, #name) == name then return entry:subview(#name + 2) end
      start = pos + 1
    end
  end
  return (@string){}
end

-- A process of browser `prog` runs outside this compositor (on the host
-- desktop): its /proc/PID/comm fits the program (browser_comm_matches),
-- it is not one of ours (a descendant of the agent) and its
-- WAYLAND_DISPLAY is not our socket. Its single instance would take the link.
local function browser_on_desktop(prog: string): boolean
  local me = getpid()
  local names = desktop_list_dir('/proc')
  local found = false
  for i = 0, < #names do
    local nm = names[i]
    if found or #nm == 0 or nm:byte(1) < 48 or nm:byte(1) > 57 then continue end
    local path = string.format('/proc/%s/comm', nm)
    local f = io.open(path, 'r')
    path:destroy()
    if not f:isopen() then continue end
    local comm = f:read('l')
    f:close()
    if browser_comm_matches(comm, prog) then
      local pid = (@cint)(tointeger(nm))
      local epath = string.format('/proc/%s/environ', nm)
      local ef = io.open(epath, 'rb')
      epath:destroy()
      local env: string
      if ef:isopen() then env = ef:read('a') ef:close() end
      local wd = environ_value(env, 'WAYLAND_DISPLAY')
      if wd ~= wc.socket and not descends_from(pid, me) then found = true end
      env:destroy()
    end
    comm:destroy()
  end
  for i = 0, < #names do names[i]:destroy() end
  names:destroy()
  return found
end

-- The browser's window in the compositor: the one the last url: launch
-- opened, else the newest mapped window of that browser (by app id).
local function browser_top(prog: string, flatpak: string): *Top
  if #wc.browser_launch > 0 then
    for i = 0, < #wc.tops do
      local t = wc.tops[i]
      if t.mapped and t.launch == wc.browser_launch then return t end
    end
  end
  local best: *Top = nilptr
  for i = 0, < #wc.tops do
    local t = wc.tops[i]
    if t.mapped and (browser_window_matches(top_app(t), prog) or (#flatpak > 0 and browser_window_matches(top_app(t), flatpak))) then
      if best == nilptr or t.id > best.id then best = t end
    end
  end
  return best
end

-- WOPEN "url:URL": the browser opens it here. A browser window already in
-- the compositor gets it (the browser's own "open in the running instance":
-- the command runs again) and the stream shows that window at once;
-- otherwise the browser starts like run: and the stream waits for its window.
-- Refused when the browser's single instance runs on the host desktop (the
-- link would open there), unless a separate profile is set.
local function open_url(url: string): (pointer, string)
  local bad = browser_url_check(url)
  if #bad > 0 then return nilptr, string.copy(bad) end
  local cmd, why = browser_command(url)
  if #cmd == 0 then return nilptr, why end
  local prog = browser_program(cmd)
  local flatpak = wayland_flatpak_id(cmd)
  local env_profile = os.getenv('GHOSTTY_WAYLAND_BROWSER_PROFILE')
  local profiled = #opt_browser_profile > 0 or #env_profile > 0
  env_profile:destroy()
  local t = browser_top(prog, flatpak)
  if t == nilptr and not profiled and ((#flatpak > 0 and flatpak_running(flatpak)) or (#flatpak == 0 and browser_on_desktop(prog))) then
    local msg = string.format('%s is running on your desktop, so the link would open there; quit it, or give the game its own browser (ghostty-agent --wayland-browser-profile NAME)', #flatpak > 0 and flatpak or prog)
    cmd:destroy() prog:destroy() flatpak:destroy()
    return nilptr, msg
  end
  local pid = spawn(cmd)
  if pid < 0 then
    cmd:destroy() prog:destroy() flatpak:destroy()
    return nilptr, string.copy('cannot start the browser (fork failed)')
  end
  wc.children:push(Child{ pid = pid })
  local c = new(@Cap)
  if t ~= nilptr then
    -- the running browser takes the URL as a new tab; the stream is its window
    log('link to the browser in window ' .. tostring(t.id) .. ' (' .. top_app(t) .. '): ' .. cmd)
    c.top = t
    c.state = CAPTURE_LIVE
    wc.caps:push(c)
    focus(t)
  else
    c.state = CAPTURE_PENDING
    c.deadline = os.now() + WAYLAND_OPEN_TIMEOUT
    c.pid = pid
    wc.launches = wc.launches + 1
    c.launch = string.format('%s.%d', wc.instance, wc.launches)
    wc.browser_launch:destroy()
    wc.browser_launch = string.copy(c.launch)
    c.first_new = wc.next_id
    c.name = string.copy(#flatpak > 0 and flatpak or prog)
    c.flatpak = string.copy(flatpak)
    log('link: started the browser "' .. cmd .. '" (pid ' .. tostring(pid) .. ') on ' .. wc.socket)
    wc.caps:push(c)
    settle(c, os.now())
  end
  cmd:destroy() prog:destroy() flatpak:destroy()
  return c, (@string){}
end

local function wl_open(wid: uint32, match: string): (pointer, string)
  if wid ~= 0 then
    local t = find_top(wid)
    if t == nilptr then return nilptr, string.copy('no such window') end
    local c = new(@Cap)
    c.top = t
    c.state = CAPTURE_LIVE
    wc.caps:push(c)
    focus(t)
    return c, (@string){}
  end
  do
    local is_url, url = wayland_match_form(match, 'url:')
    if is_url then
      local h, why = open_url(url)
      url:destroy()
      return h, why
    end
  end
  local is_run, cmd = wayland_parse_run(match)
  local is_desk, spec = wayland_match_form(match, 'desktop:')
  if not is_desk and match == 'desktop:' then is_desk = true end
  if is_desk then
    local ok, dcmd, why = wayland_desktop_command(spec, on_path)
    spec:destroy()
    if not ok then return nilptr, why end
    -- wlroots compositors pick their Wayland backend from WAYLAND_DISPLAY;
    -- ours offers shared memory buffers only, so they render in software
    is_run, cmd = true, 'env WLR_RENDERER=pixman WLR_NO_HARDWARE_CURSORS=1 ' .. dcmd
    dcmd:destroy()
  end
  local is_app, app = wayland_match_form(match, 'app:')
  if is_app then
    -- an installed app by desktop id or name: its Exec, as run: would
    local dirs = desktop_data_dirs()
    local es = desktop_scan(&dirs)
    local k = desktop_find(&es, app)
    local why: string
    if k < 0 then
      why = 'no installed app matches "' .. app .. '"'
    elseif es[k].terminal then
      why = es[k].name .. ' runs in a terminal: open "' .. es[k].exec .. '" as a terminal panel'
    else
      is_run, cmd = true, string.copy(es[k].exec)
      log('app "' .. app .. '" is ' .. es[k].id .. ': ' .. cmd)
    end
    for i = 0, < #es do es[i]:destroy() end
    es:destroy()
    for i = 0, < #dirs do dirs[i]:destroy() end
    dirs:destroy()
    app:destroy()
    if #why > 0 then return nilptr, why end
  end
  local c = new(@Cap)
  c.state = CAPTURE_PENDING
  c.deadline = os.now() + WAYLAND_OPEN_TIMEOUT
  if is_run then
    c.pid = spawn(cmd)
    if c.pid < 0 then
      cmd:destroy()
      delete(c)
      return nilptr, string.copy('cannot start the app (fork failed)')
    end
    wc.children:push(Child{ pid = c.pid })
    wc.launches = wc.launches + 1
    c.launch = string.format('%s.%d', wc.instance, wc.launches)
    c.first_new = wc.next_id
    c.name = wayland_launch_name(cmd)
    c.flatpak = wayland_flatpak_id(cmd)
    log('started "' .. cmd .. '" (pid ' .. tostring(c.pid) .. ') on ' .. wc.socket)
    cmd:destroy()
  elseif #match >= 4 and match:subview(1, 4) == 'key:' then
    local ok = wayland_parse_key(match)
    if not ok then delete(c) return nilptr, string.copy('bad key: key:LAUNCH or key:LAUNCH<tab>APP<tab>TITLE') end
    c.key = string.copy(match)
    c.deadline = os.now() + WAYLAND_HANDOFF_WAIT
  else
    c.match = match:lower()
  end
  wc.caps:push(c)
  settle(c, os.now())
  return c, (@string){}
end

-- WLIST "apps": the installed apps as `app` / `term` lines
-- (desktop_list_line), each with a PNG icon under $HOME
-- (~/.cache/ghostty-agent/icons) that a sandboxed game can read. Icons not
-- cached yet are copied (PNG) or rendered (SVG, XPM: rsvg-convert, else
-- ImageMagick) by one background job, so a path may name a file that
-- appears a moment later; an icon that cannot be made has an empty field.
local function wl_apps(): string
  local dirs = desktop_data_dirs()
  local es = desktop_scan(&dirs)
  local idirs = desktop_icon_dirs()
  local cache = desktop_icon_cache_dir()
  do -- icons queued by jobs that ended are made or failed: forget them
    local k = #wc.icon_pids - 1
    while k >= 0 do
      local ch = child_of(wc.icon_pids[k])
      if ch == nilptr or ch.done then wc.icon_pids:remove((@usize)(k)) end
      k = k - 1
    end
    if #wc.icon_pids == 0 then
      for q = 0, < #wc.icon_queued do wc.icon_queued[q]:destroy() end
      wc.icon_queued:clear()
    end
  end
  local renderer = desktop_icon_renderer()
  local jobs: stringbuilder
  local njobs = 0
  local sb: stringbuilder
  for i = 0, < #es do
    local src, size = desktop_find_icon(es[i].icon, &idirs)
    local png: string
    if #src > 0 then
      png = desktop_icon_png(cache, desktop_short_id(es[i].id), size)
      local queued = false
      for q = 0, < #wc.icon_queued do if wc.icon_queued[q] == png then queued = true break end end
      if not queued and access((@cstring)(png.data), 0) ~= 0 then
        if desktop_icon_job(&jobs, src, png, renderer) then
          njobs = njobs + 1
          wc.icon_queued:push(string.copy(png))
        else
          png:destroy() png = (@string){}
        end
      end
    end
    desktop_list_line(&sb, &es[i], png)
    png:destroy() src:destroy()
  end
  -- nested desktops that are installed: "desktop\tNAME\tNAME\t\t\n", opened with desktop:NAME
  for i = 0, < #WAYLAND_DESKTOPS do
    local p = desktop_which(WAYLAND_DESKTOPS[i])
    if #p > 0 then sb:write('desktop\t', WAYLAND_DESKTOPS[i], '\t', WAYLAND_DESKTOPS[i], '\t\t\n') end
    p:destroy()
  end
  if njobs > 0 then
    local script: stringbuilder
    script:write('mkdir -p ') desktop_sh_quote(&script, cache) script:write('\n')
    local body = jobs:promote()
    script:write(body)
    body:destroy()
    local cmd = script:promote()
    local pid = spawn(cmd)
    if pid > 0 then wc.children:push(Child{ pid = pid }) wc.icon_pids:push(pid) end
    cmd:destroy()
    log(string.format('apps: %d listed; caching %d icons in %s (%s)', #es, njobs, cache, #renderer > 0 and renderer or 'no SVG renderer: PNG icons only'))
  else
    jobs:destroy()
  end
  renderer:destroy() cache:destroy()
  for i = 0, < #es do es[i]:destroy() end
  es:destroy()
  for i = 0, < #dirs do dirs[i]:destroy() end
  dirs:destroy()
  for i = 0, < #idirs do idirs[i]:destroy() end
  idirs:destroy()
  return sb:promote()
end

local function wl_state(h: pointer): (integer, string)
  local c = (@*Cap)(h)
  return c.state, c.why
end

local function wl_title(h: pointer): string
  local c = (@*Cap)(h)
  c.title:destroy()
  if c.top ~= nilptr then c.title = string.copy(top_title(c.top))
  elseif c.pid ~= 0 then c.title = string.copy('starting…')
  else c.title = string.copy('waiting for a window') end
  return c.title
end

local function wl_frame(h: pointer, out: *CaptureFrame): boolean
  local c = (@*Cap)(h)
  local t = c.top
  if t == nilptr or t.serial == 0 then return false end
  $out = { pixels = (@*[0]uint8)(&t.pixels[0]), w = t.w, h = t.h, stride = (@usize)(t.w) * 4, serial = t.serial,
           boxes = #t.boxes > 0 and (@*[0]CaptureBox)(&t.boxes[0]) or nilptr, nbox = #t.boxes }
  return true
end

local function wl_input(h: pointer, ev: *CaptureInput): void
  local c = (@*Cap)(h)
  local t = c.top
  if t == nilptr or not t.mapped then return end
  focus(t)
  local time = now_ms()
  if ev.kind == WIN_INPUT_MOVE then
    pointer_to(t, ev.x, ev.y, time)
    wlr_seat_pointer_notify_frame(wc.seat)
  elseif ev.kind == WIN_INPUT_BUTTON then
    pointer_to(t, ev.x, ev.y, time)
    local b = BTN_LEFT + (@uint32)(math.clamp(ev.button, 0, 2))
    wlr_seat_pointer_notify_button(wc.seat, time, b, ev.down and WL_POINTER_BUTTON_STATE_PRESSED or WL_POINTER_BUTTON_STATE_RELEASED)
    wlr_seat_pointer_notify_frame(wc.seat)
  elseif ev.kind == WIN_INPUT_WHEEL then
    pointer_to(t, ev.x, ev.y, time)
    -- +dy is away from the user (scroll up); Wayland's positive vertical axis
    -- scrolls down, so the sign flips. Discrete values are in 1/120 notches.
    if ev.dy ~= 0 then
      wlr_seat_pointer_notify_axis(wc.seat, time, WL_POINTER_AXIS_VERTICAL_SCROLL, -ev.dy * AXIS_PER_NOTCH / 120.0,
        (@int32)(-ev.dy), WL_POINTER_AXIS_SOURCE_WHEEL, WL_POINTER_AXIS_RELATIVE_DIRECTION_IDENTICAL)
    end
    if ev.dx ~= 0 then -- +dx is to the right, as on Wayland
      wlr_seat_pointer_notify_axis(wc.seat, time, WL_POINTER_AXIS_HORIZONTAL_SCROLL, ev.dx * AXIS_PER_NOTCH / 120.0,
        (@int32)(ev.dx), WL_POINTER_AXIS_SOURCE_WHEEL, WL_POINTER_AXIS_RELATIVE_DIRECTION_IDENTICAL)
    end
    wlr_seat_pointer_notify_frame(wc.seat)
  elseif ev.kind == WIN_INPUT_KEY then
    -- modifiers travel in `mods`; lone modifier keys are not played
    if ev.hid >= 0xE0 and ev.hid <= 0xE7 then return end
    local code = wayland_hid_to_evdev(ev.hid)
    if code == 0 then return end
    sync_mods(ev.mods)
    key(code, ev.down)
    if not ev.down then sync_mods(0) end
  elseif ev.kind == WIN_INPUT_TEXT then
    type_text(ev.text)
  end
  wl_display_flush_clients(wc.display)
end

local function forget_cap(c: *Cap): void
  for i = 0, < #wc.caps do
    if wc.caps[i] == c then wc.caps:remove(i) break end
  end
  c.why:destroy() c.title:destroy() c.match:destroy() c.name:destroy() c.flatpak:destroy() c.launch:destroy() c.key:destroy()
  delete(c)
end

local function wl_close(h: pointer): void
  local c = (@*Cap)(h)
  -- an app launched for this stream (or re-attached by its key) is asked
  -- to close with it
  if c.top ~= nilptr and (c.pid ~= 0 or (#c.key > 0 and #c.top.launch > 0)) then top_close(c.top) end
  forget_cap(c)
end

-- The client went away (a plugin reload, the game quitting): the stream
-- goes, the window and the app launched for it stay, to be opened again.
local function wl_release(h: pointer): void
  forget_cap((@*Cap)(h))
end

local function wl_pump(): void
  wl_event_loop_dispatch(wc.loop, 0)
  reap_children()
  local now = os.now()
  for i = 0, < #wc.caps do
    if wc.caps[i].state == CAPTURE_PENDING then settle(wc.caps[i], now) end
  end
  for i = 0, < #wc.tops do render(wc.tops[i]) end
  -- forget launched processes that ended and no pending open waits for
  local i = #wc.children - 1
  while i >= 0 do
    local ch = wc.children[i]
    local waited = false
    for k = 0, < #wc.caps do
      if wc.caps[k].pid == ch.pid and wc.caps[k].state == CAPTURE_PENDING then waited = true end
    end
    if ch.done and not waited then wc.children:remove((@usize)(i)) end
    i = i - 1
  end
  wl_display_flush_clients(wc.display)
end

local function wl_poll_fds(fds: *[0]cint, max: integer): integer
  if max < 1 then return 0 end
  fds[0] = wl_event_loop_get_fd(wc.loop)
  return 1
end

local function wl_wait_ms(): integer
  for i = 0, < #wc.tops do
    local t = wc.tops[i]
    -- damage waiting for the output's next frame (its timer wakes the loop fd too)
    if t.mapped and t.sout ~= nilptr and wlr_scene_output_needs_frame(t.sout) then return 16 end
  end
  for i = 0, < #wc.caps do
    if wc.caps[i].state == CAPTURE_PENDING then return 250 end -- timeouts, exits of launched apps
  end
  return -1
end

-- The socket clients connect to (WAYLAND_DISPLAY), empty before start.
global function capture_wayland_socket(): string
  return wc.socket
end

-- Xwayland, lazily: wlroots listens on the next free X display now and
-- starts the server when the first X11 client connects. GHOSTTY_XWAYLAND=off
-- leaves it out; without the Xwayland binary there is none either. A link
-- $XDG_RUNTIME_DIR/<socket>-x11 to the display's socket gives a name that
-- stays the same when the number does not: DISPLAY=$XDG_RUNTIME_DIR/ffxiv-0-x11
-- (libxcb takes a socket path).
local function start_xwayland(): void
  local mode = os.getenv('GHOSTTY_XWAYLAND')
  if mode == 'off' or mode == '0' then log('Xwayland off (GHOSTTY_XWAYLAND)') return end
  if access('/usr/bin/Xwayland', 1) ~= 0 and access('/usr/local/bin/Xwayland', 1) ~= 0 then
    log('no Xwayland binary: X11-only apps will not show')
    return
  end
  local t0 = os.now()
  wc.xwayland = wlr_xwayland_create(wc.display, wc.compositor, mode ~= 'eager')
  if wc.xwayland == nilptr then log('cannot start Xwayland: X11-only apps will not show') return end
  wlr_xwayland_set_seat(wc.xwayland, wc.seat)
  -- X11 apps keep their menus on the "monitor" (all our outputs overlap at
  -- 0,0, one per window, each the window's size); one big output that is
  -- never drawn gives them a screen to open menus beyond their window in
  do
    local o = wlr_headless_add_output(wc.backend, X11_SCREEN_W, X11_SCREEN_H)
    if o ~= nilptr then
      wlr_output_init_render(o, wc.allocator, wc.renderer)
      local st: wlr_output_state
      wlr_output_state_init(&st)
      wlr_output_state_set_enabled(&st, true)
      wlr_output_state_set_custom_mode(&st, X11_SCREEN_W, X11_SCREEN_H, WAYLAND_REFRESH_MHZ)
      wlr_output_commit_state(o, &st)
      wlr_output_state_finish(&st)
      wlr_output_create_global(o, wc.display)
    end
  end
  hook(&wc.on_x_surface, &wc.xwayland.events.new_surface, on_x_surface, nilptr)
  hook(&wc.on_x_ready, &wc.xwayland.events.ready, on_x_ready, nilptr)
  if wc.xwayland.server ~= nilptr then hook(&wc.on_x_start, &wc.xwayland.server.events.start, on_x_start, nilptr) end
  if mode == 'eager' then wc.x_started = t0 end
  wc.x_display = string.copy((@string)(wc.xwayland.display_name))
  local disp = wc.x_display:sub(2)
  local target = '/tmp/.X11-unix/X' .. disp
  wc.x_link = wc.runtime_dir .. '/' .. wc.socket .. '-x11'
  unlink((@cstring)(wc.x_link.data))
  if symlink((@cstring)(target.data), (@cstring)(wc.x_link.data)) ~= 0 then wc.x_link:destroy() wc.x_link = (@string){} end
  log('X11 apps: DISPLAY=' .. wc.x_display .. (#wc.x_link > 0 and (' or DISPLAY=' .. wc.x_link) or '') .. (mode == 'eager' and '' or ' (Xwayland starts with the first X11 client)'))
  target:destroy() disp:destroy()
end

-- The machine's DRM render nodes, with their GPU's PCI address, driver,
-- whether it drives a display and its free VRAM (amdgpu: sysfs; nvidia:
-- one nvidia-smi query; others unknown).
local function sys_real(path: string): string
  local r = realpath((@cstring)(path.data), nilptr)
  if r == nilptr then return (@string){} end
  local out = string.copy((@string)(r))
  free(r)
  return out
end

local function sys_base(path: string): string
  local r = sys_real(path)
  local slash = 0
  for i = 1, #r do if r:byte(i) == 47 then slash = i end end
  local b = r:sub(slash + 1)
  r:destroy()
  return b
end

local function sys_read(path: string): string
  local f = io.open(path, 'r')
  if not f:isopen() then return (@string){} end
  local t = f:read('a')
  f:close()
  return t
end

local function render_nodes(): vector(RenderNode)
  local out: vector(RenderNode)
  local drm = desktop_list_dir('/sys/class/drm')
  local nvidia_csv: string
  local asked_nvidia = false
  for i = 0, < #drm do
    local nm = drm[i]
    if #nm > 7 and nm:subview(1, 7) == 'renderD' then
      local n: RenderNode
      n.path = '/dev/dri/' .. nm
      local dev = '/sys/class/drm/' .. nm .. '/device'
      n.pci = sys_base(dev)
      local drv = dev .. '/driver'
      n.driver = sys_base(drv)
      drv:destroy()
      local devreal = sys_real(dev)
      -- a connected connector ("cardN-HDMI-A-1") of a card on the same device
      for k = 0, < #drm do
        local c = drm[k]
        local dash = c:find('-', 1, true)
        if #c > 4 and c:subview(1, 4) == 'card' and dash > 0 then
          local st = sys_read('/sys/class/drm/' .. c .. '/status')
          if #st >= 9 and st:subview(1, 9) == 'connected' then
            local cr = sys_real('/sys/class/drm/' .. c:subview(1, dash - 1) .. '/device')
            if cr == devreal then n.display = true end
            cr:destroy()
          end
          st:destroy()
        end
      end
      n.free_mb, n.total_mb = -1, -1
      if n.driver == 'amdgpu' then
        local tot = sys_read(dev .. '/mem_info_vram_total')
        local used = sys_read(dev .. '/mem_info_vram_used')
        if #tot > 0 and #used > 0 then
          local tb, ub = digits_of(tot), digits_of(used)
          if tb > 0 and ub >= 0 then n.total_mb, n.free_mb = tb // 1048576, (tb - ub) // 1048576 end
        end
        tot:destroy() used:destroy()
      elseif n.driver == 'nvidia' then
        if not asked_nvidia then
          asked_nvidia = true
          local f = io.popen('timeout 5 nvidia-smi --query-gpu=pci.bus_id,memory.free,memory.total --format=csv,noheader,nounits 2>/dev/null', 'r')
          if f:isopen() then nvidia_csv = f:read('a') f:close() end
        end
        n.free_mb, n.total_mb = wayland_nvidia_vram(nvidia_csv, n.pci)
      end
      devreal:destroy() dev:destroy()
      out:push(n)
    end
  end
  nvidia_csv:destroy()
  for i = 0, < #drm do drm[i]:destroy() end
  drm:destroy()
  return out
end

-- The renderer: a GPU's (GLES2 on its render node) when the option picks
-- one and it starts, else pixman. Logs which and why.
local function make_renderer(): *wlr_renderer
  local opt = #opt_render_node > 0 and string.copy(opt_render_node) or os.getenv('GHOSTTY_WAYLAND_RENDER_NODE')
  local path, why: string, string
  if opt == 'none' or opt == 'pixman' or opt == 'off' or (#opt > 0 and opt:byte(1) == 47) then
    path, why = wayland_pick_render_node(opt, nilptr)
  else
    local nodes = render_nodes()
    path, why = wayland_pick_render_node(opt, &nodes)
    for i = 0, < #nodes do nodes[i].path:destroy() nodes[i].pci:destroy() nodes[i].driver:destroy() end
    nodes:destroy()
  end
  opt:destroy()
  if #path > 0 then
    local fd = open((@cstring)(path.data), O_RDWR | O_CLOEXEC)
    if fd >= 0 then
      local r = wlr_gles2_renderer_create_with_drm_fd(fd)
      if r ~= nilptr then
        wc.gpu, wc.drm_fd = path, fd
        log('renderer: GPU ' .. path .. ': ' .. why)
        why:destroy()
        return r
      end
      close(fd)
    end
    log('renderer: cannot render on ' .. path .. ' (' .. why .. '): software rendering')
    path:destroy() why:destroy()
    return wlr_pixman_renderer_create()
  end
  log('renderer: pixman: ' .. why)
  why:destroy()
  return wlr_pixman_renderer_create()
end

-- $BROWSER and an xdg-open shim for the apps in the compositor, so links
-- they open come back here (docs/REMOTE_WINDOWS.md "Opening URLs"). BROWSER
-- is `ghostty-agent --open-url` when that name on PATH is this binary, else
-- this binary's path; the shim is $XDG_RUNTIME_DIR/ghostty-agent-SOCKET/xdg-open,
-- first on their PATH: web and mail links go to --open-url, anything else
-- (and a refused link) to the real xdg-open.
local function setup_link_env(): void
  local exe: string
  do
    local r = realpath('/proc/self/exe', nilptr)
    if r ~= nilptr then exe = string.copy((@string)(r)) free(r) end
  end
  local prog: string
  local onpath = desktop_which('ghostty-agent')
  if #onpath > 0 and #exe > 0 then
    local r = realpath((@cstring)(onpath.data), nilptr)
    if r ~= nilptr then
      if (@string)(r) == exe then prog = string.copy('ghostty-agent') end
      free(r)
    end
  end
  onpath:destroy()
  if #prog == 0 then
    if #exe == 0 then return end
    local sb: stringbuilder
    desktop_sh_quote(&sb, exe)
    prog = sb:promote()
  end
  exe:destroy()
  wc.open_url_cmd = string.format('%s --open-url', prog)
  local dir = string.format('%s/ghostty-agent-%s', wc.runtime_dir, wc.socket)
  local path = string.format('%s/xdg-open', dir)
  local sb: stringbuilder
  sb:write('mkdir -p ') desktop_sh_quote(&sb, dir) sb:write(' 2>/dev/null')
  local mk = sb:promote()
  os.execute(mk)
  mk:destroy()
  local f = io.open(path, 'wb')
  if f:isopen() then
    f:write('#!/bin/sh\n# ghostty-agent (WAYLAND_DISPLAY=', wc.socket, '): web and mail links from apps in the\n',
      '# game\'s compositor open in its browser, as a panel in the game.\n',
      'case "$1" in\n',
      '  [hH][tT][tT][pP]://*|[hH][tT][tT][pP][sS]://*|[mM][aA][iI][lL][tT][oO]:*)\n',
      '    ', prog, ' --open-url "$1" && exit 0 ;;\n',
      'esac\n',
      '# anything else, or a link the agent refused: the real xdg-open\n',
      'here=$(cd "$(dirname "$0")" && pwd)\n',
      'PATH=$(printf \'%s\' "$PATH" | tr \':\' \'\\n\' | grep -vxF "$here" | paste -sd: -)\n',
      'export PATH\n',
      'exec xdg-open "$@"\n')
    f:close()
    local sb2: stringbuilder
    sb2:write('chmod 755 ') desktop_sh_quote(&sb2, path)
    local ch = sb2:promote()
    os.execute(ch)
    ch:destroy()
    local old = os.getenv('PATH')
    wc.path_env = string.format('%s:%s', dir, #old > 0 and old or '/usr/local/bin:/usr/bin:/bin')
    old:destroy()
  else
    log('cannot write the xdg-open shim ' .. path .. ': apps get only $BROWSER')
  end
  prog:destroy() dir:destroy() path:destroy()
end

local function start(): (boolean, string)
  local level = WLR_ERROR
  if #os.getenv('GHOSTTY_WAYLAND_DEBUG') > 0 then level = WLR_DEBUG end
  wlr_log_init(level, nilptr)
  wc.runtime_dir = os.getenv('XDG_RUNTIME_DIR')
  if #wc.runtime_dir == 0 then return false, 'XDG_RUNTIME_DIR is not set' end
  wc.display = wl_display_create()
  if wc.display == nilptr then return false, 'cannot create a Wayland display' end
  wc.loop = wl_display_get_event_loop(wc.display)
  wc.backend = wlr_headless_backend_create(wc.loop)
  if wc.backend == nilptr then return false, 'cannot create the headless backend' end
  wc.drm_fd = -1
  wc.renderer = make_renderer()
  if wc.renderer == nilptr then return false, 'cannot create the pixman renderer' end
  wc.allocator = wlr_allocator_autocreate(wc.backend, wc.renderer)
  if wc.allocator == nilptr and #wc.gpu > 0 then
    log('renderer: no buffer allocator for ' .. wc.gpu .. ': software rendering')
    wlr_renderer_destroy(wc.renderer)
    close(wc.drm_fd)
    wc.drm_fd = -1
    wc.gpu:destroy()
    wc.gpu = (@string){}
    wc.renderer = wlr_pixman_renderer_create()
    wc.allocator = wlr_allocator_autocreate(wc.backend, wc.renderer)
  end
  if wc.allocator == nilptr then return false, 'cannot create a buffer allocator' end
  -- wl_shm and friends; with a GPU also linux-dmabuf, so GL/Vulkan clients
  -- hand over GPU buffers
  wlr_renderer_init_wl_display(wc.renderer, wc.display)
  wc.compositor = wlr_compositor_create(wc.display, 6, wc.renderer)
  wlr_subcompositor_create(wc.display)
  wlr_data_device_manager_create(wc.display)
  wlr_primary_selection_v1_device_manager_create(wc.display)
  wlr_viewporter_create(wc.display)
  wc.xdg_shell = wlr_xdg_shell_create(wc.display, 6)
  hook(&wc.on_new_toplevel, &wc.xdg_shell.events.new_toplevel, on_new_toplevel, nilptr)
  hook(&wc.on_new_popup, &wc.xdg_shell.events.new_popup, on_new_popup, nilptr)
  wc.deco_mgr = wlr_xdg_decoration_manager_v1_create(wc.display)
  hook(&wc.on_new_deco, &wc.deco_mgr.events.new_toplevel_decoration, on_new_deco, nilptr)
  -- GTK3 ignores xdg-decoration but honours KDE's older protocol: server
  -- side there too, so it draws no title bar of its own (the panel is the frame)
  local kde_deco = wlr_server_decoration_manager_create(wc.display)
  if kde_deco ~= nilptr then wlr_server_decoration_manager_set_default_mode(kde_deco, WLR_SERVER_DECORATION_MANAGER_MODE_SERVER) end
  do
    local e = os.getenv('GHOSTTY_WAYLAND_SCALE') -- one digit, 1 to 4
    wc.scale = (#e == 1 and e:byte(1) >= 0x31 and e:byte(1) <= 0x34) and (e:byte(1) - 0x30) or 2
    e:destroy()
  end

  local layout = #opt_layout > 0 and opt_layout or os.getenv('GHOSTTY_XKB_LAYOUT')
  wc.xkb_ctx, wc.keymap = wayland_keymap(layout)
  if wc.keymap == nilptr then return false, 'cannot compile an xkb keymap (is xkeyboard-config installed?)' end
  kb_impl.name = 'ghostty-agent'
  wlr_keyboard_init(&keyboard, &kb_impl, 'ghostty-agent keyboard')
  wlr_keyboard_set_keymap(&keyboard, wc.keymap)
  wc.seat = wlr_seat_create(wc.display, 'seat0')
  wlr_seat_set_capabilities(wc.seat, WL_SEAT_CAPABILITY_POINTER | WL_SEAT_CAPABILITY_KEYBOARD)
  wlr_seat_set_keyboard(wc.seat, &keyboard)
  hook(&wc.on_req_sel, &wc.seat.events.request_set_selection, on_request_selection, nilptr)
  hook(&wc.on_req_psel, &wc.seat.events.request_set_primary_selection, on_request_primary, nilptr)
  hook(&wc.on_set_sel, &wc.seat.events.set_selection, on_set_selection, nilptr)
  do
    local tim = wlr_text_input_manager_v3_create(wc.display)
    if tim ~= nilptr then hook(&wc.on_new_ti, &tim.events.new_text_input, on_new_ti, nilptr) end
  end

  -- a fixed name first, so apps and scripts can find it; the next free one after
  local want = #opt_socket > 0 and opt_socket or os.getenv('GHOSTTY_WAYLAND_SOCKET')
  if #want > 0 then
    if wl_display_add_socket(wc.display, (@cstring)(want.data)) ~= 0 then return false, 'the Wayland socket name is taken' end
    wc.socket = string.copy(want)
  else
    for n = 0, 9 do
      local name = 'ffxiv-' .. tostring(n) -- easy to type: WAYLAND_DISPLAY=ffxiv-0 app
      if wl_display_add_socket(wc.display, (@cstring)(name.data)) == 0 then wc.socket = name break end
      name:destroy()
    end
    if #wc.socket == 0 then
      local auto = wl_display_add_socket_auto(wc.display)
      if auto == nilptr then return false, 'cannot add a Wayland socket' end
      wc.socket = string.copy((@string)(auto))
    end
  end
  if not wlr_backend_start(wc.backend) then return false, 'cannot start the headless backend' end
  wc.next_id = 1
  wc.instance = string.format('%x', ((@int64)(os.time()) << 20) ~ (@int64)(getpid()))
  wc.started = true
  log('compositor on WAYLAND_DISPLAY=' .. wc.socket .. ' (' .. wc.runtime_dir .. ')')
  setup_link_env()
  proxy_install()
  start_xwayland()
  return true, ''
end

-- The backend; the compositor starts on the first call. False and a literal
-- why when it cannot.
global function capture_wayland_backend(): (boolean, CaptureBackend, string)
  if not wc.started then
    local ok, why = start()
    if not ok then return false, (@CaptureBackend){}, why end
  end
  return true, (@CaptureBackend){
    name = 'wayland',
    list = wl_list, open = wl_open, state = wl_state, title = wl_title,
    frame = wl_frame, input = wl_input, close = wl_close,
    pump = wl_pump, poll_fds = wl_poll_fds, wait_ms = wl_wait_ms,
    apps = wl_apps, release = wl_release, list_serial = wl_list_serial, wid_of = wl_wid_of,
  }, ''
end

-- End every app we launched (their whole process groups) and the compositor.
-- For agent exit and tests; the backend cannot be used afterwards.
global function capture_wayland_shutdown(): void
  if not wc.started then return end
  for i = 0, < #wc.children do
    if not wc.children[i].done then kill(-wc.children[i].pid, SIGTERM) end
  end
  for _ = 1, 20 do
    reap_children()
    local left = false
    for i = 0, < #wc.children do if not wc.children[i].done then left = true end end
    if not left then break end
    usleep(50000)
  end
  for i = 0, < #wc.children do
    if not wc.children[i].done then
      kill(-wc.children[i].pid, SIGKILL)
      local st: cint = 0
      waitpid(wc.children[i].pid, &st, 0)
      wc.children[i].done = true
    end
  end
  if wc.xwayland ~= nilptr then
    unhook(&wc.on_x_surface) unhook(&wc.on_x_ready) unhook(&wc.on_x_start)
    wlr_xwayland_destroy(wc.xwayland) -- its surfaces go, and their hooks with them
    wc.xwayland = nilptr
    if #wc.x_link > 0 then unlink((@cstring)(wc.x_link.data)) end
    wc.x_display:destroy() wc.x_link:destroy()
  end
  wl_display_destroy_clients(wc.display) -- toplevels go, and their hooks with them
  unhook(&wc.on_new_toplevel) unhook(&wc.on_new_popup) unhook(&wc.on_new_deco)
  unhook(&wc.on_req_sel) unhook(&wc.on_req_psel) unhook(&wc.on_set_sel) unhook(&wc.on_new_ti)
  wlr_keyboard_finish(&keyboard)
  wlr_backend_destroy(wc.backend)
  if wc.stat_frames > 0 then
    log(string.format('rendered %d frames: %.2f ms composing, %.2f ms reading back a frame on average (%s)', wc.stat_frames,
      wc.stat_render * 1000.0 / wc.stat_frames, wc.stat_grab * 1000.0 / wc.stat_frames, #wc.gpu > 0 and wc.gpu or 'pixman'))
  end
  wlr_allocator_destroy(wc.allocator)
  wlr_renderer_destroy(wc.renderer)
  if wc.drm_fd >= 0 then close(wc.drm_fd) wc.drm_fd = -1 end
  wc.gpu:destroy()
  wl_display_destroy(wc.display)
  xkb_keymap_unref(wc.keymap)
  xkb_context_unref(wc.xkb_ctx)
  wc.started = false
end
