-- Raw jobs in ghostty-agent (docs/JOBS.md).
--
-- A job is a process on pipes, not a PTY: the client sends bytes to its
-- stdin and gets its stdout and stderr back tagged and untouched. Nothing
-- here looks at the bytes -- a Claude Code session in stream-json mode is
-- just line-framed JSON the client parses.
--
-- JOPEN, JDATA, JCLOSE, JSIG and JATTACH come from a client, JOPENED, JOUT
-- and JEXIT go back. A job belongs to the connection that opened it and dies
-- with it, unless JOB_FLAG_KEEP was set: those survive and are picked up
-- again with JATTACH, which replays the last JOB_REPLAY_BYTES of output the
-- way ATTACH replays a session's screen.
--
-- Flow control follows the window streams: while the owning connection's
-- output queue is over JOBS_OUTQ_HIGH the job's pipes are not read at all,
-- so the process blocks on its own writes instead of the agent growing.
--
-- Safety: a job runs as the user running the agent, with that user's full
-- access to the machine. The agent's token is the only gate, exactly as for
-- PTY sessions.
require 'string'
require 'vector'
require 'stringbuilder'
require 'core.protocol'
require 'agent.logic'
require 'agent.claude'
## if ccinfo.is_windows then
require 'agent.job_windows'
## else
require 'agent.job_posix'
## end

global JOBS_OUTQ_HIGH: usize <comptime> = 1024 * 1024       -- stop reading a job this far behind
global JOB_REPLAY_BYTES: usize <comptime> = 256 * 1024      -- what JATTACH replays
global JOB_INBUF_MAX: usize <comptime> = 8 * 1024 * 1024    -- stdin waiting for the pipe
local JOB_DRAIN_GRACE: float64 <comptime> = 2.0             -- seconds to wait for pipes after the exit
local JOB_LINGER_MAX: usize <comptime> = 16                 -- exited kept jobs held for a JATTACH

local Job = @record{
  jid: uint32,
  client: usize,            -- the owning connection
  owned: boolean,           -- false: kept and detached, waiting for a JATTACH
  keep: boolean,
  proc: AgentJobProc,
  pid: uint32,
  command: string,          -- argv joined by spaces, for the log only
  inbuf: ByteQueue,         -- stdin the pipe could not take yet
  close_in: boolean,        -- close stdin once `inbuf` is empty
  replay: ByteQueue,        -- chunks: stream u8, len u32, bytes
  exited: boolean,
  exit_at: float64,
  exit_status: int32,
  reported: boolean,        -- JEXIT went out
}

global AgentJobs = @record{
  jobs: vector(Job),
  next_jid: uint32,
  queue_of: function(ci: usize): *ByteQueue,
  log_fn: function(msg: string): void,
}

function AgentJobs:init(queue_of: function(ci: usize): *ByteQueue, log_fn: function(msg: string): void): void
  self.queue_of = queue_of
  self.log_fn = log_fn
  self.next_jid = 1
end

local function say(self: *AgentJobs, msg: string): void
  if self.log_fn ~= nilptr then self.log_fn(msg) end
end

-- Never the job's bytes: only what it is and how it ended.
local function sayf(self: *AgentJobs, fmt: string, jid: uint32, extra: string): void
  if self.log_fn == nilptr then return end
  local sb: stringbuilder
  sb:writef(fmt, jid, extra)
  local msg = sb:promote()
  self.log_fn(msg)
  msg:destroy()
end

local function find_job(self: *AgentJobs, jid: uint32): *Job
  for i = 0, < #self.jobs do
    if self.jobs[i].jid == jid then return &self.jobs[i] end
  end
  return nilptr
end

-- Only the connection that owns a job may touch it.
local function job_of(self: *AgentJobs, ci: usize, jid: uint32): *Job
  local j = find_job(self, jid)
  if j == nilptr or not j.owned or j.client ~= ci then return nilptr end
  return j
end

local function job_destroy(j: *Job): void
  j.proc:close()
  j.inbuf:destroy()
  j.replay:destroy()
  j.command:destroy()
end

local function drop(self: *AgentJobs, i: usize): void
  job_destroy(&self.jobs[i])
  self.jobs:remove(i)
end

local function send_jopened(q: *ByteQueue, req: uint32, jid: uint32, pid: uint32, text: string): void
  local hd: [12]uint8
  proto.put_u32(&hd, req)
  proto.put_u32((@*[0]uint8)(&hd[4]), jid)
  proto.put_u32((@*[0]uint8)(&hd[8]), pid)
  local fh: [5]uint8
  fh[0] = PROTO_JOPENED
  proto.put_u32((@*[0]uint8)(&fh[1]), (@uint32)(12 + text.size))
  q:push(&fh, 5)
  q:push(&hd, 12)
  if text.size > 0 then q:push((@*[0]uint8)(text.data), text.size) end
end

local function send_jout(q: *ByteQueue, jid: uint32, stream: uint8, p: *[0]uint8, n: usize): void
  local fh: [10]uint8
  fh[0] = PROTO_JOUT
  proto.put_u32((@*[0]uint8)(&fh[1]), (@uint32)(5 + n))
  proto.put_u32((@*[0]uint8)(&fh[5]), jid)
  fh[9] = stream
  q:push(&fh, 10)
  if n > 0 then q:push(p, n) end
end

local function send_jexit(q: *ByteQueue, jid: uint32, status: int32): void
  local st: [4]uint8
  proto.put_u32(&st, (@uint32)(status))
  proto.write_frame_id(q, PROTO_JEXIT, jid, &st, 4)
end

-- The replay ring holds tagged chunks; the oldest whole ones go first.
local function replay_push(j: *Job, stream: uint8, p: *[0]uint8, n: usize): void
  if n == 0 then return end
  local hd: [5]uint8
  hd[0] = stream
  proto.put_u32((@*[0]uint8)(&hd[1]), (@uint32)(n))
  j.replay:push(&hd, 5)
  j.replay:push(p, n)
  while j.replay:len() > JOB_REPLAY_BYTES and j.replay:len() >= 5 do
    local head = j.replay:peek()
    local ln = (@usize)(proto.get_u32((@*[0]uint8)(&head[1])))
    j.replay:consume(5 + ln)
  end
end

local function replay_to(j: *Job, q: *ByteQueue): void
  local total = j.replay:len()
  if total < 5 then return end
  local p = j.replay:peek()
  local off: usize = 0
  while off + 5 <= total do
    local stream = p[off]
    local ln = (@usize)(proto.get_u32((@*[0]uint8)(&p[off + 1])))
    if off + 5 + ln > total then return end
    send_jout(q, j.jid, stream, (@*[0]uint8)(&p[off + 5]), ln)
    off = off + 5 + ln
  end
end

local function queue_input(j: *Job, p: *[0]uint8, n: usize): void
  if j.inbuf:len() + n > JOB_INBUF_MAX then return end -- the job is not keeping up; the rest is dropped
  j.inbuf:push(p, n)
end

local function drain_input(j: *Job): void
  while j.inbuf:len() > 0 do
    local w = j.proc:write_in(j.inbuf:peek(), j.inbuf:len())
    if w > 0 then j.inbuf:consume((@usize)(w))
    elseif w == 0 then return -- the pipe is full
    else j.inbuf:consume(j.inbuf:len()) break end -- the job closed its stdin
  end
  if j.close_in then j.proc:close_in() j.close_in = false end
end

local function write_input(j: *Job, p: *[0]uint8, n: usize): void
  if j.inbuf:len() > 0 then queue_input(j, p, n) return end
  local off: usize = 0
  while off < n do
    local w = j.proc:write_in(&p[off], n - off)
    if w > 0 then off = off + (@usize)(w)
    elseif w == 0 then queue_input(j, &p[off], n - off) return
    else return end
  end
end

-- "@claude" as argv[0] with the options JSON as argv[1]: agent/claude.nelua
-- builds the real command line, so the client carries no flags of its own.
local function expand_argv(argv: *vector(string), cwd: *string): (boolean, string)
  if #argv == 0 or argv[0] ~= '@claude' then return true, (@string){} end
  local opts: string = ''
  if #argv > 1 then opts = argv[1] end
  local ok, built, dir, why = claude_job_argv(opts)
  if not ok then
    built:destroy()
    dir:destroy()
    return false, why
  end
  for i = 0, < #argv do argv[i]:destroy() end
  argv:clear()
  for i = 0, < #built do argv:push(built[i]) end
  built:destroy()
  cwd:destroy()
  $cwd = dir
  return true, (@string){}
end

local function handle_jopen(self: *AgentJobs, ci: usize, q: *ByteQueue, payload: *[0]uint8, len: usize): void
  if len < 5 then
    local why: string = 'bad jopen'
    local req: uint32 = 0
    if len >= 4 then req = proto.get_u32(payload) end
    send_jopened(q, req, 0, 0, why)
    return
  end
  local req = proto.get_u32(payload)
  local flags = payload[4]
  local argv, env = agent_split_nul((@*[0]uint8)(&payload[5]), len - 5)
  local cwd: string = ''
  local ok, why = expand_argv(&argv, &cwd)
  if ok and #argv == 0 then
    ok = false
    why = string.copy('no command')
  end
  local proc: AgentJobProc
  if ok then
    local sok, sproc, swhy = AgentJobProc.spawn(&argv, &env, cwd)
    proc = sproc
    if not sok then
      ok = false
      why = swhy:copy()
      swhy:destroy()
    end
  end
  local sb: stringbuilder
  for i = 0, < #argv do
    if i > 0 then sb:write(' ') end
    sb:write(argv[i])
  end
  local command = sb:promote()
  for i = 0, < #argv do argv[i]:destroy() end
  for i = 0, < #env do env[i]:destroy() end
  argv:destroy()
  env:destroy()
  cwd:destroy()
  if not ok then
    send_jopened(q, req, 0, 0, why)
    say(self, 'job open failed: ' .. why)
    why:destroy()
    command:destroy()
    return
  end
  why:destroy()
  local j: Job = {
    jid = self.next_jid, client = ci, owned = true, keep = (flags & JOB_FLAG_KEEP) ~= 0,
    proc = proc, pid = (@uint32)(proc.pid), command = command,
  }
  self.next_jid = self.next_jid + 1
  if self.next_jid == 0 then self.next_jid = 1 end
  send_jopened(q, req, j.jid, j.pid, (@string){})
  sayf(self, 'job %d started: %s', j.jid, j.command)
  self.jobs:push(j)
end

-- A job frame from connection `ci` (answers go to `q`). False: not a job frame.
function AgentJobs:handle(ci: usize, q: *ByteQueue, typ: uint8, payload: *[0]uint8, len: usize): boolean
  if typ == PROTO_JOPEN then
    handle_jopen(self, ci, q, payload, len)
  elseif typ == PROTO_JDATA then
    if len < 4 then return true end
    local j = job_of(self, ci, proto.get_u32(payload))
    if j == nilptr or j.exited then return true end
    if len == 4 then
      -- no bytes: the job sees EOF on its stdin (a Claude turn stream ends this way)
      if j.inbuf:len() > 0 then j.close_in = true else j.proc:close_in() end
    else
      write_input(j, (@*[0]uint8)(&payload[4]), len - 4)
    end
  elseif typ == PROTO_JCLOSE then
    if len < 4 then return true end
    local j = job_of(self, ci, proto.get_u32(payload))
    if j == nilptr then return true end
    j.keep = false -- an explicit close ends it for good
    if not j.exited then j.proc:kill() end
  elseif typ == PROTO_JSIG then
    if len < 5 then return true end
    local j = job_of(self, ci, proto.get_u32(payload))
    if j == nilptr or j.exited then return true end
    j.proc:signal((@cint)(payload[4]))
  elseif typ == PROTO_JATTACH then
    if len < 4 then return true end
    local jid = proto.get_u32(payload)
    local j = find_job(self, jid)
    if j == nilptr or (j.owned and j.client ~= ci) then
      send_jexit(q, jid, -1) -- JOB_NO_JOB on the wire
      return true
    end
    local fresh = not j.owned
    j.owned = true
    j.client = ci
    if fresh then replay_to(j, q) end
  else
    return false
  end
  return true
end

-- Once per main loop turn: move stdin, read what the jobs wrote, reap them.
function AgentJobs:pump(now: float64): void
  local buf: [32768]uint8
  local i: usize = 0
  while i < #self.jobs do
    local j = &self.jobs[i]
    local q: *ByteQueue = nilptr
    if j.owned and self.queue_of ~= nilptr then q = self.queue_of(j.client) end
    drain_input(j)
    if q == nilptr or q:len() <= JOBS_OUTQ_HIGH then
      for _ = 1, 16 do
        local n = j.proc:read_out(&buf, 32768)
        if n > 0 then
          replay_push(j, JOB_OUT, &buf, (@usize)(n))
          if q ~= nilptr then send_jout(q, j.jid, JOB_OUT, &buf, (@usize)(n)) end
        elseif n == 0 then break
        else j.proc:out_done() break end
      end
      for _ = 1, 16 do
        local n = j.proc:read_err(&buf, 32768)
        if n > 0 then
          replay_push(j, JOB_ERR, &buf, (@usize)(n))
          if q ~= nilptr then send_jout(q, j.jid, JOB_ERR, &buf, (@usize)(n)) end
        elseif n == 0 then break
        else j.proc:err_done() break end
      end
    end
    if not j.exited then
      local done, status = j.proc:poll_exit()
      if done then
        j.exited = true
        j.exit_status = status
        j.exit_at = now
      end
    elseif now - j.exit_at > JOB_DRAIN_GRACE then
      -- something the job started still holds its pipes: stop waiting for them
      j.proc:out_done()
      j.proc:err_done()
    end
    -- JEXIT only after both pipes reached EOF: no output is lost behind it
    if j.exited and j.proc.out_fd < 0 and j.proc.err_fd < 0 and not j.reported then
      if q ~= nilptr then
        send_jexit(q, j.jid, j.exit_status)
        j.reported = true
        sayf(self, 'job %d exited (%s)', j.jid, j.command)
      elseif not j.keep then
        j.reported = true
      end
    end
    if j.reported then drop(self, i) continue end
    i = i + 1
  end
  -- exited jobs kept for a JATTACH that may never come: only the newest stay
  local lingering: usize = 0
  local k: integer = #self.jobs - 1
  while k >= 0 do
    local j = &self.jobs[k]
    if j.exited and not j.owned then
      lingering = lingering + 1
      if lingering > JOB_LINGER_MAX then drop(self, (@usize)(k)) end
    end
    k = k - 1
  end
end

-- POSIX: the pipes to wake on. Jobs held back by flow control are left out,
-- so a client that stopped reading does not spin the loop.
function AgentJobs:poll_fds(fds: *[0]cint, max: integer): integer
  local n: integer = 0
  for i = 0, < #self.jobs do
    local j = &self.jobs[i]
    local q: *ByteQueue = nilptr
    if j.owned and self.queue_of ~= nilptr then q = self.queue_of(j.client) end
    if q ~= nilptr and q:len() > JOBS_OUTQ_HIGH then continue end
    if j.proc.out_fd >= 0 and n < max then fds[n] = j.proc.out_fd n = n + 1 end
    if j.proc.err_fd >= 0 and n < max then fds[n] = j.proc.err_fd n = n + 1 end
  end
  return n
end

-- The longest the main loop may sleep (ms), -1 for no limit: a job with
-- stdin still waiting for its pipe, or one whose pipes are outliving it,
-- wants to be looked at again soon.
function AgentJobs:wait_ms(): integer
  for i = 0, < #self.jobs do
    local j = &self.jobs[i]
    if j.inbuf:len() > 0 or (j.exited and (j.proc.out_fd >= 0 or j.proc.err_fd >= 0)) then return 5 end
  end
  return -1
end

-- Connection `ci` is going away: its jobs end with it unless they are kept,
-- and the jobs of the connections after it are renumbered (the agent's
-- client vector closes the gap).
function AgentJobs:client_gone(ci: usize): void
  local i: integer = #self.jobs - 1
  while i >= 0 do
    local j = &self.jobs[i]
    if j.client == ci and j.owned then
      if j.keep then
        j.owned = false -- it keeps running; its output goes to the replay ring
        sayf(self, 'job %d kept without a client (%s)', j.jid, j.command)
      else
        drop(self, (@usize)(i))
      end
    elseif j.client > ci then
      j.client = j.client - 1
    end
    i = i - 1
  end
end

-- The agent is stopping: nothing is left running behind it.
function AgentJobs:shutdown(): void
  for i = 0, < #self.jobs do job_destroy(&self.jobs[i]) end
  self.jobs:destroy()
end
