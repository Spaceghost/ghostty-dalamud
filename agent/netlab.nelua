-- Netlab in ghostty-agent (docs/NETLAB.md): a window published as a moq
-- broadcast over iroh, subscribers to it, and what both look like, for the
-- in-game panel.
--
-- The main node is one iroh endpoint serving one moq origin (agent/moqi.nelua,
-- vendor/moq-iroh). A publisher reads a capture backend (agent/capture.nelua)
-- exactly as a window stream does: downscale, tile diff, QOI (core/wincodec.nelua)
-- into WFRAME frames. Each picture is one moq object; a KEY picture starts a
-- group (every `group_ms`, and on a size change), so a subscriber that joins
-- late or loses a group starts again at the next key frame.
--
-- Each subscription gets a node of its own (its own endpoint id and UDP
-- socket), so a subscriber in this same agent is a real iroh peer of the main
-- node, and one on another machine is the same thing with a ticket carried
-- over. What a subscription receives goes to `sink` (the agent sends it to the
-- connection viewing it, docs/NETLAB.md NLFRAME).
--
-- Without -D NETLAB (no vendor/moq-iroh) every call answers "netlab not built".
require 'vector'
require 'string'
require 'stringbuilder'
require 'memory'
require 'math'
require 'os'
require 'core.protocol'
require 'core.wincodec'
require 'core.netlab_wire'
require 'agent.capture'
require 'agent.moqi'

global NETLAB_BUILT: boolean <comptime> = #[NETLAB and true or false]#
global NETLAB_NOT_BUILT: string <comptime> = 'netlab not built (this agent has no vendor/moq-iroh; see docs/NETLAB.md)'
global NETLAB_TRACK: string <comptime> = 'frames'

-- One object as a subscription hands it over (moqi_object, without the library).
global NetlabObject = @record{
  group: uint64,
  index: uint64,
  sent_us: uint64,
  recv_us: uint64,
  flags: uint32,
}
global NETLAB_OBJ_GROUP_START: uint32 <comptime> = 1
global NETLAB_OBJ_GAP: uint32 <comptime> = 2

local NetlabNode = @record{
  h: int32,
  role: string,  -- 'main' or 'viewer'
  name: string,
}

global NetlabPub = @record{
  h: int32,               -- moqi publisher
  name: string,           -- the broadcast
  source: string,         -- what the capture backend was asked for
  cap: pointer,           -- the capture handle; nilptr once it ended
  why: string,            -- why it ended
  interval: float64,      -- seconds between pictures
  group_s: float64,       -- seconds between key frames (groups)
  due: float64,
  group_at: float64,      -- when the current group started
  serial: uint64,
  max_w: integer, max_h: integer,
  pw: integer, ph: integer,
  prev: vector(uint8), scaled: vector(uint8), rects: vector(WinRect),
  scratch: vector(uint8), body: vector(uint8), q: ByteQueue,
  seq: uint32,
  group: int32,           -- the group the last object went into
  objects: uint64, groups: uint64, bytes: uint64,
  fps_n: integer, fps_at: float64, fps: float64,
}

global NetlabSub = @record{
  id: uint32,             -- the moqi subscription handle, as the protocol names it
  node: int32,            -- its own node
  name: string,           -- the broadcast
  ticket: string,
  view: integer,          -- the connection its objects go to, -1 for none
  slow_ms: uint32,
  need_group: boolean,    -- dropping until a group start (the viewer fell behind)
  delivered: uint64,
  dropped: uint64,        -- objects not handed to the viewer
  ended: boolean,
  why: string,
}

global NetlabSink = @function(ctx: pointer, sub: *NetlabSub, o: *NetlabObject, data: *[0]uint8, len: usize): boolean

-- A connection that asked for NLSTAT every `every` seconds.
local NetlabWatch = @record{ client: integer, every: float64, due: float64 }

-- `demo`: publish, then two local subscriptions once the main node can be
-- dialed through its relay (so the connection starts relayed and goes
-- direct in view), or at once with no relay.
local NetlabDemo = @record{
  pending: boolean,
  client: integer,    -- the connection that asked: it views the fast one
  req: uint32,
  give_up: float64,   -- subscribe without waiting for the relay after this
  fast: uint32, slow: uint32,
  slow_ms: uint32,
  age_ms: uint32,
}

global AgentNetlab = @record{
  started: boolean,
  main: int32,
  relay: string,
  port: uint16,
  key_path: string,       -- the main node's secret key file ('' : a new id every start)
  backend_ok: boolean,
  backend: CaptureBackend,
  nodes: vector(NetlabNode),
  pubs: vector(NetlabPub),
  subs: vector(NetlabSub),
  buf: vector(uint8),
  -- where a subscription's objects go: true when taken, false to count them dropped
  sink: NetlabSink,
  sink_ctx: pointer,
  log_fn: function(msg: string): void,
  t0: float64,
  -- the protocol side (docs/NETLAB.md): connections' output queues, who gets
  -- NLSTAT how often, and a demo waiting for the main node's relay
  queue_of: function(ci: usize): *ByteQueue,
  watchers: vector(NetlabWatch),
  demo: NetlabDemo,
}

local NETLAB_OBJECT_MAX: usize <comptime> = 8 * 1024 * 1024

-- A log line from pieces (strings and integers): built here and freed after
-- the log takes it, since `say(self, 'a ' .. b)` would leak the concatenation.
local function say(self: *AgentNetlab, ...: varargs): void
  if self.log_fn == nilptr then return end
  local sb: stringbuilder
  sb:write('netlab: ', ...)
  local line = sb:promote()
  self.log_fn(line)
  line:destroy()
end

-- moq_iroh's reason for the last failure on this thread.
local function last_error(): string
  ## if NETLAB then
  local b: [512]cchar
  moqi_last_error((@cstring)(&b), 512)
  return string.copy((@cstring)(&b))
  ## else
  return string.copy(NETLAB_NOT_BUILT)
  ## end
end

function AgentNetlab:init(backend_ok: boolean, backend: CaptureBackend, key_path: string, log_fn: function(msg: string): void): void
  self.backend_ok, self.backend = backend_ok, backend
  self.key_path = key_path:copy()
  self.log_fn = log_fn
  self.main = 0
  self.t0 = os.now()
end

-- A node of our own; its handle, or 0 and why.
local function new_node(self: *AgentNetlab, role: string, name: string, key_path: string): (int32, string)
  ## if NETLAB then
  local relay = self.relay:copy()
  defer relay:destroy() end
  local key = key_path:copy()
  defer key:destroy() end
  local cfg: moqi_node_config = {
    secret_path = #key > 0 and (@cstring)(key.data) or nilptr,
    relay = (@cstring)(relay.data),
    port = role == 'main' and self.port or 0,
  }
  local h = moqi_node_new(&cfg)
  if h <= 0 then return 0, last_error() end
  self.nodes:push(NetlabNode{ h = h, role = role:copy(), name = name:copy() })
  return h, ''
  ## else
  return 0, string.copy(NETLAB_NOT_BUILT)
  ## end
end

local function close_node(self: *AgentNetlab, h: int32): void
  for i = 0, < #self.nodes do
    if self.nodes[i].h == h then
      ## if NETLAB then
      moqi_node_close(h)
      ## end
      self.nodes[i].role:destroy()
      self.nodes[i].name:destroy()
      self.nodes:remove(i)
      return
    end
  end
end

-- Bind the main node. `relay`: 'default', 'off' or a relay URL.
function AgentNetlab:start(relay: string, port: uint16): (boolean, string)
  if not NETLAB_BUILT then return false, string.copy(NETLAB_NOT_BUILT) end
  if self.started then return true, '' end
  self.relay:destroy()
  self.relay = #relay > 0 and relay:copy() or string.copy('default')
  self.port = port
  local h, why = new_node(self, 'main', 'main', self.key_path)
  if h == 0 then return false, why end
  self.main = h
  self.started = true
  say(self, 'started (relay ', self.relay, ')')
  return true, ''
end

-- The main node's ticket ('' before start).
function AgentNetlab:ticket(): string
  ## if NETLAB then
  if not self.started then return (@string){} end
  local b: [2048]cchar
  if moqi_node_ticket(self.main, (@cstring)(&b), 2048) <= 0 then return (@string){} end
  return string.copy((@cstring)(&b))
  ## else
  return (@string){}
  ## end
end

local function pub_destroy(p: *NetlabPub): void
  p.name:destroy() p.source:destroy() p.why:destroy()
  p.prev:destroy() p.scaled:destroy() p.rects:destroy() p.scratch:destroy() p.body:destroy() p.q:destroy()
end

local function find_pub(self: *AgentNetlab, name: string): integer
  for i = 0, < #self.pubs do
    if self.pubs[i].name == name then return i end
  end
  return -1
end

-- Publish the window `source` names (the capture backend's match text: a
-- title, `run:CMD` on Linux, '' for the first) as broadcast `name`.
function AgentNetlab:publish(name: string, source: string, fps: integer, max_w: integer, max_h: integer, group_ms: integer): (boolean, string)
  if not NETLAB_BUILT then return false, string.copy(NETLAB_NOT_BUILT) end
  if not self.backend_ok then return false, string.copy('no window capture in this agent (--windows)') end
  if #name == 0 then return false, string.copy('a broadcast needs a name') end
  if find_pub(self, name) >= 0 then return false, 'already publishing ' .. name end
  if not self.started then
    local ok, why = self:start('default', 0)
    if not ok then return false, why end
  end
  local cap, cwhy = self.backend.open(0, source)
  if cap == nilptr then
    local msg = 'capture: ' .. (#cwhy > 0 and cwhy or 'open failed')
    cwhy:destroy()
    return false, msg
  end
  cwhy:destroy()
  ## if NETLAB then
  local cname = name:copy()
  defer cname:destroy() end
  local h = moqi_publish(self.main, (@cstring)(cname.data), NETLAB_TRACK)
  if h <= 0 then
    self.backend.close(cap)
    return false, last_error()
  end
  if fps <= 0 then fps = 30 end
  if group_ms <= 0 then group_ms = 1000 end
  self.pubs:push(NetlabPub{
    h = h, name = name:copy(), source = source:copy(), cap = cap,
    interval = 1.0 / math.clamp(fps, 1, 60), group_s = group_ms / 1000.0,
    max_w = max_w > 0 and max_w or 1280, max_h = max_h > 0 and max_h or 720,
    group = -1, fps_at = os.now(),
  })
  say(self, 'publishing ', name, ' from ', #source > 0 and source or '(first window)')
  return true, ''
  ## else
  return false, string.copy(NETLAB_NOT_BUILT)
  ## end
end

local function pub_close(self: *AgentNetlab, i: integer): void
  local p = &self.pubs[i]
  ## if NETLAB then
  moqi_publish_close(p.h)
  ## end
  if p.cap ~= nilptr then self.backend.close(p.cap) end
  pub_destroy(p)
  self.pubs:remove(i)
end

function AgentNetlab:unpublish(name: string): boolean
  local i = find_pub(self, name)
  if i < 0 then return false end
  pub_close(self, i)
  return true
end

-- Subscribe to broadcast `name` of the node a ticket names, from a new node
-- of our own. `max_age_ms`: moq skips groups further behind than that.
-- The subscription's id, or 0 and why.
function AgentNetlab:subscribe(ticket: string, name: string, max_age_ms: uint32, slow_ms: uint32, view: integer): (uint32, string)
  if not NETLAB_BUILT then return 0, string.copy(NETLAB_NOT_BUILT) end
  if #ticket == 0 or #name == 0 then return 0, string.copy('subscribe needs a ticket and a broadcast name') end
  if not self.started then
    local ok, why = self:start('default', 0)
    if not ok then return 0, why end
  end
  ## if NETLAB then
  local label: string
  do
    local sb: stringbuilder
    sb:writef('viewer %d', #self.subs + 1)
    label = sb:promote()
  end
  defer label:destroy() end
  local node, why = new_node(self, 'viewer', label, '')
  if node == 0 then return 0, why end
  local t, n = ticket:copy(), name:copy()
  defer t:destroy() n:destroy() end
  local h = moqi_subscribe(node, (@cstring)(t.data), (@cstring)(n.data), NETLAB_TRACK, max_age_ms)
  if h <= 0 then
    local err = last_error()
    close_node(self, node)
    return 0, err
  end
  if slow_ms > 0 then moqi_subscribe_throttle(h, slow_ms) end
  self.subs:push(NetlabSub{
    id = (@uint32)(h), node = node, name = name:copy(), ticket = ticket:copy(),
    view = view, slow_ms = slow_ms, need_group = true,
  })
  say(self, 'subscribed ', h, ' to ', name)
  return (@uint32)(h), ''
  ## else
  return 0, string.copy(NETLAB_NOT_BUILT)
  ## end
end

global function netlab_find_sub(self: *AgentNetlab, id: uint32): *NetlabSub
  for i = 0, < #self.subs do
    if self.subs[i].id == id then return &self.subs[i] end
  end
  return nilptr
end

function AgentNetlab:throttle(id: uint32, ms: uint32): boolean
  local s = netlab_find_sub(self, id)
  if s == nilptr then return false end
  s.slow_ms = ms
  ## if NETLAB then
  moqi_subscribe_throttle((@int32)(id), ms)
  ## end
  return true
end

function AgentNetlab:unsubscribe(id: uint32): boolean
  for i = 0, < #self.subs do
    local s = &self.subs[i]
    if s.id == id then
      ## if NETLAB then
      moqi_subscribe_close((@int32)(id))
      ## end
      close_node(self, s.node)
      s.name:destroy() s.ticket:destroy() s.why:destroy()
      self.subs:remove(i)
      return true
    end
  end
  return false
end

-- Everything ends; the main node too.
function AgentNetlab:stop(): void
  while #self.pubs > 0 do pub_close(self, #self.pubs - 1) end
  while #self.subs > 0 do self:unsubscribe(self.subs[#self.subs - 1].id) end
  while #self.nodes > 0 do close_node(self, self.nodes[#self.nodes - 1].h) end
  self.main = 0
  self.started = false
end

function AgentNetlab:destroy(): void
  self:stop()
  self.nodes:destroy() self.pubs:destroy() self.subs:destroy() self.buf:destroy()
  self.relay:destroy() self.key_path:destroy() self.watchers:destroy()
end

-- A connection went (agent/agent.nelua's reap): it views nothing any more,
-- and the connections after it move down one.
function AgentNetlab:client_gone(ci: usize): void
  local c = (@integer)(ci)
  for i = 0, < #self.subs do
    local s = &self.subs[i]
    if s.view == c then s.view = -1
    elseif s.view > c then s.view = s.view - 1 end
  end
  local w: integer = #self.watchers - 1
  while w >= 0 do
    if self.watchers[w].client == c then self.watchers:remove(w)
    elseif self.watchers[w].client > c then self.watchers[w].client = self.watchers[w].client - 1 end
    w = w - 1
  end
  if self.demo.pending and self.demo.client == c then self.demo.client = -1
  elseif self.demo.client > c then self.demo.client = self.demo.client - 1 end
end

-- One picture of publisher `p`, if one is due and anything changed.
local function pub_frame(self: *AgentNetlab, p: *NetlabPub, now: float64): void
  if p.cap == nilptr or now < p.due then return end
  p.due = now + p.interval
  local st, why = self.backend.state(p.cap)
  if st == CAPTURE_ENDED then
    p.why:destroy()
    p.why = #why > 0 and why:copy() or string.copy('the window closed')
    self.backend.close(p.cap)
    p.cap = nilptr
    say(self, p.name, ' ended: ', p.why)
    return
  end
  if st ~= CAPTURE_LIVE then return end
  local fr: CaptureFrame
  if not self.backend.frame(p.cap, &fr) or fr.serial == 0 then return end
  local f, w, h = wincodec_downscale(fr.pixels, fr.stride, fr.w, fr.h, p.max_w, p.max_h, &p.scaled)
  local src, stride = fr.pixels, fr.stride
  if f > 1 then src, stride = (@*[0]uint8)(&p.scaled[0]), (@usize)(w * 4) end
  -- a key frame starts a group: the first, a new size, or the group is old enough
  local key = w ~= p.pw or h ~= p.ph or p.group < 0 or now - p.group_at >= p.group_s
  if not key and fr.serial == p.serial then return end
  p.serial = fr.serial
  if key then
    wincodec_diff(nilptr, 0, src, stride, w, h, &p.rects)
  else
    wincodec_diff((@*[0]uint8)(&p.prev[0]), (@usize)(w * 4), src, stride, w, h, &p.rects)
    if #p.rects == 0 then return end
  end
  p.seq = p.seq + 1
  p.q:consume(p.q:len())
  wincodec_write_frames(&p.q, 0, p.seq, src, stride, w, h, key, &p.rects, &p.scratch, &p.body)
  ## if NETLAB then
  local g = moqi_publish_object(p.h, p.q:peek(), p.q:len(), key)
  if g < 0 then
    local err = last_error()
    say(self, p.name, ': ', err)
    err:destroy()
    return
  end
  p.group = g
  ## end
  p.objects = p.objects + 1
  p.bytes = p.bytes + p.q:len()
  if key then
    p.groups = p.groups + 1
    p.group_at = now
  end
  -- keep what subscribers now have, for the next diff
  local row = (@usize)(w * 4)
  if key then
    p.prev:resize(row * (@usize)(h))
    for y = 0, < h do memory.copy(&p.prev[(@usize)(y) * row], &src[(@usize)(y) * stride], row) end
    p.pw, p.ph = w, h
  else
    for k = 0, < #p.rects do
      local r = p.rects[k]
      for y = (@integer)(r.y), < (@integer)(r.y) + (@integer)(r.h) do
        memory.copy(&p.prev[(@usize)(y) * row + (@usize)(r.x) * 4], &src[(@usize)(y) * stride + (@usize)(r.x) * 4], (@usize)(r.w) * 4)
      end
    end
  end
  p.fps_n = p.fps_n + 1
  if now - p.fps_at >= 1 then
    p.fps = (@float64)(p.fps_n) / (now - p.fps_at)
    p.fps_n, p.fps_at = 0, now
  end
end

-- Hand what a subscription received to its viewer. A viewer that did not
-- take an object (it is behind) gets nothing more until a group start.
local function sub_drain(self: *AgentNetlab, s: *NetlabSub): void
  ## if NETLAB then
  if s.ended then return end
  if #self.buf < 65536 then self.buf:resize(65536) end
  while true do
    local o: moqi_object
    local r = moqi_read((@int32)(s.id), &o, (@*[0]uint8)(&self.buf[0]), #self.buf)
    if r == MOQI_ERR_SMALL and o.len <= NETLAB_OBJECT_MAX then
      self.buf:resize((@usize)(o.len))
      r = moqi_read((@int32)(s.id), &o, (@*[0]uint8)(&self.buf[0]), #self.buf)
    end
    if r == 0 then return end
    if r < 0 then
      s.ended = true
      s.why:destroy()
      s.why = last_error()
      say(self, 'subscription ', s.id, ' ', s.why)
      return
    end
    local ob: NetlabObject = { group = o.group, index = o.index, sent_us = o.sent_us, recv_us = o.recv_us, flags = (@uint32)(o.flags) }
    local start = (ob.flags & NETLAB_OBJ_GROUP_START) ~= 0
    if (ob.flags & NETLAB_OBJ_GAP) ~= 0 and not start then s.need_group = true end
    if start then s.need_group = false end
    local taken = false
    if not s.need_group and self.sink ~= nilptr then
      taken = self.sink(self.sink_ctx, s, &ob, (@*[0]uint8)(&self.buf[0]), (@usize)(o.len))
    end
    if taken then
      s.delivered = s.delivered + 1
    else
      s.dropped = s.dropped + 1
      if s.view >= 0 then s.need_group = true end
    end
  end
  ## end
end

-- The descriptor that wakes the loop when a subscription has something, -1 for none.
function AgentNetlab:wake_fd(): cint
  ## if NETLAB then
  if self.started then return moqi_wake_fd() end
  ## end
  return -1
end

local function json_str(sb: *stringbuilder, s: string): void
  sb:writebyte('"'_b)
  for i = 0, < s.size do
    local c = s.data[i]
    if c == '"'_b or c == '\\'_b then sb:writebyte('\\'_b) sb:writebyte(c)
    elseif c < 0x20 then sb:writef('\\u%04x', c)
    else sb:writebyte(c) end
  end
  sb:writebyte('"'_b)
end

-- A node's moq_iroh stats (JSON) into sb, or null.
local function node_stats(sb: *stringbuilder, h: int32): void
  ## if NETLAB then
  local need = moqi_stats(h, nilptr, 0)
  if need == MOQI_ERR_SMALL then
    local cap: usize = 65536
    while true do
      local b = (@*[0]cchar)(default_allocator:alloc(cap))
      if b == nilptr then break end
      local n = moqi_stats(h, (@cstring)(b), cap)
      if n > 0 then
        sb:write(string{data=(@*[0]byte)(b), size=(@usize)(n)})
        default_allocator:dealloc(b)
        return
      end
      default_allocator:dealloc(b)
      if n ~= MOQI_ERR_SMALL or cap >= 16 * 1024 * 1024 then break end
      cap = cap * 4
    end
  end
  ## end
  sb:write('null')
end

-- What the panel draws, as JSON (docs/NETLAB.md NLSTAT).
function AgentNetlab:stats_json(now: float64): string
  local sb: stringbuilder
  sb:writef('{"t_ms":%d,"built":%s,"started":%s,"backend":',
    (@int64)((now - self.t0) * 1000), NETLAB_BUILT and 'true' or 'false', self.started and 'true' or 'false')
  json_str(&sb, self.backend_ok and self.backend.name or '')
  sb:write(',"relay":') json_str(&sb, self.relay)
  sb:write(',"nodes":[')
  for i = 0, < #self.nodes do
    local n = &self.nodes[i]
    if i > 0 then sb:writebyte(','_b) end
    sb:write('{"role":') json_str(&sb, n.role)
    sb:write(',"name":') json_str(&sb, n.name)
    sb:writef(',"h":%d,"stats":', (@integer)(n.h))
    node_stats(&sb, n.h)
    sb:writebyte('}'_b)
  end
  sb:write('],"pubs":[')
  for i = 0, < #self.pubs do
    local p = &self.pubs[i]
    if i > 0 then sb:writebyte(','_b) end
    sb:write('{"name":') json_str(&sb, p.name)
    sb:write(',"source":') json_str(&sb, p.source)
    -- every number as an integer (fps in tenths): each other type writef
    -- takes is one more instance of its formatter in the agent
    local fps10 = (@integer)(p.fps * 10 + 0.5)
    sb:writef(',"h":%d,"live":%s,"w":%d,"h_px":%d,"fps":%d.%d,"objects":%d,"groups":%d,"bytes":%d,"group":%d,"group_ms":%d,"why":',
      (@integer)(p.h), p.cap ~= nilptr and 'true' or 'false', p.pw, p.ph, fps10 // 10, fps10 % 10,
      (@integer)(p.objects), (@integer)(p.groups), (@integer)(p.bytes), (@integer)(p.group), (@integer)(p.group_s * 1000))
    json_str(&sb, p.why)
    sb:writebyte('}'_b)
  end
  sb:write('],"subs":[')
  for i = 0, < #self.subs do
    local s = &self.subs[i]
    if i > 0 then sb:writebyte(','_b) end
    sb:writef('{"id":%d,"node":%d,"name":', s.id, (@integer)(s.node))
    json_str(&sb, s.name)
    sb:writef(',"viewed":%s,"slow_ms":%d,"delivered":%d,"dropped":%d,"ended":%s,"why":',
      s.view >= 0 and 'true' or 'false', s.slow_ms, (@integer)(s.delivered), (@integer)(s.dropped), s.ended and 'true' or 'false')
    json_str(&sb, s.why)
    sb:writebyte('}'_b)
  end
  sb:writef('],"demo":{"pending":%s,"fast":%d,"slow":%d}}', self.demo.pending and 'true' or 'false', self.demo.fast, self.demo.slow)
  return sb:promote()
end

-- The protocol (docs/NETLAB.md) -------------------------------------------------------

local NETLAB_OUTQ_MAX: usize <comptime> = 4 * 1024 * 1024 -- a viewer this far behind gets no more frames until a group start
local NETLAB_STATQ_MAX: usize <comptime> = 1024 * 1024   -- nor NLSTAT, this far behind

-- The sink the agent uses: a subscription's objects to the connection viewing
-- it, as NLFRAME, unless that connection is behind.
global function netlab_frame_sink(ctx: pointer, s: *NetlabSub, o: *NetlabObject, data: *[0]uint8, len: usize): boolean
  local self = (@*AgentNetlab)(ctx)
  if s.view < 0 or self.queue_of == nilptr then return false end
  local q = self.queue_of((@usize)(s.view))
  if q == nilptr or q:len() > NETLAB_OUTQ_MAX then return false end
  local flags: uint8 = 0
  if (o.flags & NETLAB_OBJ_GROUP_START) ~= 0 then flags = flags | NETLAB_FLAG_GROUP_START end
  if (o.flags & NETLAB_OBJ_GAP) ~= 0 then flags = flags | NETLAB_FLAG_GAP end
  local lat = o.recv_us > o.sent_us and o.recv_us - o.sent_us or 0
  netlab_wire.write_frame_head(q, NetlabFrameHead{
    sub = s.id, group = o.group, index = (@uint32)(o.index), flags = flags,
    lat_us = (@uint32)(math.min(lat, 0xffffffff)),
  }, len)
  q:push(data, len)
  return true
end

-- A command's words; `window=` takes the rest of the line (titles have spaces).
local function words(cmd: string): vector(string)
  local out: vector(string)
  local i: usize = 0
  while i < cmd.size do
    while i < cmd.size and (cmd.data[i] == ' '_b or cmd.data[i] == '\t'_b) do i = i + 1 end
    if i >= cmd.size then break end
    local j = i
    local rest = cmd.size - i > 7 and cmd:subview(i + 1, i + 7) == 'window='
    if rest then j = cmd.size
    else
      while j < cmd.size and cmd.data[j] ~= ' '_b and cmd.data[j] ~= '\t'_b do j = j + 1 end
    end
    out:push(string{data=(@*[0]byte)(&cmd.data[i]), size=j - i})
    i = j
  end
  return out
end

-- The value of `key=` among the words from `from` on ('' when absent).
local function opt(w: vector(string), from: integer, key: string): string
  for i = from, < #w do
    local s = w[i]
    if #s > #key and s:subview(1, #key) == key and s.data[#key] == '='_b then return s:subview(#key + 2) end
  end
  return (@string){}
end

local function has_word(w: vector(string), from: integer, word: string): boolean
  for i = from, < #w do
    if w[i] == word then return true end
  end
  return false
end

local function num(s: string, default: integer): integer
  if #s == 0 then return default end
  local v: integer = 0
  for i = 0, < s.size do
    local c = s.data[i]
    if c < '0'_b or c > '9'_b then return default end
    v = v * 10 + (c - '0'_b)
    if v > 100000000 then return default end
  end
  return v
end

-- The ticket without its direct addresses: dialed that way a connection
-- starts on the relay, and iroh finds the direct path in view.
local function relay_only(t: string): string
  local q = t:find('?', 1, true)
  if q <= 0 then return t:copy() end
  local sb: stringbuilder
  sb:write(t:subview(1, q - 1))
  local sep = '?'
  local i = q + 1
  while i <= #t do
    local amp = t:find('&', i, true)
    local e = amp > 0 and amp - 1 or #t
    local part = t:subview(i, e)
    if #part > 6 and part:subview(1, 6) == 'relay=' then
      sb:write(sep) sb:write(part)
      sep = '&'
    end
    i = e + 2
  end
  return sb:promote()
end

local function watch(self: *AgentNetlab, ci: integer, ms: integer): void
  for i = 0, < #self.watchers do
    if self.watchers[i].client == ci then
      if ms <= 0 then self.watchers:remove(i) return end
      self.watchers[i].every = (@float64)(ms) / 1000.0
      self.watchers[i].due = 0
      return
    end
  end
  if ms > 0 then self.watchers:push(NetlabWatch{ client = ci, every = (@float64)(math.max(ms, 20)) / 1000.0 }) end
end

-- The demo's two subscriptions, once the main node's ticket names its relay
-- (or at once without one, or when waiting has gone on long enough).
local function demo_step(self: *AgentNetlab, now: float64): void
  local d = &self.demo
  if not d.pending then return end
  local t = self:ticket()
  defer t:destroy() end
  local via_relay = self.relay ~= 'off' and t:find('relay=', 1, true) > 0
  if self.relay ~= 'off' and not via_relay and now < d.give_up then return end
  d.pending = false
  local dial = via_relay and relay_only(t) or t:copy()
  defer dial:destroy() end
  local why: string
  d.fast, why = self:subscribe(dial, 'netlab', d.age_ms, 0, d.client)
  if d.fast == 0 then say(self, 'demo: ', why) end
  why:destroy()
  d.slow, why = self:subscribe(dial, 'netlab', 0, d.slow_ms, -1)
  if d.slow == 0 then say(self, 'demo: ', why) end
  why:destroy()
end

-- One command from connection `ci`: (ok, text).
local function command(self: *AgentNetlab, ci: integer, cmd: string, now: float64): (boolean, string)
  local w = words(cmd)
  defer w:destroy() end
  if #w == 0 then return false, string.copy('an empty command') end
  local verb = w[0]
  if verb == 'watch' then
    watch(self, ci, num(#w > 1 and w[1] or '', 0))
    return true, (@string){}
  elseif not NETLAB_BUILT then
    return false, string.copy(NETLAB_NOT_BUILT)
  elseif verb == 'start' then
    return self:start(opt(w,1, 'relay'), (@uint16)(num(opt(w,1, 'port'), 0)))
  elseif verb == 'stop' then
    self:stop()
    self.demo = {}
    return true, (@string){}
  elseif verb == 'ticket' then
    local t = self:ticket()
    if #t == 0 then return false, string.copy('not started') end
    return true, t
  elseif verb == 'publish' then
    if #w < 2 then return false, string.copy('publish NAME [fps=N] [size=WxH] [group=MS] [window=MATCH]') end
    local size = opt(w,2, 'size')
    local x = size:find('x', 1, true)
    local mw, mh = 0, 0
    if x > 0 then mw, mh = num(size:subview(1, x - 1), 0), num(size:subview(x + 1), 0) end
    return self:publish(w[1], opt(w,2, 'window'), num(opt(w,2, 'fps'), 30), mw, mh, num(opt(w,2, 'group'), 1000))
  elseif verb == 'unpublish' then
    if #w < 2 or not self:unpublish(w[1]) then return false, string.copy('not publishing that') end
    return true, (@string){}
  elseif verb == 'subscribe' then
    if #w < 3 then return false, string.copy('subscribe TICKET NAME [age=MS] [slow=MS] [view] [via=relay]') end
    local dial = opt(w,3, 'via') == 'relay' and relay_only(w[1]) or w[1]:copy()
    defer dial:destroy() end
    local id, why = self:subscribe(dial, w[2], (@uint32)(num(opt(w,3, 'age'), 500)),
      (@uint32)(num(opt(w,3, 'slow'), 0)), has_word(w,3, 'view') and ci or -1)
    if id == 0 then return false, why end
    return true, tostring(id)
  elseif verb == 'slow' then
    if #w < 3 or not self:throttle((@uint32)(num(w[1], 0)), (@uint32)(num(w[2], 0))) then
      return false, string.copy('slow SUB MS')
    end
    return true, (@string){}
  elseif verb == 'view' then
    local s = #w >= 3 and netlab_find_sub(self, (@uint32)(num(w[1], 0))) or nilptr
    if s == nilptr then return false, string.copy('view SUB on|off') end
    s.view = w[2] == 'off' and -1 or ci
    s.need_group = true
    return true, (@string){}
  elseif verb == 'unsubscribe' then
    if #w < 2 or not self:unsubscribe((@uint32)(num(w[1], 0))) then return false, string.copy('no such subscription') end
    return true, (@string){}
  elseif verb == 'demo' then
    if self.demo.pending or self.demo.fast ~= 0 then return false, string.copy('a demo is running (stop first)') end
    if not self.started then
      local ok, why = self:start(opt(w,1, 'relay'), 0)
      if not ok then return false, why end
    end
    if find_pub(self, 'netlab') < 0 then
      local ok, why = self:publish('netlab', opt(w,1, 'window'), 30, 960, 540, num(opt(w,1, 'group'), 1000))
      if not ok then return false, why end
    end
    self.demo = { pending = true, client = ci, give_up = now + 8,
      slow_ms = (@uint32)(num(opt(w,1, 'slow'), 120)), age_ms = (@uint32)(num(opt(w,1, 'age'), 500)) }
    watch(self, ci, 100)
    demo_step(self, now)
    return true, string.copy(self.demo.pending and 'waiting for the relay' or 'running')
  end
  return false, 'unknown netlab command: ' .. verb
end

-- A frame from connection `ci`, if it is netlab's.
function AgentNetlab:handle(ci: usize, q: *ByteQueue, typ: uint8, payload: *[0]uint8, len: usize): boolean
  if typ ~= PROTO_NLCTL then return false end
  local ok, req, cmd = netlab_wire.parse_ctl(payload, len)
  if not ok then
    netlab_wire.write_reply(q, 0, false, 'short NLCTL')
    return true
  end
  local done, text = command(self, (@integer)(ci), cmd, os.now())
  netlab_wire.write_reply(q, req, done, text)
  text:destroy()
  return true
end

-- Once per main loop turn: publish, drain the subscriptions, the demo, NLSTAT.
function AgentNetlab:tick(now: float64): void
  if self.started then
    for i = 0, < #self.pubs do pub_frame(self, &self.pubs[i], now) end
    ## if NETLAB then
    moqi_wake_clear()
    ## end
    for i = 0, < #self.subs do sub_drain(self, &self.subs[i]) end
    demo_step(self, now)
  end
  if #self.watchers == 0 or self.queue_of == nilptr then return end
  local js: string
  for i = 0, < #self.watchers do
    local wt = &self.watchers[i]
    if now >= wt.due then
      wt.due = now + wt.every
      local q = self.queue_of((@usize)(wt.client))
      if q ~= nilptr and q:len() <= NETLAB_STATQ_MAX then
        if #js == 0 then js = self:stats_json(now) end
        proto.write_frame(q, PROTO_NLSTAT, (@*[0]uint8)(js.data), js.size)
      end
    end
  end
  js:destroy()
end

-- The longest the main loop may sleep (ms), -1 for no limit.
function AgentNetlab:wait_ms(now: float64): integer
  local soonest: float64 = -1
  for i = 0, < #self.pubs do
    local t = self.pubs[i].due
    if self.pubs[i].cap ~= nilptr and (soonest < 0 or t < soonest) then soonest = t end
  end
  for i = 0, < #self.watchers do
    local t = self.watchers[i].due
    if soonest < 0 or t < soonest then soonest = t end
  end
  if self.demo.pending and (soonest < 0 or now + 0.1 < soonest) then soonest = now + 0.1 end
  -- moq_iroh has no descriptor to wake the loop on Windows
  if #self.subs > 0 and self:wake_fd() < 0 and (soonest < 0 or now + 0.02 < soonest) then soonest = now + 0.02 end
  if soonest < 0 then return -1 end
  return math.max(0, (@integer)(math.ceil((soonest - now) * 1000)))
end
