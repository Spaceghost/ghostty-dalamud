-- TCP/IP inside the agent's WireGuard tunnel (docs/WIREGUARD.md "Why lwIP"):
-- vendored lwIP 2.2.1 with its raw API and NO_SYS=1, driven from the
-- agent's own loop, and the forwards that carry tunnel connections to ports
-- on this machine's loopback: the agent's own listener first, and whatever
-- else the owner allowed (RDP, VNC, Sunshine), over TCP and UDP.
--
-- lwIP wants two configuration headers, lwipopts.h and arch/cc.h. They are
-- not hand-written: the preprocessor block below writes them from a Lua
-- table into the Nelua cache (lwip-port/), and compiles lwIP's sources in
-- with `## cfile`. The layouts of the lwIP structs this file embeds are
-- declared in full, so Nelua's own size checks catch a mismatch at compile
-- time.
--
-- Each forwarded connection copies both ways with back-pressure: tunnel data
-- is acknowledged into the TCP window only once the local socket has taken
-- it, and the local socket is read only while lwIP has send buffer.
require 'memory'
require 'os'
require 'string'
require 'stringbuilder'
require 'vector'
require 'core.protocol'
require 'core.sys.net'
require 'agent.wg_proto'
require 'agent.wg_udp'
## if ccinfo.is_windows then
require 'agent.winloop'
## end

##[[
local fs = require 'nelua.utils.fs'
local root = fs.abspath(fs.join(context:get_visiting_directory(), '..'))
local lwip = fs.join(root, 'vendor', 'lwip', 'src')
local port = fs.join(fs.abspath(config.cache_dir or 'build/nelua-cache'), 'lwip-port')
-- The configuration: Lua, like every other policy in this project.
local MSS = 1360 -- a 1420-byte tunnel MTU, less the IPv6 and TCP headers
local opts = {
  {'NO_SYS', 1}, {'LWIP_TIMERS', 1}, {'SYS_LIGHTWEIGHT_PROT', 0}, {'LWIP_NOASSERT', 1},
  {'MEM_LIBC_MALLOC', 1}, {'MEMP_MEM_MALLOC', 1}, {'MEM_ALIGNMENT', 8},
  {'LWIP_IPV4', 1}, {'LWIP_IPV6', 1}, {'LWIP_ARP', 0}, {'LWIP_ETHERNET', 0}, {'LWIP_ICMP', 1},
  {'LWIP_RAW', 0}, {'LWIP_DHCP', 0}, {'LWIP_AUTOIP', 0}, {'LWIP_ACD', 0}, {'LWIP_IGMP', 0},
  {'LWIP_DNS', 0}, {'LWIP_UDP', 1}, {'LWIP_TCP', 1}, {'LWIP_NETCONN', 0}, {'LWIP_SOCKET', 0},
  {'LWIP_STATS', 0}, {'LWIP_NETIF_LOOPBACK', 0}, {'LWIP_HAVE_LOOPIF', 0},
  {'IP_REASSEMBLY', 1}, {'IP_FRAG', 1}, {'LWIP_IPV6_REASS', 1}, {'LWIP_IPV6_FRAG', 1},
  {'LWIP_IPV6_NUM_ADDRESSES', 2}, {'LWIP_IPV6_MLD', 0}, {'LWIP_IPV6_AUTOCONFIG', 0},
  {'LWIP_IPV6_SEND_ROUTER_SOLICIT', 0}, {'LWIP_ND6_ALLOW_RA_UPDATES', 0},
  {'LWIP_IPV6_DUP_DETECT_ATTEMPTS', 0}, {'LWIP_IPV6_DHCP6', 0},
  {'TCP_MSS', MSS}, {'LWIP_WND_SCALE', 1}, {'TCP_RCV_SCALE', 3},
  {'TCP_WND', '(256 * 1024)'}, {'TCP_SND_BUF', '(256 * 1024)'},
  {'TCP_SND_QUEUELEN', '((4 * TCP_SND_BUF) / TCP_MSS)'}, {'TCP_SNDLOWAT', 32768}, {'MEMP_NUM_TCP_SEG', 'TCP_SND_QUEUELEN'},
  {'MEMP_NUM_TCP_PCB', 512}, {'MEMP_NUM_UDP_PCB', 64},
  {'TCP_QUEUE_OOSEQ', 1}, {'LWIP_TCP_SACK_OUT', 1}, {'TCP_OOSEQ_MAX_BYTES', 'TCP_WND'},
  {'LWIP_TCP_KEEPALIVE', 1},
  -- two tunnels in one process (tests/test_wg_netstack.nelua) route by source address
  {'LWIP_HOOK_IP4_ROUTE_SRC(src, dest)', 'ghostty_lwip_route4((void *)(src), (void *)(dest))'},
}
local lines = {'/* Generated by agent/wg_netstack.nelua from its option table. Do not edit. */',
  '#ifndef GHOSTTY_LWIPOPTS_H', '#define GHOSTTY_LWIPOPTS_H',
  '#undef TCP_MSS /* <netinet/tcp.h> names a socket option so; nothing here uses that one */'}
for _, o in ipairs(opts) do lines[#lines+1] = '#define ' .. o[1] .. ' ' .. tostring(o[2]) end
lines[#lines+1] = 'struct netif;'
lines[#lines+1] = 'struct netif *ghostty_lwip_route4(void *src, void *dest);'
lines[#lines+1] = '#endif'
local cc = {'/* Generated by agent/wg_netstack.nelua. Do not edit. */',
  '#ifndef GHOSTTY_LWIP_CC_H', '#define GHOSTTY_LWIP_CC_H',
  '#include <stdlib.h>', '#include <string.h>',
  '#define LWIP_PLATFORM_DIAG(x) do {} while (0)',
  '#define LWIP_PLATFORM_ASSERT(x) do {} while (0)',
  '#endif'}
local function put(path, text)
  if fs.readfile(path) ~= text then
    fs.makepath(fs.dirname(path))
    assert(fs.makefile(path, text))
  end
end
put(fs.join(port, 'lwipopts.h'), table.concat(lines, '\n') .. '\n')
put(fs.join(port, 'arch', 'cc.h'), table.concat(cc, '\n') .. '\n')
cincdir(port)
cincdir(fs.join(lwip, 'include'))
for _, f in ipairs{'init', 'def', 'inet_chksum', 'ip', 'mem', 'memp', 'netif', 'pbuf', 'raw', 'stats',
                   'sys', 'tcp', 'tcp_in', 'tcp_out', 'timeouts', 'udp'} do
  cfile(fs.join(lwip, 'core', f .. '.c'))
end
for _, f in ipairs{'icmp', 'ip4', 'ip4_addr', 'ip4_frag'} do cfile(fs.join(lwip, 'core', 'ipv4', f .. '.c')) end
for _, f in ipairs{'icmp6', 'inet6', 'ip6', 'ip6_addr', 'ip6_frag', 'nd6', 'mld6'} do
  cfile(fs.join(lwip, 'core', 'ipv6', f .. '.c'))
end
]]
## cinclude '"lwip/init.h"'
## cinclude '"lwip/netif.h"'
## cinclude '"lwip/ip.h"'
## cinclude '"lwip/tcp.h"'
## cinclude '"lwip/udp.h"'
## cinclude '"lwip/pbuf.h"'
## cinclude '"lwip/timeouts.h"'

local lwip_err = @int8
local ERR_OK: lwip_err <comptime> = 0
local ERR_MEM: lwip_err <comptime> = -1
local ERR_ABRT: lwip_err <comptime> = -13

local lwip_ip4 <cimport 'ip4_addr_t', nodecl> = @record{ addr: uint32 }
local lwip_ip6 <cimport 'ip6_addr_t', nodecl> = @record{ addr: [4]uint32, zone: uint8 }
local lwip_ip <cimport 'ip_addr_t', nodecl> = @record{
  u_addr: union{ ip6: lwip_ip6, ip4: lwip_ip4 },
  type: uint8,
}
local lwip_pbuf <cimport 'pbuf', nodecl, ctypedef> = @record{ next: pointer, payload: pointer, tot_len: uint16, len: uint16 }
local lwip_tcp_pcb <cimport 'tcp_pcb', nodecl, ctypedef> = @record{
  local_ip: lwip_ip, remote_ip: lwip_ip, local_port: uint16, remote_port: uint16,
  snd_buf: uint32, snd_queuelen: uint16,
}
local lwip_udp_pcb <cimport 'udp_pcb', nodecl, ctypedef> = @record{ local_port: uint16 }
local lwip_netif <cimport 'netif', nodecl, ctypedef, forwarddecl> = @record{}
local netif_input_fn = @function(p: *lwip_pbuf, inp: *lwip_netif): lwip_err
local netif_output_fn = @function(n: *lwip_netif, p: *lwip_pbuf, dst: *lwip_ip4): lwip_err
local netif_output6_fn = @function(n: *lwip_netif, p: *lwip_pbuf, dst: *lwip_ip6): lwip_err
local netif_init_fn = @function(n: *lwip_netif): lwip_err
-- struct netif as lwipopts.h above configures it; Nelua checks the size
lwip_netif = @record{
  next: *lwip_netif,
  ip_addr: lwip_ip, netmask: lwip_ip, gw: lwip_ip,
  ip6_addr: [2]lwip_ip, ip6_addr_state: [2]uint8,
  input: netif_input_fn,
  output: netif_output_fn,
  linkoutput: pointer,
  output_ip6: netif_output6_fn,
  state: pointer,
  mtu: uint16,
  hwaddr: [6]uint8, hwaddr_len: uint8, flags: uint8, name: [2]cchar, num: uint8,
}

local tcp_accept_fn = @function(arg: pointer, newpcb: *lwip_tcp_pcb, err: lwip_err): lwip_err
local tcp_recv_fn = @function(arg: pointer, pcb: *lwip_tcp_pcb, p: *lwip_pbuf, err: lwip_err): lwip_err
local tcp_sent_fn = @function(arg: pointer, pcb: *lwip_tcp_pcb, len: uint16): lwip_err
local tcp_err_fn = @function(arg: pointer, err: lwip_err): void
local tcp_connected_fn = @function(arg: pointer, pcb: *lwip_tcp_pcb, err: lwip_err): lwip_err
local udp_recv_fn = @function(arg: pointer, pcb: *lwip_udp_pcb, p: *lwip_pbuf, addr: *lwip_ip, port: uint16): void

local function lwip_init(): void <cimport, nodecl> end
local function netif_add(n: *lwip_netif, ip: *lwip_ip4, mask: *lwip_ip4, gw: *lwip_ip4, state: pointer,
                         init: netif_init_fn, input: netif_input_fn): *lwip_netif <cimport, nodecl> end
local function netif_remove(n: *lwip_netif): void <cimport, nodecl> end
local function netif_set_up(n: *lwip_netif): void <cimport, nodecl> end
local function netif_set_link_up(n: *lwip_netif): void <cimport, nodecl> end
local function netif_set_default(n: *lwip_netif): void <cimport, nodecl> end
local function netif_add_ip6_address(n: *lwip_netif, a: *lwip_ip6, idx: *int8): lwip_err <cimport, nodecl> end
local function netif_ip6_addr_set_state(n: *lwip_netif, idx: int8, state: uint8): void <cimport, nodecl> end
local function ip_input(p: *lwip_pbuf, inp: *lwip_netif): lwip_err <cimport, nodecl> end
local function pbuf_alloc(layer: cint, len: uint16, typ: cint): *lwip_pbuf <cimport, nodecl> end
local function pbuf_free(p: *lwip_pbuf): uint8 <cimport, nodecl> end
local function pbuf_take(p: *lwip_pbuf, data: pointer, len: uint16): lwip_err <cimport, nodecl> end
local function pbuf_copy_partial(p: *lwip_pbuf, data: pointer, len: uint16, off: uint16): uint16 <cimport, nodecl> end
local function tcp_new_ip_type(t: uint8): *lwip_tcp_pcb <cimport, nodecl> end
local function tcp_bind(pcb: *lwip_tcp_pcb, ip: *lwip_ip, port: uint16): lwip_err <cimport, nodecl> end
local function tcp_bind_netif(pcb: *lwip_tcp_pcb, n: *lwip_netif): void <cimport, nodecl> end
local function tcp_listen_with_backlog(pcb: *lwip_tcp_pcb, backlog: uint8): *lwip_tcp_pcb <cimport, nodecl> end
local function tcp_accept(pcb: *lwip_tcp_pcb, fn: tcp_accept_fn): void <cimport, nodecl> end
local function tcp_arg(pcb: *lwip_tcp_pcb, arg: pointer): void <cimport, nodecl> end
local function tcp_recv(pcb: *lwip_tcp_pcb, fn: tcp_recv_fn): void <cimport, nodecl> end
local function tcp_sent(pcb: *lwip_tcp_pcb, fn: tcp_sent_fn): void <cimport, nodecl> end
local function tcp_err(pcb: *lwip_tcp_pcb, fn: tcp_err_fn): void <cimport, nodecl> end
local function tcp_recved(pcb: *lwip_tcp_pcb, len: uint16): void <cimport, nodecl> end
local function tcp_write(pcb: *lwip_tcp_pcb, data: pointer, len: uint16, flags: uint8): lwip_err <cimport, nodecl> end
local function tcp_output(pcb: *lwip_tcp_pcb): lwip_err <cimport, nodecl> end
local function tcp_close(pcb: *lwip_tcp_pcb): lwip_err <cimport, nodecl> end
local function tcp_abort(pcb: *lwip_tcp_pcb): void <cimport, nodecl> end
local function tcp_shutdown(pcb: *lwip_tcp_pcb, rx: cint, tx: cint): lwip_err <cimport, nodecl> end
local function tcp_connect(pcb: *lwip_tcp_pcb, ip: *lwip_ip, port: uint16, fn: tcp_connected_fn): lwip_err <cimport, nodecl> end
local function udp_new_ip_type(t: uint8): *lwip_udp_pcb <cimport, nodecl> end
local function udp_bind(pcb: *lwip_udp_pcb, ip: *lwip_ip, port: uint16): lwip_err <cimport, nodecl> end
local function udp_bind_netif(pcb: *lwip_udp_pcb, n: *lwip_netif): void <cimport, nodecl> end
local function udp_recv(pcb: *lwip_udp_pcb, fn: udp_recv_fn, arg: pointer): void <cimport, nodecl> end
local function udp_sendto_if(pcb: *lwip_udp_pcb, p: *lwip_pbuf, ip: *lwip_ip, port: uint16, n: *lwip_netif): lwip_err <cimport, nodecl> end
local function udp_remove(pcb: *lwip_udp_pcb): void <cimport, nodecl> end
local function ipaddr_ntoa_r(a: *lwip_ip, buf: *[0]cchar, len: cint): cstring <cimport, nodecl> end
local function sys_check_timeouts(): void <cimport, nodecl> end
local function sys_timeouts_sleeptime(): uint32 <cimport, nodecl> end
local ip_addr_any_type: lwip_ip <cimport, nodecl>
local PBUF_RAW: cint <cimport, nodecl, const>
local PBUF_TRANSPORT: cint <cimport, nodecl, const>
local PBUF_RAM: cint <cimport, nodecl, const>
local IPADDR_TYPE_V4: uint8 <comptime> = 0
local IPADDR_TYPE_V6: uint8 <comptime> = 6
local IPADDR_TYPE_ANY: uint8 <comptime> = 46
local IP6_ADDR_PREFERRED: uint8 <comptime> = 0x30
local TCP_WRITE_FLAG_COPY: uint8 <comptime> = 1
local NETIF_FLAG_UP: uint8 <comptime> = 1
local NETIF_FLAG_LINK_UP: uint8 <comptime> = 4

-- lwIP's clock, and the source routing hook lwipopts.h names ----------------------

local function sys_now(): uint32 <cexport, codename 'sys_now'>
  return (@uint32)((@uint64)(os.now() * 1000.0) & 0xffffffff)
end

local netifs: vector(*lwip_netif) -- every tunnel's interface, for the route hook

local function ghostty_lwip_route4(srcp: pointer, dest: pointer): *lwip_netif <cexport, codename 'ghostty_lwip_route4'>
  if srcp == nilptr then return nilptr end
  local src = (@*lwip_ip4)(srcp)
  for i = 0, < #netifs do
    if netifs[i].ip_addr.u_addr.ip4.addr == src.addr then return netifs[i] end
  end
  return nilptr
end

local lwip_started = false

-- Forwards and flows -----------------------------------------------------------------

global WgForward = @record{ udp: boolean, port: uint16, to: uint16 }

global WgPollFd = @record{ fd: cint, read: boolean, write: boolean }

local TcpFlow = @record{
  ns: pointer,              -- *WgNetstack
  pcb: *lwip_tcp_pcb,       -- nilptr once lwIP freed it (an error or a close)
  conn: NetConn,
  connected: boolean,
  to_local: ByteQueue,      -- tunnel bytes the local socket has not taken yet
  tunnel_eof: boolean,      -- the tunnel side sent FIN
  local_eof: boolean,       -- the local side closed (FIN sent into the tunnel)
  local_shut: boolean,      -- the local socket's write side is shut
  dead: boolean,
  port: uint16,
  ev: pointer,              -- Windows: the local socket's event
}

local UdpListener = @record{ ns: pointer, fwd: WgForward, pcb: *lwip_udp_pcb }

local UdpFlow = @record{
  listener: *UdpListener,
  sock: WgUdp,
  remote: lwip_ip,
  rport: uint16,
  last: number,
  ev: pointer,
}

local TcpListener = @record{ ns: pointer, fwd: WgForward, pcb: *lwip_tcp_pcb }

global WgNetstack = @record{
  netif: lwip_netif,
  up: boolean,
  -- IP packets for the tunnel (the WireGuard device's send_packet)
  output: function(ud: pointer, pkt: *[0]uint8, len: usize): void,
  ud: pointer,
  log: function(ud: pointer, msg: string): void,
  tcp_listeners: vector(*TcpListener),
  udp_listeners: vector(*UdpListener),
  flows: vector(*TcpFlow),
  uflows: vector(*UdpFlow),
  max_flows: integer,
  outbuf: vector(uint8),
}

-- A TCP connection opened from this side of the tunnel (WgNetstack:dial):
-- what tests/test_wg_netstack.nelua plays the game PC with.
global WgTunnelConn = @record{
  pcb: *lwip_tcp_pcb,
  connected: boolean,
  eof: boolean,             -- the other side sent FIN
  failed: boolean,          -- reset, refused, or gone
  err: int8,                -- lwIP's reason when it failed
  inq: ByteQueue,
  outq: ByteQueue,
}

local WG_TCP_MAX_FLOWS: integer <comptime> = 256
local WG_UDP_FLOW_IDLE: number <comptime> = 60
local WG_UDP_MAX_FLOWS: integer <comptime> = 64

local function nlog(ns: *WgNetstack, msg: string): void
  if ns.log ~= nilptr then ns.log(ns.ud, msg) end
end

-- The interface: packets both ways -------------------------------------------------

local function to_tunnel(ns: *WgNetstack, p: *lwip_pbuf): lwip_err
  local n = (@usize)(p.tot_len)
  if #ns.outbuf < n then ns.outbuf:resize(n) end
  pbuf_copy_partial(p, &ns.outbuf[0], p.tot_len, 0)
  if ns.output ~= nilptr then ns.output(ns.ud, (@*[0]uint8)(&ns.outbuf[0]), n) end
  return ERR_OK
end

local function netif_output4(n: *lwip_netif, p: *lwip_pbuf, dst: *lwip_ip4): lwip_err
  return to_tunnel((@*WgNetstack)(n.state), p)
end

local function netif_output6(n: *lwip_netif, p: *lwip_pbuf, dst: *lwip_ip6): lwip_err
  return to_tunnel((@*WgNetstack)(n.state), p)
end

local function netif_init(n: *lwip_netif): lwip_err
  n.name[0], n.name[1] = (@cchar)('w'_b), (@cchar)('g'_b)
  n.output = netif_output4
  n.output_ip6 = netif_output6
  n.mtu = 1420
  return ERR_OK
end

-- Bring the tunnel interface up with the agent's own addresses: `a4` (its
-- prefix is the interface's netmask) and `a6` (may be nilptr).
function WgNetstack:init(a4: *WgCidr, a6: *WgCidr, mtu: uint16): boolean
  if not lwip_started then lwip_init() lwip_started = true end
  if self.max_flows == 0 then self.max_flows = WG_TCP_MAX_FLOWS end
  local ip: lwip_ip4
  local mask: lwip_ip4
  local gw: lwip_ip4
  memory.copy(&ip.addr, &a4.addr, 4)
  local m: uint32 = a4.bits == 0 and 0 or (0xffffffff_u32 << (32 - (@uint32)(a4.bits)))
  local mb: [4]uint8 = { (@uint8)(m >> 24), (@uint8)((m >> 16) & 0xff), (@uint8)((m >> 8) & 0xff), (@uint8)(m & 0xff) }
  memory.copy(&mask.addr, &mb, 4)
  gw.addr = 0
  if netif_add(&self.netif, &ip, &mask, &gw, self, netif_init, ip_input) == nilptr then return false end
  self.netif.mtu = mtu
  if a6 ~= nilptr then
    local a: lwip_ip6
    memory.copy(&a.addr, &a6.addr, 16)
    a.zone = 0
    local idx: int8 = -1
    if netif_add_ip6_address(&self.netif, &a, &idx) == ERR_OK then
      netif_ip6_addr_set_state(&self.netif, idx, IP6_ADDR_PREFERRED)
    end
  end
  netif_set_up(&self.netif)
  netif_set_link_up(&self.netif)
  if #netifs == 0 then netif_set_default(&self.netif) end
  netifs:push(&self.netif)
  self.up = true
  return true
end

-- An IP packet out of the tunnel (the device's `deliver`).
function WgNetstack:input(pkt: *[0]uint8, len: usize): void
  if not self.up or len == 0 or len > 65535 then return end
  local p = pbuf_alloc(PBUF_RAW, (@uint16)(len), PBUF_RAM)
  if p == nilptr then return end
  pbuf_take(p, pkt, (@uint16)(len))
  if self.netif.input(p, &self.netif) ~= ERR_OK then pbuf_free(p) end
end

-- lwIP's timers; call often (the next one is due in wait_ms()).
function WgNetstack:timers(): void
  sys_check_timeouts()
end

function WgNetstack:wait_ms(): integer
  local ms = sys_timeouts_sleeptime()
  if ms > 1000 then return 1000 end
  return (@integer)(ms)
end

-- TCP forwards ---------------------------------------------------------------------

local function flow_close_local(f: *TcpFlow): void
  ## if ccinfo.is_windows then
  winloop_forget_socket(f.ev)
  f.ev = nilptr
  ## end
  if net.is_valid(f.conn.sock) then net.close(f.conn.sock) end
  f.conn.sock = net.invalid()
end

-- Tear down both sides now (a reset into the tunnel when the pcb is alive).
local function flow_abort(f: *TcpFlow): void
  if f.pcb ~= nilptr then
    tcp_arg(f.pcb, nilptr)
    tcp_recv(f.pcb, nilptr)
    tcp_sent(f.pcb, nilptr)
    tcp_err(f.pcb, nilptr)
    tcp_abort(f.pcb)
    f.pcb = nilptr
  end
  flow_close_local(f)
  f.dead = true
end

local function on_tcp_err(arg: pointer, err: lwip_err): void
  if arg == nilptr then return end
  local f = (@*TcpFlow)(arg)
  f.pcb = nilptr -- lwIP has already freed it
  flow_close_local(f)
  f.dead = true
end

local function on_tcp_recv(arg: pointer, pcb: *lwip_tcp_pcb, p: *lwip_pbuf, err: lwip_err): lwip_err
  if arg == nilptr then
    if p ~= nilptr then pbuf_free(p) end
    return ERR_OK
  end
  local f = (@*TcpFlow)(arg)
  if p == nilptr then
    f.tunnel_eof = true -- FIN from the tunnel: shut the local side once the queue drains
    return ERR_OK
  end
  local q: *lwip_pbuf = p
  while q ~= nilptr do
    f.to_local:push((@*[0]uint8)(q.payload), q.len)
    q = (@*lwip_pbuf)(q.next)
  end
  pbuf_free(p)
  -- not acknowledged into the window yet: that happens as the local socket takes it
  return ERR_OK
end

local function on_tcp_sent(arg: pointer, pcb: *lwip_tcp_pcb, len: uint16): lwip_err
  return ERR_OK -- the next pump reads more from the local socket
end

local function on_tcp_accept(arg: pointer, pcb: *lwip_tcp_pcb, err: lwip_err): lwip_err
  local l = (@*TcpListener)(arg)
  local ns = (@*WgNetstack)(l.ns)
  if err ~= ERR_OK or pcb == nilptr then return ERR_MEM end
  if #ns.flows >= ns.max_flows then
    nlog(ns, 'wireguard: too many forwarded connections; refusing one')
    tcp_abort(pcb)
    return ERR_ABRT
  end
  local f = new(@TcpFlow)
  f.ns = ns
  f.pcb = pcb
  f.port = l.fwd.to
  f.conn = net.connect('127.0.0.1', l.fwd.to)
  if not net.is_valid(f.conn.sock) then
    delete(f)
    tcp_abort(pcb)
    return ERR_ABRT
  end
  ## if ccinfo.is_windows then
  f.ev = winloop_watch(f.conn.sock, false)
  ## end
  tcp_arg(pcb, f)
  tcp_recv(pcb, on_tcp_recv)
  tcp_sent(pcb, on_tcp_sent)
  tcp_err(pcb, on_tcp_err)
  ns.flows:push(f)
  local sb: stringbuilder
  local ip: [48]cchar
  ipaddr_ntoa_r(&pcb.remote_ip, &ip, 48)
  -- the tunnel address says which peer: `ghostty-agent wg list`
  sb:writef('wireguard: tunnel connection from %s port %d to 127.0.0.1:%d', (@cstring)(&ip), (@integer)(pcb.remote_port), (@integer)(l.fwd.to))
  local msg = sb:promote()
  nlog(ns, msg)
  msg:destroy()
  return ERR_OK
end

-- Move what can move for one flow; true while it lives.
local function flow_pump(f: *TcpFlow): boolean
  if f.dead then return false end
  if not f.connected then
    local st = net.connect_poll(&f.conn)
    if st < 0 then flow_abort(f) return false end -- nothing listens there: reset the tunnel side
    if st == 0 then return true end
    f.connected = true
  end
  -- tunnel -> local, acknowledging into the window only what the socket took
  local took: usize = 0
  while f.to_local:len() > 0 do
    local n = net.send(f.conn.sock, f.to_local:peek(), f.to_local:len())
    if n < 0 then flow_abort(f) return false end
    if n == 0 then break end
    f.to_local:consume((@usize)(n))
    took = took + (@usize)(n)
  end
  while took > 0 and f.pcb ~= nilptr do
    local chunk: usize = took > 0xffff and 0xffff or took
    tcp_recved(f.pcb, (@uint16)(chunk))
    took = took - chunk
  end
  if f.tunnel_eof and f.to_local:len() == 0 and not f.local_shut then
    net.shutdown_write(f.conn.sock)
    f.local_shut = true
  end
  -- local -> tunnel, only while lwIP has room
  if not f.local_eof and f.pcb ~= nilptr then
    local buf: [16384]uint8
    local sent_any = false
    while f.pcb ~= nilptr do
      local room = (@usize)(f.pcb.snd_buf)
      if room == 0 or f.pcb.snd_queuelen > 1000 then break end
      if room > 16384 then room = 16384 end
      local n = net.recv(f.conn.sock, &buf, room)
      if n == 0 then break end
      if n < 0 then
        f.local_eof = true -- EOF (or an error): FIN into the tunnel
        tcp_shutdown(f.pcb, 0, 1)
        break
      end
      if tcp_write(f.pcb, &buf, (@uint16)(n), TCP_WRITE_FLAG_COPY) ~= ERR_OK then break end
      sent_any = true
    end
    if sent_any and f.pcb ~= nilptr then tcp_output(f.pcb) end
  end
  -- both ways closed and drained: done
  if f.local_eof and f.local_shut and f.pcb ~= nilptr then
    tcp_arg(f.pcb, nilptr)
    tcp_recv(f.pcb, nilptr)
    tcp_sent(f.pcb, nilptr)
    tcp_err(f.pcb, nilptr)
    if tcp_close(f.pcb) ~= ERR_OK then tcp_abort(f.pcb) end
    f.pcb = nilptr
    flow_close_local(f)
    f.dead = true
    return false
  end
  if f.pcb == nilptr then flow_close_local(f) f.dead = true return false end
  return true
end

local function tcp_forward(self: *WgNetstack, fwd: WgForward): boolean
  local l = new(@TcpListener)
  l.ns, l.fwd = self, fwd
  local pcb = tcp_new_ip_type(IPADDR_TYPE_ANY)
  if pcb == nilptr then delete(l) return false end
  tcp_bind_netif(pcb, &self.netif)
  if tcp_bind(pcb, &ip_addr_any_type, fwd.port) ~= ERR_OK then tcp_abort(pcb) delete(l) return false end
  l.pcb = tcp_listen_with_backlog(pcb, 16)
  if l.pcb == nilptr then tcp_abort(pcb) delete(l) return false end
  tcp_arg(l.pcb, l)
  tcp_accept(l.pcb, on_tcp_accept)
  self.tcp_listeners:push(l)
  return true
end

-- UDP forwards ------------------------------------------------------------------------

local function udp_flow_free(f: *UdpFlow): void
  ## if ccinfo.is_windows then
  winloop_forget_socket(f.ev)
  ## end
  f.sock:close()
  delete(f)
end

local function on_udp_recv(arg: pointer, pcb: *lwip_udp_pcb, p: *lwip_pbuf, addr: *lwip_ip, port: uint16): void
  local l = (@*UdpListener)(arg)
  local ns = (@*WgNetstack)(l.ns)
  local f: *UdpFlow = nilptr
  for i = 0, < #ns.uflows do
    local u = ns.uflows[i]
    if u.listener == l and u.rport == port and u.remote.type == addr.type
       and memory.equals(&u.remote.u_addr, &addr.u_addr, #lwip_ip6) then f = u break end
  end
  if f == nilptr then
    if #ns.uflows >= WG_UDP_MAX_FLOWS then pbuf_free(p) return end
    f = new(@UdpFlow)
    if not f.sock:open(0) then delete(f) pbuf_free(p) return end
    f.listener = l
    f.remote = $addr
    f.rport = port
    ## if ccinfo.is_windows then
    f.ev = winloop_watch(f.sock.sock, false)
    ## end
    ns.uflows:push(f)
  end
  f.last = os.now()
  local n = (@usize)(p.tot_len)
  if #ns.outbuf < n then ns.outbuf:resize(n) end
  pbuf_copy_partial(p, &ns.outbuf[0], p.tot_len, 0)
  pbuf_free(p)
  local to: WgEndpoint = { family = 4, port = l.fwd.to }
  to.addr[0], to.addr[3] = 127, 1
  f.sock:send(&to, (@*[0]uint8)(&ns.outbuf[0]), n)
end

local function udp_flow_pump(ns: *WgNetstack, f: *UdpFlow): void
  local buf: [65536]uint8
  while true do
    local from: WgEndpoint
    local n = f.sock:recv(&buf, 65536, &from)
    if n < 0 then break end
    if n > 0 and from.family == 4 and from.addr[0] == 127 and from.port == f.listener.fwd.to then
      local p = pbuf_alloc(PBUF_TRANSPORT, (@uint16)(n), PBUF_RAM)
      if p ~= nilptr then
        pbuf_take(p, &buf, (@uint16)(n))
        udp_sendto_if(f.listener.pcb, p, &f.remote, f.rport, &ns.netif)
        pbuf_free(p)
        f.last = os.now()
      end
    end
  end
end

-- Listen for tunnel connections to `fwd.port` and carry them to
-- 127.0.0.1:`fwd.to` (UDP too when fwd.udp).
function WgNetstack:forward(fwd: WgForward): boolean
  if not fwd.udp then return tcp_forward(self, fwd) end
  local l = new(@UdpListener)
  l.ns, l.fwd = self, fwd
  l.pcb = udp_new_ip_type(IPADDR_TYPE_ANY)
  if l.pcb == nilptr then delete(l) return false end
  udp_bind_netif(l.pcb, &self.netif)
  if udp_bind(l.pcb, &ip_addr_any_type, fwd.port) ~= ERR_OK then udp_remove(l.pcb) delete(l) return false end
  udp_recv(l.pcb, on_udp_recv, l)
  self.udp_listeners:push(l)
  return true
end

-- Stop listening for `fwd`; connections already open run on.
function WgNetstack:unforward(fwd: WgForward): void
  if fwd.udp then
    for i = 0, < #self.udp_listeners do
      local l = self.udp_listeners[i]
      if l.fwd.port == fwd.port then
        -- its flows point at it: they go with it
        local k = 0
        while k < #self.uflows do
          local u = self.uflows[k]
          if u.listener == l then self.uflows:remove(k) udp_flow_free(u) else k = k + 1 end
        end
        self.udp_listeners:remove(i)
        udp_remove(l.pcb)
        delete(l)
        return
      end
    end
    return
  end
  for i = 0, < #self.tcp_listeners do
    local l = self.tcp_listeners[i]
    if l.fwd.port == fwd.port then
      self.tcp_listeners:remove(i)
      tcp_arg(l.pcb, nilptr)
      tcp_close(l.pcb)
      delete(l)
      return
    end
  end
end

-- Is `fwd` listened for?
function WgNetstack:forwarding(fwd: WgForward): boolean
  if fwd.udp then
    for i = 0, < #self.udp_listeners do if self.udp_listeners[i].fwd.port == fwd.port then return true end end
  else
    for i = 0, < #self.tcp_listeners do if self.tcp_listeners[i].fwd.port == fwd.port then return true end end
  end
  return false
end

-- Dialling out through the tunnel ---------------------------------------------------------

local function conn_err(arg: pointer, err: lwip_err): void
  local c = (@*WgTunnelConn)(arg)
  c.pcb = nilptr
  c.failed = true
  c.err = err
end

local function conn_recv(arg: pointer, pcb: *lwip_tcp_pcb, p: *lwip_pbuf, err: lwip_err): lwip_err
  local c = (@*WgTunnelConn)(arg)
  if p == nilptr then c.eof = true return ERR_OK end
  local q: *lwip_pbuf = p
  while q ~= nilptr do
    c.inq:push((@*[0]uint8)(q.payload), q.len)
    q = (@*lwip_pbuf)(q.next)
  end
  tcp_recved(pcb, p.tot_len)
  pbuf_free(p)
  return ERR_OK
end

local function conn_connected(arg: pointer, pcb: *lwip_tcp_pcb, err: lwip_err): lwip_err
  local c = (@*WgTunnelConn)(arg)
  c.connected = true
  return ERR_OK
end

-- Open a TCP connection from this tunnel address to `dst` (IPv4) and `port`.
function WgNetstack:dial(dst: *WgCidr, port: uint16, c: *WgTunnelConn): boolean
  local ip: lwip_ip
  memory.zero(&ip, #lwip_ip)
  memory.copy(&ip.u_addr.ip4.addr, &dst.addr, 4)
  ip.type = IPADDR_TYPE_V4
  c.pcb = tcp_new_ip_type(IPADDR_TYPE_V4)
  if c.pcb == nilptr then return false end
  local me: lwip_ip = self.netif.ip_addr
  tcp_bind(c.pcb, &me, 0)
  tcp_arg(c.pcb, c)
  tcp_recv(c.pcb, conn_recv)
  tcp_err(c.pcb, conn_err)
  return tcp_connect(c.pcb, &ip, port, conn_connected) == ERR_OK
end

-- Send what is queued as far as lwIP takes it.
function WgTunnelConn:pump(): void
  if self.pcb == nilptr or not self.connected or self.outq:len() == 0 then return end
  local room = (@usize)(self.pcb.snd_buf)
  local n = self.outq:len()
  if n > room then n = room end
  if n > 0xffff then n = 0xffff end
  if n == 0 then return end
  if tcp_write(self.pcb, self.outq:peek(), (@uint16)(n), TCP_WRITE_FLAG_COPY) == ERR_OK then
    self.outq:consume(n)
    tcp_output(self.pcb)
  end
end

-- Half-close (FIN) once everything queued has gone.
function WgTunnelConn:shutdown(): void
  if self.pcb ~= nilptr then tcp_shutdown(self.pcb, 0, 1) end
end

function WgTunnelConn:close(): void
  if self.pcb ~= nilptr then
    tcp_arg(self.pcb, nilptr)
    tcp_recv(self.pcb, nilptr)
    tcp_err(self.pcb, nilptr)
    if tcp_close(self.pcb) ~= ERR_OK then tcp_abort(self.pcb) end
    self.pcb = nilptr
  end
  self.inq:destroy()
  self.outq:destroy()
end

-- A UDP socket on this side of the tunnel (tests: the game PC's Moonlight).
global WgTunnelUdp = @record{ pcb: *lwip_udp_pcb, got: vector(uint8), count: integer }

local function tunnel_udp_recv(arg: pointer, pcb: *lwip_udp_pcb, p: *lwip_pbuf, addr: *lwip_ip, port: uint16): void
  local u = (@*WgTunnelUdp)(arg)
  u.got:resize(p.tot_len)
  if p.tot_len > 0 then pbuf_copy_partial(p, &u.got[0], p.tot_len, 0) end
  u.count = u.count + 1
  pbuf_free(p)
end

function WgNetstack:udp_open(u: *WgTunnelUdp): boolean
  u.pcb = udp_new_ip_type(IPADDR_TYPE_V4)
  if u.pcb == nilptr then return false end
  local me: lwip_ip = self.netif.ip_addr
  if udp_bind(u.pcb, &me, 0) ~= ERR_OK then udp_remove(u.pcb) u.pcb = nilptr return false end
  udp_recv(u.pcb, tunnel_udp_recv, u)
  return true
end

function WgNetstack:udp_send(u: *WgTunnelUdp, dst: *WgCidr, port: uint16, data: *[0]uint8, len: usize): boolean
  local ip: lwip_ip
  memory.zero(&ip, #lwip_ip)
  memory.copy(&ip.u_addr.ip4.addr, &dst.addr, 4)
  ip.type = IPADDR_TYPE_V4
  local p = pbuf_alloc(PBUF_TRANSPORT, (@uint16)(len), PBUF_RAM)
  if p == nilptr then return false end
  pbuf_take(p, data, (@uint16)(len))
  local ok = udp_sendto_if(u.pcb, p, &ip, port, &self.netif) == ERR_OK
  pbuf_free(p)
  return ok
end

function WgTunnelUdp:close(): void
  if self.pcb ~= nilptr then udp_remove(self.pcb) self.pcb = nilptr end
  self.got:destroy()
end

-- The loop's side -----------------------------------------------------------------------

-- Descriptors to wake on: every forwarded connection's local socket,
-- appended to `out` from index `n` (up to `max`); returns the new count.
function WgNetstack:poll_fds(out: *[0]WgPollFd, n: integer, max: integer): integer
  for i = 0, < #self.flows do
    local f = self.flows[i]
    if not f.dead and n < max then
      local r = f.connected and not f.local_eof and f.pcb ~= nilptr and f.pcb.snd_buf > 0
      local w = not f.connected or f.to_local:len() > 0
      out[n] = { fd = net.socket_fd(f.conn.sock), read = r, write = w }
      n = n + 1
    end
  end
  for i = 0, < #self.uflows do
    if n < max then out[n] = { fd = self.uflows[i].sock:fd(), read = true } n = n + 1 end
  end
  return n
end

## if ccinfo.is_windows then
-- Windows: the forwards' socket events, appended to `handles`; returns how
-- many it wanted.
function WgNetstack:wait_handles(handles: *[0]pointer, n: *usize, max: usize): usize
  local wanted: usize = 0
  for i = 0, < #self.flows do
    local ev = self.flows[i].ev
    wanted = wanted + 1
    if ev ~= nilptr and $n < max then handles[$n] = ev $n = $n + 1 end
  end
  for i = 0, < #self.uflows do
    local ev = self.uflows[i].ev
    wanted = wanted + 1
    if ev ~= nilptr and $n < max then handles[$n] = ev $n = $n + 1 end
  end
  return wanted
end

function WgNetstack:reset_events(): void
  for i = 0, < #self.flows do winloop_reset(self.flows[i].ev) end
  for i = 0, < #self.uflows do winloop_reset(self.uflows[i].ev) end
end
## end

-- Service the local sockets, lwIP's timers, and forget finished flows.
function WgNetstack:pump(now: number): void
  local i = 0
  while i < #self.flows do
    local f = self.flows[i]
    if not flow_pump(f) then
      self.flows:remove(i)
      f.to_local:destroy()
      delete(f)
    else
      i = i + 1
    end
  end
  i = 0
  while i < #self.uflows do
    local f = self.uflows[i]
    udp_flow_pump(self, f)
    if now - f.last > WG_UDP_FLOW_IDLE then
      self.uflows:remove(i)
      udp_flow_free(f)
    else
      i = i + 1
    end
  end
  sys_check_timeouts()
end

function WgNetstack:destroy(): void
  for i = 0, < #self.flows do
    flow_abort(self.flows[i])
    self.flows[i].to_local:destroy()
    delete(self.flows[i])
  end
  self.flows:destroy()
  for i = 0, < #self.uflows do udp_flow_free(self.uflows[i]) end
  self.uflows:destroy()
  for i = 0, < #self.tcp_listeners do
    local l = self.tcp_listeners[i]
    tcp_close(l.pcb)
    delete(l)
  end
  self.tcp_listeners:destroy()
  for i = 0, < #self.udp_listeners do
    udp_remove(self.udp_listeners[i].pcb)
    delete(self.udp_listeners[i])
  end
  self.udp_listeners:destroy()
  if self.up then
    for k = 0, < #netifs do if netifs[k] == &self.netif then netifs:remove(k) break end end
    netif_remove(&self.netif)
    self.up = false
  end
  self.outbuf:destroy()
end
