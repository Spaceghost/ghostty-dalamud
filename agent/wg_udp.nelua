-- The embedded WireGuard's carrier: one non-blocking UDP socket, dual-stack
-- where the host has IPv6 (IPv4 peers arrive as mapped addresses and are
-- handed to the device as plain IPv4), plain IPv4 where it does not. POSIX
-- and Winsock. docs/WIREGUARD.md "Platforms".
require 'agent.wg_proto'
require 'core.sys.net'

-- The OS-level socket type, as the C prototypes below see it (as in
-- core/sys/net.nelua): NetSocket is wider, and every call converts explicitly.
## if ccinfo.is_windows then
local CSocket = @usize -- SOCKET
## else
local CSocket = @cint  -- fd
## end
local function csock(s: NetSocket): CSocket return (@CSocket)(s) end

## if ccinfo.is_windows then
## cinclude '<winsock2.h>'
## cinclude '<ws2tcpip.h>'
## linklib 'ws2_32'
local function WSAGetLastError(): cint <cimport, nodecl> end
local function ioctlsocket(s: NetSocket, cmd: clong, argp: *culong): cint <cimport, nodecl> end
local function WSAIoctl(s: NetSocket, code: uint32, inb: pointer, inlen: uint32, outb: pointer, outlen: uint32,
                        ret: *uint32, ov: pointer, cr: pointer): cint <cimport, nodecl> end
local FIONBIO: clong <cimport, nodecl, const>
local WSAEWOULDBLOCK: cint <cimport, nodecl, const>
local WSAECONNRESET: cint <cimport, nodecl, const>
local WSAEMSGSIZE: cint <cimport, nodecl, const>
local SIO_UDP_CONNRESET: uint32 <comptime> = 0x9800000C -- _WSAIOW(IOC_VENDOR, 12); MinGW's headers vary on where it lives
local socklen_t = @cint
## else
## cinclude '<sys/types.h>'
## cinclude '<sys/socket.h>'
## cinclude '<netinet/in.h>'
## cinclude '<fcntl.h>'
## cinclude '<errno.h>'
local function fcntl(fd: cint, cmd: cint, ...: cvarargs): cint <cimport, nodecl> end
local F_GETFL: cint <cimport, nodecl, const>
local F_SETFL: cint <cimport, nodecl, const>
local O_NONBLOCK: cint <cimport, nodecl, const>
local F_SETFD: cint <cimport, nodecl, const>
local FD_CLOEXEC: cint <cimport, nodecl, const>
local errno: cint <cimport, nodecl>
local socklen_t <cimport, nodecl> = @cuint
## end

local in_addr <cimport, nodecl, ctypedef> = @record{ s_addr: uint32 }
local in6_addr <cimport, nodecl, ctypedef> = @record{ s6_addr: [16]uint8 }
-- every field, so Nelua's idea of the size is the C one (16 and 28 bytes)
local sockaddr_in <cimport, nodecl, ctypedef> = @record{ sin_family: cushort, sin_port: cushort, sin_addr: in_addr, sin_zero: [8]uint8 }
local sockaddr_in6 <cimport, nodecl, ctypedef> = @record{
  sin6_family: cushort, sin6_port: cushort, sin6_flowinfo: uint32, sin6_addr: in6_addr, sin6_scope_id: uint32,
}
local sockaddr_storage <cimport, nodecl, ctypedef> = @record{ ss_family: cushort }
local sockaddr <cimport, nodecl, ctypedef> = @record{ sa_family: cushort }
local function socket(domain: cint, typ: cint, protocol: cint): NetSocket <cimport, nodecl> end
local function bind(s: CSocket, addr: *sockaddr, len: socklen_t): cint <cimport, nodecl> end
local function setsockopt(s: CSocket, level: cint, name: cint, val: pointer, len: socklen_t): cint <cimport, nodecl> end
local function recvfrom(s: CSocket, buf: pointer, len: csize, flags: cint, from: *sockaddr, fromlen: *socklen_t): isize <cimport, nodecl> end
local function sendto(s: CSocket, buf: pointer, len: csize, flags: cint, to: *sockaddr, tolen: socklen_t): isize <cimport, nodecl> end
local function htons(v: uint16): uint16 <cimport, nodecl> end
local function ntohs(v: uint16): uint16 <cimport, nodecl> end
local AF_INET: cint <cimport, nodecl, const>
local AF_INET6: cint <cimport, nodecl, const>
local SOCK_DGRAM: cint <cimport, nodecl, const>
local IPPROTO_UDP: cint <cimport, nodecl, const>
local IPPROTO_IPV6: cint <cimport, nodecl, const>
local IPV6_V6ONLY: cint <cimport, nodecl, const>
local SOL_SOCKET: cint <cimport, nodecl, const>
local SO_RCVBUF: cint <cimport, nodecl, const>
local SO_SNDBUF: cint <cimport, nodecl, const>

## cinclude '<time.h>'
local timespec <cimport, nodecl, ctypedef> = @record{ tv_sec: int64, tv_nsec: clong }
local function timespec_get(ts: *timespec, base: cint): cint <cimport, nodecl> end
local TIME_UTC: cint <cimport, nodecl, const>

-- The wall clock for TAI64N: Unix seconds and nanoseconds (C11 timespec_get).
global function wg_wall(): (int64, int64)
  local ts: timespec
  timespec_get(&ts, TIME_UTC)
  return (@int64)(ts.tv_sec), (@int64)(ts.tv_nsec)
end

global WgUdp = @record{ sock: NetSocket, v6: boolean, port: uint16 }

local function nonblocking(s: NetSocket): boolean
  ## if ccinfo.is_windows then
  local one: culong = 1
  return ioctlsocket(s, FIONBIO, &one) == 0
  ## else
  fcntl(s, F_SETFD, FD_CLOEXEC)
  local flags = fcntl(s, F_GETFL, 0)
  return flags >= 0 and fcntl(s, F_SETFL, flags | O_NONBLOCK) >= 0
  ## end
end

-- Bind UDP `port` on every address (0: any free port). False when it cannot.
function WgUdp:open(port: uint16): boolean
  net.init()
  self.sock = net.invalid()
  local s = socket(AF_INET6, SOCK_DGRAM, IPPROTO_UDP)
  if net.is_valid(s) then
    local zero: cint = 0
    setsockopt(csock(s), IPPROTO_IPV6, IPV6_V6ONLY, &zero, #cint)
    local a: sockaddr_in6
    memory.zero(&a, #sockaddr_in6)
    a.sin6_family = (@cushort)(AF_INET6)
    a.sin6_port = htons(port)
    if bind(csock(s), (@*sockaddr)(&a), #sockaddr_in6) == 0 then
      self.sock, self.v6 = s, true
    else
      net.close(s)
    end
  end
  if not net.is_valid(self.sock) then
    s = socket(AF_INET, SOCK_DGRAM, IPPROTO_UDP)
    if not net.is_valid(s) then return false end
    local a: sockaddr_in
    memory.zero(&a, #sockaddr_in)
    a.sin_family = (@cushort)(AF_INET)
    a.sin_port = htons(port)
    if bind(csock(s), (@*sockaddr)(&a), #sockaddr_in) ~= 0 then net.close(s) return false end
    self.sock, self.v6 = s, false
  end
  nonblocking(self.sock)
  -- room for a burst of full-size datagrams while the loop is busy
  local size: cint = 4 * 1024 * 1024
  setsockopt(csock(self.sock), SOL_SOCKET, SO_RCVBUF, &size, #cint)
  setsockopt(csock(self.sock), SOL_SOCKET, SO_SNDBUF, &size, #cint)
  ## if ccinfo.is_windows then
  -- without this, an ICMP port unreachable for something we sent makes the
  -- next recvfrom fail with WSAECONNRESET
  local off: uint32 = 0
  local ret: uint32 = 0
  WSAIoctl(self.sock, SIO_UDP_CONNRESET, &off, 4, nilptr, 0, &ret, nilptr, nilptr)
  ## end
  self.port = port
  return true
end

function WgUdp:close(): void
  net.close(self.sock)
  self.sock = net.invalid()
end

function WgUdp:fd(): cint return (@cint)(self.sock) end

-- One datagram into `buf`: its length, or 0 when there is none now (or it
-- was not one we can use), and where it came from.
function WgUdp:recv(buf: *[0]uint8, cap: usize, from: *WgEndpoint): isize
  local ss: [128]uint8
  local len: socklen_t = 128
  local n = recvfrom(csock(self.sock), buf, cap, 0, (@*sockaddr)(&ss), &len)
  if n < 0 then
    ## if ccinfo.is_windows then
    local e = WSAGetLastError()
    if e == WSAEWOULDBLOCK then return -1 end -- nothing now
    return 0 -- a reset or an oversize datagram: skip it and keep reading
    ## else
    return -1
    ## end
  end
  $from = {}
  local fam = (@cint)((@*sockaddr)(&ss).sa_family)
  if fam == AF_INET6 then
    local a = (@*sockaddr_in6)(&ss)
    from.port = ntohs(a.sin6_port)
    local b = (@*[16]uint8)(&a.sin6_addr)
    local mapped = true
    for i = 0, < 10 do if b[i] ~= 0 then mapped = false end end
    if mapped and b[10] == 0xff and b[11] == 0xff then
      from.family = 4
      for i = 0, < 4 do from.addr[i] = b[12 + i] end
    else
      from.family = 6
      for i = 0, < 16 do from.addr[i] = b[i] end
    end
  elseif fam == AF_INET then
    local a = (@*sockaddr_in)(&ss)
    from.port = ntohs(a.sin_port)
    from.family = 4
    local b = (@*[4]uint8)(&a.sin_addr)
    for i = 0, < 4 do from.addr[i] = b[i] end
  else
    return 0
  end
  return n
end

-- Send one datagram; false when the socket refused it (the kernel's buffer
-- is full, or the address is one this socket cannot reach).
function WgUdp:send(to: *WgEndpoint, data: *[0]uint8, len: usize): boolean
  local n: isize
  if self.v6 then
    local a: sockaddr_in6
    memory.zero(&a, #sockaddr_in6)
    a.sin6_family = (@cushort)(AF_INET6)
    a.sin6_port = htons(to.port)
    local b = (@*[16]uint8)(&a.sin6_addr)
    if to.family == 4 then
      b[10], b[11] = 0xff, 0xff
      for i = 0, < 4 do b[12 + i] = to.addr[i] end
    else
      for i = 0, < 16 do b[i] = to.addr[i] end
    end
    n = sendto(csock(self.sock), data, len, 0, (@*sockaddr)(&a), #sockaddr_in6)
  else
    if to.family ~= 4 then return false end
    local a: sockaddr_in
    memory.zero(&a, #sockaddr_in)
    a.sin_family = (@cushort)(AF_INET)
    a.sin_port = htons(to.port)
    local b = (@*[4]uint8)(&a.sin_addr)
    for i = 0, < 4 do b[i] = to.addr[i] end
    n = sendto(csock(self.sock), data, len, 0, (@*sockaddr)(&a), #sockaddr_in)
  end
  return n == (@isize)(len)
end
