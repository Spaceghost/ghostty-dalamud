-- Remote window streams in ghostty-agent (docs/REMOTE_WINDOWS.md).
--
-- The generic half of window capture: WLIST, WOPEN, WACK, WINPUT and WCLOSE
-- from clients, WLISTR, WOPENED, WFRAME and WEND back. A backend
-- (agent/capture.nelua) only finds windows, hands over pixels and plays input;
-- everything between is here: scaling to the client's limit, the frame rate,
-- tile diffs against what the client already has, encoding, and flow control
-- (at most 2 unacknowledged seq, nothing encoded for a client whose output
-- queue is already over WINDOWS_OUTQ_MAX).
--
-- A stream belongs to the connection that opened it: other connections cannot
-- see or touch it, and it closes when that connection goes. Nothing about
-- windows outlives a client (unlike PTY sessions).
require 'vector'
require 'memory'
require 'math'
require 'string'
require 'core.protocol'
require 'core.wincodec'
require 'agent.capture'

local WINDOWS_OUTQ_MAX: usize <comptime> = 4 * 1024 * 1024 -- skip frames while a client is this far behind
local WINDOWS_UNACKED_MAX: uint32 <comptime> = 2
local WINDOWS_WOPEN_HEAD: usize <comptime> = 4 + 4 + 2 + 2 + 1 -- req, wid, max_w, max_h, fps

local WinStream = @record{
  sid: uint32,
  client: usize,         -- index of the owning connection
  req: uint32,           -- the WOPEN it answers
  h: pointer,            -- the backend's handle
  max_w: integer, max_h: integer,
  interval: float64,     -- seconds between frames
  announced: boolean,    -- WOPENED went out
  serial: uint64,        -- backend frame serial last looked at
  seq: uint32,           -- last seq sent
  acked: uint32,         -- last seq the client presented
  due: float64,          -- os.now() when the next frame may go
  factor: integer,       -- downscale of the latest frame (input maps back through it)
  src_w: integer, src_h: integer, -- the window's own size in the latest frame
  pw: integer, ph: integer,       -- size of `prev` (0: the client has nothing)
  prev: vector(uint8),   -- what the client has, pw x ph, stride pw * 4
  scaled: vector(uint8),
  rects: vector(WinRect),
  scratch: vector(uint8),
  body: vector(uint8),
}

global AgentWindows = @record{
  ok: boolean,
  backend: CaptureBackend,
  why: string,           -- why there is no backend (a literal)
  streams: vector(WinStream),
  next_sid: uint32,
  -- the output queue of a connection, nilptr when it is gone
  queue_of: function(ci: usize): *ByteQueue,
}

-- Pick the backend (`--windows NAME`). False and why when there is none; the
-- agent keeps running and answers window requests with that reason.
function AgentWindows:init(name: string, queue_of: function(ci: usize): *ByteQueue): (boolean, string)
  self.queue_of = queue_of
  self.next_sid = 1
  self.ok, self.backend, self.why = capture_select(name)
  return self.ok, self.why
end

local function find_stream(self: *AgentWindows, ci: usize, sid: uint32): *WinStream
  for i = 0, < #self.streams do
    local s = &self.streams[i]
    if s.sid == sid and s.client == ci then return s end
  end
  return nilptr
end

local function send_opened(q: *ByteQueue, req: uint32, sid: uint32, w: integer, h: integer, text: string): void
  local hd: [12]uint8
  proto.put_u32(&hd, req)
  proto.put_u32((@*[0]uint8)(&hd[4]), sid)
  proto.put_u16((@*[0]uint8)(&hd[8]), (@uint16)(w))
  proto.put_u16((@*[0]uint8)(&hd[10]), (@uint16)(h))
  local fh: [5]uint8
  fh[0] = PROTO_WOPENED
  proto.put_u32((@*[0]uint8)(&fh[1]), (@uint32)(12 + text.size))
  q:push(&fh, 5)
  q:push(&hd, 12)
  q:push((@*[0]uint8)(text.data), text.size)
end

-- Close the backend's handle and forget stream `i`.
local function drop(self: *AgentWindows, i: usize): void
  local s = &self.streams[i]
  self.backend.close(s.h)
  s.prev:destroy()
  s.scaled:destroy()
  s.rects:destroy()
  s.scratch:destroy()
  s.body:destroy()
  self.streams:remove(i)
end

-- One frame: scale, announce the stream if this is its first, diff against
-- what the client has, encode and queue. Nothing goes out when no pixel the
-- client can see changed.
local function stream_send(self: *AgentWindows, s: *WinStream, q: *ByteQueue, fr: *CaptureFrame, now: float64): void
  s.serial = fr.serial
  local f, w, h = wincodec_downscale(fr.pixels, fr.stride, fr.w, fr.h, s.max_w, s.max_h, &s.scaled)
  local src, stride = fr.pixels, fr.stride
  if f > 1 then src, stride = (@*[0]uint8)(&s.scaled[0]), (@usize)(w * 4) end
  s.factor, s.src_w, s.src_h = f, fr.w, fr.h
  if not s.announced then
    send_opened(q, s.req, s.sid, w, h, self.backend.title(s.h))
    s.announced = true
  end
  local key = w ~= s.pw or h ~= s.ph -- the first frame, or a new size
  if key then
    wincodec_diff(nilptr, 0, src, stride, w, h, &s.rects)
  else
    wincodec_diff((@*[0]uint8)(&s.prev[0]), (@usize)(w * 4), src, stride, w, h, &s.rects)
  end
  if #s.rects == 0 then return end
  s.seq = s.seq + 1
  wincodec_write_frames(q, s.sid, s.seq, src, stride, w, h, key, &s.rects, &s.scratch, &s.body)
  -- keep what the client now shows: all of it, or the rectangles just sent
  local row = (@usize)(w * 4)
  if key then
    s.prev:resize(row * (@usize)(h))
    for y = 0, < h do memory.copy(&s.prev[(@usize)(y) * row], &src[(@usize)(y) * stride], row) end
    s.pw, s.ph = w, h
  else
    for k = 0, < #s.rects do
      local r = s.rects[k]
      for y = (@integer)(r.y), < (@integer)(r.y) + (@integer)(r.h) do
        memory.copy(&s.prev[(@usize)(y) * row + (@usize)(r.x) * 4], &src[(@usize)(y) * stride + (@usize)(r.x) * 4], (@usize)(r.w) * 4)
      end
    end
  end
  s.due = now + s.interval
end

-- A coordinate of the (possibly scaled) frame the client sees, in window pixels.
local function unscale(v: integer, factor: integer, size: integer): integer
  if factor > 1 then v = v * factor + factor // 2 end
  if size > 0 then v = math.clamp(v, 0, size - 1) end
  return v
end

local function get_i16(p: *[0]uint8): integer
  return (@int16)(proto.get_u16(p))
end

local function handle_input(self: *AgentWindows, s: *WinStream, p: *[0]uint8, len: usize): void
  local ev: CaptureInput
  ev.kind = p[0]
  local b = (@*[0]uint8)(&p[1])
  local n = len - 1
  if ev.kind == WIN_INPUT_MOVE or ev.kind == WIN_INPUT_BUTTON or ev.kind == WIN_INPUT_WHEEL then
    if n < 4 then return end
    ev.x = unscale(get_i16(b), s.factor, s.src_w)
    ev.y = unscale(get_i16((@*[0]uint8)(&b[2])), s.factor, s.src_h)
    if ev.kind == WIN_INPUT_BUTTON then
      if n < 6 then return end
      ev.button = b[4]
      ev.down = b[5] ~= 0
    elseif ev.kind == WIN_INPUT_WHEEL then
      if n < 8 then return end
      ev.dx = get_i16((@*[0]uint8)(&b[4]))
      ev.dy = get_i16((@*[0]uint8)(&b[6]))
    end
  elseif ev.kind == WIN_INPUT_KEY then
    if n < 4 then return end
    ev.hid = proto.get_u16(b)
    ev.down = b[2] ~= 0
    ev.mods = b[3]
  elseif ev.kind == WIN_INPUT_TEXT then
    ev.text = string{data=(@*[0]byte)(b), size=n}
  elseif ev.kind ~= WIN_INPUT_FOCUS then
    return -- a kind this agent does not know
  end
  self.backend.input(s.h, &ev)
end

-- A window frame from connection `ci` (answers go to `q`). False: not a window frame.
function AgentWindows:handle(ci: usize, q: *ByteQueue, typ: uint8, payload: *[0]uint8, len: usize): boolean
  if typ == PROTO_WLIST then
    if not self.ok then proto.write_frame(q, PROTO_ERR, (@*[0]uint8)(self.why.data), self.why.size) return true end
    local text = self.backend.list()
    proto.write_frame(q, PROTO_WLISTR, (@*[0]uint8)(text.data), text.size)
    text:destroy()
  elseif typ == PROTO_WOPEN then
    if len < WINDOWS_WOPEN_HEAD then
      local why: string = 'bad wopen'
      if len >= 4 then send_opened(q, proto.get_u32(payload), 0, 0, 0, why)
      else proto.write_frame(q, PROTO_ERR, (@*[0]uint8)(why.data), why.size) end
      return true
    end
    local req = proto.get_u32(payload)
    if not self.ok then send_opened(q, req, 0, 0, 0, self.why) return true end
    local wid = proto.get_u32((@*[0]uint8)(&payload[4]))
    local max_w = (@integer)(proto.get_u16((@*[0]uint8)(&payload[8])))
    local max_h = (@integer)(proto.get_u16((@*[0]uint8)(&payload[10])))
    local fps = (@integer)(payload[12])
    if fps == 0 then fps = 30 end
    fps = math.clamp(fps, 1, 60)
    local match = string{data=(@*[0]byte)(&payload[WINDOWS_WOPEN_HEAD]), size=len - WINDOWS_WOPEN_HEAD}
    local h, why = self.backend.open(wid, match)
    if h == nilptr then
      send_opened(q, req, 0, 0, 0, #why > 0 and why or 'open failed')
      why:destroy()
      return true
    end
    why:destroy()
    self.streams:push(WinStream{
      sid = self.next_sid, client = ci, req = req, h = h, max_w = max_w, max_h = max_h,
      interval = 1.0 / fps, factor = 1,
    })
    self.next_sid = self.next_sid + 1
    if self.next_sid == 0 then self.next_sid = 1 end
  elseif typ == PROTO_WACK then
    if len < 8 then return true end
    local s = find_stream(self, ci, proto.get_u32(payload))
    if s == nilptr then return true end
    local seq = proto.get_u32((@*[0]uint8)(&payload[4]))
    -- only forward, and never past what was sent (u32 arithmetic survives wrapping)
    if seq - s.acked <= s.seq - s.acked then s.acked = seq end
  elseif typ == PROTO_WINPUT then
    if len < 5 then return true end
    local s = find_stream(self, ci, proto.get_u32(payload))
    if s == nilptr or not s.announced then return true end
    handle_input(self, s, (@*[0]uint8)(&payload[4]), len - 4)
  elseif typ == PROTO_WCLOSE then
    if len < 4 then return true end
    local sid = proto.get_u32(payload)
    for i = 0, < #self.streams do
      if self.streams[i].sid == sid and self.streams[i].client == ci then drop(self, i) break end
    end
  else
    return false
  end
  return true
end

-- Once per main loop turn, after the backend's pump: settle pending opens,
-- end streams whose window went, and send the frames that are due.
function AgentWindows:tick(now: float64): void
  if not self.ok then return end
  local i: usize = 0
  while i < #self.streams do
    local s = &self.streams[i]
    local q = self.queue_of(s.client)
    if q == nilptr then i = i + 1 continue end -- going away: the client's reap closes it
    local st, why = self.backend.state(s.h)
    local fr: CaptureFrame
    if not s.announced then
      if st == CAPTURE_PENDING then i = i + 1 continue end
      if st == CAPTURE_ENDED then
        send_opened(q, s.req, 0, 0, 0, #why > 0 and why or 'capture ended')
        drop(self, i)
        continue
      end
      -- live: announce with the first frame when there is one, else without a size
      if q:len() <= WINDOWS_OUTQ_MAX and self.backend.frame(s.h, &fr) and fr.serial ~= 0 then
        stream_send(self, s, q, &fr, now)
      else
        send_opened(q, s.req, s.sid, 0, 0, self.backend.title(s.h))
        s.announced = true
      end
      i = i + 1
      continue
    end
    if st == CAPTURE_ENDED then
      local reason = #why > 0 and why or 'capture ended'
      proto.write_frame_id(q, PROTO_WEND, s.sid, (@*[0]uint8)(reason.data), reason.size)
      drop(self, i)
      continue
    end
    if st == CAPTURE_LIVE and s.seq - s.acked < WINDOWS_UNACKED_MAX and now >= s.due
       and q:len() <= WINDOWS_OUTQ_MAX and self.backend.frame(s.h, &fr)
       and fr.serial ~= 0 and fr.serial ~= s.serial then
      stream_send(self, s, q, &fr, now)
    end
    i = i + 1
  end
end

-- The longest the main loop may sleep (ms), -1 for no limit: the backend's
-- own wish, and the next frame time of every stream that may send then.
-- Streams waiting for a WACK or for their client's queue to drain are woken
-- by that socket instead.
function AgentWindows:wait_ms(now: float64): integer
  if not self.ok or #self.streams == 0 then return -1 end
  local best = self.backend.wait_ms()
  for i = 0, < #self.streams do
    local s = &self.streams[i]
    if s.announced and s.seq - s.acked < WINDOWS_UNACKED_MAX and s.due > now then
      local ms = math.max(1, (@integer)(math.ceil((s.due - now) * 1000.0)))
      if best < 0 or ms < best then best = ms end
    end
  end
  return best
end

-- POSIX: the backend's descriptors to wake on; returns the count.
function AgentWindows:poll_fds(fds: *[0]cint, max: integer): integer
  if not self.ok then return 0 end
  return self.backend.poll_fds(fds, max)
end

function AgentWindows:pump(): void
  if self.ok then self.backend.pump() end
end

-- Connection `ci` is going away: close its streams, and renumber the streams
-- of the connections after it (the agent's client vector closes the gap).
function AgentWindows:client_gone(ci: usize): void
  local i: integer = #self.streams - 1
  while i >= 0 do
    if self.streams[i].client == ci then drop(self, (@usize)(i))
    elseif self.streams[i].client > ci then self.streams[i].client = self.streams[i].client - 1 end
    i = i - 1
  end
end
