-- Client side of the ghostty-agent protocol: one TCP connection multiplexing
-- many PTY sessions. Fully non-blocking; call `pump` every frame.
require 'string'
require 'vector'
require 'core.sys.net'
require 'core.protocol'
require 'core.wincodec'

global AgentState = @enum(cint){ Disconnected = 0, Connecting, Handshake, Ready, Failed }

global AgentEvent = @record{
  typ: uint8,       -- PROTO_* from the agent
  id: uint32,
  status: int32,    -- EXIT: exit status; CLIP: -1 when the agent has no clipboard for us
  data: *[0]uint8,  -- valid only during the callback
  len: usize,
  offset: uint64,   -- ATTACHED: the session's output bytes so far
  has_offset: boolean,
  -- version 3 windows (docs/REMOTE_WINDOWS.md): `id` is the stream id (sid)
  -- of WOPENED / WFRAME / WEND, except WOPENED's `req` below
  req: uint32,      -- WOPENED: the WOPEN it answers; JOPENED: the JOPEN it answers
  w: uint16,        -- WOPENED: the window's size
  h: uint16,
  -- version 4 jobs (docs/JOBS.md): `id` is the job id (jid) of JOPENED /
  -- JOUT / JEXIT, in its own number space -- never a session id
  stream: uint8,    -- JOUT: JOB_OUT (stdout) or JOB_ERR (stderr)
}

global AgentEventFn = @function(ctx: pointer, ev: *AgentEvent): void

global AgentClient = @record{
  sock: NetSocket,
  conn: NetConn,
  state: AgentState,
  host: string,
  port: uint16,
  token: string,
  inq: ByteQueue,
  outq: ByteQueue,
  on_event: AgentEventFn,
  ctx: pointer,
  last_error: string,
  next_open_seq: uint32,
  connect_started: float64,
  -- per connection, from the handshake reply "ghostty-agent <version> <nonce>"
  version: integer,            -- 1 for agents that send no version 2 frames
  nonce: uint64,               -- changes when the agent restarts; 0 = unknown (version 1)
  attach_fifo: vector(uint32), -- version 1: ATTACH ids waiting for OK "attached" / ERR "no such session"
  clip_fifo: vector(uint8),    -- CLIP_SET / CLIP_GET waiting for their reply
  clip_off: boolean,           -- the agent does not know clipboard frames: stop sending them
  read_chunks: integer,        -- 16 KiB socket reads per pump; 0 = 8 (window streams ask for more)
  next_job_req: uint32,        -- JOPEN request ids, matched by JOPENED's req
}

-- Why window frames are not sent to an agent greeting with version 1 or 2.
global AGENT_WINDOWS_TOO_OLD: string <comptime> = 'agent too old for windows: update ghostty-agent'
-- Why a job (a process on pipes) is not asked of an agent below version 4.
global AGENT_JOBS_TOO_OLD: string <comptime> = 'agent too old for jobs: a PTY is used instead (update ghostty-agent)'

function AgentClient:init(host: string, port: uint16, token: string): void
  $self = {}
  self.sock = net.invalid()
  self.host = host:copy()
  self.port = port
  self.token = token:copy()
end

function AgentClient:destroy(): void
  net.close(self.sock)
  self.sock = net.invalid()
  self.inq:destroy()
  self.outq:destroy()
  self.host:destroy()
  self.token:destroy()
  self.last_error:destroy()
  self.attach_fifo:destroy()
  self.clip_fifo:destroy()
  self.state = AgentState.Disconnected
end

local function set_error(self: *AgentClient, msg: string): void
  local copy = msg:copy() -- `msg` may be last_error itself
  self.last_error:destroy()
  self.last_error = copy
end

function AgentClient:disconnect(): void
  net.close(self.sock)
  self.sock = net.invalid()
  self.state = AgentState.Disconnected
end

function AgentClient:connect(now: float64): void
  if self.state == AgentState.Connecting or self.state == AgentState.Handshake or self.state == AgentState.Ready then return end
  if net.is_valid(self.sock) then self:disconnect() end
  self.inq:destroy()
  self.outq:destroy()
  self.version = 0
  self.nonce = 0
  self.attach_fifo:clear()
  self.clip_fifo:clear()
  self.clip_off = false
  self.conn = net.connect(self.host, self.port)
  if not net.is_valid(self.conn.sock) then
    self.state = AgentState.Failed
    set_error(self, 'connect failed')
    return
  end
  self.sock = self.conn.sock
  self.connect_started = now
  if self.conn.connected then
    self.state = AgentState.Handshake
    proto.write_frame(&self.outq, PROTO_HELLO, (@*[0]uint8)(self.token.data), self.token.size)
  else
    self.state = AgentState.Connecting
  end
end

function AgentClient:ready(): boolean
  return self.state == AgentState.Ready
end

local function emit(self: *AgentClient, ev: *AgentEvent): void
  if self.on_event ~= nilptr then self.on_event(self.ctx, ev) end
end

-- Session frames go out only on an authenticated connection: the agent drops
-- a client whose first frame is not HELLO, and every connection starts with an
-- empty queue anyway. Callers send again what matters once Ready.

-- Request a new session; false when not connected (nothing was sent). The
-- agent answers with OPENED carrying the real session id, in request order.
function AgentClient:open(cols: uint16, rows: uint16, argv: *vector(string), env: *vector(string)): boolean
  if self.state ~= AgentState.Ready then return false end
  local payload: ByteQueue
  local b: [4]uint8
  proto.put_u16(&b, cols)
  proto.put_u16((@*[0]uint8)(&b[2]), rows)
  payload:push(&b, 4)
  for i = 0, < #argv do
    payload:push_string(argv[i])
    local z: [1]uint8
    payload:push(&z, 1)
  end
  local zz: [1]uint8
  payload:push(&zz, 1)
  if env ~= nilptr then
    for i = 0, < #env do
      payload:push_string(env[i])
      local z: [1]uint8
      payload:push(&z, 1)
    end
  end
  proto.write_frame(&self.outq, PROTO_OPEN, payload:peek(), payload:len())
  payload:destroy()
  return true
end

function AgentClient:write(id: uint32, data: *[0]uint8, len: usize): void
  if self.state ~= AgentState.Ready then return end
  proto.write_frame_id(&self.outq, PROTO_DATA, id, data, len)
end

function AgentClient:resize(id: uint32, cols: uint16, rows: uint16): void
  if self.state ~= AgentState.Ready then return end
  local b: [4]uint8
  proto.put_u16(&b, cols)
  proto.put_u16((@*[0]uint8)(&b[2]), rows)
  proto.write_frame_id(&self.outq, PROTO_RESIZE, id, &b, 4)
end

function AgentClient:close_session(id: uint32): void
  if self.state ~= AgentState.Ready then return end
  proto.write_frame_id(&self.outq, PROTO_CLOSE, id, nilptr, 0)
end

-- Subscribe to a session. `fed` is how many of its output bytes this client
-- already fed to its terminal: a version 2 agent replays only the rest while
-- it still has them. True when the ATTACH was sent; ATTACHED (or EXIT for an
-- unknown id) follows.
function AgentClient:attach(id: uint32, fed: uint64): boolean
  if self.state ~= AgentState.Ready then return false end
  local b: [8]uint8
  proto.put_u64(&b, fed)
  proto.write_frame_id(&self.outq, PROTO_ATTACH, id, &b, 8)
  if self.version < 2 then self.attach_fifo:push(id) end
  return true
end

function AgentClient:detach(id: uint32): void
  if self.state ~= AgentState.Ready then return end
  proto.write_frame_id(&self.outq, PROTO_DETACH, id, nilptr, 0)
end

-- The host's system clipboard (the desktop the agent runs on). An agent that
-- answers these with ERR "unknown frame" gets no more of them on this connection.
function AgentClient:clip_set(text: string): void
  if self.state ~= AgentState.Ready or self.clip_off then return end
  proto.write_frame(&self.outq, PROTO_CLIP_SET, (@*[0]uint8)(text.data), text.size)
  self.clip_fifo:push(PROTO_CLIP_SET)
end

-- Answered by a CLIP event; its status is -1 (and no text) when the agent has
-- no clipboard for us, so the caller can fall back to its own.
function AgentClient:clip_get(): void
  if self.state ~= AgentState.Ready then return end
  if self.clip_off then
    local ev: AgentEvent = { typ = PROTO_CLIP, status = -1 }
    emit(self, &ev)
    return
  end
  proto.write_frame(&self.outq, PROTO_CLIP_GET, nilptr, 0)
  self.clip_fifo:push(PROTO_CLIP_GET)
end

function AgentClient:list(): void
  if self.state ~= AgentState.Ready then return end
  proto.write_frame(&self.outq, PROTO_LIST, nilptr, 0)
end

-- Raw jobs (version 4, docs/JOBS.md) ------------------------------------------
-- A job is a process the agent runs on pipes instead of a PTY: no terminal, no
-- screen, no reflow, so a line of JSON arrives as the program wrote it. Only a
-- version 4 agent knows these frames.

function AgentClient:jobs_ok(): boolean
  return self.state == AgentState.Ready and self.version >= 4
end

-- A request id for the next JOPEN (never 0, so 0 can mean "none").
function AgentClient:job_req(): uint32
  self.next_job_req = self.next_job_req + 1
  if self.next_job_req == 0 then self.next_job_req = 1 end
  return self.next_job_req
end

-- Ask for a job: req u32, flags u8, then argv and env exactly as OPEN carries
-- them. The agent answers JOPENED with this req. False when nothing was sent.
function AgentClient:jopen(req: uint32, flags: uint8, argv: *vector(string), env: *vector(string)): boolean
  if not self:jobs_ok() or #argv == 0 then return false end
  local payload: ByteQueue
  local b: [5]uint8
  proto.put_u32(&b, req)
  b[4] = flags
  payload:push(&b, 5)
  for i = 0, < #argv do
    payload:push_string(argv[i])
    local z: [1]uint8
    payload:push(&z, 1)
  end
  local zz: [1]uint8
  payload:push(&zz, 1)
  if env ~= nilptr then
    for i = 0, < #env do
      payload:push_string(env[i])
      local z: [1]uint8
      payload:push(&z, 1)
    end
  end
  proto.write_frame(&self.outq, PROTO_JOPEN, payload:peek(), payload:len())
  payload:destroy()
  return true
end

-- Bytes for the job's stdin; none closes it (the job sees EOF).
function AgentClient:jdata(jid: uint32, data: *[0]uint8, len: usize): void
  if self.state ~= AgentState.Ready then return end
  proto.write_frame_id(&self.outq, PROTO_JDATA, jid, data, len)
end

function AgentClient:jclose(jid: uint32): void
  if self.state ~= AgentState.Ready then return end
  proto.write_frame_id(&self.outq, PROTO_JCLOSE, jid, nilptr, 0)
end

-- Remote windows (version 3) ---------------------------------------------------
-- Only a version 3 agent knows these frames; an older one would answer
-- "unknown frame" and, worse for WOPEN, never a WOPENED. Each request to one
-- is refused here: false, plus an ERR event carrying AGENT_WINDOWS_TOO_OLD.

-- Connected to an agent that streams windows.
function AgentClient:windows_ok(): boolean
  return self.state == AgentState.Ready and self.version >= 3
end

local function windows_refuse(self: *AgentClient): boolean
  if self.state ~= AgentState.Ready then return false end
  local msg: string = AGENT_WINDOWS_TOO_OLD
  local ev: AgentEvent = { typ = PROTO_ERR, data = (@*[0]uint8)(msg.data), len = msg.size }
  emit(self, &ev)
  return false
end

-- Ask for the windows the agent can capture; answered by a WLISTR event.
function AgentClient:wlist(): boolean
  if not self:windows_ok() then return windows_refuse(self) end
  proto.write_frame(&self.outq, PROTO_WLIST, nilptr, 0)
  return true
end

-- Ask for the apps the agent can start (WLIST "apps"); answered by a WLISTR
-- of app lines. An agent from before app lists answers with its windows.
function AgentClient:wlist_apps(): boolean
  if not self:windows_ok() then return windows_refuse(self) end
  local what: string = 'apps'
  proto.write_frame(&self.outq, PROTO_WLIST, (@*[0]uint8)(what.data), what.size)
  return true
end

-- Subscribe to the window list (WLIST "watch"): answered at once, then pushed
-- again whenever a window maps or unmaps or one of our streams opens or
-- closes. An agent from before watching answers once and never again.
function AgentClient:wlist_watch(): boolean
  if not self:windows_ok() then return windows_refuse(self) end
  local what: string = 'watch'
  proto.write_frame(&self.outq, PROTO_WLIST, (@*[0]uint8)(what.data), what.size)
  return true
end

-- Open window `wid` (0: the desktop picks, or the first matching `match`)
-- as a stream no larger than max_w x max_h at up to `fps`. Answered, maybe
-- much later, by a WOPENED event carrying `req`.
function AgentClient:wopen(req: uint32, wid: uint32, max_w: uint16, max_h: uint16, fps: uint8, match: string): boolean
  if not self:windows_ok() then return windows_refuse(self) end
  local b: [13]uint8
  proto.put_u32(&b, req)
  proto.put_u32((@*[0]uint8)(&b[4]), wid)
  proto.put_u16((@*[0]uint8)(&b[8]), max_w)
  proto.put_u16((@*[0]uint8)(&b[10]), max_h)
  b[12] = fps
  local hdr: [5]uint8
  hdr[0] = PROTO_WOPEN
  proto.put_u32((@*[0]uint8)(&hdr[1]), (@uint32)(13 + match.size))
  self.outq:push(&hdr, 5)
  self.outq:push(&b, 13)
  if match.size > 0 then self.outq:push((@*[0]uint8)(match.data), match.size) end
  return true
end

-- The frame `seq` of stream `sid` is on screen: the agent may send more.
function AgentClient:wack(sid: uint32, seq: uint32): void
  if not self:windows_ok() then return end
  local b: [4]uint8
  proto.put_u32(&b, seq)
  proto.write_frame_id(&self.outq, PROTO_WACK, sid, &b, 4)
end

-- Pointer or keyboard input for stream `sid`: WIN_INPUT_* `kind` and its body.
function AgentClient:winput(sid: uint32, kind: uint8, body: *[0]uint8, len: usize): void
  if not self:windows_ok() then return end
  local hdr: [10]uint8
  hdr[0] = PROTO_WINPUT
  proto.put_u32((@*[0]uint8)(&hdr[1]), (@uint32)(5 + len))
  proto.put_u32((@*[0]uint8)(&hdr[5]), sid)
  hdr[9] = kind
  self.outq:push(&hdr, 10)
  if len > 0 then self.outq:push(body, len) end
end

-- Clips (docs/CAPTURE.md): start one on the host, whose answer is a COPENED
-- event carrying `req`. False when there is no connection.
function AgentClient:copen(req: uint32, kind: uint8, w: uint16, h: uint16, fps: uint8): boolean
  if self.state ~= AgentState.Ready then return false end
  local b: [10]uint8
  proto.put_u32(&b, req)
  b[4] = kind
  proto.put_u16((@*[0]uint8)(&b[5]), w)
  proto.put_u16((@*[0]uint8)(&b[7]), h)
  b[9] = fps
  proto.write_frame(&self.outq, PROTO_COPEN, (@*[0]uint8)(&b), 10)
  return true
end

-- One frame of clip `cid`, already encoded (WINCODEC_ENC_QOI or _RAW).
function AgentClient:cframe(cid: uint32, seq: uint32, enc: uint8, data: *[0]uint8, len: usize): void
  if self.state ~= AgentState.Ready then return end
  local hdr: [14]uint8
  hdr[0] = PROTO_CFRAME
  proto.put_u32((@*[0]uint8)(&hdr[1]), (@uint32)(9 + len))
  proto.put_u32((@*[0]uint8)(&hdr[5]), cid)
  proto.put_u32((@*[0]uint8)(&hdr[9]), seq)
  hdr[13] = enc
  self.outq:push(&hdr, 14)
  if len > 0 then self.outq:push(data, len) end
end

-- The same, from rows that may be wider than the frame (a strided readback):
-- only the pixels are sent, without the padding at the end of each row.
function AgentClient:cframe_rows(cid: uint32, seq: uint32, src: *[0]uint8, stride: usize, w: integer, h: integer): void
  if self.state ~= AgentState.Ready then return end
  local row = (@usize)(w) * 4
  local hdr: [14]uint8
  hdr[0] = PROTO_CFRAME
  proto.put_u32((@*[0]uint8)(&hdr[1]), (@uint32)(9 + row * (@usize)(h)))
  proto.put_u32((@*[0]uint8)(&hdr[5]), cid)
  proto.put_u32((@*[0]uint8)(&hdr[9]), seq)
  hdr[13] = WINCODEC_ENC_RAW
  self.outq:push(&hdr, 14)
  for y = 0, < h do self.outq:push((@*[0]uint8)(&src[(@usize)(y) * stride]), row) end
end

-- No more frames: the host encodes what it has (`cancel`: it writes nothing).
function AgentClient:cend(cid: uint32, cancel: boolean): void
  if self.state ~= AgentState.Ready then return end
  local b: [1]uint8 = { cancel and 1 or 0 }
  proto.write_frame_id(&self.outq, PROTO_CEND, cid, (@*[0]uint8)(&b), 1)
end

function AgentClient:wclose(sid: uint32): void
  if not self:windows_ok() then return end
  proto.write_frame_id(&self.outq, PROTO_WCLOSE, sid, nilptr, 0)
end

-- One row of a LISTR reply: "id\tcols\trows\tattached\tcommand\n".
global AgentListEntry = @record{ id: uint32, cols: uint16, rows: uint16, attached: integer, command: string }

-- Parse a LISTR payload. Entries borrow `data` for `command`.
global function agent_parse_list(data: *[0]uint8, len: usize): vector(AgentListEntry)
  local out: vector(AgentListEntry)
  local text = string{data=(@*[0]byte)(data), size=len}
  local line_start: usize = 0
  for pos: usize = 0, < len do
    if data[pos] == 10 then
      local fields: [5]string
      local nf: integer = 0
      local fs: usize = line_start
      for k: usize = line_start, < pos + 1 do
        if nf < 4 and (k == pos or data[k] == 9) then
          fields[nf] = string{data=(@*[0]byte)(&data[fs]), size=k - fs}
          nf = nf + 1
          fs = k + 1
        end
      end
      if nf == 4 then
        fields[4] = string{data=(@*[0]byte)(&data[fs]), size=pos - fs}
        local id, ok1 = tointeger(fields[0])
        out:push(AgentListEntry{
          id = (@uint32)(id), cols = (@uint16)(tointeger(fields[1])), rows = (@uint16)(tointeger(fields[2])),
          attached = tointeger(fields[3]), command = fields[4],
        })
      end
      line_start = pos + 1
    end
  end
  return out
end

local function parse_digits(text: string, i: usize): (uint64, usize)
  local v: uint64 = 0
  while i < text.size and text.data[i] >= '0'_b and text.data[i] <= '9'_b do
    v = v * 10 + (text.data[i] - '0'_b)
    i = i + 1
  end
  return v, i
end

-- "ghostty-agent <version> [<nonce>]"; anything else counts as version 1.
local function parse_greeting(self: *AgentClient, text: string): void
  self.version = 1
  self.nonce = 0
  local prefix: string = 'ghostty-agent '
  if text.size <= prefix.size or text:subview(1, prefix.size) ~= prefix then return end
  local v, i = parse_digits(text, prefix.size)
  if i == prefix.size or v > 1000 then return end
  self.version = (@integer)(v)
  if i < text.size and text.data[i] == ' '_b then
    local n, j = parse_digits(text, i + 1)
    if j > i + 1 then self.nonce = n end
  end
end

-- A clipboard request got its reply: which kind it was (0 when none waited).
local function clip_reply(self: *AgentClient): uint8
  if #self.clip_fifo == 0 then return 0 end
  local kind = self.clip_fifo[0]
  self.clip_fifo:remove(0)
  return kind
end

local function dispatch(self: *AgentClient): void
  while true do
    local ok, typ, payload, len = proto.read_frame(&self.inq)
    if not ok then break end
    local ev: AgentEvent = { typ = typ, data = payload, len = len }
    local text = string{data=(@*[0]byte)(payload), size=len}
    local deliver = true
    local handshake_failed = false
    if typ == PROTO_OK then
      if self.state == AgentState.Handshake then
        parse_greeting(self, text)
        self.state = AgentState.Ready
      elseif self.version < 2 and text == 'attached' and #self.attach_fifo > 0 then
        ev = { typ = PROTO_ATTACHED, id = self.attach_fifo[0] }
        self.attach_fifo:remove(0)
      elseif text == 'clipboard set' then
        clip_reply(self)
      end
    elseif typ == PROTO_ERR then
      if self.state == AgentState.Handshake then
        set_error(self, text)
        handshake_failed = true
      elseif (text == 'unknown frame' or text == 'clipboard unavailable') and #self.clip_fifo > 0 then
        local kind = clip_reply(self)
        if text == 'unknown frame' then
          deliver = false -- said once below, not for every request still on its way
          if not self.clip_off then
            self.clip_off = true
            local note: string = 'agent does not know clipboard frames; clipboard sync off until it reconnects'
            local nev: AgentEvent = { typ = PROTO_ERR, data = (@*[0]uint8)(note.data), len = note.size }
            emit(self, &nev)
          end
        end
        if kind == PROTO_CLIP_GET then
          if deliver then emit(self, &ev) end
          ev = { typ = PROTO_CLIP, status = -1 } -- the paste still gets its answer
          deliver = true
        end
      elseif self.version < 2 and text == 'no such session' and #self.attach_fifo > 0 then
        ev = { typ = PROTO_EXIT, id = self.attach_fifo[0], status = (@int32)(PROTO_NO_SESSION) }
        self.attach_fifo:remove(0)
      elseif self.version < 2 and (text == 'bad open' or text == 'forkpty failed') then
        ev = { typ = PROTO_OPENED, id = 0, data = payload, len = len }
      end
    elseif typ == PROTO_OPENED or typ == PROTO_SDATA or typ == PROTO_EXIT or typ == PROTO_ATTACHED then
      if len >= 4 then
        ev.id = proto.get_u32(payload)
        ev.data = (@*[0]uint8)(&payload[4])
        ev.len = len - 4
        if typ == PROTO_EXIT and ev.len >= 4 then
          ev.status = (@int32)(proto.get_u32(ev.data))
        elseif typ == PROTO_ATTACHED and ev.len >= 8 then
          ev.offset = proto.get_u64(ev.data)
          ev.has_offset = true
        end
      else
        deliver = false -- malformed: an OPENED without an id must not take a waiting session
      end
    elseif typ == PROTO_CLIP then
      clip_reply(self)
    elseif typ == PROTO_WOPENED then
      -- req, sid, w, h, title (sid 0: refused, the text says why)
      if len >= 12 then
        ev.req = proto.get_u32(payload)
        ev.id = proto.get_u32((@*[0]uint8)(&payload[4]))
        ev.w = proto.get_u16((@*[0]uint8)(&payload[8]))
        ev.h = proto.get_u16((@*[0]uint8)(&payload[10]))
        ev.data = (@*[0]uint8)(&payload[12])
        ev.len = len - 12
      else
        deliver = false
      end
    elseif typ == PROTO_JOPENED then
      -- req, jid, pid (jid 0: the open failed and the text says why)
      if len >= 12 then
        ev.req = proto.get_u32(payload)
        ev.id = proto.get_u32((@*[0]uint8)(&payload[4]))
        ev.status = (@int32)(proto.get_u32((@*[0]uint8)(&payload[8]))) -- the pid
        ev.data = (@*[0]uint8)(&payload[12])
        ev.len = len - 12
      else
        deliver = false
      end
    elseif typ == PROTO_JOUT then
      -- jid, stream u8, bytes
      if len >= 5 then
        ev.id = proto.get_u32(payload)
        ev.stream = payload[4]
        ev.data = (@*[0]uint8)(&payload[5])
        ev.len = len - 5
      else
        deliver = false
      end
    elseif typ == PROTO_JEXIT then
      if len >= 8 then
        ev.id = proto.get_u32(payload)
        ev.status = (@int32)(proto.get_u32((@*[0]uint8)(&payload[4])))
        ev.data = nilptr
        ev.len = 0
      else
        deliver = false
      end
    elseif typ == PROTO_WFRAME then
      -- the whole payload stays for wincodec_parse; the sid is read ahead
      if len >= 4 then ev.id = proto.get_u32(payload) else deliver = false end
    elseif typ == PROTO_COPENED then
      -- req, cid, text (cid 0: the host refused, the text says why)
      if len >= 8 then
        ev.req = proto.get_u32(payload)
        ev.id = proto.get_u32((@*[0]uint8)(&payload[4]))
        ev.data = (@*[0]uint8)(&payload[8])
        ev.len = len - 8
      else
        deliver = false
      end
    elseif typ == PROTO_CDONE then
      if len >= 8 then
        ev.id = proto.get_u32(payload)
        ev.status = (@int32)(proto.get_u32((@*[0]uint8)(&payload[4])))
        ev.data = (@*[0]uint8)(&payload[8])
        ev.len = len - 8
      else
        deliver = false
      end
    elseif typ == PROTO_WEND then
      if len >= 4 then
        ev.id = proto.get_u32(payload)
        ev.data = (@*[0]uint8)(&payload[4])
        ev.len = len - 4
      else
        deliver = false
      end
    end
    if deliver then emit(self, &ev) end
    proto.frame_consume(&self.inq, len)
    if handshake_failed then
      -- refused (bad token): close the socket now, the retry opens a new one
      self:disconnect()
      self.state = AgentState.Failed
      self.inq:destroy()
      break
    end
  end
end

-- Send what is queued, as far as the socket takes it now. False when the
-- connection broke (or there is none).
function AgentClient:flush(): boolean
  if self.state ~= AgentState.Handshake and self.state ~= AgentState.Ready then return false end
  while self.outq:len() > 0 do
    local n = net.send(self.sock, self.outq:peek(), self.outq:len())
    if n < 0 then
      self:disconnect()
      self.state = AgentState.Failed
      set_error(self, 'connection lost')
      return false
    elseif n == 0 then
      break
    else
      self.outq:consume((@usize)(n))
    end
  end
  return true
end

-- Drive I/O. `now` is a monotonic clock in seconds (ImGui time is fine).
function AgentClient:pump(now: float64): void
  if self.state == AgentState.Connecting then
    local r = net.connect_poll(&self.conn)
    if r == 1 then
      self.state = AgentState.Handshake
      -- HELLO must be the first frame the agent sees, whatever got queued
      local q: ByteQueue
      proto.write_frame(&q, PROTO_HELLO, (@*[0]uint8)(self.token.data), self.token.size)
      if self.outq:len() > 0 then q:push(self.outq:peek(), self.outq:len()) end
      self.outq:destroy()
      self.outq = q
    elseif r == -1 or now - self.connect_started > 5.0 then
      self:disconnect()
      self.state = AgentState.Failed
      set_error(self, 'agent unreachable')
      return
    else
      return
    end
  end
  if self.state ~= AgentState.Handshake and self.state ~= AgentState.Ready then return end

  if not self:flush() then return end

  -- read input, a bounded amount per frame: a flood waits in the socket (and
  -- the agent stops reading the shell) instead of stalling the game
  local buf: [16384]uint8
  local chunks = self.read_chunks > 0 and self.read_chunks or 8
  for _ = 1, chunks do
    local n = net.recv(self.sock, &buf, 16384)
    if n > 0 then
      self.inq:push(&buf, (@usize)(n))
    elseif n == 0 then
      break
    else
      self:disconnect()
      self.state = AgentState.Failed
      set_error(self, 'connection closed')
      break
    end
  end
  dispatch(self)
end
