

-- The ghostty-agent connection and session lifetime: open, reattach (LIST /
-- ATTACH after a reload), and removal.
require 'core.app.state'
require 'core.app.voice'
require 'core.sys.conpty'

-- A character is loaded (not the title screen or character select): pets and
-- pins follow it, so they are not opened without one.
global function player_loaded(): boolean
  local pc: GuObject
  return host.api.get_object ~= nilptr and host.api.get_object(WORLD_PLAYER, 0, &pc) ~= 0 and pc.found ~= 0
end

-- Agent ----------------------------------------------------------------------
-- Paste text into a terminal: bracketed when the application asked for it
-- (DEC 2004), plain otherwise; libghostty does the wrapping and newlines.
global function paste_text(s: *Session, str: string): void
  if #str == 0 then return end
  local bracketed = ghostty_terminal_mode_enabled(s.view.term, 2004, false)
  local cap = str.size + 32
  local buf = (@*[0]cchar)(default_allocator:alloc(cap))
  if buf == nilptr then return end
  local written: usize = 0
  if ghostty_paste_encode((@cstring)(str.data), str.size, bracketed, buf, cap, &written) == GHOSTTY_SUCCESS and written > 0 then
    s:write((@*[0]uint8)(buf), written)
  else
    s:write_string(str)
  end
  default_allocator:dealloc(buf)
  s.view:scroll_bottom()
end

-- The open terminal streaming agent session `id`, if any. Jobs are skipped:
-- their jids are a number space of their own, so jid 3 is not session 3.
local function find_agent_session(id: uint32): *Session
  if id == 0 then return nilptr end
  for i = 0, < #host.sessions do
    local s = host.sessions[i]
    if s.kind == TransportKind.Agent and s.agent ~= nilptr and not s.awaiting_open and not s.job and s.agent_id == id then return s end
  end
  return nilptr
end

-- Take a session out of the queue waiting for an open: a job leaves no hole
-- behind, or the next OPENED would take it for a closed terminal and close
-- the shell it answers.
local function drop_pending(s: *Session): void
  for i = 0, < #host.pending_open do
    if host.pending_open[i] == s then host.pending_open:remove(i) return end
  end
end

-- The session of job `jid` (docs/JOBS.md), if any.
local function find_job_session(jid: uint32): *Session
  if jid == 0 then return nilptr end
  for i = 0, < #host.sessions do
    local s = host.sessions[i]
    if s.kind == TransportKind.Agent and s.job and not s.awaiting_open and s.agent_id == jid then return s end
  end
  return nilptr
end

-- Remote window replies (WLISTR, WOPENED, WFRAME, WEND, WGEOM) belong to
-- core/app/remotewin.nelua, which sets this before sending its first request.
-- `link` says which agent answered: several may be connected at once, and a
-- window list, a stream id and a frame mean nothing without it.
global agent_window_event: function(link: *AgentLink, ev: *AgentEvent): void

-- Clip replies (COPENED, CDONE) belong to core/app/capture.nelua, which sets
-- this before it asks for its first clip.
global agent_clip_event: function(ev: *AgentEvent): void

-- Netlab's NLREPLY, NLSTAT and NLFRAME (core/app/netlab.nelua sets it; docs/NETLAB.md).
global agent_netlab_event: function(ev: *AgentEvent): void

global function agent_event(ctx: pointer, ev: *AgentEvent): void
  -- every link sets ctx to itself; the local one leaves it nilptr
  local link: *AgentLink = ctx ~= nilptr and (@*AgentLink)(ctx) or &host.local_agent
  if ev.typ >= PROTO_WLISTR and ev.typ <= PROTO_WGEOM then
    if agent_window_event ~= nilptr then agent_window_event(link, ev) end
  elseif ev.typ >= PROTO_NLREPLY and ev.typ <= PROTO_NLFRAME then
    -- the panel speaks NLCTL to the local agent only (core/app/netlab.nelua)
    if agent_netlab_event ~= nilptr and link == &host.local_agent then agent_netlab_event(ev) end
  elseif ev.typ == PROTO_COPENED or ev.typ == PROTO_CDONE then
    if agent_clip_event ~= nilptr then agent_clip_event(ev) end
  elseif ev.typ == PROTO_OPENED then
    -- OPENED answers the OPENs in order. A closed terminal leaves a nilptr in
    -- its place, so the answers after it still reach the right terminals.
    -- Sessions waiting for a JOPENED are skipped: jobs are answered by req,
    -- not in this order (docs/JOBS.md).
    local s: *Session = nilptr
    for i = 0, < #host.pending_open do
      local c = host.pending_open[i]
      if c == nilptr or not c.job then
        s = c
        host.pending_open:remove(i)
        break
      end
    end
    if s == nilptr then
      -- nobody wants this shell any more: don't leave it running
      if ev.id ~= 0 then host.local_agent.client:close_session(ev.id) end
    elseif ev.id == 0 then
      local sb: stringbuilder -- no `..` chain: its intermediate strings would leak
      sb:write('\r\n[ghostty] agent refused: ', string{data=(@*[0]byte)(ev.data), size=ev.len}, '\r\n')
      local msg = sb:promote()
      s:feed_text(msg)
      msg:destroy()
      if s.assistant then -- e.g. the Windows agent could not start the command
        local note = policy_assistant_exit(0, true)
        s:feed_text(note)
        note:destroy()
      end
      s.exited = true
    else
      s:agent_opened(ev.id)
    end
  elseif ev.typ == PROTO_SDATA then
    local s = find_agent_session(ev.id)
    if s ~= nilptr then s:feed(ev.data, ev.len) end
  elseif ev.typ == PROTO_EXIT then
    for i = 0, < #host.sessions do
      local s = host.sessions[i]
      if s.kind == TransportKind.Agent and not s.awaiting_open and not s.job and s.agent_id == ev.id and ev.id ~= 0 then
        s:mark_exited(ev.status)
      end
    end
  elseif ev.typ == PROTO_JOPENED and voice_on_opened(ev.req, ev.id, string{data=(@*[0]byte)(ev.data), size=ev.len}) then
    -- voice input's job (core/app/voice.nelua)
  elseif ev.typ == PROTO_JOPENED then
    -- JOPENED answers by the req its JOPEN carried, not in order
    local s: *Session = nilptr
    for i = 0, < #host.sessions do
      local c = host.sessions[i]
      if c.kind == TransportKind.Agent and c.job and c.awaiting_open and c.job_req ~= 0 and c.job_req == ev.req then s = c break end
    end
    if s == nilptr then
      -- nobody waits for it any more: do not leave the process running
      if ev.id ~= 0 then host.local_agent.client:jclose(ev.id) end
    elseif ev.id == 0 then
      -- The agent would not run it as a job: this one has no job runner (the
      -- Windows agent's stub refuses every JOPEN), or the command itself
      -- cannot start. Ask again as a PTY session, which every agent can do,
      -- and let that answer decide -- a console there may reflow long lines,
      -- but an answer beats none. It goes to the back of the queue because
      -- its OPEN is sent now, after the ones already waiting.
      logf(LOG_INFO, 'session %d: agent refused a job (%s); asking for a PTY instead',
        s.id, string{data=(@*[0]byte)(ev.data), size=ev.len})
      s.job = false
      s.job_req = 0
      drop_pending(s)
      s:reopen()
      host.pending_open:push(s)
    else
      drop_pending(s)
      s:agent_opened(ev.id)
    end
  elseif ev.typ == PROTO_JOUT and voice_on_out(ev.id, ev.stream, ev.data, ev.len) then
  elseif ev.typ == PROTO_JEXIT and voice_on_exit(ev.id, ev.status, paste_text) then
  elseif ev.typ == PROTO_JOUT then
    local s = find_job_session(ev.id)
    if s ~= nilptr then s:feed(ev.data, ev.len) end -- stdout and stderr, in the order they came
  elseif ev.typ == PROTO_JEXIT then
    local s = find_job_session(ev.id)
    if s ~= nilptr then s:mark_exited(ev.status) end
  elseif ev.typ == PROTO_ATTACHED then
    local s = find_agent_session(ev.id)
    if s ~= nilptr then s:attached(ev.has_offset, ev.offset) end
  elseif ev.typ == PROTO_ERR then
    -- only logged: failed OPENs and unknown ATTACH ids come as OPENED / EXIT
    logf(LOG_WARN, 'agent: %s', string{data=(@*[0]byte)(ev.data), size=ev.len})
  elseif ev.typ == PROTO_OK then
    -- handshake / attach acks
  elseif ev.typ == PROTO_CLIP then
    -- the system clipboard arrived for a paste
    local target = host.paste_target
    host.paste_target = 0
    for i = 0, < #host.sessions do
      local s = host.sessions[i]
      if s.id == target then
        if ev.status >= 0 then
          paste_text(s, string{data=(@*[0]byte)(ev.data), size=ev.len})
        elseif host.imgui_ok then
          -- the agent has no clipboard for us: the game's (Wine) clipboard
          local txt = imgui.GetClipboardText()
          if txt ~= nilptr then paste_text(s, txt) end
        end
        break
      end
    end
  elseif ev.typ == PROTO_LISTR then
    -- Reattach every shell nobody is attached to, so restarting the game (or
    -- reloading the plugin) brings the same terminals back.
    local entries = agent_parse_list(ev.data, ev.len)
    for i = 0, < #entries do
      local e = entries[i]
      if e.attached == 0 and e.id ~= 0 and find_agent_session(e.id) == nilptr then
        local s = new(@Session)
        if s:init_attach(host.next_session_id, e.command, e.cols, e.rows, &host.local_agent.client, e.id) then
          host.next_session_id = host.next_session_id + 1
          host.sessions:push(s)
          -- put it back where it was: world (with its anchor), window, minimized or tab
          local view, fs = policy_world_restore(s.id, e.id)
          s.font_scale = fs
          if view == 'world' then
            host.world:push(s)
            host.world_visible = true
            host.world_pins_done = true
          elseif view == 'window' then
            host.windows:push(s)
          elseif view == 'min' then
            host.minimized:push(s)
          elseif view == 'native' then
            host.native:push(s) -- a game window again (core/app/nativeview.nelua; an ImGui window if it cannot be)
          else
            host.dropdown_tabs:push(s)
            host.dropdown_active = #host.dropdown_tabs - 1
          end
          logf(LOG_INFO, 'session %d: reattached agent session %d as %s', s.id, e.id, #view > 0 and view or 'tab')
          view:destroy()
        else
          s:destroy()
          delete(s)
        end
      end
    end
    entries:destroy()
    host.reattach_done = true
    host.layout_restored = true -- saving the layout can no longer overwrite the one just restored
  end
end

-- The token for one agent: the inline one, else the file, else empty.
global function read_token_of(token: string, token_file: string): string
  if #token > 0 then return token:copy() end
  if #token_file > 0 then
    require 'io'
    local f = io.open(token_file, 'rb')
    if f:isopen() then
      local content = f:read('a')
      f:destroy() -- close() alone keeps the stream record allocated (no GC)
      local e = #content
      while e > 0 and (content:byte(e) == 10 or content:byte(e) == 13 or content:byte(e) == 32) do e = e - 1 end
      local tok = content:sub(1, e)
      content:destroy()
      return tok
    end
    logf(LOG_WARN, 'agent token file not readable: %s', token_file)
  end
  return string.copy('')
end

global function read_token(): string
  return read_token_of(policy.agent.token, policy.agent.token_file)
end

-- The links from CONFIG.agents. They stream windows and nothing else: no
-- shells, no saved layout and no fallbacks, because a terminal always runs on
-- the local agent (docs/MULTI_AGENT.md).
global function agent_extras_teardown(): void
  for i = 0, < #host.agents do
    local link = host.agents[i]
    link.client:destroy()
    link.error_shown:destroy()
    link.name:destroy()
    delete(link)
  end
  host.agents:clear()
end

global function agent_extras_setup(): void
  agent_extras_teardown()
  for i = 0, < #policy.agents do
    local cfg: *NamedAgentCfg = &policy.agents[i]
    local link: *AgentLink = new(@AgentLink)
    link.name = string.copy(cfg.name)
    -- A link with no token of its own uses the CONFIG.agent one. These are the
    -- owner's machines on one tailnet sharing one secret, and making every
    -- entry repeat it means pasting a secret into config per machine. It is
    -- also what happens in practice when token_file does not resolve: under
    -- Wine `home` in init.lua points inside the prefix, not at the Linux home,
    -- so the file is not there and the link would otherwise send nothing and
    -- be refused with 'bad token'. Per-peer keys replace all of this
    -- (docs/MULTI_AGENT.md, "Other people's machines").
    local tok = read_token_of(cfg.cfg.token, cfg.cfg.token_file)
    if #tok == 0 then
      tok:destroy()
      tok = read_token()
      if #tok > 0 then
        logf(LOG_INFO, 'agent link "%s": no token of its own, using the CONFIG.agent one', cfg.name)
      end
    end
    link.client:init(cfg.cfg.host, (@uint16)(cfg.cfg.port), tok)
    link.client.node:destroy()
    link.client.node = cfg.cfg.node:copy()
    tok:destroy()
    link.client.on_event = agent_event
    link.client.ctx = link -- which link an event came from
    link.enabled = true
    link.last_try = -100.0
    link.prev_state = AgentState.Disconnected
    host.agents:push(link)
    if #cfg.cfg.node > 0 then
      logf(LOG_INFO, 'agent link "%s": iroh %s', link.name, cfg.cfg.node)
    else
      logf(LOG_INFO, 'agent link "%s": %s:%d', link.name, cfg.cfg.host, cfg.cfg.port)
    end
  end
end

-- Connect and read the extra links. Only the parts an agent needs to serve
-- windows: the session, fallback and layout handling stays with the local one.
local function agent_extras_pump(now: float64): void
  for i = 0, < #host.agents do
    local link = host.agents[i]
    if link.enabled then
      local st = link.client.state
      if st == AgentState.Disconnected or st == AgentState.Failed then
        if now - link.last_try > 3.0 then
          link.last_try = now
          link.client:connect(now)
        end
      end
      link.client:pump(now)
      st = link.client.state
      if st == AgentState.Ready then
        link.down = false
        if not link.listed then
          link.listed = true
          link.client:wlist()
        end
      elseif st == AgentState.Failed then
        link.listed = false
        if not link.down then
          link.down = true
          if link.client.last_error ~= link.error_shown then
            link.error_shown:destroy()
            link.error_shown = link.client.last_error:copy()
            logf(LOG_WARN, 'agent link "%s": %s', link.name, link.client.last_error)
          end
        end
      end
      link.prev_state = st
    end
  end
end

global function agent_setup(): void
  do -- one iroh identity for this install, so an agent's allowlist can name it
    local sb: stringbuilder
    sb:write(host.dir, '/iroh.key')
    local p = sb:promote()
    net.iroh_set_key_path(p)
    p:destroy()
  end
  host.local_agent.client:destroy()
  local tok = read_token()
  host.local_agent.client:init(policy.agent.host, (@uint16)(policy.agent.port), tok)
  host.local_agent.client.node:destroy()
  host.local_agent.client.node = policy.agent.node:copy()
  tok:destroy()
  host.local_agent.client.on_event = agent_event
  host.local_agent.client.ctx = nilptr
  host.local_agent.name:destroy()
  host.local_agent.name = string.copy('local')
  host.local_agent.enabled = true
  host.local_agent.last_try = -100.0
  host.local_agent.prev_state = AgentState.Disconnected -- a fresh client: its first Ready is a (re)connect
  host.layout_restored = false -- until LISTR: the terminals on screen are not the whole layout
  agent_extras_setup()
end

-- The connection became Ready (first connect or a reconnect).
global function agent_on_ready(): void
  local nonce = host.local_agent.client.nonce
  -- a different agent process: its session ids mean other shells (or none).
  -- That includes a version 1 agent (nonce 0) replaced by a version 2 one:
  -- the new agent numbers its shells from 1 again.
  local restarted = host.local_agent.seen and nonce ~= host.local_agent.nonce
  -- the same agent: the shells still run, subscribe again. Two agents without
  -- a nonce (version 1) cannot be told apart; their terminals stay as they are.
  local same = nonce ~= 0 and nonce == host.local_agent.nonce
  for i = 0, < #host.sessions do
    local s = host.sessions[i]
    if s.kind == TransportKind.Agent and s.agent == &host.local_agent.client then
      s:connection_lost() -- an ATTACHED of the old connection never comes
      if not s.awaiting_open and not s.exited then
        if s.job then
          -- a job dies with the connection that opened it (docs/JOBS.md): it
          -- is not kept and there is nothing to attach to
          s:mark_exited(-1)
          s.agent = nilptr
          s.agent_id = 0
        elseif restarted then
          s:mark_exited(-1)
          s.agent = nilptr -- closing it must not CLOSE a new shell that got its id
          s.agent_id = 0
        elseif same and not s.sleeping then
          s:reattach()
        end
      end
    end
  end
  host.local_agent.seen = true
  host.local_agent.nonce = nonce
  -- OPENs of the old connection got no answer: forget closed terminals, ask again
  local j = 0
  for i = 0, < #host.pending_open do
    local s = host.pending_open[i]
    if s ~= nilptr then
      host.pending_open[j] = s
      j = j + 1
    end
  end
  host.pending_open:resize(j)
  for i = 0, < #host.pending_open do host.pending_open[i]:reopen() end
  host.local_agent.error_shown:destroy() -- the next failure is news again
end

-- The agent is down: terminals still waiting for their shell whose profile
-- has a local fallback (lua/platform.lua gives native Windows one) open it.
local function agent_use_fallbacks(): void
  local j = 0
  for i = 0, < #host.pending_open do
    local s = host.pending_open[i]
    local f: *Profile = nilptr
    if s ~= nilptr and s.local_fallback and s.awaiting_open and not s.exited then
      -- no fallback profile: the same command, here over ConPTY -- or on
      -- pipes when its output is parsed rather than drawn (the /ask panel's
      -- hidden session), which a pseudo console would reflow
      logf(LOG_INFO, 'session %d: no agent, running it locally', s.id)
      local lp: Profile = { name = s.label:copy(), transport = string.copy(s.capture and 'pipe' or 'conpty') }
      for k = 0, < #s.open_argv do lp.argv:push(s.open_argv[k]:copy()) end
      s:use_fallback(&lp) -- frees open_argv: lp holds its own copies
      profile_free(&lp)
      continue
    end
    if s ~= nilptr then
      local asked: Profile = { transport = 'agent', fallback = s.fallback }
      f = policy_open_profile(&asked, true)
      if f == &asked then f = nilptr end
    end
    if f ~= nilptr then
      logf(LOG_INFO, 'session %d: no agent, opening fallback profile %s', s.id, f.name)
      s:use_fallback(f)
    else
      host.pending_open[j] = s
      j = j + 1
    end
  end
  host.pending_open:resize(j)
end

global function agent_pump(now: float64): void
  agent_extras_pump(now)
  if not host.local_agent.enabled then return end
  local st = host.local_agent.client.state
  if st == AgentState.Disconnected or st == AgentState.Failed then
    if now - host.local_agent.last_try > 3.0 then
      host.local_agent.last_try = now
      host.local_agent.client:connect(now)
    end
  end
  host.local_agent.client:pump(now)
  st = host.local_agent.client.state
  if st == AgentState.Ready then host.local_agent.down = false end
  if st == AgentState.Failed and not host.local_agent.down then
    host.local_agent.down = true
    agent_use_fallbacks()
  end
  if st == AgentState.Ready and host.local_agent.prev_state ~= AgentState.Ready then agent_on_ready() end
  host.local_agent.prev_state = st
  if st == AgentState.Ready and not host.local_agent.listed then
    host.local_agent.listed = true
    host.layout_restored = false
    host.local_agent.client:list()
  elseif st == AgentState.Failed then
    host.reattach_done = true -- don't hold the first tab back forever
    if host.local_agent.client.last_error ~= host.local_agent.error_shown then
      -- surface the failure in the waiting tabs, once per distinct error
      local sb: stringbuilder -- no `..` chain: its intermediate strings would leak
      sb:write('[ghostty] ', host.local_agent.client.last_error, ' (retrying)\r\n')
      local msg = sb:promote()
      for i = 0, < #host.pending_open do
        local s = host.pending_open[i]
        if s ~= nilptr then s:feed_text(msg) end
      end
      msg:destroy()
      host.local_agent.error_shown:destroy()
      host.local_agent.error_shown = host.local_agent.client.last_error:copy()
    end
  end
end

-- Kill switch on: nothing reads the connection any more, and the agent stops
-- reading every shell whose output this client leaves unread (a build in a
-- tab would freeze). Detach the streaming shells instead; they keep running.
global function agent_hold_sessions(): void
  if not host.local_agent.enabled then return end
  for i = 0, < #host.sessions do
    local s = host.sessions[i]
    if s.kind == TransportKind.Agent and s.agent == &host.local_agent.client and not s.sleeping then
      s:sleep()
      s.held = s.sleeping
    end
  end
  host.local_agent.client:flush() -- the DETACHes: no pump runs until the switch is off
end

-- Kill switch off: the held shells stream again; the agent sends what they missed.
global function agent_release_sessions(): void
  for i = 0, < #host.sessions do
    local s = host.sessions[i]
    if s.held then
      s.held = false
      s:wake()
    end
  end
end

-- Shutdown: send what is still queued (DETACH / CLOSE) one last time. Nothing
-- that arrives now reaches agent_event: a LISTR would create sessions after
-- the session list is gone.
global function agent_final_flush(): void
  host.local_agent.client.on_event = nilptr
  if host.local_agent.enabled then host.local_agent.client:pump(0.0) end
end

-- Sessions -------------------------------------------------------------------
-- A session for profile `p` as given (no fallback choice).
global function session_open(p: *Profile, cols: uint16, rows: uint16): *Session
  local s = new(@Session)
  local agent: *AgentClient = nilptr
  if host.local_agent.enabled then agent = &host.local_agent.client end
  if not s:init(host.next_session_id, p, cols, rows, agent) then
    s:destroy()
    delete(s)
    return nilptr
  end
  host.next_session_id = host.next_session_id + 1
  if s.kind == TransportKind.Agent and s.awaiting_open then host.pending_open:push(s) end
  host.sessions:push(s)
  logf(LOG_INFO, 'session %d: %s (%s)', s.id, p.name, p.transport)
  return s
end

global function session_new(profile_index: integer, cols: uint16, rows: uint16): *Session
  local p = policy_profile(profile_index)
  if p == nilptr then
    if #policy.profiles == 0 then return nilptr end
    p = policy_profile(0)
  end
  -- no agent answered the last attempt: a profile with a local fallback opens that
  p = policy_open_profile(p, not host.local_agent.enabled or host.local_agent.down)
  return session_open(p, cols, rows)
end

-- /term ask: a session running what lua/assistant.lua chose. It stays open
-- after the assistant exits. With `local_fallback` and no agent answering,
-- the same argv runs over ConPTY instead.
global function session_new_assistant(spec: *AssistantOpen, cols: uint16, rows: uint16): *Session
  local p: Profile = { name = spec.label, transport = spec.transport }
  if spec.transport == 'agent' and spec.local_fallback and (not host.local_agent.enabled or host.local_agent.down) then
    p.transport = 'conpty'
  end
  p.argv = spec.argv -- borrowed: Session:init copies what it keeps
  local s = session_open(&p, cols, rows)
  if s == nilptr then return nilptr end
  s.assistant = true
  s.local_fallback = spec.local_fallback and s.kind == TransportKind.Agent
  return s
end

-- A session without a transport, for text the core writes into it itself.
global function session_new_local(label: string, cols: uint16, rows: uint16): *Session
  local s = new(@Session)
  if not s:init_local(host.next_session_id, label, cols, rows) then
    delete(s)
    return nilptr
  end
  host.next_session_id = host.next_session_id + 1
  host.sessions:push(s)
  logf(LOG_INFO, 'session %d: %s (local)', s.id, label)
  return s
end

global function session_remove(s: *Session): void
  for i = 0, < #host.pending_open do
    if host.pending_open[i] == s then
      if host.local_agent.client.state == AgentState.Ready then
        host.pending_open[i] = nilptr -- its OPEN is on the way: keep its place for the answer
      else
        host.pending_open:remove(i) -- nothing on the way; Ready sends the others again
      end
      break
    end
  end
  for i = 0, < #host.sessions do
    if host.sessions[i] == s then host.sessions:remove(i) break end
  end
  s:destroy()
  delete(s)
end
