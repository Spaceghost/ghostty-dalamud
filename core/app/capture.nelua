-- /term shot and /term clip: pictures of the game with the terminals in them
-- (docs/CAPTURE.md).
--
-- The game's own screenshot key photographs the scene before Dalamud's ImGui
-- render, so the terminals are not in the file it writes; core/capture.nelua
-- grabs the frame ImGui drew into instead. This module is the part with a
-- schedule: it arms that grab at the very end of the frame, reads the pixels
-- back a frame later, encodes a PNG a few rows at a time so no single frame
-- carries a whole image, writes it into <config>/screenshots and hands the path
-- to the gallery prompt lua/gallery.lua already draws.
--
-- /term clip does not encode anything in the game: reduced-size frames go to
-- ghostty-agent, which runs ffmpeg on the host (core/../agent/clips.nelua).
-- GIF and MP4 are for the owner's media spread, never for the gallery - the
-- site takes PNG and JPEG only.
require 'core.capture'
require 'core.pngenc'
require 'core.wincodec'
require 'core.imgui_internal'
require 'core.app.agent'
require 'core.app.gallery'
require 'core.sys.fsbase'
require 'io'
require 'os'
require 'C.stdio'

-- Caps. A clip is bounded on every axis so a mistyped number cannot fill the
-- host's disk or the socket: seconds, frames a second, pixels and total bytes.
global CLIP_SECONDS_DEFAULT: float64 <comptime> = 6.0
global CLIP_SECONDS_MAX: float64 <comptime> = 20.0
global CLIP_FPS_DEFAULT: integer <comptime> = 10
global CLIP_FPS_MAX: integer <comptime> = 15
global CLIP_MAX_W: integer <comptime> = 1280
global CLIP_MAX_H: integer <comptime> = 720
global CLIP_MAX_FRAMES: integer <comptime> = 300
global CLIP_MAX_BYTES: usize <comptime> = 192 * 1024 * 1024
global CLIP_OPEN_TIMEOUT: float64 <comptime> = 5.0  -- waiting for the agent's answer
global CLIP_DONE_TIMEOUT: float64 <comptime> = 120.0 -- waiting for ffmpeg
global CLIP_KIND_GIF: uint8 <comptime> = 0
global CLIP_KIND_MP4: uint8 <comptime> = 1

-- Rows of PNG a frame may encode: about 48 KB of pixels, so the work per frame
-- stays in the low milliseconds whatever the shot's width.
local PNG_BYTES_PER_FRAME: integer <comptime> = 48 * 1024

-- Frames the game is given to hide its own UI before a clean shot is taken.
local HUD_SETTLE_FRAMES: integer <comptime> = 3
-- The HUD comes back after this long whatever else happened: a capture that
-- fails must never leave the player without their action bars.
local HUD_MAX_SECONDS: float64 <comptime> = 4.0

-- The game windows a clean shot hides (AtkUnitBase names), checked at compile
-- time into one call each. Only chrome: nothing that would hide the world or a
-- conversation.
## local HUD_ADDONS = {
##   '_ActionBar', '_ActionBar01', '_ActionBar02', '_ActionBar03', '_ActionBar04', '_ActionBar05',
##   '_ActionBar06', '_ActionBar07', '_ActionBar08', '_ActionBar09', '_ActionCross',
##   '_ActionDoubleCrossL', '_ActionDoubleCrossR', '_PartyList', '_ParameterWidget', '_Status',
##   '_TargetInfo', '_TargetInfoMainTarget', '_TargetInfoCastBar', '_TargetInfoBuffDebuff',
##   '_FocusTargetInfo', '_NaviMap', '_MainCommand', '_BagWidget', '_Exp', '_ToDoList',
##   '_ScenarioTree', '_LimitBreak', '_Money', 'ChatLog',
## }
global CAPTURE_HUD_ADDONS: integer <comptime> = #[#HUD_ADDONS]#

local ShotStage = @enum{ None = 0, Hiding, Arm, Wait, Encode }

local Shot = @record{
  stage: ShotStage,
  panel: boolean,         -- crop to the focused terminal's window
  clean: boolean,         -- hide the game's own UI for the shot
  share: boolean,         -- offer it to the gallery when it is written
  settle: integer,        -- frames left before arming
  path: string,
  enc: PngEnc,
}

local ClipStage = @enum{ None = 0, Sizing, Opening, Running, Ending }

local Clip = @record{
  stage: ClipStage,
  panel: boolean,
  clean: boolean,
  kind: uint8,
  seconds: float64,
  fps: integer,
  req: uint32,
  cid: uint32,
  w: integer, h: integer,   -- the size frames are sent at
  started: float64,
  next_at: float64,
  asked_at: float64,
  seq: uint32,
  sent: integer,
  bytes: usize,
  dropped: integer,
}

-- The result of the last shot, for whatever asked for one that was not a
-- person: the camera (core/app/lakitu.nelua) and, through it, the MCP server.
-- `serial` changes when a shot finishes, which is how a caller that queued one
-- knows its own has landed without a callback into another thread.
global CaptureShotResult = @record{
  serial: uint32,
  ok: boolean,
  path: string,    -- owned here; copy it before the next shot
  error: string,   -- owned here
}
global capture_shot: CaptureShotResult

local function shot_done(ok: boolean, path: string, why: string): void
  capture_shot.path:destroy()
  capture_shot.error:destroy()
  capture_shot.ok = ok
  capture_shot.path = ok and path:copy() or (@string){}
  capture_shot.error = ok and (@string){} or why:copy()
  capture_shot.serial = capture_shot.serial + 1
end

local shot: Shot
local clip: Clip
local hud_hidden: boolean = false
local hud_at: float64 = 0
-- reused between frames so a clip never allocates once it is running
local clip_small: vector(uint8)
local clip_qoi: vector(uint8)

-- Paths -----------------------------------------------------------------------

local function join(dir: string, name: string): string
  if #dir == 0 then return string.copy(name) end
  local last = dir.data[dir.size - 1]
  if last == '/'_b or last == '\\'_b then return dir .. name end
  return dir .. '/' .. name
end

-- <config>/screenshots, created when missing.
global function capture_dir(): string
  local d = join(host.dir, 'screenshots')
  fs_mkdir((@cstring)(d.data))
  return d
end

-- ghostty_20260919_203512.png, and _1, _2 ... when that name is taken.
local function shot_path(dir: string, ext: string): string
  local stamp = os.date('%Y%m%d_%H%M%S')
  defer stamp:destroy() end
  for n = 0, 99 do
    local sb: stringbuilder
    sb:write('ghostty_', stamp)
    if n > 0 then sb:writef('_%d', n) end
    sb:write(ext)
    local name = sb:promote()
    local path = join(dir, name)
    name:destroy()
    local f = io.open(path, 'rb')
    if not f:isopen() then f:destroy() return path end
    f:destroy()
    path:destroy()
  end
  return join(dir, 'ghostty_shot' .. ext)
end

local function write_bytes(path: string, data: *vector(uint8)): boolean
  if #data == 0 then return false end
  local f = io.open(path, 'wb')
  if not f:isopen() then f:destroy() return false end
  local ok = f:write(string{ data = (@*[0]byte)(&data[0]), size = (@usize)(#data) })
  f:destroy()
  return ok
end

-- The game's own UI ------------------------------------------------------------

local function hud_set(shown: boolean): void
  if host.api.addon_show == nilptr then return end
  local v: cint = shown and 1 or 0
  ## for _, n in ipairs(HUD_ADDONS) do
  host.api.addon_show(#[n]#, v)
  ## end
end

local function hud_hide(now: float64): boolean
  if host.api.addon_show == nilptr then return false end
  hud_set(false)
  hud_hidden = true
  hud_at = now
  return true
end

local function hud_restore(): void
  if not hud_hidden then return end
  hud_hidden = false
  hud_set(true)
end

-- What to capture --------------------------------------------------------------

-- The focused terminal's ImGui window: the dropdown while it is on screen, else
-- the most recent floating window. False when the terminal in focus is a world
-- screen (it has no ImGui window of its own) or the internals are missing.
local function panel_rect(): (boolean, float32, float32, float32, float32)
  if not imgui_int_bound then imgui_internal_bind(resolve_imgui) end
  if imgui_int.FindWindowByName == nilptr then return false, 0, 0, 0, 0 end
  local w: *ImGuiWindow = nilptr
  if host.dropdown_open then
    w = imgui_int.FindWindowByName('##ghostty_dropdown')
  end
  if (w == nilptr or not w.WasActive) and #host.windows > 0 then
    local name: [48]cchar
    C.snprintf((@cstring)(&name), #name, '###ghostty_win%d', (@cint)(host.windows[#host.windows - 1].id))
    w = imgui_int.FindWindowByName((@cstring)(&name))
  end
  if w == nilptr or not w.WasActive or w.Size.x < 8 or w.Size.y < 8 then return false, 0, 0, 0, 0 end
  return true, w.Pos.x, w.Pos.y, w.Size.x, w.Size.y
end

-- Dalamud's D3D11 device, the one ImGui draws with (the same one
-- core/app/remotewin.nelua streams window textures on). nilptr with an older
-- shim, which has no scene depth callback to ask.
local function capture_device(): pointer
  if host.api.get_scene_depth == nilptr then return nilptr end
  local sd: GuSceneDepth
  if host.api.get_scene_depth(&sd) == 0 then return nilptr end
  return sd.ui_device
end

-- Arm the next rendered frame: the whole frame, or the focused panel's
-- rectangle. The frame's own size is only known inside the callback, so a full
-- frame asks for zeroes and a crop is clamped there as well.
local function arm(panel: boolean): (boolean, string)
  local device = capture_device()
  if device == nilptr then
    return false, 'no D3D11 device from Dalamud (an older shim, or no scene depth callback)'
  end
  local x: uint32, y: uint32, w: uint32, h: uint32 = 0, 0, 0, 0
  if panel then
    local ok, px, py, pw, ph = panel_rect()
    if not ok then
      return false, 'no terminal window on screen to crop to (a world screen has none; try without "panel")'
    end
    -- the viewport's own origin: ImGui coordinates are the desktop's, the frame's are not
    local vp = imgui.GetMainViewport()
    local okc, cx, cy, cw, ch = capture_crop(px - vp.Pos.x, py - vp.Pos.y, pw, ph,
      (@uint32)(math.max(1, vp.Size.x)), (@uint32)(math.max(1, vp.Size.y)))
    if not okc then return false, 'the terminal window is off screen' end
    x, y, w, h = cx, cy, cw, ch
  end
  if not capture_arm(device, x, y, w, h) then
    return false, #capture.reason > 0 and capture.reason or 'a capture is already in flight'
  end
  return true, (@string){}
end

-- The callback that does the copying, appended to the list the renderer draws
-- last so the target holds the game frame with every ImGui window on it.
local function queue_callback(): void
  if imgui.DrawListAddCallback == nilptr or imgui.GetForegroundDrawList == nilptr then return end
  local dl = imgui.GetForegroundDrawList()
  if dl == nilptr then return end
  imgui.DrawListAddCallback(dl, (@pointer)(capture_render_cb), nilptr)
end

-- Commands ---------------------------------------------------------------------

global function capture_app_busy(): boolean
  return shot.stage ~= ShotStage.None or clip.stage ~= ClipStage.None
end

local function parse_flags(args: string, panel: *boolean, clean: *boolean, kind: *uint8, seconds: *float64): (boolean, string)
  local rest = args
  while #rest > 0 do
    while #rest > 0 and rest.data[0] == ' '_b do rest = rest:subview(2) end
    if #rest == 0 then break end
    local cut = rest:find(' ', 1, true)
    local word = cut > 0 and rest:subview(1, cut - 1) or rest
    rest = cut > 0 and rest:subview(cut + 1) or (@string){}
    if word == 'panel' or word == 'window' then $panel = true
    elseif word == 'full' or word == 'frame' then $panel = false
    elseif word == 'clean' or word == 'nohud' or word == 'hud' then $clean = true
    elseif word == 'gif' then $kind = CLIP_KIND_GIF
    elseif word == 'mp4' or word == 'video' then $kind = CLIP_KIND_MP4
    elseif word.data[0] >= '0'_b and word.data[0] <= '9'_b then
      local n: float64 = 0
      local frac: float64 = 0
      for i = 0, < #word do
        local c = word.data[i]
        if c >= '0'_b and c <= '9'_b then
          if frac > 0 then
            n = n + (@float64)(c - '0'_b) * frac
            frac = frac * 0.1
          else
            n = n * 10 + (@float64)(c - '0'_b)
          end
        elseif c == '.'_b and frac == 0 then
          frac = 0.1
        else
          return false, 'seconds must be a number'
        end
      end
      $seconds = n
    else
      return false, 'not something shot or clip knows'
    end
  end
  return true, (@string){}
end

-- /term shot [panel|full] [clean]
-- A line for /term shot status: what the frame grabs have been doing.
global function capture_describe(): string
  local sb: stringbuilder
  sb:writef('%d frames captured, %d skipped while one was in flight, %d given up on',
    (@integer)(capture.taken), (@integer)(capture.skipped), (@integer)(capture.misses))
  if #capture.reason > 0 then sb:write('; last problem: ', capture.reason) end
  return sb:promote()
end

-- Start a shot without a person typing one: the same stages /term shot uses,
-- minus the argument parsing and minus the gallery prompt unless asked for.
-- False when a capture is already in flight -- there is only one frame buffer,
-- and the caller is expected to wait rather than queue.
global function capture_shot_begin(panel: boolean, clean: boolean, share: boolean): (boolean, string)
  if capture_app_busy() then return false, 'one capture at a time' end
  shot = {}
  shot.panel, shot.clean, shot.share = panel, clean, share
  if clean and not hud_hide(host.last_time) then shot.clean = false end
  shot.stage = shot.clean and ShotStage.Hiding or ShotStage.Arm
  shot.settle = HUD_SETTLE_FRAMES
  return true, (@string){}
end

global function shot_command(args: string): cint
  if args == 'status' or args == 'diag' then
    local line = capture_describe()
    sayf(LOG_INFO, 'shot: %s', line)
    line:destroy()
    return 0
  end
  if capture_app_busy() then
    say(LOG_WARN, 'shot: one capture at a time; this one is still being written')
    return 4
  end
  local panel, clean: boolean = false, false
  local kind: uint8 = CLIP_KIND_GIF
  local seconds: float64 = 0
  local ok, why = parse_flags(args, &panel, &clean, &kind, &seconds)
  if not ok then
    sayf(LOG_WARN, 'shot: %s (/term shot [panel|full] [clean])', why)
    return 3
  end
  local started, why = capture_shot_begin(panel, clean, true)
  if not started then
    sayf(LOG_WARN, 'shot: %s; this one is still being written', why)
    return 4
  end
  if clean and not shot.clean then
    say(LOG_WARN, 'shot: this plugin build cannot hide the game\'s UI; taking the shot as it is')
  end
  return 0
end

-- /term clip [seconds] [gif|mp4] [panel] [clean]
global function clip_command(args: string): cint
  if capture_app_busy() then
    say(LOG_WARN, 'clip: one capture at a time')
    return 4
  end
  local panel, clean: boolean = false, false
  local kind: uint8 = CLIP_KIND_GIF
  local seconds: float64 = CLIP_SECONDS_DEFAULT
  local ok, why = parse_flags(args, &panel, &clean, &kind, &seconds)
  if not ok then
    sayf(LOG_WARN, 'clip: %s (/term clip [seconds] [gif|mp4] [panel] [clean])', why)
    return 3
  end
  if seconds < 1 then seconds = 1 end
  if seconds > CLIP_SECONDS_MAX then
    sayf(LOG_INFO, 'clip: %d seconds is the most a clip records', (@integer)(CLIP_SECONDS_MAX))
    seconds = CLIP_SECONDS_MAX
  end
  if not host.local_agent.client:ready() then
    say(LOG_WARN, 'clip: no ghostty-agent connection; clips are encoded on the host, so one is needed')
    return 4
  end
  if capture_device() == nilptr then
    say(LOG_WARN, 'clip: no D3D11 device from Dalamud, so no frame can be captured')
    return 4
  end
  clip = {}
  clip.panel, clip.clean, clip.kind, clip.seconds = panel, clean, kind, seconds
  clip.fps = CLIP_FPS_DEFAULT
  if clip.fps > CLIP_FPS_MAX then clip.fps = CLIP_FPS_MAX end
  clip.stage = ClipStage.Sizing
  if clean and not hud_hide(host.last_time) then clip.clean = false end
  sayf(LOG_INFO, 'clip: recording %d seconds at %d frames a second; the host encodes it',
    (@integer)(seconds), clip.fps)
  return 0
end

-- The gallery -------------------------------------------------------------------

local function offer(path: string): void
  local z = path:copy() -- NUL-terminated for Lua
  defer z:destroy() end
  if not policy_gallery_offer(z) then
    sayf(LOG_INFO, 'shot: saved %s', path)
    return
  end
  sayf(LOG_INFO, 'shot: saved %s - the prompt asks whether to share it', path)
end

-- Per frame ---------------------------------------------------------------------

local function shot_fail(why: string): void
  hud_restore()
  shot_done(false, (@string){}, why)
  sayf(LOG_WARN, 'shot: %s', why)
  shot.path:destroy()
  png_enc_destroy(&shot.enc)
  shot = {}
  capture_reset()
end

local function shot_tick(now: float64): void
  if shot.stage == ShotStage.Hiding then
    if shot.settle > 0 then
      shot.settle = shot.settle - 1
      return
    end
    shot.stage = ShotStage.Arm
  end
  if shot.stage == ShotStage.Arm then
    local ok, why = arm(shot.panel)
    if not ok then shot_fail(why) return end
    queue_callback()
    shot.stage = ShotStage.Wait
    return
  end
  if shot.stage == ShotStage.Wait then
    local st = capture_poll()
    if st == CaptureState.Failed then shot_fail(capture.reason) return end
    if st ~= CaptureState.Ready then return end
    hud_restore()
    local dir = capture_dir()
    defer dir:destroy() end
    shot.path = shot_path(dir, '.png')
    if not png_begin(&shot.enc, (@*[0]uint8)(&capture.pixels[0]), (@usize)(capture.w) * 4,
                     (@integer)(capture.w), (@integer)(capture.h), true) then
      shot_fail('the frame could not be encoded')
      return
    end
    shot.stage = ShotStage.Encode
    return
  end
  if shot.stage == ShotStage.Encode then
    local rows = PNG_BYTES_PER_FRAME // math.max(1, (@integer)(capture.w) * 3)
    if rows < 2 then rows = 2 end
    if rows > 64 then rows = 64 end
    if not png_step(&shot.enc, rows) then return end
    local written = write_bytes(shot.path, &shot.enc.out)
    local bytes = #shot.enc.out
    png_enc_destroy(&shot.enc)
    capture_reset() -- the pixels the encoder borrowed are free again
    if not written then
      shot_fail('the file could not be written into the screenshots folder')
      return
    end
    local path = shot.path
    shot.path = (@string){}
    shot.stage = ShotStage.None
    sayf(LOG_INFO, 'shot: %dx%d, %d KB', (@integer)(capture.w), (@integer)(capture.h), bytes // 1024)
    shot_done(true, path, (@string){})
    if shot.share then offer(path) end
    path:destroy()
  end
end

local function clip_finish(cancel: boolean): void
  if clip.cid ~= 0 then host.local_agent.client:cend(clip.cid, cancel) end
  hud_restore()
  clip.stage = cancel and ClipStage.None or ClipStage.Ending
  clip.asked_at = host.last_time
  if cancel then clip = {} end
  capture_reset()
end

-- One captured frame, scaled down and sent to the agent.
local function clip_send_frame(): void
  local w, h = (@integer)(capture.w), (@integer)(capture.h)
  local src = (@*[0]uint8)(&capture.pixels[0])
  local stride = (@usize)(capture.w) * 4
  local scaled, sw, sh = wincodec_downscale_fit(src, stride, w, h, CLIP_MAX_W, CLIP_MAX_H, &clip_small)
  local fsrc, fstride = src, stride
  if scaled then
    fsrc = (@*[0]uint8)(&clip_small[0])
    fstride = (@usize)(sw) * 4
  end
  if clip.w == 0 then clip.w, clip.h = sw, sh end
  if sw ~= clip.w or sh ~= clip.h then
    -- the frame changed size mid-clip (a resolution change): ffmpeg was told
    -- one size and must not be sent another, so the clip ends here
    clip_finish(false)
    say(LOG_INFO, 'clip: the frame changed size, so the clip ends here; the host is encoding it')
    return
  end
  clip_qoi:clear()
  wincodec_qoi_encode(fsrc, fstride, 0, 0, sw, sh, &clip_qoi)
  local raw = (@usize)(sw) * (@usize)(sh) * 4
  local n = (@usize)(#clip_qoi)
  local enc = WINCODEC_ENC_QOI
  if n >= raw then enc, n = WINCODEC_ENC_RAW, raw end
  clip.seq = clip.seq + 1
  if enc == WINCODEC_ENC_QOI then
    host.local_agent.client:cframe(clip.cid, clip.seq, enc, (@*[0]uint8)(&clip_qoi[0]), n)
  else
    host.local_agent.client:cframe_rows(clip.cid, clip.seq, fsrc, fstride, sw, sh)
  end
  clip.sent = clip.sent + 1
  clip.bytes = clip.bytes + n
end

local function clip_tick(now: float64): void
  if clip.stage == ClipStage.Sizing then
    -- one frame first: only it can say how large the game's frame is, which
    -- the agent needs before it can start ffmpeg
    local st = capture_poll()
    if st == CaptureState.Failed then
      sayf(LOG_WARN, 'clip: %s', capture.reason)
      hud_restore()
      clip = {}
      capture_reset()
      return
    end
    if st == CaptureState.Ready then
      local _, sw, sh = wincodec_downscale_fit((@*[0]uint8)(&capture.pixels[0]), (@usize)(capture.w) * 4,
        (@integer)(capture.w), (@integer)(capture.h), CLIP_MAX_W, CLIP_MAX_H, &clip_small)
      clip.w, clip.h = sw, sh
      clip.req = clip.req + 1
      if clip.req == 0 then clip.req = 1 end
      if not host.local_agent.client:copen(clip.req, clip.kind, (@uint16)(sw), (@uint16)(sh), (@uint8)(clip.fps)) then
        say(LOG_WARN, 'clip: the agent connection went away')
        hud_restore()
        clip = {}
        capture_reset()
        return
      end
      clip.stage = ClipStage.Opening
      clip.asked_at = now
      return
    end
    if st == CaptureState.Idle then
      local ok, why = arm(clip.panel)
      if not ok then
        sayf(LOG_WARN, 'clip: %s', why)
        hud_restore()
        clip = {}
        return
      end
      queue_callback()
    end
    return
  end
  if clip.stage == ClipStage.Opening then
    if now - clip.asked_at > CLIP_OPEN_TIMEOUT then
      say(LOG_WARN, 'clip: the agent never answered; it is probably too old for clips (update ghostty-agent)')
      hud_restore()
      clip = {}
      capture_reset()
    end
    return
  end
  if clip.stage == ClipStage.Running then
    local st = capture_poll()
    if st == CaptureState.Ready then
      clip_send_frame()
      capture_reset()
    elseif st == CaptureState.Failed then
      sayf(LOG_WARN, 'clip: %s', capture.reason)
      clip_finish(false)
      return
    end
    if now - clip.started >= clip.seconds or clip.sent >= CLIP_MAX_FRAMES or clip.bytes >= CLIP_MAX_BYTES then
      clip_finish(false)
      say(LOG_INFO, 'clip: recorded; the host is encoding it')
      return
    end
    if now >= clip.next_at and clip.stage == ClipStage.Running then
      clip.next_at = now + 1.0 / (@float64)(clip.fps)
      if capture_busy() then
        -- the readback has not caught up: give this slot up rather than queue it
        clip.dropped = clip.dropped + 1
      else
        local ok, why = arm(clip.panel)
        if not ok then
          sayf(LOG_WARN, 'clip: %s', why)
          clip_finish(false)
          return
        end
        queue_callback()
      end
    end
    return
  end
  if clip.stage == ClipStage.Ending then
    if now - clip.asked_at > CLIP_DONE_TIMEOUT then
      say(LOG_WARN, 'clip: the host never finished encoding it')
      clip = {}
    end
    return
  end
end

-- The agent's answers ----------------------------------------------------------

global function capture_event(ev: *AgentEvent): void
  if ev.typ == PROTO_COPENED then
    if clip.stage ~= ClipStage.Opening or ev.req ~= clip.req then
      if ev.id ~= 0 then host.local_agent.client:cend(ev.id, true) end -- nobody is waiting for it
      return
    end
    if ev.id == 0 then
      local why = string{ data = (@*[0]byte)(ev.data), size = ev.len }
      sayf(LOG_WARN, 'clip: the host cannot record one: %s', why)
      hud_restore()
      clip = {}
      capture_reset()
      return
    end
    clip.cid = ev.id
    clip.stage = ClipStage.Running
    clip.started = host.last_time
    clip.next_at = host.last_time
    -- the frame that settled the size is already read back: it is frame one
    if capture.state == CaptureState.Ready then
      clip_send_frame()
      capture_reset()
      clip.next_at = host.last_time + 1.0 / (@float64)(clip.fps)
    end
  elseif ev.typ == PROTO_CDONE then
    if clip.cid == 0 or ev.id ~= clip.cid then return end
    local text = string{ data = (@*[0]byte)(ev.data), size = ev.len }
    if ev.status == 0 then
      sayf(LOG_INFO, 'clip: %s (%d frames, %d dropped)', text, clip.sent, clip.dropped)
    else
      sayf(LOG_WARN, 'clip: %s', text)
    end
    clip = {}
  end
end

-- Called at the very end of the frame, after everything has drawn: the copy is
-- armed here so the callback lands last in the frame's draw data.
global function capture_frame(now: float64, live: boolean): void
  agent_clip_event = capture_event -- where a clip's COPENED / CDONE answers go
  if hud_hidden and now - hud_at > HUD_MAX_SECONDS then hud_restore() end
  if not live then return end
  if shot.stage ~= ShotStage.None then shot_tick(now) end
  if clip.stage ~= ClipStage.None then clip_tick(now) end
end

global function capture_app_shutdown(): void
  hud_restore()
  if clip.cid ~= 0 then host.local_agent.client:cend(clip.cid, true) end
  shot.path:destroy()
  png_enc_destroy(&shot.enc)
  shot = {}
  clip = {}
  clip_small:destroy()
  clip_qoi:destroy()
  capture_shutdown()
end
