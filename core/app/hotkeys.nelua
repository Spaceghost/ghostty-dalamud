

-- Input the game does not hand to ImGui: the toggle keys (Win32 key state),
-- the controller button gestures.
require 'core.app.worldview'
require 'core.sys.dualsense_reader'

global ForegroundFn = @function(): boolean

-- Whether the game's window is in front (Windows). Elsewhere there is no
-- such check and this is always true.
global function game_foreground(): boolean
  ## if ccinfo.is_windows then
    local pid: uint32 = 0
    GetWindowThreadProcessId(GetForegroundWindow(), &pid)
    return pid == GetCurrentProcessId()
  ## else
    return true
  ## end
end

-- The controller toggle button this frame, from the source toggle_gamepad_button
-- names: the DualSense Create button read from the controller's HID reports
-- ('create'), or a Dalamud GamepadButtons flag through the shim. Returns
-- whether the button's state is known (then `down` is it) and, from a shim
-- without gamepad_down, whether it was pressed this frame. The HID reports
-- arrive whichever window is in front, and Create captures screenshots and
-- video elsewhere (Steam, Game Bar, Remote Play): the reports are still
-- drained, but Create only counts while `foreground` (game_foreground) says
-- the game is in front.
global function poll_toggle_pad(now: float64, foreground: ForegroundFn): (boolean, boolean, boolean)
  if policy.toggle_gamepad_hid then
    dualsense_reader_poll(&host.dualsense, now, log)
    local down = dualsense_reader_take(&host.dualsense)
    if down and not foreground() then down = false end
    return true, down, false
  end
  dualsense_reader_close(&host.dualsense) -- not chosen (any more): let go of the controller
  if policy.toggle_gamepad_mask == 0 then return false, false, false end
  local mask = (@cint)(policy.toggle_gamepad_mask)
  if host.api.gamepad_down ~= nilptr then return true, host.api.gamepad_down(mask) ~= 0, false end
  if host.api.gamepad_pressed ~= nilptr then return false, false, host.api.gamepad_pressed(mask) ~= 0 end
  return false, false, false
end

-- Global hotkey while the drop-down is not focused.
global function poll_toggle_key(): void
  local pressed = false
  -- While a terminal has focus the key arrives as an ImGui key event and
  -- key_action (terminal.nelua) matches it against the same toggle chords
  -- (which also keeps it out of the shell), so only poll when no terminal is
  -- focused.
  ## if ccinfo.is_windows then
    -- ImGui never sees non-modifier key presses unless some ImGui text input
    -- is active (Dalamud forwards them to the game instead), so ask Win32.
    local vk = (@cint)(policy.toggle_consume_vk)
    if vk > 0 then
      local down = (GetAsyncKeyState(vk) & 0x8000) ~= 0
      if down and not host.toggle_vk_down and not host.terminal_focused then
        local shift = (GetAsyncKeyState(0x10) & 0x8000) ~= 0
        local ctrl = (GetAsyncKeyState(0x11) & 0x8000) ~= 0
        local alt = (GetAsyncKeyState(0x12) & 0x8000) ~= 0
        if game_foreground() then
          if ctrl == policy.toggle_ctrl and shift == policy.toggle_shift and alt == policy.toggle_alt then
            pressed = true
          elseif ctrl == policy.world_toggle_ctrl and shift == policy.world_toggle_shift and alt == policy.world_toggle_alt then
            toggle_world()
          end
        end
      end
      host.toggle_vk_down = down
    end
  ## else
    if host.toggle_imkey ~= ImGuiKey_None and not host.terminal_focused then
      local io = imgui.GetIO()
      if not io.KeySuper and imgui.IsKeyPressed(host.toggle_imkey, false) then
        if io.KeyCtrl == policy.toggle_ctrl and io.KeyShift == policy.toggle_shift and io.KeyAlt == policy.toggle_alt then
          pressed = true
        elseif io.KeyCtrl == policy.world_toggle_ctrl and io.KeyShift == policy.world_toggle_shift and io.KeyAlt == policy.world_toggle_alt then
          toggle_world()
        end
      end
    end
  ## end
  local now = imgui.GetTime()
  local have_state, down, pad_pressed = poll_toggle_pad(now, game_foreground)
  if have_state then
    -- tap: show/hide the dropdown; hold: next terminal; double tap: previous
    local ev = pad_gesture_update(&host.pad, down, now)
    if ev == PadGesture.Tap then pressed = true
    elseif ev == PadGesture.HoldStep then select_terminal(1)
    elseif ev == PadGesture.DoubleTap then select_terminal(-1) end
  elseif pad_pressed then
    pressed = true
  end
  if pressed then toggle_visible() end
end

global function resolve_toggle_key(): void
  host.toggle_imkey = ImGuiKey_None
  for i = 0, < input_key_count() do
    local k = input_key(i)
    if k.name == policy.toggle_key then host.toggle_imkey = k.imkey break end
  end
end
