

-- Where terminals live and whether they show: dropdown tabs, floating windows,
-- minimized, world panels; visibility toggles, focus stepping and the
-- character animation that follows them.
require 'core.app.agent'

-- Visibility -----------------------------------------------------------------------

-- The device animation matches state every frame: out while the dropdown is
-- out or any terminal (tab, window, world panel) has keyboard focus.
global function sync_animation(): void
  local want = host.dropdown_open or host.terminal_focused or host.world_focus ~= 0
  if want == host.anim_out then return end
  host.anim_out = want
  local err = policy_anim_toggle(want)
  if #err > 0 then logf(LOG_WARN, 'animation: %s', err) end
  err:destroy()
end

global function set_visible(v: boolean): void
  if host.dropdown_open == v then return end
  host.dropdown_open = v
  -- the dropdown takes the keyboard: a world panel must not keep it too
  if v then host.dropdown_focus_next = true host.world_focus = 0 end
end

global function set_world_visible(v: boolean): void
  if host.world_visible == v then return end
  host.world_visible = v
  if not v then host.world_focus = 0 end
end

-- Send a session to the terminals floating around the character.
global function make_pet(s: *Session): boolean
  local err = policy_world_command(s.id, 'pet')
  local ok = #err == 0
  if ok then
    host.world:push(s)
    set_world_visible(true)
  else
    logf(LOG_WARN, 'pet: %s', err)
  end
  err:destroy()
  return ok
end

-- Show or hide the dropdown and every floating window. Several input paths can
-- report the same press (Win32 key poll, ImGui key event, gamepad); only the
-- first one per frame counts.
global function toggle_visible(): void
  if host.last_toggle_frame == host.frame then return end
  host.last_toggle_frame = host.frame
  set_visible(not host.dropdown_open)
  if host.api.consume_key ~= nilptr then host.api.consume_key((@cint)(policy.toggle_consume_vk)) end
end

-- ctrl+shift+`: show/hide the terminals in the world; the first show with
-- none summons a pet terminal.
global function toggle_world(): void
  if host.last_world_toggle_frame == host.frame then return end
  host.last_world_toggle_frame = host.frame
  if host.api.consume_key ~= nilptr then host.api.consume_key((@cint)(policy.toggle_consume_vk)) end
  if not host.world_visible and #host.world == 0 then
    -- a pet needs a character to follow; without one the shell would be orphaned
    if not player_loaded() then
      logf(LOG_WARN, 'pet: no player (log in first)')
      return
    end
    local s = session_new(policy.default_profile - 1, 80, 24)
    if s ~= nilptr and not make_pet(s) then session_remove(s) end
    return
  end
  set_world_visible(not host.world_visible)
end


-- Drop-down --------------------------------------------------------------------
-- Remove a terminal from every view list (it stays alive).
global function take_out_of_views(s: *Session): void
  for i = 0, < #host.dropdown_tabs do
    if host.dropdown_tabs[i] == s then
      host.dropdown_tabs:remove(i)
      if host.dropdown_active >= #host.dropdown_tabs then host.dropdown_active = #host.dropdown_tabs - 1 end
      break
    end
  end
  for i = 0, < #host.windows do
    if host.windows[i] == s then host.windows:remove(i) break end
  end
  for i = 0, < #host.minimized do
    if host.minimized[i] == s then host.minimized:remove(i) break end
  end
  -- a game window closes by itself once its terminal left host.native (core/app/nativeview.nelua)
  for i = 0, < #host.native do
    if host.native[i] == s then host.native:remove(i) break end
  end
  for i = 0, < #host.world do
    if host.world[i] == s then
      host.world:remove(i)
      local e = policy_world_command(s.id, 'forget')
      e:destroy()
      break
    end
  end
  if host.world_focus == s.id then host.world_focus = 0 end
  if host.world_drag_id == s.id then host.world_drag_id = 0 end
  -- a panel that leaves the world is no longer full screen (the camera
  -- would otherwise stay zoomed on nothing)
  if host.world_full_id == s.id then host.world_full_id = 0 end
  if host.world_full_last == s.id then host.world_full_last = 0 end
end

-- Close a terminal wherever it lives (tab, floating window, world panel).
global function close_terminal(s: *Session): void
  local was_tab = false
  for i = 0, < #host.dropdown_tabs do
    if host.dropdown_tabs[i] == s then was_tab = true break end
  end
  take_out_of_views(s)
  -- the last tab closing hides the dropdown instead of spawning a fresh shell
  if was_tab and #host.dropdown_tabs == 0 then set_visible(false) end
  if host.popup_session == s then host.popup_session = nilptr end
  session_remove(s)
end

-- Taskbar ------------------------------------------------------------------------
global function find_session(id: integer): *Session
  for i = 0, < #host.sessions do
    if host.sessions[i].id == id then return host.sessions[i] end
  end
  return nilptr
end

-- A game window asked to take the keyboard (bring_forward), and the one that
-- has it (core/app/nativeview.nelua keeps both); 0 none.
global native_focus_request: integer = 0
global native_focused_id: integer = 0

-- The terminal commands act on: focused world panel, else a focused game
-- window, else the dropdown's active tab, else the most recent floating window.
global function active_terminal(): *Session
  if host.world_focus ~= 0 then
    local s = find_session(host.world_focus)
    if s ~= nilptr then return s end
  end
  if native_focused_id ~= 0 then
    local s = find_session(native_focused_id)
    if s ~= nilptr then return s end
  end
  if host.dropdown_active >= 0 and host.dropdown_active < #host.dropdown_tabs then return host.dropdown_tabs[host.dropdown_active] end
  if #host.windows > 0 then return host.windows[#host.windows - 1] end
  if #host.world > 0 then return host.world[#host.world - 1] end
  return nilptr
end

global function minimize(s: *Session): void
  take_out_of_views(s)
  host.minimized:push(s)
end

-- Back into the dropdown as the active tab, and show it.
global function restore(s: *Session): void
  take_out_of_views(s)
  host.dropdown_tabs:push(s)
  host.dropdown_active = #host.dropdown_tabs - 1
  set_visible(true)
end

-- Bring a terminal forward wherever it lives.
global function bring_forward(s: *Session): void
  for i = 0, < #host.world do
    if host.world[i] == s then
      set_world_visible(true)
      host.world_focus = s.id
      -- and no ImGui window keeps the keyboard alongside the panel
      if imgui.SetWindowFocusNil ~= nilptr then imgui.SetWindowFocusNil() end
      return
    end
  end
  for i = 0, < #host.dropdown_tabs do
    if host.dropdown_tabs[i] == s then
      host.dropdown_active = i
      set_visible(true)
      return
    end
  end
  for i = 0, < #host.windows do
    if host.windows[i] == s then set_visible(true) return end
  end
  for i = 0, < #host.native do
    if host.native[i] == s then native_focus_request = s.id return end
  end
  restore(s) -- minimized (or nowhere)
end

-- Step through the terminals (dropdown tabs, floating windows, world panels)
-- and bring the chosen one forward with keyboard focus.
global function select_terminal(dir: integer): void
  local list: vector(*Session)
  for i = 0, < #host.dropdown_tabs do list:push(host.dropdown_tabs[i]) end
  for i = 0, < #host.windows do list:push(host.windows[i]) end
  for i = 0, < #host.native do list:push(host.native[i]) end
  for i = 0, < #host.world do list:push(host.world[i]) end
  local n = #list
  if n > 0 then
    host.select_idx = ((host.select_idx + dir) % n + n) % n
    local s = list[host.select_idx]
    host.world_focus = 0
    bring_forward(s)
    logf(LOG_INFO, 'selected terminal %d (%d of %d)', s.id, host.select_idx + 1, n)
  end
  list:destroy()
end
