global function ghostty_key_encoder_new(allocator: *GhosttyAllocator, encoder: *GhosttyKeyEncoder): GhosttyResult <cimport, nodecl> end
global function ghostty_key_encoder_free(encoder: GhosttyKeyEncoder): void <cimport, nodecl> end
