-- libghostty-vt bindings for Nelua.
--
-- Every type and function here mirrors vendor/ghostty/include/ghostty/vt.h.
-- Records are declared `nodecl` so the C compiler uses the real header
-- definitions; the field lists below only exist for Nelua type checking.
-- Enum values and macros are imported by name, never hardcoded.

-- We link libghostty-vt statically; without this the Windows header marks
-- every function dllimport.
## cdefine 'GHOSTTY_STATIC'
## cinclude '<ghostty/vt.h>'
## linklib 'ghostty-vt'

global ghostty = @record{}

-- Result codes -------------------------------------------------------------
global GhosttyResult = @cint
global GHOSTTY_SUCCESS: cint <cimport, nodecl, const>
global GHOSTTY_OUT_OF_MEMORY: cint <cimport, nodecl, const>
global GHOSTTY_INVALID_VALUE: cint <cimport, nodecl, const>
global GHOSTTY_OUT_OF_SPACE: cint <cimport, nodecl, const>
global GHOSTTY_NO_VALUE: cint <cimport, nodecl, const>
global GHOSTTY_IO_ERROR: cint <cimport, nodecl, const>
global GHOSTTY_LIMIT_EXCEEDED: cint <cimport, nodecl, const>
global GHOSTTY_REJECTED: cint <cimport, nodecl, const>

-- Opaque handles -----------------------------------------------------------
global GhosttyTerminal <cimport, nodecl> = @pointer
global GhosttyRenderState <cimport, nodecl> = @pointer
global GhosttyRenderStateRowIterator <cimport, nodecl> = @pointer
global GhosttyRenderStateRowCells <cimport, nodecl> = @pointer
global GhosttyKeyEncoder <cimport, nodecl> = @pointer
global GhosttyKeyEvent <cimport, nodecl> = @pointer
global GhosttyAllocator <cimport, nodecl> = @record{ ctx: pointer, vtable: pointer }

-- Plain data types ---------------------------------------------------------
global GhosttyColorRgb <cimport, nodecl> = @record{ r: uint8, g: uint8, b: uint8 }
global GhosttyString <cimport, nodecl> = @record{ ptr: *[0]uint8, len: usize }
global GhosttyBuffer <cimport, nodecl> = @record{ ptr: *[0]uint8, cap: usize, len: usize }

global GhosttyStyleColorValue <cimport, nodecl> = @union{
  palette: uint8,
  rgb: GhosttyColorRgb,
  _padding: uint64,
}
global GhosttyStyleColor <cimport, nodecl> = @record{ tag: cint, value: GhosttyStyleColorValue }
global GhosttyStyle <cimport, nodecl> = @record{
  size: usize,
  fg_color: GhosttyStyleColor,
  bg_color: GhosttyStyleColor,
  underline_color: GhosttyStyleColor,
  bold: boolean,
  italic: boolean,
  faint: boolean,
  blink: boolean,
  inverse: boolean,
  invisible: boolean,
  strikethrough: boolean,
  overline: boolean,
  underline: cint,
}

global GhosttyRenderStateColors <cimport, nodecl> = @record{
  size: usize,
  background: GhosttyColorRgb,
  foreground: GhosttyColorRgb,
  cursor: GhosttyColorRgb,
  cursor_has_value: boolean,
  palette: [256]GhosttyColorRgb,
}

global GhosttyRenderStateRowSelection <cimport, nodecl> = @record{ size: usize, start_x: uint16, end_x: uint16 }

global GhosttyRenderStateCursor <cimport, nodecl> = @record{
  size: usize,
  viewport_has_value: boolean,
  viewport_x: uint16,
  viewport_y: uint16,
  wide_tail: boolean,
  visible: boolean,
  blinking: boolean,
  password_input: boolean,
  visual_style: cint,
}

global GhosttyTerminalScrollbar <cimport, nodecl> = @record{ total: uint64, offset: uint64, len: uint64 }
global GhosttyTerminalScrollViewportValue <cimport, nodecl> = @union{ delta: isize, row: usize, _padding: [2]uint64 }
global GhosttyTerminalScrollViewport <cimport, nodecl> = @record{ tag: cint, value: GhosttyTerminalScrollViewportValue }

-- Enum values ---------------------------------------------------------------
global GHOSTTY_SCROLL_VIEWPORT_TOP: cint <cimport, nodecl, const>
global GHOSTTY_SCROLL_VIEWPORT_BOTTOM: cint <cimport, nodecl, const>
