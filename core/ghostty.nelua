global GHOSTTY_RENDER_STATE_ROW_CELLS_DATA_STYLE: cint <cimport, nodecl, const>
global GHOSTTY_RENDER_STATE_ROW_CELLS_DATA_GRAPHEMES_LEN: cint <cimport, nodecl, const>
global GHOSTTY_RENDER_STATE_ROW_CELLS_DATA_BG_COLOR: cint <cimport, nodecl, const>
