-- Terminal modes (DEC private / ANSI), queried through GHOSTTY_TERMINAL_DATA_MODE.
global GhosttyMode <cimport, nodecl> = @uint16
global GhosttyTerminalModeConfig <cimport, nodecl> = @record{ mode: GhosttyMode, value: boolean }
global GHOSTTY_TERMINAL_DATA_MODE: cint <cimport, nodecl, const>
global function ghostty_mode_new(value: uint16, ansi: boolean): GhosttyMode <cimport, nodecl> end

-- True when the terminal has DEC mode `num` (e.g. 2004 bracketed paste) enabled.
global function ghostty_terminal_mode_enabled(terminal: GhosttyTerminal, num: uint16, ansi: boolean): boolean
  local cfg: GhosttyTerminalModeConfig = { mode = ghostty_mode_new(num, ansi) }
  if ghostty_terminal_get(terminal, GHOSTTY_TERMINAL_DATA_MODE, &cfg) ~= GHOSTTY_SUCCESS then return false end
  return cfg.value
end
