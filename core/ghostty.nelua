-- Callback types -------------------------------------------------------------
global GhosttyTerminalWritePtyFn = @function(terminal: GhosttyTerminal, userdata: pointer, data: *[0]uint8, len: usize): void
-- The title is not passed to the callback; query GHOSTTY_TERMINAL_DATA_TITLE.
global GhosttyTerminalTitleChangedFn = @function(terminal: GhosttyTerminal, userdata: pointer): void
global GhosttyTerminalBellFn = @function(terminal: GhosttyTerminal, userdata: pointer): void

