global ImGuiResolver = @function(name: cstring): pointer

-- Fill the function table using `resolve`. Returns the number of exports that
-- could not be resolved and reports each missing name through `report`.
-- Optional exports (a third `true` in the list) stay nil when missing and do
-- not count; their callers check for nil.
global function imgui_bind(resolve: ImGuiResolver, report: function(name: cstring): void): integer
  local missing: integer = 0
  ## for _, e in ipairs(exports) do
    do
      local p: pointer = resolve(#[e[2]]#)
      ## if not e[3] then
      if p == nilptr then
        missing = missing + 1
        if report then report(#[e[2]]#) end
      end
      ## end
      imgui.#|e[1]|# = (@#[ImGuiApi.value.fields[e[1]].type]#)(p)
    end
  ## end
  return missing
end

global function imgui_ready(): boolean
  return imgui.Begin ~= nilptr and imgui.GetIO ~= nilptr and imgui.DrawListAddText ~= nilptr
end

-- Small helpers -----------------------------------------------------------
global function vec2(x: float32, y: float32): ImVec2
  return ImVec2{ x = x, y = y }
end

-- Pack r,g,b,a bytes into ImU32 (IM_COL32 layout: ABGR little endian).
global function im_col32(r: uint8, g: uint8, b: uint8, a: uint8): uint32
  return (@uint32)(r) | ((@uint32)(g) << 8) | ((@uint32)(b) << 16) | ((@uint32)(a) << 24)
end
