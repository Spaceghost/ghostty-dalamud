## for _, c in ipairs(consts) do
  global #|c|#: cint <cimport, nodecl, const>
## end

-- The function table. Field names drop the `ig` / `ImDrawList_` prefixes;
-- the cimgui export names are listed in `imgui_exports` below.
global ImGuiApi = @record{
  GetIO: function(): *ImGuiIO,
  GetMainViewport: function(): *ImGuiViewport,
  GetBackgroundDrawList: function(): *ImDrawList,
  GetForegroundDrawList: function(): *ImDrawList,
  Begin: function(name: cstring, p_open: *boolean, flags: cint): boolean,
  End: function(): void,
  BeginChild: function(str_id: cstring, size: ImVec2, border: boolean, flags: cint): boolean,
  EndChild: function(): void,
  SetNextWindowPos: function(pos: ImVec2, cond: cint, pivot: ImVec2): void,
  SetNextWindowSize: function(size: ImVec2, cond: cint): void,
  SetNextWindowFocus: function(): void,
  SetNextWindowBgAlpha: function(alpha: float32): void,
  GetWindowDrawList: function(): *ImDrawList,
  GetWindowPos: function(pOut: *ImVec2): void,
  GetWindowSize: function(pOut: *ImVec2): void,
  GetContentRegionAvail: function(pOut: *ImVec2): void,
  GetCursorScreenPos: function(pOut: *ImVec2): void,
  SetCursorScreenPos: function(pos: ImVec2): void,
  IsWindowFocused: function(flags: cint): boolean,
  IsWindowHovered: function(flags: cint): boolean,
  PushStyleVarFloat: function(idx: cint, val: float32): void,
  PushStyleVarVec2: function(idx: cint, val: ImVec2): void,
  PopStyleVar: function(count: cint): void,
  PushStyleColorU32: function(idx: cint, col: uint32): void,
  PopStyleColor: function(count: cint): void,
  GetFont: function(): *ImFont,
  GetFontSize: function(): float32,
  PushFont: function(font: *ImFont): void,
  PopFont: function(): void,
  IsKeyDown: function(key: cint): boolean,
  -- queue a key event as the backend would (input.nelua releases stuck keys)
  IOAddKeyEvent: function(io: *ImGuiIO, key: cint, down: boolean): void,
  GetFrameCount: function(): cint,
  IsKeyPressed: function(key: cint, rep: boolean): boolean,
  IsMouseClicked: function(button: cint, rep: boolean): boolean,
  IsMouseDown: function(button: cint): boolean,
  IsMouseReleased: function(button: cint): boolean,
  GetMousePos: function(pOut: *ImVec2): void,
  InvisibleButton: function(str_id: cstring, size: ImVec2, flags: cint): boolean,
  IsItemActive: function(): boolean,
  IsItemHovered: function(flags: cint): boolean,
  SetKeyboardFocusHere: function(offset: cint): void,
  SetNextFrameWantCaptureKeyboard: function(want: boolean): void,
  SetNextFrameWantCaptureMouse: function(want: boolean): void,
  GetClipboardText: function(): cstring,
  SetClipboardText: function(text: cstring): void,
  GetTime: function(): float64,
  BeginTabBar: function(str_id: cstring, flags: cint): boolean,
  EndTabBar: function(): void,
  BeginTabItem: function(label: cstring, p_open: *boolean, flags: cint): boolean,
  EndTabItem: function(): void,
  TabItemButton: function(label: cstring, flags: cint): boolean,
  SmallButton: function(label: cstring): boolean,
  CollapsingHeader: function(label: cstring, flags: cint): boolean,
  SliderFloat: function(label: cstring, v: *float32, v_min: float32, v_max: float32, format: cstring, flags: cint): boolean,
  SliderInt: function(label: cstring, v: *cint, v_min: cint, v_max: cint, format: cstring, flags: cint): boolean,
  Checkbox: function(label: cstring, v: *boolean): boolean,
  BeginCombo: function(label: cstring, preview: cstring, flags: cint): boolean,
  EndCombo: function(): void,
  Separator: function(): void,
  TextUnformatted: function(text: cstring, text_end: cstring): void,
  PushTextWrapPos: function(wrap_local_pos_x: float32): void,
  PopTextWrapPos: function(): void,
  Spacing: function(): void,
  PushStyleColorVec4: function(idx: cint, col: ImVec4): void,
  SetWindowFocusNil: function(): void,
  PushIDInt: function(id: cint): void,
  PopID: function(): void,
  Text: function(fmt: cstring, ...: cvarargs): void,
  Button: function(label: cstring, size: ImVec2): boolean,
  SameLine: function(offset: float32, spacing: float32): void,
  Selectable: function(label: cstring, selected: boolean, flags: cint, size: ImVec2): boolean,
  Dummy: function(size: ImVec2): void,
  DrawListAddRectFilled: function(dl: *ImDrawList, p_min: ImVec2, p_max: ImVec2, col: uint32, rounding: float32, flags: cint): void,
  DrawListAddTriangleFilled: function(dl: *ImDrawList, p1: ImVec2, p2: ImVec2, p3: ImVec2, col: uint32): void,
  DrawListAddRect: function(dl: *ImDrawList, p_min: ImVec2, p_max: ImVec2, col: uint32, rounding: float32, flags: cint, thickness: float32): void,
  DrawListAddLine: function(dl: *ImDrawList, p1: ImVec2, p2: ImVec2, col: uint32, thickness: float32): void,
  DrawListAddText: function(dl: *ImDrawList, font: *ImFont, font_size: float32, pos: ImVec2, col: uint32, text_begin: cstring, text_end: cstring, wrap_width: float32, cpu_fine_clip_rect: *ImVec4): void,
  DrawListPushClipRect: function(dl: *ImDrawList, min: ImVec2, max: ImVec2, intersect: boolean): void,
  DrawListPopClipRect: function(dl: *ImDrawList): void,
  FontCalcTextSizeA: function(pOut: *ImVec2, font: *ImFont, size: float32, max_width: float32, wrap_width: float32, text_begin: cstring, text_end: cstring, remaining: *cstring): void,
  -- the font's glyph for a BMP code point (16-bit ImWchar), nilptr when it has none (core/glyphfb.nelua)
  FontFindGlyphNoFallback: function(font: *ImFont, c: uint16): pointer,
  -- the same, but a code point the font lacks gives its fallback glyph: how core/glyphfb.nelua
  -- asks a cimgui that does not export ImFont_FindGlyphNoFallback
  FontFindGlyph: function(font: *ImFont, c: uint16): pointer,
  -- raw triangles with per-vertex colour (soft gradients: the visual bell)
  DrawListPrimReserve: function(dl: *ImDrawList, idx_count: cint, vtx_count: cint): void,
  DrawListPrimVtx: function(dl: *ImDrawList, pos: ImVec2, uv: ImVec2, col: uint32): void,
  GetFontTexUvWhitePixel: function(pOut: *ImVec2): void,
  -- glass chrome (core/chrome.nelua, core/app/dropdown.nelua)
  DrawListAddCircle: function(dl: *ImDrawList, center: ImVec2, radius: float32, col: uint32, num_segments: cint, thickness: float32): void,
  DrawListAddCircleFilled: function(dl: *ImDrawList, center: ImVec2, radius: float32, col: uint32, num_segments: cint): void,
  DrawListAddPolyline: function(dl: *ImDrawList, points: *ImVec2, num_points: cint, col: uint32, flags: cint, thickness: float32): void,
  BeginTooltip: function(): void,
  EndTooltip: function(): void,
  IsMouseDragging: function(button: cint, lock_threshold: float32): boolean,
  IsItemActivated: function(): boolean,
  IsItemDeactivatedAfterEdit: function(): boolean,
  OpenPopup: function(str_id: cstring, flags: cint): void,
  BeginPopup: function(str_id: cstring, flags: cint): boolean,
  EndPopup: function(): void,
  CloseCurrentPopup: function(): void,
  -- callback: function(list: *ImDrawList, cmd: *ImDrawCmd): void, or IMDRAW_CALLBACK_RESET
  DrawListAddCallback: function(dl: *ImDrawList, callback: pointer, callback_data: pointer): void,
  -- a textured rectangle (remote windows: the ImTextureID is Dalamud's D3D11 shader resource view)
  DrawListAddImage: function(dl: *ImDrawList, tex: pointer, p_min: ImVec2, p_max: ImVec2, uv_min: ImVec2, uv_max: ImVec2, col: uint32): void,
  -- a one-line text box (the Windows picker's Run:); callback unused (nilptr)
  InputText: function(label: cstring, buf: cstring, buf_size: csize, flags: cint, callback: pointer, user_data: pointer): boolean,
  -- the /ask panel's input box and its scrolled conversation (core/ui.nelua); optional
  InputTextMultiline: function(label: cstring, buf: cstring, buf_size: csize, size: ImVec2, flags: cint, callback: pointer, user_data: pointer): boolean,
  SetScrollHereY: function(center_y_ratio: float32): void,
  GetScrollY: function(): float32,
  GetScrollMaxY: function(): float32,
}

-- Draw-list callback that makes the renderer restore its own state. Dalamud's
-- value, not stock ImGui's (void*)-1: Dalamud uses -1 for its private blur
-- callback, which frees UserCallbackData. Re-check Dalamud.Bindings.ImGui
-- ImDrawCallbackResetRenderState on every Dalamud API bump.
global IMDRAW_CALLBACK_RESET: isize <comptime> = -8

global imgui: ImGuiApi

