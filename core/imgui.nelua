-- Dear ImGui (cimgui 1.88 docking, as shipped by Dalamud) bindings.
--
-- Types and enum values come from the vendored cimgui.h so the C compiler
-- owns every struct layout. Functions are NOT linked: Dalamud already has
-- cimgui.dll loaded in-process, so the host resolves each export by name at
-- runtime (GetProcAddress on Windows, a fake table in tests) and fills the
-- `imgui` function table below.

## cdefine 'CIMGUI_DEFINE_ENUMS_AND_STRUCTS'
-- cimgui.h carries one C++-only `constexpr`; harmless as plain C.
## cdefine 'constexpr'
## if not ccinfo.is_windows then
## cdefine '__cdecl'
## end
## cinclude '<cimgui.h>'

global ImVec2 <cimport, nodecl> = @record{ x: float32, y: float32 }
global ImVec4 <cimport, nodecl> = @record{ x: float32, y: float32, z: float32, w: float32 }
global ImDrawVert <cimport, nodecl> = @record{ pos: ImVec2, uv: ImVec2, col: uint32 }
global ImVector_ImDrawVert <cimport, nodecl> = @record{ Size: cint, Capacity: cint, Data: *[0]ImDrawVert }
global ImDrawCmd <cimport, nodecl> = @record{
  ClipRect: ImVec4, TextureId: pointer, VtxOffset: cuint, IdxOffset: cuint, ElemCount: cuint,
  UserCallback: pointer,       -- draw-list callback (1.88: no UserCallbackDataSize)
  UserCallbackData: pointer,
}
global ImVector_ImDrawCmd <cimport, nodecl> = @record{ Size: cint, Capacity: cint, Data: *[0]ImDrawCmd }
global ImVector_ImDrawIdx <cimport, nodecl> = @record{ Size: cint, Capacity: cint, Data: *[0]uint16 }
global ImDrawCmdHeader <cimport, nodecl> = @record{ ClipRect: ImVec4, TextureId: pointer, VtxOffset: cuint }
-- Only the buffers are used (world-space panels remap vertices after drawing;
-- /term selftest counts them), the texture of the next command, and the
-- write cursors core/hudmask.nelua puts back after rewriting a list's tail.
global ImDrawList <cimport, nodecl> = @record{
  CmdBuffer: ImVector_ImDrawCmd, IdxBuffer: ImVector_ImDrawIdx, VtxBuffer: ImVector_ImDrawVert, Flags: cint, _CmdHeader: ImDrawCmdHeader,
  _VtxCurrentIdx: cuint, _VtxWritePtr: *ImDrawVert, _IdxWritePtr: *uint16,
}
-- The font's atlas and its textures (Dalamud's ImGui keeps several per atlas;
-- TextureIndexCommon holds the white pixel shapes use): a game window's
-- offscreen draw list starts on that texture (core/app/nativeview.nelua).
global ImFontAtlasTexture <cimport, nodecl> = @record{ TexID: pointer, TexPixelsAlpha8: *uint8, TexPixelsRGBA32: *uint32 }
global ImVector_ImFontAtlasTexture <cimport, nodecl> = @record{ Size: cint, Capacity: cint, Data: *[0]ImFontAtlasTexture }
global ImFontAtlas <cimport, nodecl> = @record{ Textures: ImVector_ImFontAtlasTexture, TextureIndexCommon: cint }
global ImFont <cimport, nodecl> = @record{ ContainerAtlas: *ImFontAtlas }
global ImGuiViewport <cimport, nodecl> = @record{ ID: uint32, Flags: cint, Pos: ImVec2, Size: ImVec2, WorkPos: ImVec2, WorkSize: ImVec2 }
global ImVector_ImWchar <cimport, nodecl> = @record{ Size: cint, Capacity: cint, Data: *[0]uint16 }

-- Only the ImGuiIO fields the plugin reads are declared; the C compiler uses
-- the full definition from cimgui.h for offsets.
global ImGuiIO <cimport, nodecl> = @record{
  ConfigFlags: cint,
  DeltaTime: float32,
  DisplaySize: ImVec2,
  WantCaptureMouse: boolean,
  WantCaptureKeyboard: boolean,
  WantTextInput: boolean,
  MouseWheel: float32,
  MouseWheelH: float32,
  KeyCtrl: boolean,
  KeyShift: boolean,
  KeyAlt: boolean,
  KeySuper: boolean,
  InputQueueCharacters: ImVector_ImWchar,
}

