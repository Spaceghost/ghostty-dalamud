##  {'F7','F7','f7',0,0x76},{'F8','F8','f8',0,0x77},{'F9','F9','f9',0,0x78},{'F10','F10','f10',0,0x79},{'F11','F11','f11',0,0x7A},{'F12','F12','f12',0,0x7B},
##  {'Keypad0','NUMPAD_0','kp0',48,0x60},{'Keypad1','NUMPAD_1','kp1',49,0x61},{'Keypad2','NUMPAD_2','kp2',50,0x62},{'Keypad3','NUMPAD_3','kp3',51,0x63},
##  {'Keypad4','NUMPAD_4','kp4',52,0x64},{'Keypad5','NUMPAD_5','kp5',53,0x65},{'Keypad6','NUMPAD_6','kp6',54,0x66},{'Keypad7','NUMPAD_7','kp7',55,0x67},
##  {'Keypad8','NUMPAD_8','kp8',56,0x68},{'Keypad9','NUMPAD_9','kp9',57,0x69},{'KeypadDecimal','NUMPAD_DECIMAL','kpdecimal',46,0x6E},
