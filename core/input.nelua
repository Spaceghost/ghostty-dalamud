##  {'Equal','EQUAL','equal',61,0xBB},{'LeftBracket','BRACKET_LEFT','leftbracket',91,0xDB},{'Backslash','BACKSLASH','backslash',92,0xDC},
##  {'RightBracket','BRACKET_RIGHT','rightbracket',93,0xDD},{'GraveAccent','BACKQUOTE','grave',96,0xC0},
