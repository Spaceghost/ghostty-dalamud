## for i = 0, 9 do keymap[#keymap+1] = {tostring(i), 'DIGIT_'..i, tostring(i), 48 + i, 48 + i} end
## for i = 0, 25 do local c = string.char(65 + i) keymap[#keymap+1] = {c, c, c:lower(), 97 + i, 65 + i} end
-- The character with shift on a US layout, by keymap name (alt+shift+<key>).
-- A stopgap until the layout is asked (ToUnicode).
## local shifted = { apostrophe = 34, comma = 60, minus = 95, period = 62, slash = 63, semicolon = 58, equal = 43,
##   leftbracket = 123, backslash = 124, rightbracket = 125, grave = 126 }
## for i = 0, 9 do shifted[tostring(i)] = (')!@#$%^&*('):byte(i + 1) end
## for i = 0, 25 do shifted[string.char(97 + i)] = 65 + i end

global KeyInfo = @record{ imkey: cint, gkey: cint, name: string, codepoint: uint32, shifted: uint32, vk: cint, rep: KeyRepeat, presses: integer }

global input_keys: [#[#keymap]#]KeyInfo
local input_repeat_frame: cint = -1

local keys_ready: boolean = false
local function ensure_keys(): void
  if keys_ready then return end
  ## for i, k in ipairs(keymap) do
    input_keys[#[i-1]#] = { imkey = #|'ImGuiKey_'..k[1]|#, gkey = #|'GHOSTTY_KEY_'..k[2]|#, name = #[k[3]]#, codepoint = #[k[4]]#, shifted = #[shifted[k[3]] or 0]#, vk = #[k[5]]# }
  ## end
  keys_ready = true
end

global function input_key_count(): integer
  ensure_keys()
  return #input_keys
end

global function input_key(i: integer): *KeyInfo
  ensure_keys()
  return &input_keys[i]
end

-- Modifier state from ImGuiIO, as libghostty mods.
global function input_mods(io: *ImGuiIO): uint16
  local mods: uint16 = 0
  if io.KeyShift then mods = mods | GHOSTTY_MODS_SHIFT end
  if io.KeyCtrl then mods = mods | GHOSTTY_MODS_CTRL end
  if io.KeyAlt then mods = mods | GHOSTTY_MODS_ALT end
  if io.KeySuper then mods = mods | GHOSTTY_MODS_SUPER end
  return mods
end

-- A key press decision for one frame.
global InputSink = @function(ctx: pointer, data: *[0]uint8, len: usize): void
global ActionSink = @function(ctx: pointer, action: string, key: *KeyInfo): boolean

local function encode_utf8(cp: uint32, out: *[0]uint8): usize
  if cp < 0x80 then
    out[0] = (@uint8)(cp)
    return 1
  elseif cp < 0x800 then
    out[0] = (@uint8)(0xC0 | (cp >> 6))
    out[1] = (@uint8)(0x80 | (cp & 0x3F))
    return 2
  elseif cp < 0x10000 then
    out[0] = (@uint8)(0xE0 | (cp >> 12))
    out[1] = (@uint8)(0x80 | ((cp >> 6) & 0x3F))
    out[2] = (@uint8)(0x80 | (cp & 0x3F))
    return 3
  else
    out[0] = (@uint8)(0xF0 | (cp >> 18))
    out[1] = (@uint8)(0x80 | ((cp >> 12) & 0x3F))
    out[2] = (@uint8)(0x80 | ((cp >> 6) & 0x3F))
    out[3] = (@uint8)(0x80 | (cp & 0x3F))
    return 4
  end
end

-- Keep keystrokes away from the game while a terminal has focus. Dalamud's
-- WndProc only withholds WM_KEYDOWN/WM_CHAR from the game while WantTextInput
-- is set; WantCaptureKeyboard alone lets Enter and letters open the chat box
-- (notably in controller mode). ImGui recomputes the flag in NewFrame, so
-- setting it during draw covers the messages until the next frame.
global function input_claim_keyboard(io: *ImGuiIO): void
  io.WantCaptureKeyboard = true
  io.WantTextInput = true
end

-- Queue a release for a key ImGui holds down, so its own state agrees from
-- the next NewFrame on (and the key's next press is an edge again).
local function queue_release(io: *ImGuiIO, key: cint): void
  if imgui.IOAddKeyEvent ~= nilptr then imgui.IOAddKeyEvent(io, key, false) end
end

-- Polling resumes after the game had the keyboard: modifiers released
-- meanwhile are still down in ImGui (a stuck ctrl turns backspace into
-- delete-word). Drop each one ImGui holds that the keyboard (`ctrl`..`super`,
-- the OS state) does not, for this frame and in ImGui. Modifiers are otherwise
-- left as ImGui has them: it applies each change in order with the key events,
-- so a queued key keeps the modifiers it was typed with.
global function input_release_stuck_mods(io: *ImGuiIO, ctrl: boolean, shift: boolean, alt: boolean, super: boolean): void
  if io.KeyCtrl and not ctrl then
    io.KeyCtrl = false
    queue_release(io, ImGuiKey_ModCtrl) queue_release(io, ImGuiKey_LeftCtrl) queue_release(io, ImGuiKey_RightCtrl)
  end
  if io.KeyShift and not shift then
    io.KeyShift = false
    queue_release(io, ImGuiKey_ModShift) queue_release(io, ImGuiKey_LeftShift) queue_release(io, ImGuiKey_RightShift)
  end
  if io.KeyAlt and not alt then
    io.KeyAlt = false
    queue_release(io, ImGuiKey_ModAlt) queue_release(io, ImGuiKey_LeftAlt) queue_release(io, ImGuiKey_RightAlt)
  end
  if io.KeySuper and not super then
    io.KeySuper = false
    queue_release(io, ImGuiKey_ModSuper) queue_release(io, ImGuiKey_LeftSuper) queue_release(io, ImGuiKey_RightSuper)
  end
end

-- Poll ImGui for this frame's keyboard input and emit bytes for the PTY.
--
-- `on_action` is asked first for every named key press (with the Lua keymap
-- behind it); if it returns true the key is consumed by the plugin.
-- Text characters arrive through the ImGui character queue; control keys
-- and chords are encoded with libghostty's key encoder so the terminal sees
-- exactly what a native Ghostty would send (including kitty keyboard mode).
-- `right_alt`: the right Alt key is physically down; with ctrl and alt both
-- reported it is AltGr, which types characters rather than chords.
global function input_poll_keys(io: *ImGuiIO, encoder: GhosttyKeyEncoder, event: GhosttyKeyEvent,
                                sink: InputSink, sink_ctx: pointer,
                                on_action: ActionSink, action_ctx: pointer, right_alt: boolean): void
  ensure_keys()
  -- repeat state advances once per frame even when several terminals poll
  local frame = imgui.GetFrameCount()
  local fresh = frame ~= input_repeat_frame
  local resumed = fresh and frame ~= input_repeat_frame + 1
  input_repeat_frame = frame
  ## if ccinfo.is_windows then
    if resumed then
      input_release_stuck_mods(io, (win_key_state(0x11) & 0x8000) ~= 0, (win_key_state(0x10) & 0x8000) ~= 0,
        (win_key_state(0x12) & 0x8000) ~= 0, (win_key_state(0x5B) & 0x8000) ~= 0 or (win_key_state(0x5C) & 0x8000) ~= 0)
    end
  ## end
  local altgr = right_alt and io.KeyCtrl and io.KeyAlt -- Windows reports AltGr as ctrl+alt
  local mods = input_mods(io)
  local buf: [64]cchar
  local outlen: usize = 0
  local eaten_cp: uint32 = 0 -- character of a printable key an action consumed

  -- 1. Named keys (control keys always; printable keys only when a chord
  --    modifier is held, otherwise the character queue below handles them).
  for i = 0, < #input_keys do
    local k = &input_keys[i]
    if fresh then
      local down = key_physically_down(k.vk, k.imkey)
      local imgui_down = imgui.IsKeyDown(k.imkey)
      if resumed then
        -- polling resumes after frames without a focused terminal: forget old
        -- state, and release in ImGui what the game heard go up
        k.rep = {}
        if imgui_down and not down then queue_release(io, k.imkey) end
      end
      k.presses = key_repeat_step(&k.rep, down, imgui.IsKeyPressed(k.imkey, false), imgui_down, io.DeltaTime)
    end
    if k.presses > 0 then
      if on_action ~= nilptr and on_action(action_ctx, k.name, k) then
        if k.codepoint >= 32 then eaten_cp = k.codepoint end
        continue
      end
      local printable = k.codepoint >= 32 and k.codepoint ~= 127
      -- AltGr+<key> types a character (@ on a German layout), not a chord
      local chord = (io.KeyCtrl or io.KeyAlt or io.KeySuper) and not (altgr and printable)
      if printable and not chord then
        continue -- comes through InputQueueCharacters with proper layout/IME handling
      end
      ghostty_key_event_set_action(event, GHOSTTY_KEY_ACTION_PRESS)
      ghostty_key_event_set_key(event, k.gkey)
      ghostty_key_event_set_mods(event, mods)
      ghostty_key_event_set_consumed_mods(event, 0)
      ghostty_key_event_set_unshifted_codepoint(event, k.codepoint)
      ghostty_key_event_set_utf8(event, nilptr, 0)
      if printable and not io.KeyCtrl and not io.KeySuper and k.codepoint ~= 0 then
        -- alt+<key>: give the encoder the character so it can ESC-prefix it
        local cp = k.codepoint
        if io.KeyShift and k.shifted ~= 0 then
          cp = k.shifted
          ghostty_key_event_set_consumed_mods(event, GHOSTTY_MODS_SHIFT)
        end
        local u: [8]uint8
        local n = encode_utf8(cp, &u)
        ghostty_key_event_set_utf8(event, (@cstring)(&u), n)
      end
      if ghostty_key_encoder_encode(encoder, event, &buf, 64, &outlen) == GHOSTTY_SUCCESS and outlen > 0 then
        sink(sink_ctx, (@*[0]uint8)(&buf), outlen)
      end
    end
  end

  -- 2. Text input.
  local q = &io.InputQueueCharacters
  for i = 0, < q.Size do
    local cp: uint32 = q.Data[i]
    if eaten_cp ~= 0 and (cp == eaten_cp or (eaten_cp >= 97 and eaten_cp <= 122 and cp == eaten_cp - 32)) then
      eaten_cp = 0 -- drop it once (shift makes the letter uppercase)
    elseif cp >= 32 and cp ~= 127 and not ((io.KeyCtrl and not altgr) or io.KeySuper) then
      local u: [8]uint8
      local n = encode_utf8(cp, &u)
      -- Send through the encoder so kitty keyboard protocol text events are right.
      ghostty_key_event_set_action(event, GHOSTTY_KEY_ACTION_PRESS)
      ghostty_key_event_set_key(event, GHOSTTY_KEY_UNIDENTIFIED)
      -- the layout already applied shift (and AltGr's ctrl+alt)
      local consumed: uint16 = GHOSTTY_MODS_SHIFT
      if altgr then consumed = consumed | GHOSTTY_MODS_CTRL | GHOSTTY_MODS_ALT end
      ghostty_key_event_set_mods(event, mods & ~consumed)
      ghostty_key_event_set_consumed_mods(event, mods & consumed)
      ghostty_key_event_set_unshifted_codepoint(event, cp)
      ghostty_key_event_set_utf8(event, (@cstring)(&u), n)
      if ghostty_key_encoder_encode(encoder, event, &buf, 64, &outlen) == GHOSTTY_SUCCESS and outlen > 0 then
        sink(sink_ctx, (@*[0]uint8)(&buf), outlen)
      else
        sink(sink_ctx, &u, n)
      end
    end
  end
  q.Size = 0 -- consumed
end

global function input_poll(io: *ImGuiIO, encoder: GhosttyKeyEncoder, event: GhosttyKeyEvent,
                           sink: InputSink, sink_ctx: pointer,
                           on_action: ActionSink, action_ctx: pointer): void
  local right_alt = false
  ## if ccinfo.is_windows then
    right_alt = (win_key_state(0xA5) & 0x8000) ~= 0
  ## end
  input_poll_keys(io, encoder, event, sink, sink_ctx, on_action, action_ctx, right_alt)
end

-- Gamepad button gestures ----------------------------------------------------------
-- One button, three meanings: a quick press, a double tap, and a hold that
-- repeats while held. A single tap is only reported once the double-tap window
-- (from its release to the next press) has passed, so it never fires before a
-- double tap; a press or hold after the window reports the tap first.
global PadGesture = @enum{ None = 0, Tap, DoubleTap, HoldStep }

global PadGestureState = @record{
  down: boolean,
  down_at: float64,
  last_step: float64,
  holding: boolean,
  taps: integer,
  tap_at: float64,
}

global PAD_HOLD_S: float64 <comptime> = 0.4
global PAD_REPEAT_S: float64 <comptime> = 0.7
global PAD_DOUBLE_S: float64 <comptime> = 0.3

global function pad_gesture_update(st: *PadGestureState, down: boolean, t: float64): PadGesture
  local ev = PadGesture.None
  if down and not st.down then
    st.down_at = t
    st.holding = false
    if st.taps == 1 and t - st.tap_at > PAD_DOUBLE_S then
      st.taps = 0 -- the samples skipped the window (a hitch): the last tap stands alone
      ev = PadGesture.Tap
    end
  elseif down and st.down then
    if not st.holding and t - st.down_at >= PAD_HOLD_S then
      if st.taps == 1 then
        st.taps = 0 -- a tap, then this hold: the tap first, the hold from the next frame
        ev = PadGesture.Tap
      else
        st.holding = true
        st.last_step = t
        ev = PadGesture.HoldStep
      end
    elseif st.holding and t - st.last_step >= PAD_REPEAT_S then
      st.last_step = t
      ev = PadGesture.HoldStep
    end
  elseif not down and st.down then
    if not st.holding then
      if st.taps == 1 and st.down_at - st.tap_at <= PAD_DOUBLE_S then
        st.taps = 0
        ev = PadGesture.DoubleTap
      else
        st.taps = 1
        st.tap_at = t
      end
    end
    st.holding = false
  elseif not down and st.taps == 1 and t - st.tap_at > PAD_DOUBLE_S then
    st.taps = 0
    ev = PadGesture.Tap
  end
  st.down = down
  return ev
end

-- Touchpad swipes as arrow keys ------------------------------------------------------
-- The DualSense touchpad as four arrow keys, for a terminal: a swipe gives one
-- arrow per TOUCH_STEP_X across (TOUCH_STEP_Y up or down) in the direction it
-- mostly went, so a long swipe gives several and a short flick one. Held at
-- the edge the last step went toward, after TOUCH_HOLD_S, the arrow repeats
-- every TOUCH_REPEAT_S; a finger laid on an edge and held still does the same
-- after TOUCH_EDGE_HOLD_S. Coordinates are the controller's (x 0..1919 from
-- the left, y 0..1079 from the top).
global TouchDir = @enum{ None = 0, Up, Down, Left, Right }

global TouchSwipeState = @record{
  touching: boolean,
  ax: integer, ay: integer, -- where the next step is measured from
  dir: TouchDir,            -- the last step's direction (None: none yet this touch)
  step_at: float64,         -- when the last step was (or the touch began)
  repeat_at: float64,       -- when the last arrow was given
}

global TOUCH_STEP_X: integer <comptime> = 240     -- an eighth of the pad across
global TOUCH_STEP_Y: integer <comptime> = 180     -- a sixth of it up or down
global TOUCH_HOLD_S: float64 <comptime> = 0.35
global TOUCH_EDGE_HOLD_S: float64 <comptime> = 0.5
global TOUCH_REPEAT_S: float64 <comptime> = 0.08
global TOUCH_EDGE_X: integer <comptime> = 384     -- the outer fifth each side
global TOUCH_EDGE_Y: integer <comptime> = 270     -- the outer quarter top and bottom

-- The edge (x, y) is at, horizontal ones first; `want` asks for that one only.
local function touch_edge(x: integer, y: integer, want: TouchDir): TouchDir
  local d = TouchDir.None
  if x < TOUCH_EDGE_X then d = TouchDir.Left
  elseif x >= 1920 - TOUCH_EDGE_X then d = TouchDir.Right
  elseif y < TOUCH_EDGE_Y then d = TouchDir.Up
  elseif y >= 1080 - TOUCH_EDGE_Y then d = TouchDir.Down end
  if want ~= TouchDir.None then
    if want == TouchDir.Left and x < TOUCH_EDGE_X then return want end
    if want == TouchDir.Right and x >= 1920 - TOUCH_EDGE_X then return want end
    if want == TouchDir.Up and y < TOUCH_EDGE_Y then return want end
    if want == TouchDir.Down and y >= 1080 - TOUCH_EDGE_Y then return want end
    return TouchDir.None
  end
  return d
end

-- Start over from where the finger is (the pad was pressed: a finger moves
-- as it clicks, which is not a swipe).
global function touch_swipe_reset(st: *TouchSwipeState, x: integer, y: integer, t: float64): void
  st.ax, st.ay, st.dir, st.step_at, st.repeat_at = x, y, TouchDir.None, t, t
end

-- One sample of the first finger; at most one arrow a call (a swipe faster
-- than that gives the rest on the next frames).
global function touch_swipe_update(st: *TouchSwipeState, touching: boolean, x: integer, y: integer, t: float64): TouchDir
  if not touching then
    st.touching, st.dir = false, TouchDir.None
    return TouchDir.None
  end
  if not st.touching then
    st.touching = true
    touch_swipe_reset(st, x, y, t)
    return TouchDir.None
  end
  local dx, dy = x - st.ax, y - st.ay
  local fx = (@float64)(math.abs(dx)) / TOUCH_STEP_X
  local fy = (@float64)(math.abs(dy)) / TOUCH_STEP_Y
  if fx >= 1 or fy >= 1 then
    local d: TouchDir
    if fx >= fy then
      d = dx > 0 and TouchDir.Right or TouchDir.Left
      st.ax = st.ax + (dx > 0 and TOUCH_STEP_X or -TOUCH_STEP_X)
      st.ay = y
    else
      d = dy > 0 and TouchDir.Down or TouchDir.Up
      st.ay = st.ay + (dy > 0 and TOUCH_STEP_Y or -TOUCH_STEP_Y)
      st.ax = x
    end
    st.dir, st.step_at, st.repeat_at = d, t, t
    return d
  end
  if st.dir ~= TouchDir.None then
    -- held at the edge it went toward
    if t - st.step_at >= TOUCH_HOLD_S and t - st.repeat_at >= TOUCH_REPEAT_S and touch_edge(x, y, st.dir) ~= TouchDir.None then
      st.repeat_at = t
      return st.dir
    end
  elseif t - st.step_at >= TOUCH_EDGE_HOLD_S and t - st.repeat_at >= TOUCH_REPEAT_S then
    -- laid on an edge and held still
    local d = touch_edge(x, y, TouchDir.None)
    if d ~= TouchDir.None then
      st.repeat_at = t
      return d
    end
  end
  return TouchDir.None
end

-- Keys from the controller -------------------------------------------------------
-- What the touchpad types into the focused terminal (core/app/hotkeys.nelua):
-- arrows from swipes, Enter from a click, and deleting from a double click or
-- a held one. Encoded like keys from the keyboard, so a program in application
-- cursor mode or the kitty keyboard protocol gets what it expects.
global PadKey = @enum{ None = 0, Up, Down, Left, Right, Enter, Backspace, DeleteWord }

global PAD_KEYS_MAX: integer <comptime> = 32

global PadKeyQueue = @record{
  n: integer,
  k: [PAD_KEYS_MAX]PadKey,
}

global function pad_keys_push(q: *PadKeyQueue, k: PadKey): void
  if k == PadKey.None or q.n >= PAD_KEYS_MAX then return end
  q.k[q.n] = k
  q.n = q.n + 1
end

global function pad_key_of_dir(d: TouchDir): PadKey
  if d == TouchDir.Up then return PadKey.Up
  elseif d == TouchDir.Down then return PadKey.Down
  elseif d == TouchDir.Left then return PadKey.Left
  elseif d == TouchDir.Right then return PadKey.Right end
  return PadKey.None
end

-- Every queued key through `encoder` into `sink`, then the queue empty.
-- Deleting a word is Ctrl+W (readline, zsh's line editor, most prompts).
global function pad_keys_send(q: *PadKeyQueue, encoder: GhosttyKeyEncoder, event: GhosttyKeyEvent,
                              sink: InputSink, sink_ctx: pointer): void
  local buf: [64]cchar
  for i = 0, < q.n do
    local k = q.k[i]
    local key, mods, cp = GHOSTTY_KEY_UNIDENTIFIED, (@uint16)(0), (@uint32)(0)
    if k == PadKey.Up then key = GHOSTTY_KEY_ARROW_UP
    elseif k == PadKey.Down then key = GHOSTTY_KEY_ARROW_DOWN
    elseif k == PadKey.Left then key = GHOSTTY_KEY_ARROW_LEFT
    elseif k == PadKey.Right then key = GHOSTTY_KEY_ARROW_RIGHT
    elseif k == PadKey.Enter then key, cp = GHOSTTY_KEY_ENTER, 13
    elseif k == PadKey.Backspace then key = GHOSTTY_KEY_BACKSPACE
    elseif k == PadKey.DeleteWord then key, mods, cp = GHOSTTY_KEY_W, GHOSTTY_MODS_CTRL, 119 end
    if key ~= GHOSTTY_KEY_UNIDENTIFIED then
      ghostty_key_event_set_action(event, GHOSTTY_KEY_ACTION_PRESS)
      ghostty_key_event_set_key(event, key)
      ghostty_key_event_set_mods(event, mods)
      ghostty_key_event_set_consumed_mods(event, 0)
      ghostty_key_event_set_unshifted_codepoint(event, cp)
      ghostty_key_event_set_utf8(event, nilptr, 0)
      local outlen: usize = 0
      if ghostty_key_encoder_encode(encoder, event, &buf, 64, &outlen) == GHOSTTY_SUCCESS and outlen > 0 then
        sink(sink_ctx, (@*[0]uint8)(&buf), outlen)
      end
    end
  end
  q.n = 0
end
