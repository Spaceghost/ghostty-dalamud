-- Translate ImGui keyboard state into libghostty key events and PTY bytes.
require 'string'
require 'math'
require 'core.ghostty'
require 'core.imgui'

-- Key presses and repeat. Two sources describe each key and neither is
-- enough alone:
-- * ImGui's edge (IsKeyPressed) counts every press exactly once, but it lags:
--   events are handled at NewFrame, and when several arrive together ImGui
--   spreads them over later frames. A key released while the game had the
--   keyboard stays down in ImGui, so its next press brings no edge at all.
-- * The OS state (GetAsyncKeyState) is current but misses a tap that begins
--   and ends between two frames, and cannot tell a press from a key held
--   since before the terminal took the keyboard.
-- So ImGui's edge is the press. The OS state only adds the press ImGui cannot
-- report (it still holds the key from a release it never heard), decides how
-- long a key is held, and ends a hold. Repeat counts held frames rather than
-- wall time, each frame adding at most KEY_REPEAT_MAX_STEP: ImGui's own repeat
-- uses wall time, so a tap across a game hitch would look held.
global KEY_REPEAT_DELAY <comptime> = 0.3
global KEY_REPEAT_RATE <comptime> = 0.035
global KEY_REPEAT_MAX_STEP <comptime> = 1 / 30
global KeyRepeat = @record{
  down: boolean,       -- physically held as of the last frame
  armed: boolean,      -- seen released while polled: a later hold is a real press
  passive: boolean,    -- held with no press counted for it: never repeats
  early: boolean,      -- passive since before polling began (not armed)
  early_n: integer,    -- frames polled since `early` began
  imgui_seen: boolean, -- ImGui showed the key down while `early`
  owes_up: boolean,    -- ImGui shows the key down from a press already seen; its release is still coming
  edge_up: boolean,    -- last frame counted an edge while the OS showed the key up
  held: float32, next_at: float32,
}

-- Presses to send this frame (0 or 1). `down`: the key is physically held
-- now; `edge`: ImGui handled a new press this frame; `imgui_down`: ImGui thinks
-- the key is held. Whichever of the OS state and ImGui's edge comes first, and
-- however far apart, a tap is one press. A key already held when a terminal
-- takes the keyboard (the ctrl+` that opened it) sends nothing until released.
global function key_repeat_step(r: *KeyRepeat, down: boolean, edge: boolean, imgui_down: boolean, dt: float32): integer
  if edge then imgui_down = true end
  local owes = r.owes_up and imgui_down
  r.owes_up = imgui_down and (owes or down or edge)
  local edge_up = r.edge_up
  r.edge_up = false
  if r.early then
    -- A key held since before polling: ImGui's edge is a press right after
    -- polling began (it raced the first poll) or once ImGui had shown the key
    -- down (a release came in between). Later it is the OS autorepeat of the
    -- held key, which ImGui never saw go down.
    if edge and r.early_n > 0 and not r.imgui_seen then edge = false end
    r.early_n = r.early_n + 1
    r.imgui_seen = r.imgui_seen or imgui_down
  end
  if edge then
    r.down, r.passive, r.early, r.held, r.next_at = down, false, false, 0, KEY_REPEAT_DELAY
    if not down then r.armed, r.edge_up = true, true end
    return 1
  end
  if not down then
    r.down, r.armed, r.passive, r.early, r.held = false, true, false, false, 0
    return 0
  end
  if not r.down then
    r.down = true
    if r.armed and edge_up and owes then
      return 0 -- the OS state caught up with last frame's press: the same press, held
    end
    if r.armed and imgui_down and not owes then
      -- ImGui still holds the key from a release it never heard: this press
      -- brings no edge, so it counts here
      r.passive, r.held, r.next_at = false, 0, KEY_REPEAT_DELAY
      return 1
    end
    -- a press whose edge is still coming, or a key held before polling began
    r.passive, r.early, r.early_n, r.imgui_seen = true, not r.armed, 0, imgui_down
    return 0
  end
  if r.passive then return 0 end
  r.held = r.held + math.clamp(dt, 0, KEY_REPEAT_MAX_STEP)
  if r.held >= r.next_at then
    r.next_at = r.held + KEY_REPEAT_RATE
    return 1
  end
  return 0
end

## if ccinfo.is_windows then
local function win_key_state(vk: cint): int16 <cimport 'GetAsyncKeyState', nodecl> end
## end

-- Is the key physically held? The OS state, because ImGui only hears key
-- messages while a terminal claims text input: a key released while the game
-- had the keyboard stays "down" in ImGui. Off Windows (tests) ImGui is the
-- only source.
local function key_physically_down(vk: cint, imkey: cint): boolean
  ## if ccinfo.is_windows then
    if vk > 0 then return (win_key_state(vk) & 0x8000) ~= 0 end
  ## end
  return imgui.IsKeyDown(imkey)
end

-- ImGui named key -> (ghostty key, lowercase name used by the Lua keymap, unshifted codepoint)
## local keymap = {
##  {'Tab','TAB','tab',9,0x09},{'LeftArrow','ARROW_LEFT','left',0,0x25},{'RightArrow','ARROW_RIGHT','right',0,0x27},
##  {'UpArrow','ARROW_UP','up',0,0x26},{'DownArrow','ARROW_DOWN','down',0,0x28},{'PageUp','PAGE_UP','pageup',0,0x21},
##  {'PageDown','PAGE_DOWN','pagedown',0,0x22},{'Home','HOME','home',0,0x24},{'End','END','end',0,0x23},
##  {'Insert','INSERT','insert',0,0x2D},{'Delete','DELETE','delete',0,0x2E},{'Backspace','BACKSPACE','backspace',0,0x08},
##  {'Space','SPACE','space',32,0x20},{'Enter','ENTER','enter',13,0x0D},{'Escape','ESCAPE','escape',27,0x1B},
