-- Kitty graphics placements rendered from libghostty-vt onto Dalamud's D3D11
-- device. Images stay owned by libghostty; this cache owns only GPU textures.
require 'core.ghostty'
require 'core.imgui'
require 'core.wintex'
require 'core.glyphfb'
require 'vector'

global KittyTexture = @record{
  image_id: uint32,
  generation: uint64,
  used: uint64,
  tex: WinTex,
}

global KittyGraphicsCache = @record{
  iter: GhosttyKittyGraphicsPlacementIterator,
  images: vector(KittyTexture),
  pixels: vector(uint8),
  clock: uint64,
}

local KITTY_TEXTURE_MAX <comptime> = 128

global function kitty_cache_init(c: *KittyGraphicsCache): boolean
  return ghostty_kitty_graphics_placement_iterator_new(nilptr, &c.iter) == GHOSTTY_SUCCESS
end

global function kitty_cache_destroy(c: *KittyGraphicsCache): void
  for i = 0, < #c.images do wintex_release(&c.images[i].tex) end
  c.images:destroy()
  c.pixels:destroy()
  if c.iter ~= nilptr then ghostty_kitty_graphics_placement_iterator_free(c.iter) end
  $c = {}
end

local function cached(c: *KittyGraphicsCache, id: uint32): *KittyTexture
  c.clock = c.clock + 1
  for i = 0, < #c.images do
    if c.images[i].image_id == id then c.images[i].used = c.clock return &c.images[i] end
  end
  -- A terminal may churn image IDs indefinitely even though libghostty's own
  -- pixel store is bounded. Keep the GPU side bounded as well.
  if #c.images >= KITTY_TEXTURE_MAX then
    local oldest: integer = 0
    for i = 1, < #c.images do if c.images[i].used < c.images[oldest].used then oldest = i end end
    wintex_release(&c.images[oldest].tex)
    c.images:remove(oldest)
  end
  c.images:push(KittyTexture{ image_id = id, used = c.clock })
  return &c.images[#c.images - 1]
end

local function upload(c: *KittyGraphicsCache, dst: *KittyTexture, image: GhosttyKittyGraphicsImage): boolean
  local w: uint32, h: uint32, fmt: cint = 0, 0, -1
  local src: *[0]uint8 = nilptr
  local len: usize = 0
  local generation: uint64 = 0
  if ghostty_kitty_graphics_image_get(image, GHOSTTY_KITTY_IMAGE_DATA_WIDTH, &w) ~= GHOSTTY_SUCCESS
    or ghostty_kitty_graphics_image_get(image, GHOSTTY_KITTY_IMAGE_DATA_HEIGHT, &h) ~= GHOSTTY_SUCCESS
    or ghostty_kitty_graphics_image_get(image, GHOSTTY_KITTY_IMAGE_DATA_FORMAT, &fmt) ~= GHOSTTY_SUCCESS
    or ghostty_kitty_graphics_image_get(image, GHOSTTY_KITTY_IMAGE_DATA_DATA_PTR, &src) ~= GHOSTTY_SUCCESS
    or ghostty_kitty_graphics_image_get(image, GHOSTTY_KITTY_IMAGE_DATA_DATA_LEN, &len) ~= GHOSTTY_SUCCESS
    or ghostty_kitty_graphics_image_get(image, GHOSTTY_KITTY_IMAGE_DATA_GENERATION, &generation) ~= GHOSTTY_SUCCESS
    or src == nilptr or w == 0 or h == 0 or w > 16384 or h > 16384 then return false end
  local bpp: usize = 0
  if fmt == GHOSTTY_KITTY_IMAGE_FORMAT_RGB then bpp = 3
  elseif fmt == GHOSTTY_KITTY_IMAGE_FORMAT_RGBA then bpp = 4
  elseif fmt == GHOSTTY_KITTY_IMAGE_FORMAT_GRAY_ALPHA then bpp = 2
  elseif fmt == GHOSTTY_KITTY_IMAGE_FORMAT_GRAY then bpp = 1
  else return false end
  local count = (@usize)(w) * (@usize)(h)
  if count > 268435456 or len < count * bpp then return false end
  local ok, fresh = wintex_ensure(&dst.tex, terminal_image_device(), w, h)
  if not ok then return false end
  if not fresh and dst.generation == generation then return true end
  c.pixels:resize(count * 4)
  for i: usize = 0, < count do
    local si, di = i * bpp, i * 4
    if fmt == GHOSTTY_KITTY_IMAGE_FORMAT_RGB or fmt == GHOSTTY_KITTY_IMAGE_FORMAT_RGBA then
      c.pixels[di], c.pixels[di + 1], c.pixels[di + 2] = src[si + 2], src[si + 1], src[si]
      c.pixels[di + 3] = fmt == GHOSTTY_KITTY_IMAGE_FORMAT_RGBA and src[si + 3] or 255
    else
      c.pixels[di], c.pixels[di + 1], c.pixels[di + 2] = src[si], src[si], src[si]
      c.pixels[di + 3] = fmt == GHOSTTY_KITTY_IMAGE_FORMAT_GRAY_ALPHA and src[si + 1] or 255
    end
  end
  wintex_upload_from(&dst.tex, WinRect{ x = 0, y = 0, w = (@uint16)(w), h = (@uint16)(h) }, &c.pixels[0], (@usize)(w) * 4)
  dst.generation = generation
  return true
end

-- Draw one protocol z layer. The caller places these around the background,
-- glyph and cursor passes so Kitty's below-background/below-text/above-text
-- ordering remains meaningful.
global function kitty_draw_layer(dl: *ImDrawList, terminal: GhosttyTerminal, c: *KittyGraphicsCache,
                                 origin: ImVec2, cell_w: float32, cell_h: float32, layer: cint): void
  if dl == nilptr or c.iter == nilptr or imgui.DrawListAddImage == nilptr or terminal_image_device() == nilptr then return end
  local graphics: GhosttyKittyGraphics = nilptr
  if ghostty_terminal_get(terminal, GHOSTTY_TERMINAL_DATA_KITTY_GRAPHICS, &graphics) ~= GHOSTTY_SUCCESS or graphics == nilptr then return end
  if ghostty_kitty_graphics_get(graphics, GHOSTTY_KITTY_GRAPHICS_DATA_PLACEMENT_ITERATOR, &c.iter) ~= GHOSTTY_SUCCESS then return end
  if ghostty_kitty_graphics_placement_iterator_set(c.iter, GHOSTTY_KITTY_GRAPHICS_PLACEMENT_ITERATOR_OPTION_LAYER, &layer) ~= GHOSTTY_SUCCESS then return end
  while ghostty_kitty_graphics_placement_next(c.iter) do
    local id: uint32 = 0
    local xo: uint32, yo: uint32 = 0, 0
    if ghostty_kitty_graphics_placement_get(c.iter, GHOSTTY_KITTY_GRAPHICS_PLACEMENT_DATA_IMAGE_ID, &id) ~= GHOSTTY_SUCCESS then continue end
    ghostty_kitty_graphics_placement_get(c.iter, GHOSTTY_KITTY_GRAPHICS_PLACEMENT_DATA_X_OFFSET, &xo)
    ghostty_kitty_graphics_placement_get(c.iter, GHOSTTY_KITTY_GRAPHICS_PLACEMENT_DATA_Y_OFFSET, &yo)
    local image = ghostty_kitty_graphics_image(graphics, id)
    if image == nilptr then continue end
    local info: GhosttyKittyGraphicsPlacementRenderInfo = { size = #GhosttyKittyGraphicsPlacementRenderInfo }
    if ghostty_kitty_graphics_placement_render_info(c.iter, image, terminal, &info) ~= GHOSTTY_SUCCESS or not info.viewport_visible then continue end
    local tex = cached(c, id)
    if not upload(c, tex, image) or tex.tex.srv == nilptr then continue end
    local x0 = origin.x + (@float32)(info.viewport_col) * cell_w + (@float32)(xo)
    local y0 = origin.y + (@float32)(info.viewport_row) * cell_h + (@float32)(yo)
    local x1, y1 = x0 + (@float32)(info.pixel_width), y0 + (@float32)(info.pixel_height)
    local u0 = (@float64)(info.source_x) / tex.tex.w
    local v0 = (@float64)(info.source_y) / tex.tex.h
    local u1 = (@float64)(info.source_x + info.source_width) / tex.tex.w
    local v1 = (@float64)(info.source_y + info.source_height) / tex.tex.h
    imgui.DrawListAddImage(dl, tex.tex.srv, vec2(x0, y0), vec2(x1, y1), vec2(u0, v0), vec2(u1, v1), 0xffffffff_u32)
  end
end
