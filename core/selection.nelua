-- Mouse text selection. The hit testing, click counting and ordering are pure
-- logic; the rest installs the selection on the libghostty terminal, which
-- then owns it (tracked through scrolling and reflow), reports it through the
-- render state for drawing, and formats it back to text for the clipboard.
require 'string'
require 'math'
require 'core.ghostty'
require 'core.termview'

-- libghostty selection API (vt/point.h, grid_ref.h, selection.h) ------------------
global GhosttyPointCoordinate <cimport, nodecl> = @record{ x: uint16, y: uint32 }
global GhosttyPointValue <cimport, nodecl> = @union{ coordinate: GhosttyPointCoordinate, _padding: [2]uint64 }
global GhosttyPoint <cimport, nodecl> = @record{ tag: cint, value: GhosttyPointValue }
global GhosttyGridRef <cimport, nodecl> = @record{ size: usize, node: pointer, x: uint16, y: uint16 }
-- `end` is a Nelua keyword, hence the quoted field name.
global GhosttySelection <cimport, nodecl> = @record{
  size: usize,
  start: GhosttyGridRef,
  #|'end'|#: GhosttyGridRef,
  rectangle: boolean,
}
global GhosttyTerminalSelectWordOptions <cimport, nodecl> = @record{
  size: usize,
  ref: GhosttyGridRef,
  boundary_codepoints: *[0]uint32,
  boundary_codepoints_len: usize,
}
global GhosttyTerminalSelectLineOptions <cimport, nodecl> = @record{
  size: usize,
  ref: GhosttyGridRef,
  whitespace: *[0]uint32,
  whitespace_len: usize,
  semantic_prompt_boundary: boolean,
}
global GhosttyTerminalSelectionFormatOptions <cimport, nodecl> = @record{
  size: usize,
  emit: cint,
  unwrap: boolean,
  trim: boolean,
  selection: *GhosttySelection,
}

global GHOSTTY_POINT_TAG_VIEWPORT: cint <cimport, nodecl, const>
global GHOSTTY_POINT_TAG_SCREEN: cint <cimport, nodecl, const>
global GHOSTTY_TERMINAL_OPT_SELECTION: cint <cimport, nodecl, const>
global GHOSTTY_TERMINAL_DATA_SELECTION: cint <cimport, nodecl, const>
global GHOSTTY_FORMATTER_FORMAT_PLAIN: cint <cimport, nodecl, const>

global function ghostty_terminal_grid_ref(terminal: GhosttyTerminal, point: GhosttyPoint, out_ref: *GhosttyGridRef): GhosttyResult <cimport, nodecl> end
global function ghostty_terminal_point_from_grid_ref(terminal: GhosttyTerminal, ref: *GhosttyGridRef, tag: cint, out: *GhosttyPointCoordinate): GhosttyResult <cimport, nodecl> end
global function ghostty_terminal_select_word(terminal: GhosttyTerminal, options: *GhosttyTerminalSelectWordOptions, out_selection: *GhosttySelection): GhosttyResult <cimport, nodecl> end
global function ghostty_terminal_select_line(terminal: GhosttyTerminal, options: *GhosttyTerminalSelectLineOptions, out_selection: *GhosttySelection): GhosttyResult <cimport, nodecl> end
global function ghostty_terminal_selection_format_buf(terminal: GhosttyTerminal, options: GhosttyTerminalSelectionFormatOptions, buf: *[0]uint8, buf_len: usize, out_written: *usize): GhosttyResult <cimport, nodecl> end

-- Pure logic ----------------------------------------------------------------------

-- A cell in screen coordinates: column, and row counted from the top of the
-- scrollback, so a point stays put while the viewport scrolls.
global SelPoint = @record{ x: integer, y: integer }

global function selpoint_less(a: SelPoint, b: SelPoint): boolean
  return a.y < b.y or (a.y == b.y and a.x < b.x)
end

global function selpoint_eq(a: SelPoint, b: SelPoint): boolean
  return a.x == b.x and a.y == b.y
end

-- The selected range in reading order: from the earlier start to the later end
-- of the anchor span (the cell, word or line first pressed) and the head span
-- (the same unit under the pointer now).
global function selection_span(a0: SelPoint, a1: SelPoint, h0: SelPoint, h1: SelPoint): (SelPoint, SelPoint)
  local lo = selpoint_less(h0, a0) and h0 or a0
  local hi = selpoint_less(a1, h1) and h1 or a1
  return lo, hi
end

-- Shift+click keeps the end of [lo, hi] farther from the click and moves the other.
global function selection_extend_anchor(lo: SelPoint, hi: SelPoint, click: SelPoint): SelPoint
  if selpoint_less(click, lo) then return hi end
  return lo
end

-- Grid cell under a pixel offset from the grid origin, clamped to the grid so
-- a drag past an edge selects up to that edge.
global function selection_cell_at(x: float32, y: float32, cell_w: float32, cell_h: float32, cols: integer, rows: integer): (integer, integer)
  local col, row = 0, 0
  if cell_w > 0 then col = (@integer)(math.floor(x / cell_w)) end
  if cell_h > 0 then row = (@integer)(math.floor(y / cell_h)) end
  return math.clamp(col, 0, math.max(cols - 1, 0)), math.clamp(row, 0, math.max(rows - 1, 0))
end

global SELECTION_CLICK_INTERVAL: float64 <comptime> = 0.35

global SelectionState = @record{
  dragging: boolean,        -- left button held since a press on the grid
  moved: boolean,           -- a cell drag left its anchor cell (a plain click selects nothing)
  mode: integer,            -- 1 cell, 2 word, 3 line
  anchor0: SelPoint,        -- the unit first pressed, in screen coordinates
  anchor1: SelPoint,
  clicks: integer,          -- 1 single, 2 double, 3 triple; a fourth click starts over
  click_time: float64,
  click_col: integer,
  click_row: integer,
}

-- Count a press at viewport cell (col, row): quick repeats on the same cell
-- make double and triple clicks.
global function selection_click(st: *SelectionState, now: float64, col: integer, row: integer): integer
  if st.clicks > 0 and st.clicks < 3 and now - st.click_time <= SELECTION_CLICK_INTERVAL
     and col == st.click_col and row == st.click_row then
    st.clicks = st.clicks + 1
  else
    st.clicks = 1
  end
  st.click_time = now
  st.click_col, st.click_row = col, row
  return st.clicks
end

-- Terminal side -------------------------------------------------------------------

local function grid_ref(v: *TermView, tag: cint, x: integer, y: integer, out: *GhosttyGridRef): boolean
  local p: GhosttyPoint = { tag = tag }
  p.value.coordinate = { x = (@uint16)(x), y = (@uint32)(y) }
  $out = { size = #GhosttyGridRef }
  return ghostty_terminal_grid_ref(v.term, p, out) == GHOSTTY_SUCCESS
end

local function screen_point(v: *TermView, ref: *GhosttyGridRef): SelPoint
  local c: GhosttyPointCoordinate
  ghostty_terminal_point_from_grid_ref(v.term, ref, GHOSTTY_POINT_TAG_SCREEN, &c)
  return SelPoint{ x = c.x, y = c.y }
end

local function viewport_to_screen(v: *TermView, col: integer, row: integer, out: *SelPoint): boolean
  local ref: GhosttyGridRef
  if not grid_ref(v, GHOSTTY_POINT_TAG_VIEWPORT, col, row, &ref) then return false end
  local c: GhosttyPointCoordinate
  if ghostty_terminal_point_from_grid_ref(v.term, &ref, GHOSTTY_POINT_TAG_SCREEN, &c) ~= GHOSTTY_SUCCESS then return false end
  $out = { x = c.x, y = c.y }
  return true
end

local function span_of(v: *TermView, sel: *GhosttySelection, out0: *SelPoint, out1: *SelPoint): void
  local a, b = screen_point(v, &sel.start), screen_point(v, &sel.#|'end'|#)
  $out0, $out1 = selection_span(a, a, b, b)
end

-- The word (mode 2) or line (mode 3) around screen cell p; false when there is
-- none (blank cells).
local function unit_at(v: *TermView, mode: integer, p: SelPoint, out0: *SelPoint, out1: *SelPoint): boolean
  local sel: GhosttySelection = { size = #GhosttySelection }
  if mode == 2 then
    local opts: GhosttyTerminalSelectWordOptions = { size = #GhosttyTerminalSelectWordOptions }
    if not grid_ref(v, GHOSTTY_POINT_TAG_SCREEN, p.x, p.y, &opts.ref) then return false end
    if ghostty_terminal_select_word(v.term, &opts, &sel) ~= GHOSTTY_SUCCESS then return false end
  elseif mode == 3 then
    local opts: GhosttyTerminalSelectLineOptions = { size = #GhosttyTerminalSelectLineOptions }
    if not grid_ref(v, GHOSTTY_POINT_TAG_SCREEN, p.x, p.y, &opts.ref) then return false end
    if ghostty_terminal_select_line(v.term, &opts, &sel) ~= GHOSTTY_SUCCESS then return false end
  else
    return false
  end
  span_of(v, &sel, out0, out1)
  return true
end

-- Hand [a, b] to the terminal; from here on it tracks the range itself.
local function install(v: *TermView, a: SelPoint, b: SelPoint): void
  local sel: GhosttySelection = { size = #GhosttySelection }
  if not grid_ref(v, GHOSTTY_POINT_TAG_SCREEN, a.x, a.y, &sel.start) then return end
  if not grid_ref(v, GHOSTTY_POINT_TAG_SCREEN, b.x, b.y, &sel.#|'end'|#) then return end
  ghostty_terminal_set(v.term, GHOSTTY_TERMINAL_OPT_SELECTION, &sel)
end

global function selection_clear(v: *TermView, st: *SelectionState): void
  st.dragging = false
  ghostty_terminal_set(v.term, GHOSTTY_TERMINAL_OPT_SELECTION, nilptr)
end

-- The terminal's current selection in reading order, if any.
global function selection_range(v: *TermView): (boolean, SelPoint, SelPoint)
  local lo: SelPoint, hi: SelPoint
  local cur: GhosttySelection = { size = #GhosttySelection }
  if ghostty_terminal_get(v.term, GHOSTTY_TERMINAL_DATA_SELECTION, &cur) ~= GHOSTTY_SUCCESS then return false, lo, hi end
  span_of(v, &cur, &lo, &hi)
  return true, lo, hi
end

-- Left press on viewport cell (col, row). `clicks` picks the unit (1 cell,
-- 2 word, 3 line); `extend` (shift) moves the near end of the current
-- selection instead. Returns true when the press selected a word or line.
global function selection_press(v: *TermView, st: *SelectionState, col: integer, row: integer, clicks: integer, extend: boolean): boolean
  local p: SelPoint
  if not viewport_to_screen(v, col, row, &p) then return false end
  st.dragging = true
  st.moved = false
  st.mode = 1
  if extend then
    local has, lo, hi = selection_range(v)
    if has then
      local anchor = selection_extend_anchor(lo, hi, p)
      st.anchor0, st.anchor1 = anchor, anchor
      st.moved = true
      local a, b = selection_span(anchor, anchor, p, p)
      install(v, a, b)
      return false
    end
  end
  st.anchor0, st.anchor1 = p, p
  local a0: SelPoint, a1: SelPoint
  if clicks > 1 and unit_at(v, clicks, p, &a0, &a1) then
    st.mode = clicks
    st.anchor0, st.anchor1 = a0, a1
    install(v, a0, a1)
    return true
  end
  ghostty_terminal_set(v.term, GHOSTTY_TERMINAL_OPT_SELECTION, nilptr)
  return false
end

-- The pointer is over viewport cell (col, row) while the button is held.
-- Word and line drags grow by whole words and lines.
global function selection_drag(v: *TermView, st: *SelectionState, col: integer, row: integer): void
  if not st.dragging then return end
  local p: SelPoint
  if not viewport_to_screen(v, col, row, &p) then return end
  if st.mode == 1 and not st.moved then
    if selpoint_eq(p, st.anchor0) then return end
    st.moved = true
  end
  local h0, h1 = p, p
  local u0: SelPoint, u1: SelPoint
  if st.mode > 1 and unit_at(v, st.mode, p, &u0, &u1) then h0, h1 = u0, u1 end
  local a, b = selection_span(st.anchor0, st.anchor1, h0, h1)
  install(v, a, b)
end

-- The button went up. Returns true when the gesture left a selection behind.
global function selection_release(v: *TermView, st: *SelectionState): boolean
  if not st.dragging then return false end
  st.dragging = false
  local has = selection_range(v)
  return has
end

-- The selected text as UTF-8: soft-wrapped rows joined, trailing blanks
-- trimmed, rows separated by newlines. Empty when nothing is selected.
global function selection_text(v: *TermView): string
  local opts: GhosttyTerminalSelectionFormatOptions = {
    size = #GhosttyTerminalSelectionFormatOptions, emit = GHOSTTY_FORMATTER_FORMAT_PLAIN, unwrap = true, trim = true,
  }
  local need: usize = 0
  if ghostty_terminal_selection_format_buf(v.term, opts, nilptr, 0, &need) ~= GHOSTTY_OUT_OF_SPACE or need == 0 then
    return (@string){}
  end
  local out = string.create(need)
  local written: usize = 0
  if ghostty_terminal_selection_format_buf(v.term, opts, (@*[0]uint8)(out.data), need, &written) ~= GHOSTTY_SUCCESS or written == 0 then
    out:destroy()
    return (@string){}
  end
  out.data[written] = 0 -- stays usable as a cstring for the clipboard
  out.size = written
  return out
end
