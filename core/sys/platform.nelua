-- Which platform the code runs on, as Lua sees it through ghostty.platform():
-- 'windows' (native Windows), 'wine' (a Windows build running under Wine or
-- Proton: ntdll exports wine_get_version), 'linux', 'macos' or 'posix'.
-- The name is a static string; callers never free it.
require 'string'

## if ccinfo.is_windows then
## cinclude '<windows.h>'
local function GetModuleHandleA(name: cstring): pointer <cimport, nodecl> end
local function GetProcAddress(mod: pointer, name: cstring): pointer <cimport, nodecl> end
local function GetFileAttributesA(path: cstring): uint32 <cimport, nodecl> end
local INVALID_FILE_ATTRIBUTES: uint32 <comptime> = 0xffffffff_u32

global function platform_is_wine(): boolean
  local ntdll = GetModuleHandleA('ntdll.dll')
  if ntdll ~= nilptr and GetProcAddress(ntdll, 'wine_get_version') ~= nilptr then return true end
  -- Some staging/Proton builds keep wine_get_version out of GetProcAddress's
  -- view even though it is in the PE export table. Wine's default Z: mapping
  -- exposes the Linux process filesystem; native Windows does not have it.
  return GetFileAttributesA('Z:\\proc\\self\\status') ~= INVALID_FILE_ATTRIBUTES
end

global function platform_name(): string
  if platform_is_wine() then return 'wine' end
  return 'windows'
end
## else
global function platform_is_wine(): boolean return false end

global function platform_name(): string
  ## if ccinfo.is_linux then
    return 'linux'
  ## elseif ccinfo.is_apple then
    return 'macos'
  ## else
    return 'posix'
  ## end
end
## end
