#!/usr/bin/env bash
# ghostty-voice: listen, and print what was said as one line on stdout.
#
# Ghostty for FFXIV runs this through ghostty-agent as a raw job when you
# press the DualSense PS button twice (CONFIG.voice_command); pressing it twice
# again closes this script's stdin, which ends the recording. It also ends at
# GHOSTTY_VOICE_MAX seconds (60). Everything else goes to stderr.
#
# The microphone: GHOSTTY_VOICE_MIC (a PipeWire/PulseAudio source name) when
# set; otherwise the first microphone that is not a game controller's, and a
# controller's (a DualSense has one) only when it is the only one there is.
#
# Speech to text, the first found:
#   whisper-cli (whisper.cpp) with GHOSTTY_VOICE_MODEL, default
#     ~/.local/share/ghostty/whisper/ggml-base.en.bin (fetched on first use
#     when curl is there: 142 MB);
#   whisper (openai-whisper, Python), model GHOSTTY_VOICE_WHISPER_MODEL (base.en).
# GHOSTTY_VOICE_LANG sets the language (en).
set -uo pipefail

MAX=${GHOSTTY_VOICE_MAX:-60}
LANG_=${GHOSTTY_VOICE_LANG:-en}
MODEL=${GHOSTTY_VOICE_MODEL:-${XDG_DATA_HOME:-$HOME/.local/share}/ghostty/whisper/ggml-base.en.bin}
MODEL_URL=${GHOSTTY_VOICE_MODEL_URL:-https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-base.en.bin}

say() { printf 'ghostty-voice: %s\n' "$*" >&2; }

# A controller's microphone, by the names PipeWire gives them.
is_controller() {
  case "${1,,}" in
    *dualsense*|*wireless_controller*|*054c*|*dualshock*|*controller*|*gamepad*) return 0 ;;
  esac
  return 1
}

pick_source() {
  if [[ -n "${GHOSTTY_VOICE_MIC:-}" ]]; then printf '%s' "$GHOSTTY_VOICE_MIC"; return; fi
  command -v pactl >/dev/null || return 0
  local name controller=
  while read -r _ name _; do
    [[ -z "$name" || "$name" == *.monitor ]] && continue
    if is_controller "$name"; then
      [[ -z "$controller" ]] && controller=$name
    else
      printf '%s' "$name"
      return
    fi
  done < <(pactl list short sources 2>/dev/null)
  printf '%s' "$controller"
}

tmp=$(mktemp -d "${TMPDIR:-/tmp}/ghostty-voice.XXXXXX") || exit 1
trap 'rm -rf "$tmp"' EXIT
wav=$tmp/said.wav

src=$(pick_source)
say "listening on ${src:-the default microphone}"
if command -v pw-record >/dev/null; then
  pw-record ${src:+--target "$src"} --rate 16000 --channels 1 --format s16 "$wav" &
elif command -v parecord >/dev/null; then
  parecord ${src:+--device="$src"} --rate=16000 --channels=1 --format=s16le --file-format=wav "$wav" &
else
  say "no recorder: install pipewire-utils (pw-record) or pulseaudio-utils (parecord)"
  exit 2
fi
rec=$!

# Until stdin closes (stopped in game) or the time limit.
timeout "$MAX" cat >/dev/null
kill -INT "$rec" 2>/dev/null
wait "$rec" 2>/dev/null
if [[ ! -s "$wav" ]]; then say "nothing was recorded"; exit 4; fi

if command -v whisper-cli >/dev/null; then
  if [[ ! -f "$MODEL" ]]; then
    command -v curl >/dev/null || { say "no model at $MODEL (and no curl to fetch one)"; exit 3; }
    say "fetching the speech model once: $MODEL_URL"
    mkdir -p "$(dirname "$MODEL")" && curl -fsSL -o "$MODEL.part" "$MODEL_URL" && mv "$MODEL.part" "$MODEL" \
      || { say "could not fetch the model"; exit 3; }
  fi
  whisper-cli -m "$MODEL" -l "$LANG_" -nt -np -f "$wav" 2>/dev/null | tr '\n' ' ' | sed 's/^ *//; s/ *$//; s/  */ /g'
  echo
elif command -v whisper >/dev/null; then
  whisper "$wav" --model "${GHOSTTY_VOICE_WHISPER_MODEL:-base.en}" --language "$LANG_" --output_format txt --output_dir "$tmp" >/dev/null 2>&1 \
    && tr '\n' ' ' < "$tmp/said.txt" | sed 's/^ *//; s/ *$//; s/  */ /g'
  echo
else
  say "no speech to text: install whisper.cpp (whisper-cli) or openai-whisper"
  exit 3
fi
