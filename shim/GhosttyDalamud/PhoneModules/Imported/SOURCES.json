{
  "xivhudCommit": "854e424",
  "adaptations": [
    "Embedded module classes have no Dalamud plugin interfaces",
    "Per-module configuration and one outer UI entry point",
    "Journal/Character native and external hosting disabled",
    "Chat collection enabled independently of phone presentation",
    "Embedded Grimoire shares the outer Kami lifecycle",
    "Floating notice cards replaced by the phone notification center",
    "Tap/hold Backspace edits and clears the weave; combat Enter is intercepted before native chat"
  ],
