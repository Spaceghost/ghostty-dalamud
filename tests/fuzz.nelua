-- Randomized stress over the places this project parses bytes it did not
-- write: VT streams from a shell into libghostty, wire frames from an agent
-- into core/protocol.nelua, and datagrams from anyone into the agent's
-- WireGuard (agent/wg_device.nelua). Neither may crash, read out of bounds or
-- grow the heap without bound, whatever arrives.
--
--   tests/fuzz [seed] [iterations]
--
-- Deterministic: the same seed replays the same bytes, so a failure in CI is
-- reproducible from the seed in its output. tests/run.sh runs a short fixed
-- pass; the sanitizer job runs a long one, where AddressSanitizer turns a
-- one-byte overrun into a failure instead of a lucky pass. The heap after the
-- warm-up iterations must not grow (tests/heapcheck.nelua).
require 'tests.heapcheck'
require 'core.ghostty'
require 'core.protocol'
require 'agent.logic'
require 'agent.wg_device'
require 'string'
require 'vector'
require 'io'
require 'os'
require 'arg'

-- xorshift64*: a PRNG of our own, so the run does not depend on the C library
local rng_state: uint64 = 0x2545f4914f6cdd1d
local function srand(seed: uint64): void
  rng_state = seed | 1_u64
end
local function rnd(): uint64
  local x = rng_state
  x = x ~ (x >> 12)
  x = x ~ (x << 25)
  x = x ~ (x >> 27)
  rng_state = x
  return x * 0x2545f4914f6cdd1d_u64
end
local function rnd_below(n: usize): usize
  if n == 0 then return 0 end
  return (@usize)(rnd() % n)
end

-- Fragments worth hitting more often than random bytes would: CSI, OSC, DCS,
-- charset switches, wide characters and the sequences the renderer reads back.
local SEEDS: []string = {
  '\27[31m', '\27[0m', '\27[1;5H', '\27[2J', '\27[?1049h', '\27[?1049l',
  '\27[6n', '\27]0;title\7', '\27]8;;https://example.invalid\27\\', '\27P+q544e\27\\',
  '\27[?25l', '\27[?25h', '\27#8', '\27(0', '\27)B', '\27[38;2;10;20;30m',
  '\27[999;999H', '\27[J', '\27[K', '\27[S', '\27[T', '\27[10L', '\27[10M',
  '\r\n', '\t', '\b', '\x0c', '\x0e', '\x0f', '\x7f',
  'plain text ', 'ｗｉｄｅ', '👩‍💻', 'é', '\xc3', '\xff\xfe', '\27',
  '\27[', '\27[;;;;;;;;;;;;;;;;;;;;;;;m', '\27]', '\27]0;', '\27P',
}

-- A random stream: mostly fragments, some raw bytes, always bounded.
local function make_stream(out: *vector(uint8), max: usize): void
  out:clear()
  local n = 1 + rnd_below(max)
  while #out < n do
    if rnd() % 4 == 0 then
      out:push((@uint8)(rnd_below(256)))
    else
      local s = SEEDS[rnd_below(#SEEDS)]
      for i = 0, < s.size do out:push(s.data[i]) end
    end
  end
end

-- VT bytes into a terminal, read back the way the renderer does ----------------------
local vt_bytes: usize = 0
local stream: vector(uint8)
local function vt_round(iter: integer): void
  local term: GhosttyTerminal
  local cols: uint16 = (@uint16)(1 + rnd_below(120))
  local rows: uint16 = (@uint16)(1 + rnd_below(60))
  if ghostty_terminal_new(nilptr, &term, cols, rows) ~= GHOSTTY_SUCCESS then return end
  defer ghostty_terminal_free(term) end
  ghostty_terminal_resize(term, cols, rows, 8, 16)

  local state: GhosttyRenderState
  if ghostty_render_state_new(nilptr, &state) ~= GHOSTTY_SUCCESS then return end
  defer ghostty_render_state_free(state) end

  for _ = 1, 8 do
    make_stream(&stream, 512)
    ghostty_terminal_vt_write(term, (@*[0]uint8)(&stream[0]), #stream)
    vt_bytes = vt_bytes + #stream
    -- a resize in the middle of a stream is what a real window does
    if rnd() % 8 == 0 then
      cols = (@uint16)(1 + rnd_below(200))
      rows = (@uint16)(1 + rnd_below(80))
      ghostty_terminal_resize(term, cols, rows, 8, 16)
    end
    if ghostty_render_state_update(state, term) ~= GHOSTTY_SUCCESS then continue end
    local colors: GhosttyRenderStateColors = { size = #GhosttyRenderStateColors }
    ghostty_render_state_get(state, GHOSTTY_RENDER_STATE_DATA_COLORS, &colors)
  end
end

-- Wire frames into the protocol reader ---------------------------------------------
local frames_read: usize = 0
local function proto_round(iter: integer): void
  local q: ByteQueue
  defer q:destroy() end
  -- a mix of well-formed frames and raw noise, fed in arbitrary slices the way
  -- a socket delivers them
  for _ = 1, 16 do
    if rnd() % 3 == 0 then
      make_stream(&stream, 64)
      q:push((@*[0]uint8)(&stream[0]), #stream)
    else
      make_stream(&stream, 48)
      local typ: uint8 = (@uint8)(rnd_below(24))
      if rnd() % 4 == 0 then
        proto.write_frame_id(&q, typ, (@uint32)(rnd()), (@*[0]uint8)(&stream[0]), #stream)
      else
        proto.write_frame(&q, typ, (@*[0]uint8)(&stream[0]), #stream)
      end
    end
    while true do
      local ok, typ, payload, len = proto.read_frame(&q)
      if not ok then break end
      frames_read = frames_read + 1
      -- every byte of the payload must be readable
      local sum: uint64 = 0
      for i = 0, < len do sum = sum + payload[i] end
      if sum == 0xdeadbeef then io.write('') end -- keep the loop
      proto.frame_consume(&q, len)
    end
    -- a truncated frame stays in the queue; drop it now and then
    if rnd() % 5 == 0 and q:len() > 0 then q:consume(rnd_below(q:len())) end
  end
end

-- The agent's own string parsing, on text it never wrote -----------------------------
local function agent_round(iter: integer): void
  make_stream(&stream, 96)
  local raw = string{data = (@*[0]byte)(&stream[0]), size = #stream}
  local argv, env = agent_split_nul((@*[0]uint8)(&stream[0]), #stream)
  for i = 0, < #argv do argv[i]:destroy() end
  for i = 0, < #env do env[i]:destroy() end
  argv:destroy() env:destroy()
  local h, p = agent_parse_hostport(raw)
  h:destroy()
  local t = agent_trim(raw)
  t:destroy()
  local c = agent_crlf(raw)
  c:destroy()
  local ok, k, v = agent_env_split(raw)
  k:destroy() v:destroy()
  local hex = agent_hex(raw)
  hex:destroy()
end

-- Datagrams into the WireGuard device ----------------------------------------------
-- Every message type at its own size and at random sizes, half of them with a
-- valid MAC1 (anyone who knows the agent's public key can make one), so the
-- parsers behind MAC1 are reached; and the address parsers on random text.
local wg_dev: WgDevice
local wg_sent = 0
local wg_now: number = 1000
local function wg_send(ud: pointer, ep: *WgEndpoint, data: *[0]uint8, len: usize): void wg_sent = wg_sent + 1 end
local function fuzz_wall(): (int64, int64) return 1800000000 + (@int64)(wg_now), 0 end

local function wg_round(iter: integer): void
  local sizes: [6]usize = { WG_INITIATION_SIZE, WG_RESPONSE_SIZE, WG_COOKIE_SIZE, WG_DATA_MIN, 0, 0 }
  local buf: [256]uint8
  for _ = 1, 8 do
    wg_now = wg_now + 0.05
    local n = sizes[rnd_below(6)]
    if n == 0 then n = rnd_below(256) end
    for i: usize = 0, < n do buf[i] = (@uint8)(rnd() & 0xff) end
    if n >= 4 and rnd_below(4) ~= 0 then
      buf[0] = (@uint8)(1 + rnd_below(4))
      buf[1], buf[2], buf[3] = 0, 0, 0
    end
    if (n == WG_INITIATION_SIZE or n == WG_RESPONSE_SIZE) and rnd_below(2) == 0 then
      blake2s(&buf[n - 32], 16, &wg_dev.mac1_key, 32, &buf, n - 32)
    end
    local from: WgEndpoint = { family = 4, port = (@uint16)(rnd() & 0xffff) }
    from.addr[0] = 203
    wg_dev:receive(&from, &buf, n, wg_now)
    wg_dev:tick(wg_now)
  end
  make_stream(&stream, 48)
  local raw = string{data = (@*[0]byte)(&stream[0]), size = #stream}
  local c: WgCidr
  wgp.parse_cidr(raw, &c)
  local fam: uint8
  local a: [16]uint8
  wgp.parse_ip(raw, &fam, &a)
  local ok, f, total, src, dst = wgp.ip_header((@*[0]uint8)(&stream[0]), #stream)
end

-- Driver -----------------------------------------------------------------------------
local seed: uint64 = 20260919
local iters: integer = 64
if #arg >= 1 then seed = (@uint64)(tointeger(arg[1])) end
if #arg >= 2 then iters = tointeger(arg[2]) end
local env_iters = os.getenv('GHOSTTY_FUZZ_ITERS')
if env_iters.size > 0 then iters = tointeger(env_iters) end
io.write('fuzz seed=', seed, ' iterations=', iters, '\n')

stream:reserve(4096) -- its growth must not read as a leak
srand(seed)
heap_stable('fuzz vt', iters, vt_round)
srand(seed ~ 0x9e3779b9_u64)
heap_stable('fuzz protocol', iters, proto_round)
srand(seed ~ 0x517cc1b7_u64)
heap_stable('fuzz agent strings', iters, agent_round)
do
  local key: [32]uint8
  local peer: [32]uint8
  for i = 0, < 32 do key[i] = (@uint8)(rnd() & 0xff) peer[i] = (@uint8)(rnd() & 0xff) end
  wg_dev.send = wg_send
  wg_dev.wall = fuzz_wall
  wg_dev:init(&key)
  wg_dev:add_peer('fuzz', &peer, nilptr)
  wg_dev.index:reserve(16) -- its growth must not read as a leak
end
srand(seed ~ 0x2f0a6c11_u64)
heap_stable('fuzz wireguard', iters, wg_round)
wg_dev:destroy()

stream:destroy()
io.write('fuzz OK: ', vt_bytes, ' VT bytes, ', frames_read, ' frames read\n')
