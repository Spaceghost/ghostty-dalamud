-- Manual smoke test of remote windows through a Windows ghostty-agent.exe
-- with the Win32 capture backend, run from the host (not part of
-- tests/run.sh: it needs the agent on Windows or under Wine, and a window to
-- capture).
--
--   ghostty-agent.exe --listen 127.0.0.1:PORT --token-file TOKENFILE --windows win32
--   vendor/nelua-lang/nelua --cc tools/zig-cc.sh -P nogc -L . tests/smoke_windows_win32.nelua \
--     PORT TOKEN MATCH FIRST.ppm AFTER.ppm
--
-- WLIST, WOPEN by match, 3 s of WFRAMEs (acknowledged, so flow control keeps
-- them coming), the rebuilt picture as FIRST.ppm, a click, TEXT, KEY enter and
-- more TEXT, the picture after as AFTER.ppm, WCLOSE. Each step prints PASS or
-- FAIL; the exit code is the number of failures.
require 'core.sys.net'
require 'core.protocol'
require 'core.wincodec'
require 'string'
require 'vector'
require 'memory'
require 'io'
require 'os'
require 'arg'

## cinclude '<unistd.h>'
local function usleep(us: cuint): cint <cimport, nodecl> end

local port: uint16 = (@uint16)(tointeger(arg[1]))
local token: string = arg[2]
local match: string = arg[3]
local first_path: string = arg[4]
local after_path: string = arg[5]

local failures = 0
local function step(name: string, ok: boolean, detail: string): void
  if ok then print('PASS', name, detail) else print('FAIL', name, detail) failures = failures + 1 end
end

local Msg = @record{ typ: uint8, data: vector(uint8) }

local Conn = @record{
  sock: NetSocket,
  inq: ByteQueue,
  outq: ByteQueue,
  msgs: vector(Msg),
  closed: boolean,
}

local function conn_pump(c: *Conn): void
  while c.outq:len() > 0 do
    local n = net.send(c.sock, c.outq:peek(), c.outq:len())
    if n <= 0 then break end
    c.outq:consume((@usize)(n))
  end
  local buf: [65536]uint8
  for _ = 1, 64 do
    local n = net.recv(c.sock, &buf, #buf)
    if n > 0 then c.inq:push(&buf, (@usize)(n))
    elseif n == 0 then break
    else c.closed = true break end
  end
  while true do
    local ok, typ, payload, len = proto.read_frame(&c.inq)
    if not ok then break end
    local m: Msg = { typ = typ }
    m.data:resize(len)
    if len > 0 then memory.copy(&m.data[0], payload, len) end
    c.msgs:push(m)
    proto.frame_consume(&c.inq, len)
  end
end

local function send(c: *Conn, typ: uint8, p: *[0]uint8, len: usize): void
  proto.write_frame(&c.outq, typ, p, len)
  conn_pump(c)
end

local function msg_text(m: *Msg, from: usize): string
  if #m.data <= from then return (@string){} end
  return string{data=(@*[0]byte)(&m.data[from]), size=#m.data - from}
end

-- The first message of type `typ` (and, with `sid` ~= 0, whose payload starts
-- with it), waiting up to `secs`. False on timeout. The caller destroys m.data.
local function take(c: *Conn, typ: uint8, sid: uint32, secs: number): (boolean, Msg)
  local tries = (@integer)(secs * 200)
  for t = 0, tries do
    for i = 0, < #c.msgs do
      local m = &c.msgs[i]
      if m.typ == typ and (sid == 0 or (#m.data >= 4 and proto.get_u32((@*[0]uint8)(&m.data[0])) == sid)) then
        local got = $m
        c.msgs:remove(i)
        return true, got
      end
    end
    if t < tries then usleep(5000) conn_pump(c) end
  end
  return false, (@Msg){}
end

local function count(c: *Conn, typ: uint8, sid: uint32): integer
  local n = 0
  for i = 0, < #c.msgs do
    local m = &c.msgs[i]
    if m.typ == typ and (sid == 0 or proto.get_u32((@*[0]uint8)(&m.data[0])) == sid) then n = n + 1 end
  end
  return n
end

local function settle(c: *Conn, secs: number): void
  for _ = 1, (@integer)(secs * 200) do usleep(5000) conn_pump(c) end
end

local function conn_open_at(at: uint16): Conn
  local c: Conn
  local nc = net.connect('127.0.0.1', at)
  assert(net.is_valid(nc.sock), 'connect')
  for _ = 1, 400 do
    if net.connect_poll(&nc) == 1 then break end
    usleep(5000)
  end
  assert(nc.connected, 'connected')
  c.sock = nc.sock
  send(&c, PROTO_HELLO, (@*[0]uint8)(token.data), token.size)
  local ok, m = take(&c, PROTO_OK, 0, 3)
  assert(ok, 'handshake')
  assert(msg_text(&m, 0):find('ghostty-agent 4 ', 1, true) == 1, 'a version 4 agent')
  m.data:destroy()
  return c
end


local function conn_close(c: *Conn): void
  net.close(c.sock)
  for i = 0, < #c.msgs do c.msgs[i].data:destroy() end
  c.msgs:destroy()
  c.inq:destroy()
  c.outq:destroy()
end

local function wlist(c: *Conn): string
  send(c, PROTO_WLIST, nilptr, 0)
  local ok, m = take(c, PROTO_WLISTR, 0, 3)
  assert(ok, 'WLISTR')
  local s = msg_text(&m, 0):copy()
  m.data:destroy()
  return s
end

-- WOPEN; returns (req, sid, w, h, title) from its WOPENED
local next_req: uint32 = 100
local function wopen(c: *Conn, wid: uint32, max_w: uint16, max_h: uint16, fps: uint8, match: string): (uint32, uint32, integer, integer, string)
  next_req = next_req + 1
  local p: [13 + 64]uint8
  proto.put_u32(&p, next_req)
  proto.put_u32((@*[0]uint8)(&p[4]), wid)
  proto.put_u16((@*[0]uint8)(&p[8]), max_w)
  proto.put_u16((@*[0]uint8)(&p[10]), max_h)
  p[12] = fps
  if #match > 0 then memory.copy(&p[13], match.data, match.size) end
  send(c, PROTO_WOPEN, &p, 13 + match.size)
  local ok, m = take(c, PROTO_WOPENED, next_req, 3)
  assert(ok, 'WOPENED for the request')
  local sid = proto.get_u32((@*[0]uint8)(&m.data[4]))
  local w = (@integer)(proto.get_u16((@*[0]uint8)(&m.data[8])))
  local h = (@integer)(proto.get_u16((@*[0]uint8)(&m.data[10])))
  local title = msg_text(&m, 12):copy()
  m.data:destroy()
  return next_req, sid, w, h, title
end

local function send_sid(c: *Conn, typ: uint8, sid: uint32): void
  local p: [4]uint8
  proto.put_u32(&p, sid)
  send(c, typ, &p, 4)
end

local function wack(c: *Conn, sid: uint32, seq: uint32): void
  local p: [8]uint8
  proto.put_u32(&p, sid)
  proto.put_u32((@*[0]uint8)(&p[4]), seq)
  send(c, PROTO_WACK, &p, 8)
end

local function winput(c: *Conn, sid: uint32, kind: uint8, body: *[0]uint8, n: usize): void
  local p: [64]uint8
  proto.put_u32(&p, sid)
  p[4] = kind
  if n > 0 then memory.copy(&p[5], body, n) end
  send(c, PROTO_WINPUT, &p, 5 + n)
end

-- What a client shows for one stream.
local Screen = @record{ w: integer, h: integer, px: vector(uint8) }

-- Receive one whole seq of `sid` into `scr`: (seq, key, changed pixel count).
local function recv_seq(c: *Conn, sid: uint32, scr: *Screen, secs: number): (uint32, boolean, integer)
  local seq: uint32 = 0
  local key = false
  local area = 0
  while true do
    local ok, m = take(c, PROTO_WFRAME, sid, secs)
    assert(ok, 'a WFRAME arrives')
    local okf, f = wincodec_parse((@*[0]uint8)(&m.data[0]), #m.data)
    assert(okf and f.sid == sid)
    if seq == 0 then seq = f.seq else assert(f.seq == seq, 'one seq at a time') end
    if f.flags & WINCODEC_FLAG_KEY ~= 0 then
      key = true
      scr.w, scr.h = f.w, f.h
      scr.px:resize((@usize)(scr.w * scr.h * 4))
    end
    assert(f.w == scr.w and f.h == scr.h, 'a new size comes as a KEY frame')
    while true do
      local okr, fr = wincodec_next_rect(&f)
      if not okr then break end
      assert(wincodec_apply_rect(&fr, (@*[0]uint8)(&scr.px[0]), (@usize)(scr.w * 4)))
      area = area + (@integer)(fr.r.w) * (@integer)(fr.r.h)
    end
    local ended = f.flags & WINCODEC_FLAG_END ~= 0
    m.data:destroy()
    if ended then break end
  end
  return seq, key, area
end

local function write_ppm(path: string, scr: *Screen): boolean
  local file = io.open(path, 'wb')
  if not file:isopen() then return false end
  file:write(string.format('P6\n%d %d\n255\n', scr.w, scr.h))
  local row = string.create((@usize)(scr.w * 3))
  for y = 0, < scr.h do
    for x = 0, < scr.w do
      local o = (y * scr.w + x) * 4
      row.data[x*3], row.data[x*3+1], row.data[x*3+2] = scr.px[o+2], scr.px[o+1], scr.px[o]
    end
    file:write(row)
  end
  row:destroy()
  file:close()
  return true
end

-- WFRAMEs of `sid` for `secs`, each seq acknowledged: (seqs, key frames)
local function stream(c: *Conn, sid: uint32, scr: *Screen, secs: number): (integer, integer)
  local seqs, keys = 0, 0
  local t0 = os.now()
  while os.now() - t0 < secs do
    if count(c, PROTO_WFRAME, sid) == 0 then
      settle(c, 0.01)
    else
      local seq, key, _ = recv_seq(c, sid, scr, 2)
      wack(c, sid, seq)
      seqs = seqs + 1
      if key then keys = keys + 1 end
    end
  end
  return seqs, keys
end

local c = conn_open_at(port)
local text = wlist(&c)
io.write(text)
step('WLIST', text:find('\t', 1, true) > 0, '')
text:destroy()

local req, sid, w, h, title = wopen(&c, 0, 1920, 1080, 30, match)
step('WOPEN by match', sid ~= 0, string.format('%dx%d %s', w, h, title))
title:destroy()
if sid == 0 then os.exit(failures) end

local scr: Screen
local t0 = os.now()
local seqs, keys = stream(&c, sid, &scr, 3)
step('WFRAMEs arrive', seqs > 0 and keys > 0, string.format('%d seqs (%d key) in 3 s, %dx%d', seqs, keys, scr.w, scr.h))
step('first picture written', seqs > 0 and write_ppm(first_path, &scr), first_path)

-- click in the middle, then type
local p: [8]uint8
proto.put_u16(&p, (@uint16)(scr.w // 2))
proto.put_u16((@*[0]uint8)(&p[2]), (@uint16)(scr.h // 2))
p[4], p[5] = 0, 1
winput(&c, sid, WIN_INPUT_BUTTON, &p, 6)
p[5] = 0
winput(&c, sid, WIN_INPUT_BUTTON, &p, 6)
local typed: string = 'typed through ghostty-agent'
winput(&c, sid, WIN_INPUT_TEXT, (@*[0]uint8)(typed.data), typed.size)
proto.put_u16(&p, 0x28) p[2], p[3] = 1, 0
winput(&c, sid, WIN_INPUT_KEY, &p, 4)
p[2] = 0
winput(&c, sid, WIN_INPUT_KEY, &p, 4)
local typed2: string = 'second line'
winput(&c, sid, WIN_INPUT_TEXT, (@*[0]uint8)(typed2.data), typed2.size)
local seqs2, _ = stream(&c, sid, &scr, 1.5)
step('WFRAMEs after input', seqs2 > 0, string.format('%d seqs', seqs2))
step('after picture written', write_ppm(after_path, &scr), after_path)

send_sid(&c, PROTO_WCLOSE, sid)
settle(&c, 0.3)
conn_close(&c)
print(failures == 0 and 'ALL PASS' or string.format('%d FAILED', failures))
os.exit(failures)
