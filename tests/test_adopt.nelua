-- Adopted windows and the game's chat on world panels, the pure parts
-- (core/adopt.nelua, core/chatlog.nelua, docs/ADOPT.md): the window <-> panel
-- mapping, clipping and strip cutting, the draw-list copy through a fake
-- ImGui, snapshots, the pointer remap and the mouse event rewrite, keeping a
-- window on screen, the flags, the adopt/release state machine, the pull
-- grip, window names, the chat ring, wrapping, the input line and colours.
require 'core.adopt'
require 'core.chatlog'
require 'core.policy'
require 'string'
require 'vector'
require 'math'
require 'io'
require 'os'
require 'arg'

## cinclude '<stdlib.h>'
local function calloc(n: csize, size: csize): pointer <cimport, nodecl> end
local function free(p: pointer): void <cimport, nodecl> end
local EVENT_SIZE: csize <cimport 'sizeof(ImGuiInputEvent)', nodecl, const>

local function near(a: float32, b: float32, eps: float32): boolean return math.abs(a - b) < eps end

-- A fake ImGui: primitives and texture pushes are recorded ------------------------
local Vtx = @record{ x: float32, y: float32, u: float32, v: float32, col: uint32, tex: pointer }
local out: vector(Vtx)
local reserved = 0
local tex_stack: vector(pointer)
local pushes = 0
local function f_reserve(dl: *ImDrawList, ni: cint, nv: cint): void reserved = reserved + nv end
local function f_vtx(dl: *ImDrawList, pos: ImVec2, uv: ImVec2, col: uint32): void
  local t: pointer = nilptr
  if #tex_stack > 0 then t = tex_stack[#tex_stack - 1] end
  out:push(Vtx{ x = pos.x, y = pos.y, u = uv.x, v = uv.y, col = col, tex = t })
end
local function f_push(dl: *ImDrawList, t: pointer): void tex_stack:push(t) pushes = pushes + 1 end
local function f_pop(dl: *ImDrawList): void tex_stack:pop() end
imgui.DrawListPrimReserve = f_reserve
imgui.DrawListPrimVtx = f_vtx
imgui_int.DrawListPushTextureID = f_push
imgui_int.DrawListPopTextureID = f_pop

-- A source draw list built by hand: `quads` axis-aligned rectangles, one command each.
local src_cmds: vector(ImDrawCmd)
local src_idx: vector(uint16)
local src_vtx: vector(ImDrawVert)
local function src_reset(): void src_cmds:clear() src_idx:clear() src_vtx:clear() end
local function src_quad(x0: float32, y0: float32, x1: float32, y1: float32, clip: ImVec4, tex: usize, col: uint32): void
  local base = #src_vtx
  src_vtx:push(ImDrawVert{ pos = vec2(x0, y0), uv = vec2(0, 0), col = col })
  src_vtx:push(ImDrawVert{ pos = vec2(x1, y0), uv = vec2(1, 0), col = col })
  src_vtx:push(ImDrawVert{ pos = vec2(x1, y1), uv = vec2(1, 1), col = col })
  src_vtx:push(ImDrawVert{ pos = vec2(x0, y1), uv = vec2(0, 1), col = col })
  local i0 = #src_idx
  local ks: [6]integer = { 0, 1, 2, 0, 2, 3 }
  for k = 0, < 6 do src_idx:push((@uint16)(base + ks[k])) end
  src_cmds:push(ImDrawCmd{ ClipRect = clip, TextureId = (@pointer)(tex), VtxOffset = 0, IdxOffset = (@cuint)(i0), ElemCount = 6 })
end
local function src_list(): ImDrawList
  local l: ImDrawList
  l.CmdBuffer = { Size = #src_cmds, Capacity = #src_cmds, Data = (@*[0]ImDrawCmd)(&src_cmds[0]) }
  l.IdxBuffer = { Size = #src_idx, Capacity = #src_idx, Data = (@*[0]uint16)(&src_idx[0]) }
  l.VtxBuffer = { Size = #src_vtx, Capacity = #src_vtx, Data = (@*[0]ImDrawVert)(&src_vtx[0]) }
  return l
end
local function bounds(): (float32, float32, float32, float32)
  local x0, y0, x1, y1: float32, float32, float32, float32 = 1e9, 1e9, -1e9, -1e9
  for i = 0, < #out do
    x0, y0 = math.min(x0, out[i].x), math.min(y0, out[i].y)
    x1, y1 = math.max(x1, out[i].x), math.max(y1, out[i].y)
  end
  return x0, y0, x1, y1
end
local function area(): float32
  local a: float32 = 0
  for i = 0, < #out // 3 do
    local p, q, r = out[i * 3], out[i * 3 + 1], out[i * 3 + 2]
    a = a + math.abs((q.x - p.x) * (r.y - p.y) - (r.x - p.x) * (q.y - p.y)) * 0.5
  end
  return a
end
local dst: ImDrawList
local HUGE: ImVec4 = { -1e9, -1e9, 1e9, 1e9 }

-- Mapping ------------------------------------------------------------------------------
do
  -- a 400 x 200 window at (100, 50) into a 1000 x 1000 box at (0, 34): scale 2.5, centred vertically
  local m = adopt_fit(100, 50, 400, 200, 0, 34, 1000, 1000)
  assert(near(m.scale, 2.5, 1e-5) and near(m.ox, 0, 1e-4) and near(m.oy, 34 + 250, 1e-3), 'fit keeps the aspect, centred')
  local u, v = adopt_to_panel(&m, 300, 150)
  assert(near(u, 500, 1e-3) and near(v, 534, 1e-3), 'window centre -> box centre')
  local x, y = adopt_to_window(&m, u, v)
  assert(near(x, 300, 1e-3) and near(y, 150, 1e-3), 'and back')
  -- a degenerate box keeps scale 1
  m = adopt_fit(0, 0, 400, 200, 0, 0, 0, 0)
  assert(m.scale == 1, 'empty box: scale 1')
  print('mapping OK')
end

-- Clipping and strips --------------------------------------------------------------------
do
  local p: AdoptPoly
  p.n = 3
  p.v[0] = { x = -10, y = 0, col = 0xff0000ff }
  p.v[1] = { x = 10, y = 0, col = 0xff0000ff }
  p.v[2] = { x = 0, y = 20, col = 0xff0000ff }
  adopt_clip(&p, 0, 0, 100, 100)
  assert(p.n >= 3, 'half a triangle is left')
  for i = 0, < p.n do assert(p.v[i].x >= -1e-4, 'nothing left of the edge') end
  local q: AdoptPoly
  q.n = 3
  q.v[0] = { x = 200, y = 0 } q.v[1] = { x = 210, y = 0 } q.v[2] = { x = 205, y = 5 }
  adopt_clip(&q, 0, 0, 100, 100)
  assert(q.n == 0, 'wholly outside: nothing')
  -- interpolation carries uv and colour
  local r: AdoptPoly
  r.n = 3
  r.v[0] = { x = 0, y = 0, u = 0, col = 0 }
  r.v[1] = { x = 100, y = 0, u = 1, col = 0xffffffff }
  r.v[2] = { x = 0, y = 100, u = 0, col = 0 }
  adopt_clip(&r, 0, 0, 50, 100)
  local found = false
  for i = 0, < r.n do
    if near(r.v[i].x, 50, 1e-3) and near(r.v[i].y, 0, 1e-3) then
      found = true
      assert(near(r.v[i].u, 0.5, 1e-4), 'uv interpolated at the cut')
      assert((r.v[i].col & 0xff) == 128, 'colour interpolated at the cut')
    end
  end
  assert(found, 'a vertex on the cut edge')
  -- a wide polygon cut into strips of 30
  out:clear()
  local w: AdoptPoly
  w.n = 4
  w.v[0] = { x = 0, y = 0 } w.v[1] = { x = 100, y = 0 } w.v[2] = { x = 100, y = 10 } w.v[3] = { x = 0, y = 10 }
  local n = adopt_emit_poly(&dst, &w, vec2(1000, 2000), 30)
  assert(n == #out and n == 4 * 6, 'four strips, two triangles each')
  for i = 0, < #out // 3 do
    local a, b, c = out[i*3], out[i*3+1], out[i*3+2]
    local minx, maxx = math.min(a.x, math.min(b.x, c.x)), math.max(a.x, math.max(b.x, c.x))
    assert(maxx - minx <= 30 + 1e-3, 'no triangle wider than a strip')
    assert(minx >= 1000 - 1e-3 and maxx <= 1100 + 1e-3, 'origin added')
  end
  assert(near(area(), 1000, 1e-2), 'strips cover the polygon exactly')
  print('clipping OK')
end

-- The draw-list copy ---------------------------------------------------------------------
do
  src_reset()
  local win_clip: ImVec4 = { 100, 50, 500, 250 }
  -- inside, clipped by its own clip rect, and wholly outside its clip rect
  src_quad(120, 60, 220, 100, win_clip, 11, 0xff00ff00)
  src_quad(450, 200, 700, 400, win_clip, 12, 0xffff0000) -- sticks out of the window
  src_quad(600, 300, 650, 350, win_clip, 13, 0xff0000ff) -- outside the clip rect
  local l = src_list()
  local m = adopt_fit(100, 50, 400, 200, 0, 0, 800, 400) -- scale 2
  out:clear() pushes = 0
  local box: ImVec4 = { 0, 0, 800, 400 }
  local n = adopt_copy(&dst, &l, &m, vec2(0, 0), box, 0)
  assert(n == #out, 'returns the vertices written')
  local x0, y0, x1, y1 = bounds()
  assert(near(x0, 40, 1e-3) and near(y0, 20, 1e-3), 'first quad at panel (40, 20)')
  assert(near(x1, 800, 1e-3) and near(y1, 400, 1e-3), 'the second quad is clipped to the window edge')
  assert(near(area(), 200 * 80 + 100 * 100, 1), 'areas: the inside quad whole, the other cut')
  assert(pushes == 2, 'one texture push per command drawn (the third is culled)')
  for i = 0, < #out do assert(out[i].tex == (@pointer)(11_usize) or out[i].tex == (@pointer)(12_usize), 'textures carried') end
  assert(#tex_stack == 0, 'every push popped')
  -- a callback command is skipped, as are empty ones
  src_cmds[0].UserCallback = (@pointer)(1_usize)
  src_cmds[1].ElemCount = 0
  l = src_list()
  out:clear()
  assert(adopt_copy(&dst, &l, &m, vec2(0, 0), box, 0) == 0, 'callbacks and empty commands draw nothing')
  -- an index past the vertices stops that command
  src_reset()
  src_quad(120, 60, 220, 100, win_clip, 11, 0xff00ff00)
  src_idx[4] = 99
  l = src_list()
  out:clear()
  assert(adopt_copy(&dst, &l, &m, vec2(0, 0), box, 0) == 3, 'broken indices: the first triangle only')
  -- without texture exports nothing is pushed, still drawn
  imgui_int.DrawListPushTextureID = nilptr
  src_reset()
  src_quad(120, 60, 220, 100, win_clip, 11, 0xff00ff00)
  l = src_list()
  out:clear() pushes = 0
  assert(adopt_copy(&dst, &l, &m, vec2(0, 0), box, 0) == 6 and pushes == 0, 'no push export: drawn in the current texture')
  imgui_int.DrawListPushTextureID = f_push
  print('copy OK')
end

-- Snapshots ----------------------------------------------------------------------------------
do
  local snap: AdoptSnap
  src_reset()
  local clip: ImVec4 = { 0, 0, 1000, 1000 }
  src_quad(100, 100, 200, 150, clip, 1, 0xffffffff)
  local l = src_list()
  adopt_snap_take(&snap, &l, 100, 100, 300, 200, false)
  -- a popup that spills past the window's box
  src_reset()
  src_quad(280, 180, 380, 260, clip, 2, 0xffffffff)
  l = src_list()
  adopt_snap_take(&snap, &l, 280, 180, 380, 260, true)
  assert(#snap.lists == 2 and #snap.vtx == 8 and #snap.idx == 12 and #snap.cmds == 2, 'both lists kept')
  -- the lists were copied: changing the source does not change the snapshot
  src_vtx[0].pos.x = -5000
  local m = adopt_fit(100, 100, 200, 100, 0, 0, 200, 100) -- scale 1
  out:clear()
  local box: ImVec4 = { 0, 0, 200, 100 }
  adopt_snap_emit(&dst, &snap, &m, vec2(0, 0), box, HUGE, 0)
  local x0, y0, x1, y1 = bounds()
  assert(near(x0, 0, 1e-3) and near(y0, 0, 1e-3), 'window list at the box corner')
  assert(near(x1, 280, 1e-3) and near(y1, 160, 1e-3), 'the popup spills over the box')
  -- the popup clipped to the box when given the same box
  out:clear()
  adopt_snap_emit(&dst, &snap, &m, vec2(0, 0), box, box, 0)
  x0, y0, x1, y1 = bounds()
  assert(near(x1, 200, 1e-3) and near(y1, 100, 1e-3), 'popup box respected')
  assert(adopt_snap_inside(&snap, 150, 120) and adopt_snap_inside(&snap, 350, 250), 'inside the window or its popup')
  assert(not adopt_snap_inside(&snap, 90, 120), 'outside both')
  adopt_snap_clear(&snap)
  assert(#snap.lists == 0 and #snap.vtx == 0, 'cleared')
  out:clear()
  assert(adopt_snap_emit(&dst, &snap, &m, vec2(0, 0), box, HUGE, 0) == 0, 'an empty snapshot draws nothing')
  adopt_snap_destroy(&snap)
  print('snapshots OK')
end

-- Pointer -------------------------------------------------------------------------------------
do
  local m = adopt_fit(100, 50, 400, 200, 0, 34, 800, 400) -- scale 2, window top-left at panel (0, 34)
  local p = adopt_pointer(10, 10, &m, true, 400, 234, false, true, false, true)
  assert(p.remap and near(p.x, 300, 1e-3) and near(p.y, 150, 1e-3), 'focused, on the window: remapped')
  p = adopt_pointer(10, 10, &m, true, 400, 234, false, false, false, true)
  assert(not p.remap and p.x == 10 and p.y == 10, 'not focused: the real pointer')
  p = adopt_pointer(10, 10, &m, true, 400, 234, true, true, false, true)
  assert(not p.remap, 'another screen window under the pointer wins')
  p = adopt_pointer(10, 10, &m, true, 400, 10, false, true, false, false)
  assert(not p.remap, 'the title strip is not the window')
  p = adopt_pointer(10, 10, &m, true, 900, 900, true, true, true, false)
  assert(p.remap, 'a held button keeps the window (a drag off its edge)')
  p = adopt_pointer(-3.4e38, -3.4e38, &m, true, 400, 234, false, true, false, true)
  assert(not p.remap, 'no mouse: nothing')
  -- the queued events rewritten, the real position kept
  -- C's size, not Nelua's: only the fields read are declared
  local evs = (@*[0]ImGuiInputEvent)(calloc(3, EVENT_SIZE))
  evs[0].Type = ImGuiInputEventType_MousePos evs[0].MousePos = { 5, 6 }
  evs[1].Type = ImGuiInputEventType_MousePos + 1
  evs[2].Type = ImGuiInputEventType_MousePos evs[2].MousePos = { 7, 8 }
  local q: ImVector_ImGuiInputEvent = { Size = 3, Capacity = 3, Data = evs }
  local real: ImVec2
  assert(adopt_peek_mouse(&q, &real) and real.x == 7 and real.y == 8, 'peek finds the last position')
  assert(adopt_rewrite_mouse(&q, 300, 150, &real) == 2, 'both positions rewritten')
  assert(evs[0].MousePos.PosX == 300 and evs[2].MousePos.PosY == 150 and real.x == 7 and real.y == 8, 'remapped, real kept')
  q.Size = 1
  evs[0].Type = ImGuiInputEventType_MousePos + 1
  assert(adopt_rewrite_mouse(&q, 1, 1, &real) == 0 and not adopt_peek_mouse(&q, &real), 'none queued: the caller queues one')
  free(evs)
  print('pointer OK')
end

-- Placement, flags, state machine -----------------------------------------------------------------
do
  local moved, x, y = adopt_on_screen(10, 10, 100, 100, 0, 0, 1920, 1080)
  assert(not moved and x == 10 and y == 10, 'on screen: stays')
  moved, x, y = adopt_on_screen(1900, -20, 100, 100, 0, 0, 1920, 1080)
  assert(moved and x == 1820 and y == 0, 'pulled back inside')
  moved, x, y = adopt_on_screen(-50, 1000, 3000, 100, 0, 0, 1920, 1080)
  assert(moved and x == 0 and y == 980, 'wider than the display: left edge wins')
  local f: cint = ImGuiWindowFlags_NoTitleBar
  assert(adopt_frame_flags(f, false) == f | ImGuiWindowFlags_NoMouseInputs, 'click-through while not remapped')
  assert(adopt_frame_flags(f, true) == f, 'its own flags while remapped')
  assert(adopt_restore_flags(f | ImGuiWindowFlags_NoMouseInputs, f) == f, 'our bit taken back')
  assert(adopt_restore_flags(f | ImGuiWindowFlags_NoMouseInputs, f | ImGuiWindowFlags_NoMouseInputs) == f | ImGuiWindowFlags_NoMouseInputs, 'the plugin\'s own bit kept')

  local e: AdoptEntry = { state = AdoptState.Waiting, since = 0 }
  assert(adopt_step(&e, false, 1) == AdoptAction.None and e.state == AdoptState.Waiting, 'waiting')
  assert(adopt_step(&e, true, 2) == AdoptAction.Take and e.state == AdoptState.Adopted, 'first sight: take')
  assert(adopt_step(&e, true, 3) == AdoptAction.None, 'drawn: nothing to do')
  assert(adopt_step(&e, false, 3.2) == AdoptAction.None, 'one frame missing is not lost')
  assert(adopt_step(&e, false, 3.6) == AdoptAction.Lose and e.state == AdoptState.Lost, 'gone for a while: lost')
  assert(adopt_step(&e, true, 4) == AdoptAction.Regain and e.state == AdoptState.Adopted, 'back')
  adopt_step(&e, false, 5)
  assert(e.state == AdoptState.Lost, 'lost again')
  assert(adopt_step(&e, false, 5 + ADOPT_LOST_LIMIT + 1) == AdoptAction.GiveUp and e.state == AdoptState.Released, 'lost too long: given up')
  assert(adopt_step(&e, true, 9999) == AdoptAction.None, 'released stays released')
  local w: AdoptEntry = { state = AdoptState.Waiting, since = 0 }
  assert(adopt_step(&w, false, ADOPT_WAIT_LIMIT + 1) == AdoptAction.GiveUp, 'never seen: given up')
  print('state OK')
end

-- Grip and names ------------------------------------------------------------------------------------
do
  local g = adopt_grip_rect(100, 200, 400, 300, 0)
  assert(near(g.x, 100 + (400 - ADOPT_GRIP_W) / 2, 1e-3) and near(g.w, 198, 1e-3), 'above the top edge, centred')
  g = adopt_grip_rect(100, 10, 400, 300, 0)
  assert(near(g.y, 12, 1e-3), 'no room above: just inside')
  g = adopt_grip_rect(0, 200, 20, 100, 0)
  assert(near(g.z - g.x, 40, 1e-3), 'narrow windows get a usable grip')
  local win: ImVec4 = { 100, 200, 500, 500 }
  g = adopt_grip_rect(100, 200, 400, 300, 0)
  assert(adopt_grip_shown(true, win, g, 300, 300), 'modifier + over the window')
  assert(adopt_grip_shown(true, win, g, 300, g.y + 3), 'on the grip itself (above the window)')
  assert(not adopt_grip_shown(false, win, g, 300, 300), 'no modifier: no grip')
  assert(not adopt_grip_shown(true, win, g, 50, 50), 'elsewhere: no grip')
  assert(adopt_in_rect(g, g.x, g.y) and not adopt_in_rect(g, g.z, g.y), 'half-open rectangles')
  assert(adopt_window_id_part('Chat 2###chat2') == 'chat2', 'id after ###')
  assert(adopt_window_id_part('###chat2') == 'chat2', 'id only')
  assert(adopt_window_id_part('Plain') == 'Plain', 'no ###: the whole name')
  assert(adopt_window_label('Chat 2###chat2') == 'Chat 2', 'label before ##')
  assert(adopt_window_label('Settings##x') == 'Settings', 'label before ##')
  assert(adopt_window_label('Plain') == 'Plain', 'no ##')
  print('grip and names OK')
end

-- The chat ring --------------------------------------------------------------------------------------
do
  local r: ChatRing
  chatlog_push(&r, 10, 'Ab Cd', 'hello\nworld')
  local l = chatlog_line(&r, 0)
  assert(l ~= nilptr and l.kind == 10 and l.sender == 'Ab Cd' and l.text == 'hello world' and l.seq == 1, 'kept, newline flattened')
  chatlog_push(&r, 10 + 128, '', 'x') -- flags above the channel bits dropped
  assert(chatlog_line(&r, 1).kind == 10, 'channel bits only')
  for i = 1, CHATLOG_MAX_LINES + 10 do
    local sb: stringbuilder
    sb:writef('line %d', i)
    local s = sb:promote()
    chatlog_push(&r, 57, '', s)
    s:destroy()
  end
  assert(chatlog_count(&r) == CHATLOG_MAX_LINES, 'at most 500 lines')
  assert(chatlog_line(&r, 0).text == 'line 11', 'oldest kept')
  assert(chatlog_line(&r, CHATLOG_MAX_LINES - 1).text == 'line 510', 'newest last')
  assert(chatlog_line(&r, CHATLOG_MAX_LINES) == nilptr and chatlog_line(&r, -1) == nilptr, 'out of range: nil')
  assert(chatlog_line(&r, CHATLOG_MAX_LINES - 1).seq == 512, 'sequence keeps counting')
  -- long text cut on a character boundary
  local sb: stringbuilder
  for i = 1, CHATLOG_MAX_TEXT do sb:write('é') end -- two bytes each
  local long = sb:promote()
  local c = chatlog_clean(long, 5)
  assert(#c == 4, 'never ends inside a character')
  c:destroy() long:destroy()
  chatlog_destroy(&r)
  assert(chatlog_count(&r) == 0, 'destroyed')
  print('ring OK')
end

-- Wrapping -------------------------------------------------------------------------------------------
local function mono(s: string, start: integer, len: integer): float32
  -- 10 px per character (UTF-8 continuation bytes are free)
  local n = 0
  for i = start, < start + len do
    if (s.data[i] & 0xC0) ~= 0x80 then n = n + 1 end
  end
  return (@float32)(n * 10)
end
local function rows(s: string, width: float32): vector(string)
  local spans: vector(ChatSpan)
  chatlog_wrap(s, width, mono, &spans)
  local v: vector(string)
  for i = 0, < #spans do v:push(s:subview(spans[i].start + 1, spans[i].start + spans[i].len)) end
  spans:destroy()
  return v
end
do
  local v = rows('the quick brown fox', 100)
  assert(#v == 2 and v[0] == 'the quick ' and v[1] == 'brown fox', 'breaks after a space')
  v:destroy()
  v = rows('abcdefghijklmnop', 50)
  assert(#v == 4 and v[0] == 'abcde' and v[3] == 'p', 'a long word is cut between characters')
  v:destroy()
  v = rows('ééééé', 20)
  assert(#v == 3 and v[0] == 'éé' and v[2] == 'é', 'UTF-8 characters never split')
  v:destroy()
  v = rows('', 100)
  assert(#v == 1 and #v[0] == 0, 'empty text: one empty row')
  v:destroy()
  v = rows('ab', 5)
  assert(#v == 2 and v[0] == 'a', 'narrower than a character: one per row')
  v:destroy()
  v = rows('a b c', 1000)
  assert(#v == 1, 'fits: one row')
  v:destroy()
  print('wrap OK')
end

-- The input line and colours ---------------------------------------------------------------------------
do
  local inp: ChatInput
  assert(chatinput_insert(&inp, 'h'_b) and chatinput_insert(&inp, 0xE9) and chatinput_insert(&inp, 0x1F600), 'ascii, two and four bytes')
  assert(chatinput_text(&inp) == 'h\u{e9}\u{1F600}', 'UTF-8 encoded')
  assert(not chatinput_insert(&inp, 10) and not chatinput_insert(&inp, 0xD800), 'controls and surrogates refused')
  chatinput_backspace(&inp)
  assert(chatinput_text(&inp) == 'h\u{e9}', 'backspace removes a whole character')
  chatinput_backspace(&inp) chatinput_backspace(&inp) chatinput_backspace(&inp)
  assert(#chatinput_text(&inp) == 0, 'empty after too many backspaces')
  for i = 1, CHATLOG_INPUT_MAX do chatinput_insert(&inp, 'a'_b) end
  assert(not chatinput_insert(&inp, 'a'_b), 'the game\'s 500 byte limit')
  inp.buf:clear()
  local typed: string = '  hi '
  for k = 0, < #typed do chatinput_insert(&inp, typed.data[k]) end
  local t = chatinput_take(&inp)
  assert(t == 'hi' and #chatinput_text(&inp) == 0, 'taken trimmed, cleared')
  t:destroy()
  chatinput_insert(&inp, ' '_b)
  t = chatinput_take(&inp)
  assert(#t == 0, 'only spaces: nothing to send')
  chatinput_destroy(&inp)
  assert(chatlog_game_colour(0xFFFFA679) == im_col32(0xFF, 0xA6, 0x79, 0xFF), 'ARGB -> IM_COL32')
  print('input OK')
end

-- lua/adopt.lua, in a Lua state with the core's ghostty table (tests/test_adopt.lua)
if #arg >= 2 then
  local root: string = arg[1]
  local scratch: string = arg[2]
  local L = luaL_newstate()
  luaL_openlibs(L)
  world_lua_register(L)
  fs_lua_register(L)
  local script = root .. '/tests/test_adopt.lua'
  if luaL_loadfilex(L, (@cstring)(script.data), nilptr) ~= LUA_OK then
    io.stderr:write((@cstring)(lua_tolstring(L, -1, nilptr)), '\n')
    os.exit(1)
  end
  lua_pushlstring(L, (@cstring)(root.data), root.size)
  lua_pushlstring(L, (@cstring)(scratch.data), scratch.size)
  if lua_pcall(L, 2, 0, 0) ~= LUA_OK then
    io.stderr:write((@cstring)(lua_tolstring(L, -1, nilptr)), '\n')
    os.exit(1)
  end
  lua_close(L)
end

print('test_adopt OK')
