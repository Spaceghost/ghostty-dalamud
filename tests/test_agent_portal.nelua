-- Portal fixture through real agent TCP protocol and frame codec.
-- Synthetic portal helper: authenticate, list, open, reconstruct BGRA via
-- the production frame codec, then observe natural capture termination.
-- tools/test-portal-agent.py additionally verifies CLI-to-watcher handoff.
require 'core.sys.net'
require 'tests.check'
require 'core.protocol'
require 'core.wincodec'
require 'agent.capture' -- capture_test_render: the pixels the agent's test backend draws
require 'string'
require 'vector'
require 'memory'
require 'io'
require 'os'
require 'arg'

## cinclude '<unistd.h>'
local function usleep(us: cuint): cint <cimport, nodecl> end

local port: uint16 = (@uint16)(tointeger(arg[1]))
local token: string = arg[2]


local Msg = @record{ typ: uint8, data: vector(uint8) }

local Conn = @record{
  sock: NetSocket,
  inq: ByteQueue,
  outq: ByteQueue,
  msgs: vector(Msg),
  closed: boolean,
}

local function conn_pump(c: *Conn): void
  while c.outq:len() > 0 do
    local n = net.send(c.sock, c.outq:peek(), c.outq:len())
    if n <= 0 then break end
    c.outq:consume((@usize)(n))
  end
  local buf: [65536]uint8
  for _ = 1, 64 do
    local n = net.recv(c.sock, &buf, #buf)
    if n > 0 then c.inq:push(&buf, (@usize)(n))
    elseif n == 0 then break
    else c.closed = true break end
  end
  while true do
    local ok, typ, payload, len = proto.read_frame(&c.inq)
    if not ok then break end
    local m: Msg = { typ = typ }
    m.data:resize(len)
    if len > 0 then memory.copy(&m.data[0], payload, len) end
    c.msgs:push(m)
    proto.frame_consume(&c.inq, len)
  end
end

local function send(c: *Conn, typ: uint8, p: *[0]uint8, len: usize): void
  proto.write_frame(&c.outq, typ, p, len)
  conn_pump(c)
end

local function msg_text(m: *Msg, from: usize): string
  if #m.data <= from then return (@string){} end
  return string{data=(@*[0]byte)(&m.data[from]), size=#m.data - from}
end

-- The first message of type `typ` (and, with `sid` ~= 0, whose payload starts
-- with it), waiting up to `secs`. False on timeout. The caller destroys m.data.
local function take(c: *Conn, typ: uint8, sid: uint32, secs: number): (boolean, Msg)
  local tries = (@integer)(secs * 200)
  for t = 0, tries do
    for i = 0, < #c.msgs do
      local m = &c.msgs[i]
      if m.typ == typ and (sid == 0 or (#m.data >= 4 and proto.get_u32((@*[0]uint8)(&m.data[0])) == sid)) then
        local got = $m
        c.msgs:remove(i)
        return true, got
      end
    end
    if t < tries then usleep(5000) conn_pump(c) end
  end
  return false, (@Msg){}
end

local function count(c: *Conn, typ: uint8, sid: uint32): integer
  local n = 0
  for i = 0, < #c.msgs do
    local m = &c.msgs[i]
    if m.typ == typ and (sid == 0 or proto.get_u32((@*[0]uint8)(&m.data[0])) == sid) then n = n + 1 end
  end
  return n
end

local function settle(c: *Conn, secs: number): void
  for _ = 1, (@integer)(secs * 200) do usleep(5000) conn_pump(c) end
end

local function conn_open_at(at: uint16): Conn
  local c: Conn
  local nc = net.connect('127.0.0.1', at)
  assert(net.is_valid(nc.sock), 'connect')
  for _ = 1, 400 do
    if net.connect_poll(&nc) == 1 then break end
    usleep(5000)
  end
  assert(nc.connected, 'connected')
  c.sock = nc.sock
  send(&c, PROTO_HELLO, (@*[0]uint8)(token.data), token.size)
  local ok, m = take(&c, PROTO_OK, 0, 3)
  assert(ok, 'handshake')
  assert(msg_text(&m, 0):find('ghostty-agent 4 ', 1, true) == 1, 'a version 4 agent')
  m.data:destroy()
  return c
end

local function conn_open(): Conn return conn_open_at(port) end

local function conn_close(c: *Conn): void
  net.close(c.sock)
  for i = 0, < #c.msgs do c.msgs[i].data:destroy() end
  c.msgs:destroy()
  c.inq:destroy()
  c.outq:destroy()
end

local function wlist(c: *Conn): string
  send(c, PROTO_WLIST, nilptr, 0)
  local ok, m = take(c, PROTO_WLISTR, 0, 3)
  assert(ok, 'WLISTR')
  local s = msg_text(&m, 0):copy()
  m.data:destroy()
  return s
end

-- WOPEN; returns (req, sid, w, h, title) from its WOPENED
local next_req: uint32 = 100
local function wopen(c: *Conn, wid: uint32, max_w: uint16, max_h: uint16, fps: uint8, match: string): (uint32, uint32, integer, integer, string)
  next_req = next_req + 1
  local p: [13 + 64]uint8
  proto.put_u32(&p, next_req)
  proto.put_u32((@*[0]uint8)(&p[4]), wid)
  proto.put_u16((@*[0]uint8)(&p[8]), max_w)
  proto.put_u16((@*[0]uint8)(&p[10]), max_h)
  p[12] = fps
  if #match > 0 then memory.copy(&p[13], match.data, match.size) end
  send(c, PROTO_WOPEN, &p, 13 + match.size)
  local ok, m = take(c, PROTO_WOPENED, next_req, 3)
  assert(ok, 'WOPENED for the request')
  local sid = proto.get_u32((@*[0]uint8)(&m.data[4]))
  local w = (@integer)(proto.get_u16((@*[0]uint8)(&m.data[8])))
  local h = (@integer)(proto.get_u16((@*[0]uint8)(&m.data[10])))
  local title = msg_text(&m, 12):copy()
  m.data:destroy()
  return next_req, sid, w, h, title
end

local function send_sid(c: *Conn, typ: uint8, sid: uint32): void
  local p: [4]uint8
  proto.put_u32(&p, sid)
  send(c, typ, &p, 4)
end

local function wack(c: *Conn, sid: uint32, seq: uint32): void
  local p: [8]uint8
  proto.put_u32(&p, sid)
  proto.put_u32((@*[0]uint8)(&p[4]), seq)
  send(c, PROTO_WACK, &p, 8)
end

local function winput(c: *Conn, sid: uint32, kind: uint8, body: *[0]uint8, n: usize): void
  local p: [64]uint8
  proto.put_u32(&p, sid)
  p[4] = kind
  if n > 0 then memory.copy(&p[5], body, n) end
  send(c, PROTO_WINPUT, &p, 5 + n)
end

-- What a client shows for one stream.
local Screen = @record{ w: integer, h: integer, px: vector(uint8) }

-- Receive one whole seq of `sid` into `scr`: (seq, key, changed pixel count).
local function recv_seq(c: *Conn, sid: uint32, scr: *Screen, secs: number): (uint32, boolean, integer)
  local seq: uint32 = 0
  local key = false
  local area = 0
  while true do
    local ok, m = take(c, PROTO_WFRAME, sid, secs)
    assert(ok, 'a WFRAME arrives')
    local okf, f = wincodec_parse((@*[0]uint8)(&m.data[0]), #m.data)
    assert(okf and f.sid == sid)
    if seq == 0 then seq = f.seq else assert(f.seq == seq, 'one seq at a time') end
    if f.flags & WINCODEC_FLAG_KEY ~= 0 then
      key = true
      scr.w, scr.h = f.w, f.h
      scr.px:resize((@usize)(scr.w * scr.h * 4))
    end
    assert(f.w == scr.w and f.h == scr.h, 'a new size comes as a KEY frame')
    while true do
      local okr, fr = wincodec_next_rect(&f)
      if not okr then break end
      assert(wincodec_apply_rect(&fr, (@*[0]uint8)(&scr.px[0]), (@usize)(scr.w * 4)))
      area = area + (@integer)(fr.r.w) * (@integer)(fr.r.h)
    end
    local ended = f.flags & WINCODEC_FLAG_END ~= 0
    m.data:destroy()
    if ended then break end
  end
  return seq, key, area
end


local c = conn_open()
local listed = wlist(&c)
assert(listed:find('portal', 1, true) > 0)
listed:destroy()
local _, sid, w, h, title = wopen(&c, 0, 1024, 768, 30, 'portal:')
assert(sid > 0 and w == 1 and h == 1)
title:destroy()
local screen: Screen
local _, key, area = recv_seq(&c, sid, &screen, 5)
assert(key and area == 1 and screen.w == 1 and screen.h == 1)
assert(screen.px[0] == 66 and screen.px[1] == 71 and screen.px[2] == 82)
local ended, endmsg = take(&c, PROTO_WEND, sid, 3)
assert(ended)
endmsg.data:destroy()
screen.px:destroy()
conn_close(&c)
print('portal agent stream OK')
