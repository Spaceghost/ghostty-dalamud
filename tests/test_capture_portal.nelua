require 'agent.capture'
local function usleep(usec: cuint): cint <cimport, nodecl> end
local ok, backend, why = capture_select('portal')
assert(ok, why)
local refused, reason = backend.open(12, '')
assert(refused == nilptr and #reason > 0)
reason:destroy()
local handle, err = backend.open(0, 'portal:')
assert(handle ~= nilptr, err)
err:destroy()
local state, _ = backend.state(handle)
assert(state == CAPTURE_PENDING)
local frame: CaptureFrame
for i=1,5000 do
  backend.pump()
  if backend.frame(handle, &frame) then break end
  usleep(1000)
end
assert(frame.w == 1 and frame.h == 1 and frame.stride == 4 and frame.serial == 2)
assert(frame.pixels[0] == 66 and frame.pixels[3] == 65)
local live, _ = backend.state(handle)
assert(live == CAPTURE_LIVE)
local wid = backend.wid_of(handle)
assert(wid > 0 and backend.list_serial() > 0)
local listing = backend.list()
local listed = listing:find(tostring(wid) .. '\t1\t1\tportal\t', 1, true)
assert(listed ~= nil)
listing:destroy()
local attached, attach_error = backend.open(wid, '')
assert(attached == handle and #attach_error == 0)
attach_error:destroy()
backend.release(handle)
local retained: CaptureFrame
assert(backend.frame(attached, &retained) and retained.serial == frame.serial)
assert(backend.state(attached) == CAPTURE_LIVE)
backend.release(attached)
local reattached, reattach_error = backend.open(wid, '')
assert(reattached == attached and #reattach_error == 0)
reattach_error:destroy()
assert(backend.frame(reattached, &retained))
backend.close(reattached)
local expired, expired_error = backend.open(wid, '')
assert(expired == nilptr and #expired_error > 0)
expired_error:destroy()
local fds: array(cint, 4)
assert(backend.poll_fds((@*[0]cint)(&fds), 4) == 0 and backend.wait_ms() == -1)
print('portal capture backend OK')
