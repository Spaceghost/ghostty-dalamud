-- The Win32 capture backend's pure parts (agent/capture_win32_logic.nelua):
-- HID → VK, key lParams, key characters, mouse words, blank captures, UTF-16 for WM_CHAR, WLISTR lines and
-- window matching. The Win32 half is exercised by tests/smoke_capture_win32.
require 'agent.capture_win32_logic'
require 'string'
require 'vector'
require 'stringbuilder'

-- HID usage → VK
do
  local function vk(hid: uint16): uint8 local v, _ = cw32_hid_key(hid) return v end
  local function ext(hid: uint16): boolean local _, e = cw32_hid_key(hid) return e end
  assert(vk(0x04) == 0x41 and vk(0x1D) == 0x5A)          -- a, z
  assert(vk(0x1E) == 0x31 and vk(0x26) == 0x39 and vk(0x27) == 0x30) -- 1, 9, 0
  assert(vk(0x28) == 0x0D and not ext(0x28))             -- enter
  assert(vk(0x58) == 0x0D and ext(0x58))                 -- keypad enter is extended
  assert(vk(0x29) == 0x1B and vk(0x2A) == 0x08 and vk(0x2B) == 0x09 and vk(0x2C) == 0x20)
  assert(vk(0x2D) == 0xBD and vk(0x2E) == 0xBB and vk(0x2F) == 0xDB and vk(0x30) == 0xDD)
  assert(vk(0x33) == 0xBA and vk(0x34) == 0xDE and vk(0x35) == 0xC0)
  assert(vk(0x36) == 0xBC and vk(0x37) == 0xBE and vk(0x38) == 0xBF)
  assert(vk(0x3A) == 0x70 and vk(0x45) == 0x7B)          -- F1, F12
  assert(vk(0x68) == 0x7C and vk(0x73) == 0x87)          -- F13, F24
  assert(vk(0x4F) == 0x27 and vk(0x50) == 0x25 and vk(0x51) == 0x28 and vk(0x52) == 0x26)
  assert(ext(0x4F) and ext(0x4A) and ext(0x4C) and ext(0x49))
  assert(vk(0x4A) == 0x24 and vk(0x4D) == 0x23 and vk(0x4B) == 0x21 and vk(0x4E) == 0x22)
  assert(vk(0x49) == 0x2D and vk(0x4C) == 0x2E)
  assert(vk(0xE0) == CW32_VK_LCONTROL and not ext(0xE0) and vk(0xE4) == CW32_VK_RCONTROL and ext(0xE4))
  assert(vk(0xE1) == CW32_VK_LSHIFT and vk(0xE5) == CW32_VK_RSHIFT)
  assert(vk(0xE2) == CW32_VK_LMENU and vk(0xE6) == CW32_VK_RMENU and ext(0xE6))
  assert(vk(0xE3) == 0x5B and vk(0xE7) == 0x5C)
  assert(vk(0x00) == 0 and vk(0x03) == 0 and vk(0xFF) == 0 and vk(0x74) == 0)
  assert(cw32_generic_vk(CW32_VK_RCONTROL) == CW32_VK_CONTROL)
  assert(cw32_generic_vk(CW32_VK_LSHIFT) == CW32_VK_SHIFT)
  assert(cw32_generic_vk(CW32_VK_LMENU) == CW32_VK_MENU)
  assert(cw32_generic_vk(0x41) == 0x41)
end

-- key lParam and message
do
  assert(cw32_key_lparam(0x1E, true, false, false) == 0x001E0001)
  assert(cw32_key_lparam(0x1E, false, false, false) == 0xC01E0001)
  assert(cw32_key_lparam(0x48, true, true, false) == 0x01480001)
  assert(cw32_key_lparam(0x3E, true, false, true) == 0x203E0001)
  assert(cw32_key_lparam(0x1FF, true, false, false) == 0x00FF0001) -- scan code is 8 bits
  assert(cw32_key_msg(0x41, true, false) == CW32_WM_KEYDOWN)
  assert(cw32_key_msg(0x41, false, false) == CW32_WM_KEYUP)
  assert(cw32_key_msg(0x73, true, true) == CW32_WM_SYSKEYDOWN)     -- alt+F4
  assert(cw32_key_msg(CW32_VK_LMENU, false, false) == CW32_WM_SYSKEYUP)
end

-- the WM_CHAR a key stands for
do
  assert(cw32_key_char(0x0D, 0) == 0x0D and cw32_key_char(0x09, 0) == 0x09)
  assert(cw32_key_char(0x08, 2) == 0x08 and cw32_key_char(0x1B, 0) == 0x1B)
  assert(cw32_key_char(0x0D, 1) == 0x0A and cw32_key_char(0x09, 1) == 0)
  assert(cw32_key_char(0x43, 1) == 3 and cw32_key_char(0x5A, 3) == 26)  -- ctrl+c, ctrl+shift+z
  assert(cw32_key_char(0x43, 0) == 0 and cw32_key_char(0x43, 2) == 0)   -- letters come as TEXT
  assert(cw32_key_char(0x43, 5) == 0 and cw32_key_char(0x0D, 4) == 0)   -- alt: none
  assert(cw32_key_char(0x27, 0) == 0 and cw32_key_char(0x70, 1) == 0)   -- arrows, F-keys
end

-- mouse words
do
  assert(cw32_makelparam(10, 20) == 0x0014000A)
  assert(cw32_makelparam(-1, 5) == 0x0005FFFF)
  assert(cw32_wheel_wparam(120, CW32_MK_CONTROL) == 0x00780008)
  assert(cw32_wheel_wparam(-120, 0) == 0xFF880000)
  assert(cw32_wheel_wparam(100000, 0) == 0x7FFF0000)
  assert(cw32_button_msg(0, true) == CW32_WM_LBUTTONDOWN and cw32_button_msg(0, false) == CW32_WM_LBUTTONUP)
  assert(cw32_button_msg(1, true) == CW32_WM_RBUTTONDOWN and cw32_button_msg(2, false) == CW32_WM_MBUTTONUP)
  assert(cw32_button_msg(3, true) == 0)
  assert(cw32_button_mk(0) == CW32_MK_LBUTTON and cw32_button_mk(2) == CW32_MK_MBUTTON and cw32_button_mk(5) == 0)
  assert(cw32_abs_coord(0, 0, 1920) == 0 and cw32_abs_coord(1919, 0, 1920) == 65535)
  assert(cw32_abs_coord(-1920, -1920, 3840) == 0 and cw32_abs_coord(1919, -1920, 3840) == 65535)
  assert(cw32_abs_coord(960, 0, 1921) == 32768)
  assert(cw32_abs_coord(5000, 0, 1920) == 65535 and cw32_abs_coord(-5, 0, 1920) == 0)
end

-- blank capture detection
do
  local px: [4 * 3]uint8
  assert(cw32_all_black(&px, 3))
  px[11] = 255 -- alpha only
  assert(cw32_all_black(&px, 3))
  px[9] = 1
  assert(not cw32_all_black(&px, 3))
  assert(cw32_all_black(&px, 2) and cw32_all_black(&px, 0))
end

-- UTF-8 → UTF-16 units
do
  local function units(s: string, want: vector(uint16)): boolean
    local v = cw32_utf16_units(s)
    local ok = #v == #want
    if ok then for i = 0, < #v do if v[i] ~= want[i] then ok = false end end end
    v:destroy()
    want:destroy()
    return ok
  end
  assert(units('hi', (@vector(uint16)){0x68, 0x69}))
  assert(units('é€', (@vector(uint16)){0xE9, 0x20AC}))
  assert(units('😀', (@vector(uint16)){0xD83D, 0xDE00}))                  -- a surrogate pair: two WM_CHARs
  assert(units('a\xFFb', (@vector(uint16)){0x61, 0xFFFD, 0x62}))           -- stray byte
  assert(units('\xE2\x82', (@vector(uint16)){0xFFFD, 0xFFFD}))             -- truncated sequence
  assert(units('\xC0\xAF', (@vector(uint16)){0xFFFD, 0xFFFD}))             -- overlong
  assert(units('\xED\xA0\x80', (@vector(uint16)){0xFFFD, 0xFFFD, 0xFFFD})) -- encoded surrogate
  local e = cw32_utf16_units('')
  assert(#e == 0)
  e:destroy()
end

-- WLISTR fields, names, matching
do
  local s = cw32_sanitize('a\tb\nc\rd')
  assert(s == 'a b c d')
  s:destroy()
  local b = cw32_basename('C:\\Windows\\system32\\notepad.exe')
  assert(b == 'notepad.exe')
  b:destroy()
  b = cw32_basename('notepad.exe')
  assert(b == 'notepad.exe')
  b:destroy()
  b = cw32_basename('C:\\dir\\')
  assert(b == '')
  b:destroy()

  local sb: stringbuilder
  cw32_list_line(&sb, 0x00010ABC, 640, 480, 'notepad.exe', 'Untitled\t- Notepad\n')
  local line = sb:promote()
  assert(line == '68284\t640\t480\tnotepad.exe\tUntitled - Notepad \n')
  line:destroy()

  assert(cw32_window_matches('Untitled - Notepad', 'notepad.exe', 'NOTEPAD'))
  assert(cw32_window_matches('Something', 'notepad.exe', 'pad.e'))
  assert(cw32_window_matches('Mozilla Firefox', 'firefox.exe', 'fire'))
  assert(not cw32_window_matches('Mozilla Firefox', 'firefox.exe', 'chrome'))
  assert(not cw32_window_matches('abc', 'x.exe', ''))
  assert(not cw32_window_matches('ab', 'x', 'abc'))
  assert(cw32_contains_ci('abc', 'ABC') and cw32_contains_ci('xabc', 'bC'))
end

print('test_capture_win32 OK')
