require 'agent.clipboard_offer'
local offer: ClipboardOffer
local old = offer:select(false)
local current = offer:select(false)
assert(not offer:complete(old, 'old copy'))
assert(not offer.ready and #offer.text == 0)
assert(offer:complete(current, 'notes'))
assert(offer.ready and offer.text == 'notes')
local secret = offer:select(true)
assert(offer.ready and offer.sensitive and #offer.text == 0)
assert(not offer:complete(secret, 'password'))
local empty = offer:select(false)
assert(offer:complete(empty, '') and offer.ready and not offer.sensitive)
local invalid = offer:select(false)
assert(not offer:complete(invalid, 'bad\0text'))
assert(not offer:complete(invalid, '\xff'))
assert(not offer:complete(invalid, '\xc0\xaf'))
assert(not offer:complete(invalid, '\xed\xa0\x80'))
assert(not offer:complete(invalid, '\xf4\x90\x80\x80'))
assert(not offer.ready and #offer.text == 0)
assert(offer:complete(invalid, '界 ✓'))
local too_long: string = string.rep('x', 65537)
local next = offer:select(false)
assert(not offer:complete(next, too_long) and not offer.ready)
too_long:destroy()
offer.text:destroy()
print('clipboard source generations OK')
