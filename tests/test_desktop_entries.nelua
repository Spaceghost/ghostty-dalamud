-- agent/desktop_entries.nelua: .desktop parsing, Exec field codes, finding an
-- app by id or fuzzy name, list lines, icon lookup in a made-up XDG tree
-- and the icon cache jobs. Args: a scratch directory.
require 'agent.desktop_entries'
require 'string'
require 'stringbuilder'
require 'vector'
require 'io'
require 'os'
require 'arg'

local scratch: string = #arg >= 1 and arg[1] or '/tmp'

local function check(ok: boolean, what: string): void
  if not ok then io.stderr:write('FAIL: ', what, '\n') os.exit(1) end
end

-- -P nogc: a message built with `..` or string.format is a real allocation, so
-- one is only built on the failing path, which exits before it can matter.
local function checkf(ok: boolean, fmt: string, ...: varargs): void
  if not ok then
    io.stderr:write('FAIL: ', string.format(fmt, ...), '\n')
    os.exit(1)
  end
end

-- the same reason: a command or a path built here is freed by its builder
local function shell(fmt: string, ...: varargs): void
  local cmd: string = string.format(fmt, ...)
  os.execute(cmd)
  cmd:destroy()
end

local function write_file(path: string, text: string): void
  local f = io.open(path, 'wb')
  checkf(f:isopen(), 'write %s', path)
  f:write(text)
  f:destroy()
end

local function write_under(dir: string, rel: string, text: string): void
  local path: string = string.format('%s%s', dir, rel)
  write_file(path, text)
  path:destroy()
end

-- parsing
do
  local ok, e = desktop_parse('org.example.Calc.desktop', [[
# comment
[Desktop Entry]
Type=Application
Name=Calculator
Name[de]=Rechner
Exec=gnome-calculator --mode %u %%done
Icon=org.example.Calc
Categories=Utility;Calculator;
Terminal=false

[Desktop Action new]
Name=New Window
Exec=other
]])
  check(ok, 'an application parses')
  checkf(e.name == 'Calculator', 'the unlocalized name: %s', e.name)
  checkf(e.exec == 'gnome-calculator --mode  %done', 'field codes: [%s]', e.exec)
  check(e.icon == 'org.example.Calc' and e.categories == 'Utility;Calculator;', 'icon, categories')
  check(not e.terminal, 'not a terminal app')
  e:destroy()
  local ok2 = desktop_parse('x.desktop', '[Desktop Entry]\nType=Application\nName=Hidden\nExec=x\nNoDisplay=true\n')
  check(not ok2, 'NoDisplay is not shown')
  local ok3 = desktop_parse('y.desktop', '[Desktop Entry]\nType=Link\nName=Link\nURL=http://x\n')
  check(not ok3, 'a Link is not an app')
  local ok4, e4 = desktop_parse('htop.desktop', '[Desktop Entry]\nType=Application\nName=Htop\nExec=htop\nTerminal=true\nIcon=htop\n')
  check(ok4 and e4.terminal, 'a terminal app')
  e4:destroy()
  local c = desktop_exec_command('app %i --name %c %F', 'My App', 'appicon')
  checkf(c == "app --icon 'appicon' --name 'My App'", 'exec %%i %%c: %s', c)
  c:destroy()
  local ok5, e5 = desktop_parse('esc.desktop', '[Desktop Entry]\nType=Application\nName=Esc\nExec=sh -c "echo a\\sb"\n')
  checkf(ok5 and e5.exec == 'sh -c "echo a b"', 'string escapes: %s', e5.exec)
  e5:destroy()
end

-- a made-up XDG tree: data home with one app, a data dir with two, one of
-- them shadowed by the data home; icons in hicolor (png and svg) and pixmaps
local root: string = string.format('%s/xdg', scratch)
shell("rm -rf '%s'", root)
shell("mkdir -p '%s/home/applications' '%s/sys/applications/vendor' '%s/sys/icons/hicolor/48x48/apps' '%s/sys/icons/hicolor/128x128/apps' '%s/sys/icons/hicolor/scalable/apps'",
  root, root, root, root, root)
write_under(root, '/home/applications/org.example.Calc.desktop', '[Desktop Entry]\nType=Application\nName=Calculator (mine)\nExec=mycalc\nIcon=calc\n')
write_under(root, '/sys/applications/org.example.Calc.desktop', '[Desktop Entry]\nType=Application\nName=Calculator\nExec=calc\nIcon=calc\n')
write_under(root, '/sys/applications/org.example.TextEditor.desktop', '[Desktop Entry]\nType=Application\nName=Text Editor\nExec=gnome-text-editor %U\nIcon=org.example.TextEditor\nCategories=Utility;TextEditor;\n')
write_under(root, '/sys/applications/vendor/tool.desktop', '[Desktop Entry]\nType=Application\nName=Vendor Tool\nExec=/opt/vendor/bin/vtool\n')
write_under(root, '/sys/icons/hicolor/48x48/apps/calc.png', 'png48')
write_under(root, '/sys/icons/hicolor/128x128/apps/calc.png', 'png128')
write_under(root, '/sys/icons/hicolor/scalable/apps/org.example.TextEditor.svg', '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"><rect width="16" height="16" fill="red"/></svg>')

local dirs: vector(string)
dirs:push(string.format('%s/home/applications', root))
dirs:push(string.format('%s/sys/applications', root))
local es = desktop_scan(&dirs)
checkf(#es == 3, 'three apps, the shadowed one once: %d', #es)
checkf(es[0].name == 'Calculator (mine)', 'sorted by name, data home wins: %s', es[0].name)
checkf(es[1].name == 'Text Editor' and es[2].id == 'vendor-tool.desktop', 'sorted; subdirectory ids get their prefix: %s', es[2].id)

-- finding
check(desktop_find(&es, 'org.example.TextEditor') == 1, 'by short id')
check(desktop_find(&es, 'org.example.texteditor.desktop') == 1, 'by id, any case')
check(desktop_find(&es, 'text') == 1, 'by a word of the name')
check(desktop_find(&es, 'calc') == 0, 'by a prefix')
check(desktop_find(&es, 'vtool') == 2, 'by the program name')
check(desktop_find(&es, 'zzzz') == -1, 'nothing')

-- icons
local idirs: vector(string)
idirs:push(string.format('%s/sys/icons', root))
local p, sz = desktop_find_icon('calc', &idirs)
local want: string = string.format('%s/sys/icons/hicolor/128x128/apps/calc.png', root)
checkf(p == want and sz == 128, 'the 128 px png first: %s', p)
local p2, sz2 = desktop_find_icon('org.example.TextEditor', &idirs)
checkf(p2:find('scalable', 1, true) > 0 and sz2 == 0, 'scalable svg: %s', p2)
local p3 = desktop_find_icon('no-such-icon-anywhere-xyz', &idirs)
check(#p3 == 0, 'no icon')
local abs: string = string.format('%s/sys/icons/hicolor/48x48/apps/calc.png', root)
local p4, sz4 = desktop_find_icon(abs, &idirs)
checkf(#p4 > 0 and sz4 == DESKTOP_ICON_PX, 'an absolute path is taken as is: %s %d', p4, sz4)
abs:destroy()
p3:destroy()

-- list lines
do
  local sb: stringbuilder
  desktop_list_line(&sb, &es[1], '/home/u/.cache/ghostty-agent/icons/org.example.TextEditor-128.png')
  local ok4, e4 = desktop_parse('htop.desktop', '[Desktop Entry]\nType=Application\nName=Htop\nExec=htop\nTerminal=true\nCategories=System;\n')
  desktop_list_line(&sb, &e4, '')
  local l = sb:promote()
  checkf(l == 'app\torg.example.TextEditor\tText Editor\t/home/u/.cache/ghostty-agent/icons/org.example.TextEditor-128.png\tUtility;TextEditor;\nterm\thtop\tHtop\t\tSystem;\thtop\n',
    'list lines: %s', l)
  l:destroy()
  e4:destroy()
  sb:destroy()
end

-- cache jobs: a PNG is copied, an SVG rendered (by whatever this host has)
local cache: string = string.format('%s/cache', root)
shell("mkdir -p '%s'", cache)
local renderer = desktop_icon_renderer()
print('icon renderer: ', #renderer > 0 and renderer or 'none')
do
  local sb: stringbuilder
  local d1 = desktop_icon_png(cache, 'org.example.Calc', sz)
  local want1: string = string.format('%s/org.example.Calc-128.png', cache)
  checkf(d1 == want1, 'cache name: %s', d1)
  want1:destroy()
  check(desktop_icon_job(&sb, p, d1, renderer), 'a png job')
  local d2 = desktop_icon_png(cache, 'org.example.TextEditor', sz2)
  local svg_ok = desktop_icon_job(&sb, p2, d2, renderer)
  check(svg_ok == (#renderer > 0), 'an svg job when there is a renderer')
  local script = sb:promote()
  io.write(script)
  check(os.execute(script) ~= nil, 'the jobs ran')
  local f = io.open(d1, 'rb')
  check(f:isopen(), 'png copied')
  local t = f:read('a')
  f:destroy()
  check(t == 'png128', 'png copied as is')
  t:destroy()
  if svg_ok then
    local g = io.open(d2, 'rb')
    checkf(g:isopen(), 'svg rendered to %s', d2)
    local head = g:read(8)
    g:destroy()
    check(head == '\x89PNG\r\n\x1a\n', 'the rendered icon is a PNG')
    head:destroy()
  end
  script:destroy()
  d1:destroy()
  d2:destroy()
  sb:destroy()
end

-- -P nogc: every string and vector this test built, freed before it exits
renderer:destroy()
cache:destroy()
p:destroy() p2:destroy() p4:destroy() want:destroy()
for i = 0, < #idirs do idirs[i]:destroy() end
idirs:destroy()
for i = 0, < #es do es[i]:destroy() end
es:destroy()
for i = 0, < #dirs do dirs[i]:destroy() end
dirs:destroy()
root:destroy()
print('desktop entries OK')
