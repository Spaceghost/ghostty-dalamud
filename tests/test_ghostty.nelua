-- Smoke test: drive libghostty-vt through the Nelua binding on the host.
require 'core.ghostty'
require 'string'
require 'io'
require 'os'

local function check(res: cint, what: string)
  if res ~= GHOSTTY_SUCCESS then
    io.stderr:writef("%s failed: %d\n", what, res)
    os.exit(1)
  end
end

-- -P nogc: string.format allocates, so a printed line is freed after it is printed.
local function printf(fmt: string, ...: varargs)
  local line: string = string.format(fmt, ...)
  print(line)
  line:destroy()
end

-- Verify the sized-struct ABI sizes against the manifest shipped by the library.
local manifest: string = ghostty_type_json()
local function manifest_size(name: string): integer
  -- -P nogc: every concat allocates, and chaining two of them strands the one in
  -- the middle, so the needle is built in one step and freed before returning.
  local needle: string = string.format('"%s"', name)
  local pos = manifest:find(needle, 1, true)
  needle:destroy()
  assert(pos > 0, 'type missing from manifest')
  local spos = manifest:find('"size":', pos, true)
  assert(spos > 0)
  local i = spos + 7
  local n: integer = 0
  while i <= #manifest do
    local c = manifest:byte(i)
    if c == 32 then i = i + 1
    elseif c >= 48 and c <= 57 then n = n * 10 + (c - 48); i = i + 1
    else break end
  end
  return n
end
assert(manifest_size('GhosttyStyle') == #GhosttyStyle, 'GhosttyStyle size mismatch')
assert(manifest_size('GhosttyRenderStateColors') == #GhosttyRenderStateColors, 'Colors size mismatch')
assert(manifest_size('GhosttyRenderStateCursor') == #GhosttyRenderStateCursor, 'Cursor size mismatch')
print('sized structs match manifest:', #GhosttyStyle, #GhosttyRenderStateColors, #GhosttyRenderStateCursor)

local term: GhosttyTerminal
check(ghostty_terminal_new(nilptr, &term, 20, 5), 'terminal_new')
check(ghostty_terminal_resize(term, 20, 5, 8, 16), 'terminal_resize')

local replies: string = ''
local function write_pty(terminal: GhosttyTerminal, userdata: pointer, data: *[0]uint8, len: usize): void
  local chunk: string = string{data=(@*[0]byte)(data), size=len}:copy()
  local grown: string = replies .. chunk
  chunk:destroy()
  replies:destroy()
  replies = grown
end
check(ghostty_terminal_set(term, GHOSTTY_TERMINAL_OPT_WRITE_PTY, (@pointer)(write_pty)), 'set write_pty')

local input: string = "Hi\r\n\27[31mred\27[0m \27[1mbold\27[0m\27[6n"
ghostty_terminal_vt_write(term, (@*[0]uint8)(input.data), input.size)

local state: GhosttyRenderState
check(ghostty_render_state_new(nilptr, &state), 'render_state_new')
check(ghostty_render_state_update(state, term), 'render_state_update')

local colors: GhosttyRenderStateColors = { size = #GhosttyRenderStateColors }
check(ghostty_render_state_get(state, GHOSTTY_RENDER_STATE_DATA_COLORS, &colors), 'get colors')
printf('default fg=%d,%d,%d bg=%d,%d,%d palette[1]=%d,%d,%d',
  colors.foreground.r, colors.foreground.g, colors.foreground.b,
  colors.background.r, colors.background.g, colors.background.b,
  colors.palette[1].r, colors.palette[1].g, colors.palette[1].b)

local iter: GhosttyRenderStateRowIterator
check(ghostty_render_state_row_iterator_new(nilptr, &iter), 'row_iterator_new')
local cells: GhosttyRenderStateRowCells
check(ghostty_render_state_row_cells_new(nilptr, &cells), 'row_cells_new')
check(ghostty_render_state_get(state, GHOSTTY_RENDER_STATE_DATA_ROW_ITERATOR, &iter), 'get row iterator')

local rows: [8]string
local y = 0
while ghostty_render_state_row_iterator_next(iter) do
  check(ghostty_render_state_row_get(iter, GHOSTTY_RENDER_STATE_ROW_DATA_CELLS, &cells), 'row cells')
  local line: string = ''
  while ghostty_render_state_row_cells_next(cells) do
    local buf: [16]uint8
    local gb: GhosttyBuffer = { ptr = &buf, cap = 16, len = 0 }
    check(ghostty_render_state_row_cells_get(cells, GHOSTTY_RENDER_STATE_ROW_CELLS_DATA_GRAPHEMES_UTF8, &gb), 'graphemes utf8')
    if gb.len == 0 then
      local grown: string = line .. '.'
      line:destroy()
      line = grown
    else
      local cell: string = string{data=(@*[0]byte)(&buf), size=gb.len}:copy()
      local grown: string = line .. cell
      cell:destroy()
      line:destroy()
      line = grown
      local style: GhosttyStyle = { size = #GhosttyStyle }
      check(ghostty_render_state_row_cells_get(cells, GHOSTTY_RENDER_STATE_ROW_CELLS_DATA_STYLE, &style), 'style')
      local fg: GhosttyColorRgb
      local has_fg = ghostty_render_state_row_cells_get(cells, GHOSTTY_RENDER_STATE_ROW_CELLS_DATA_FG_COLOR, &fg) == GHOSTTY_SUCCESS
      if y == 1 and has_fg then
        printf('  fg=%d,%d,%d bold=%s', fg.r, fg.g, fg.b, style.bold)
      elseif y == 1 and style.bold then
        print('  bold cell (default fg)')
      end
    end
  end
  rows[y] = line
  y = y + 1
end
for i = 0, y - 1 do printf('row %d: [%s]', i, rows[i]) end
assert(rows[0]:subview(1, 2) == 'Hi', 'row 0 text')
assert(rows[1]:subview(1, 3) == 'red', 'row 1 text')

local cursor: GhosttyRenderStateCursor = { size = #GhosttyRenderStateCursor }
check(ghostty_render_state_get(state, GHOSTTY_RENDER_STATE_DATA_CURSOR, &cursor), 'get cursor')
printf('cursor at %d,%d visible=%s', cursor.viewport_x, cursor.viewport_y, cursor.visible)
assert(cursor.viewport_y == 1 and cursor.viewport_x == 8)
local shown: string = replies:gsub('\27', 'ESC')
print('pty replies (DSR response):', shown)
shown:destroy()
assert(replies == "\27[2;9R", "expected cursor position report")
replies:destroy()
for i = 0, y - 1 do rows[i]:destroy() end

-- Key encoding: Enter and ctrl+c.
local enc: GhosttyKeyEncoder
check(ghostty_key_encoder_new(nilptr, &enc), 'key_encoder_new')
ghostty_key_encoder_setopt_from_terminal(enc, term)
local ev: GhosttyKeyEvent
check(ghostty_key_event_new(nilptr, &ev), 'key_event_new')
local out: [32]cchar
local outlen: usize
ghostty_key_event_set_action(ev, GHOSTTY_KEY_ACTION_PRESS)
ghostty_key_event_set_key(ev, GHOSTTY_KEY_ENTER)
check(ghostty_key_encoder_encode(enc, ev, &out, 32, &outlen), 'encode enter')
assert(outlen == 1 and out[0] == 13, 'enter encodes to CR')
ghostty_key_event_set_key(ev, GHOSTTY_KEY_C)
ghostty_key_event_set_mods(ev, GHOSTTY_MODS_CTRL)
ghostty_key_event_set_unshifted_codepoint(ev, 99)
check(ghostty_key_encoder_encode(enc, ev, &out, 32, &outlen), 'encode ctrl+c')
assert(outlen == 1 and out[0] == 3, 'ctrl+c encodes to ETX')
print('key encoder ok')

ghostty_key_event_free(ev)
ghostty_key_encoder_free(enc)
ghostty_render_state_row_cells_free(cells)
ghostty_render_state_row_iterator_free(iter)
ghostty_render_state_free(state)
ghostty_terminal_free(term)
print('OK')
