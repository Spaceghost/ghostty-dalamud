-- Exercise the exported host surface without ImGui: init loads the Lua
-- policy, status/commands work, shutdown is clean.
require 'core.host'
require 'string'
require 'io'
require 'os'
require 'arg'

local logged: integer = 0
local last_log: string
local function log_cb(level: cint, msg: cstring): void
  logged = logged + 1
  last_log:destroy()
  last_log = string.copy(msg)
  io.write('[log ', level, '] ', msg, '\n')
end
local function logged_has(sub: string): boolean return last_log:find(sub, 1, true) > 0 end
local consumed: cint = 0
local function consume_cb(vk: cint): void consumed = vk end

local api: GuHostApi = { size = #GuHostApi, log = log_cb, consume_key = consume_cb }
local dir: string = arg[1]
assert(gu_init(&api, (@cstring)(dir.data)) == 0)
assert(logged >= 2, 'init logs')
print('version:', gu_version())

local buf: [64]cchar
local n = gu_status(&buf, 64)
print('status:', (@string)((@cstring)(&buf)))
assert(n > 0)

-- No ImGui in this process: gu_frame must be a safe no-op.
gu_frame()
gu_popup_draw(nilptr, 0, 0, 10, 10, 0)

local w: cint, h: cint
gu_popup_size(&w, &h)
assert(w == 900 and h == 480)

-- Words where a number belongs are unknown commands, not a tointeger abort.
assert(gu_command('minimize') == 3)
assert(gu_command('restore all') == 3)
assert(gu_command('new tab') == 3)
assert(gu_command('window two') == 3)
assert(gu_command('send #abc hi') == 3)
assert(gu_command('new -') == 3 and gu_command('window +') == 3 and gu_command('min -') == 3)
assert(gu_command('new  1') == 3 and gu_command('focus # 1') == 3)
assert(gu_command('focus #x') == 3 and gu_command('min 1x') == 3)
assert(gu_command('focus') == 5 and gu_command('focus #99') == 5 and gu_command('send #99 hi') == 5)

-- No character (this API has no get_object): no pet or pin shell is opened.
do
  local n = #host.sessions
  assert(gu_command('pet') == 4 and #host.sessions == n, 'pet needs a player')
  assert(gu_command('pin') == 4 and #host.sessions == n, 'pin of a new shell needs a player')
end

-- A popup chip click on a minimized terminal restores it, which removes it from
-- host.minimized: the click is applied after the chip loops, not inside them.
-- This checks only the deferred-apply half (popup_request_click/popup_apply_click).
-- popup_chip and popup_body need ImGui, which the host test does not have, so
-- that the chip loop records the click instead of calling bring_forward was
-- checked by reading popup.nelua, not by this test.
assert(gu_command('new') == 0 and gu_command('new') == 0)
assert(gu_command('min') == 0 and gu_command('min') == 0)
assert(#host.minimized == 2, 'two minimized')
popup_request_click(host.minimized[0].id)
popup_apply_click()
assert(#host.minimized == 1, 'chip click restored one')
popup_apply_click() -- the click is consumed
assert(#host.minimized == 1)
local left = host.minimized[0].id
assert(gu_command('min #99') == 5)
do
  local c1 = string.format('restore #%d', left)
  assert(gu_command(c1) == 0 and #host.minimized == 0, 'restore #id')
  local c2 = string.format('min %d', left)
  assert(gu_command(c2) == 0 and #host.minimized == 1, 'min id')
  c1:destroy() c2:destroy()
end

-- The info bar entry's list (core/app/inventory.nelua): every terminal by
-- kind, in order pets, pins, windows, tabs, minimized; a pick brings that one
-- forward and closes the list.
do
  assert(inventory_world_kind('pet') == InventoryKind.Pet and inventory_world_kind('hud') == InventoryKind.Docked)
  assert(inventory_world_kind('world') == InventoryKind.Pin and inventory_world_kind('orbit') == InventoryKind.Pin
    and inventory_world_kind('follow') == InventoryKind.Pin and inventory_world_kind('') == InventoryKind.Pin)
  assert(inventory_kind_name(InventoryKind.Minimized) == 'minimized' and inventory_kind_name(InventoryKind.Pet) == 'pet')
  -- lua/world.lua names an anchor's kind for the core
  assert(luaL_loadstring(policy.L, "CONFIG.world.anchors[777] = { kind = 'pet' } CONFIG.world.anchors[778] = { kind = 'hud' }") == LUA_OK
    and lua_pcall(policy.L, 0, 0, 0) == LUA_OK)
  local k1, k2, k3 = policy_world_kind(777), policy_world_kind(778), policy_world_kind(779)
  assert(k1 == 'pet' and k2 == 'hud' and k3 == '', 'CONFIG.world.kind')
  k1:destroy() k2:destroy() k3:destroy()
  assert(luaL_loadstring(policy.L, "CONFIG.world.anchors[777] = nil CONFIG.world.anchors[778] = nil") == LUA_OK
    and lua_pcall(policy.L, 0, 0, 0) == LUA_OK)

  local rows: vector(InventoryRow)
  inventory_collect(&rows)
  local total = #host.world + #host.windows + #host.dropdown_tabs + #host.minimized
  assert(total >= 2 and #rows == total, 'every terminal listed')
  assert(rows[#rows - 1].kind == InventoryKind.Minimized and rows[#rows - 1].s.id == left, 'minimized last')
  local tabs = 0
  for i = 0, < #rows do
    if rows[i].kind == InventoryKind.Tab then
      assert(i == 0 or rows[i - 1].kind ~= InventoryKind.Minimized, 'tabs before minimized')
      tabs = tabs + 1
    end
  end
  assert(tabs == #host.dropdown_tabs)
  rows:destroy()

  inventory_toggle(5, 6)
  assert(surface.list_open and surface.list_x == 5 and surface.list_y == 6 and surface.list_frames == 0)
  inventory_pick(left)
  assert(inventory_apply_pick() and not surface.list_open and #host.minimized == 0, 'a pick restores it and closes the list')
  assert(not inventory_apply_pick(), 'the pick is consumed')
  inventory_toggle(0, 0)
  inventory_pick(99999)
  assert(not inventory_apply_pick() and surface.list_open, 'a vanished terminal: nothing happens')
  inventory_toggle(0, 0)
  assert(not surface.list_open, 'a second click closes it')
  assert(inventory_height(3, 1000) == 34 + 3 * 28 + 8 and inventory_height(0, 1000) == 34 + 28 + 8)
  assert(inventory_height(100, 300) == 300, 'at most the given height')
  local c = string.format('min %d', left)
  assert(gu_command(c) == 0 and #host.minimized == 1)
  c:destroy()
end

-- /term reload detaches agent shells instead of closing them (even when the new
-- config fails to load), lets go of the full-screen panel, drag, camera, walk
-- and animation, and saves the layout only when LISTR has restored it.
local state_file = string.format('%s/world-state.lua', dir)
local function state_saved(): boolean
  local f = io.open(state_file)
  local found = f:isopen()
  f:destroy() -- close() alone keeps the stream's own allocation
  return found
end
do
  local s = host.sessions[0]
  s.awaiting_open = false -- as if the agent had OPENED it
  s.agent_id = 4242
  host.local_agent.client.state = AgentState.Ready -- frames are only queued on a live connection
  host.world_full_id, host.drag.id, host.cam_saved_d = s.id, s.id, 3
  host.walk.id, host.anim_out = s.id, true
  host.layout_restored = false -- no LISTR yet: what is on screen is not the saved layout
  os.remove(state_file)
  local good_dir, good_install = host.dir, boot.install_dir
  host.dir = string.copy('build/test-scratch/no-such-config')
  boot.install_dir = string.copy('build/test-scratch/no-such-config')
  local before = host.local_agent.client.outq:len()
  assert(gu_command('reload') == 2, 'reload without lua/init.lua fails')
  local detached, closed = 0, 0
  local p = host.local_agent.client.outq:peek()
  local pos: usize = before
  while pos + 9 <= host.local_agent.client.outq:len() do
    local typ = p[pos]
    local len = proto.get_u32((@*[0]uint8)(&p[pos + 1]))
    if len == 4 and proto.get_u32((@*[0]uint8)(&p[pos + 5])) == 4242 then
      if typ == PROTO_DETACH then detached = detached + 1 end
      if typ == PROTO_CLOSE then closed = closed + 1 end
    end
    pos = pos + 5 + len
  end
  assert(detached == 1 and closed == 0, 'reload detaches')
  assert(#host.sessions == 0 and #host.minimized == 0)
  assert(host.world_full_id == 0 and host.drag.id == 0 and host.cam_restore, 'full screen, drag and camera released')
  assert(host.walk.id == 0 and not host.anim_out, 'walk and animation released')
  assert(not state_saved(), 'reload before LISTR saves no layout')
  host.local_agent.client.state = AgentState.Disconnected -- nothing behind it
  host.dir:destroy() boot.install_dir:destroy()
  host.dir, boot.install_dir = good_dir, good_install
end
-- Once LISTR restored the layout, reload saves it first. Even when the new
-- config fails to load, the (now empty) layout waits for the next LISTR: the
-- periodic save must not write it over the saved one.
assert(gu_command('reload') == 0, 'reload')
do
  assert(gu_command('new') == 0 and #host.sessions == 1)
  local s = host.sessions[0]
  s.awaiting_open = false
  s.agent_id = 4243
  host.local_agent.client.state = AgentState.Ready
  host.layout_restored = true
  local good_dir, good_install = host.dir, boot.install_dir
  host.dir = string.copy('build/test-scratch/no-such-config')
  boot.install_dir = string.copy('build/test-scratch/no-such-config')
  assert(gu_command('reload') == 2, 'failed reload after LISTR')
  assert(state_saved(), 'reload after LISTR saves the layout')
  assert(not host.layout_restored, 'the layout waits for the next LISTR')
  host.local_agent.client.state = AgentState.Disconnected
  host.dir:destroy() boot.install_dir:destroy()
  host.dir, boot.install_dir = good_dir, good_install
  os.remove(state_file)
end
state_file:destroy()
assert(gu_command('reload') == 0, 'reload after a failed one')
assert(gu_command('bogus') == 3)

-- The controller toggle's source: toggle_gamepad_button = 'create' reads the
-- DualSense over HID (fake devices on the host), any other button goes
-- through the shim and lets go of the controller, shutdown closes it.
local pad_bits: cint = 0
local function fake_gamepad_down(mask: cint): cint return (pad_bits & mask) ~= 0 and 1 or 0 end
local in_front = true
local function fake_foreground(): boolean return in_front end
do
  assert(policy.toggle_gamepad_mask == 0x4000 and not policy.toggle_gamepad_hid, 'shipped default: select')
  assert(game_foreground(), 'no foreground check off Windows')
  local have, down, pressed = poll_toggle_pad(1.0, fake_foreground)
  assert(not have and not down and not pressed, 'no gamepad callbacks: nothing')
  host.api.gamepad_down = fake_gamepad_down
  pad_bits = 0x4000
  have, down = poll_toggle_pad(1.02, fake_foreground)
  assert(have and down and hid_fake.scans == 0, 'select comes from the shim; no HID scan')

  hid_fake.devices[0] = { vid = 0x054C, pid = 0x0CE6, usage_page = 1, usage = 5, input_len = 64 }
  hid_fake.count = 1
  policy.toggle_gamepad_hid, policy.toggle_gamepad_mask = true, 0 -- what 'create' loads to (test_policy)
  have, down = poll_toggle_pad(1.04, fake_foreground)
  assert(have and not down and hid_is_open(&host.dualsense.dev) and hid_fake.watching, 'create: the DualSense opens; the shim is not asked')
  local report: [64]uint8
  report[0], report[9] = 0x01, 0x10
  local idle: [64]uint8
  idle[0] = 0x01
  hid_fake_push(&report, 64)
  have, down = poll_toggle_pad(1.06, fake_foreground)
  assert(have and down, 'Create held')

  -- The controller is read whichever window is in front, and Create captures
  -- screenshots elsewhere: its reports are drained there but never count.
  in_front = false
  have, down = poll_toggle_pad(1.07, fake_foreground)
  assert(have and not down, 'held while another window comes to the front: let go')
  hid_fake_push(&idle, 64)
  hid_fake_push(&report, 64)
  hid_fake_push(&idle, 64)
  have, down = poll_toggle_pad(1.08, fake_foreground)
  assert(have and not down and hid_fake.head == hid_fake.tail, 'a tap in another window: drained, ignored')
  in_front = true
  have, down = poll_toggle_pad(1.09, fake_foreground)
  assert(have and not down, 'and nothing of it left when the game comes back to the front')
  hid_fake_push(&report, 64)
  have, down = poll_toggle_pad(1.10, fake_foreground)
  assert(have and down, 'Create in front counts again')

  policy.toggle_gamepad_hid, policy.toggle_gamepad_mask = false, 0x4000
  have, down = poll_toggle_pad(1.12, fake_foreground)
  assert(have and down and not hid_is_open(&host.dualsense.dev) and hid_fake.closes == 1 and not hid_fake.watching, 'back to select: the controller is let go')
  policy.toggle_gamepad_hid, policy.toggle_gamepad_mask = true, 0
  pad_bits = 0
  have, down = poll_toggle_pad(1.14, fake_foreground)
  assert(have and not down and hid_is_open(&host.dualsense.dev), 'create again')
  -- ps: the PS button instead of Create, from the same reports
  policy.toggle_gamepad_ps = true
  local ps_report: [64]uint8
  ps_report[0] = 0x01
  ps_report[8] = 0x08
  ps_report[10] = 0x01 -- PS
  hid_fake_push(&ps_report, 64)
  have, down = poll_toggle_pad(1.16, fake_foreground)
  assert(have and down, 'ps: the PS button toggles')
  local create_only: [64]uint8
  create_only[0] = 0x01
  create_only[8] = 0x08
  create_only[9] = 0x10 -- Create
  hid_fake_push(&create_only, 64)
  have, down = poll_toggle_pad(1.18, fake_foreground)
  assert(have and not down, 'ps: Create does not')
  policy.toggle_gamepad_ps = false
  host.api.gamepad_down = nilptr
end

-- Voice input's job (core/app/voice.nelua): its JOPENED, stdout and stderr,
-- and at its exit the text pasted into the terminal it began in.
local pasted: string
local pasted_into: integer = 0
local function fake_paste(s: *Session, text: string): void
  pasted:destroy()
  pasted = text:copy()
  pasted_into = s.id
end
do
  local s = session_new(0, 80, 24)
  assert(s ~= nilptr)
  host.voice_on, host.voice_req, host.voice_target = true, 77, s.id
  assert(not voice_on_opened(78, 5, ''), 'another JOPEN is not ours')
  assert(voice_on_opened(77, 5, '') and host.voice_jid == 5, 'ours: its job')
  assert(not voice_on_out(6, JOB_OUT, nilptr, 0), 'another job is not ours')
  local said: string = '  hello there\n'
  local more: string = 'general kenobi\n'
  local noise: string = 'ghostty-voice: listening on dualsense\n'
  assert(voice_on_out(5, JOB_ERR, (@*[0]uint8)(noise.data), #noise))
  assert(voice_on_out(5, JOB_OUT, (@*[0]uint8)(said.data), #said))
  assert(voice_on_out(5, JOB_OUT, (@*[0]uint8)(more.data), #more))
  assert(voice_on_exit(5, 0, fake_paste) and not host.voice_on, 'done')
  assert(pasted == 'hello there general kenobi' and pasted_into == s.id, 'stdout only, on one line, into the terminal it began in')
  -- a failure pastes nothing and says why
  pasted:destroy() pasted = ''
  host.voice_on, host.voice_req, host.voice_target = true, 78, s.id
  assert(voice_on_opened(78, 6, ''))
  local why: string = 'ghostty-voice: no speech to text\n'
  assert(voice_on_out(6, JOB_ERR, (@*[0]uint8)(why.data), #why))
  assert(voice_on_exit(6, 3, fake_paste) and #pasted == 0 and logged_has('no speech to text'), 'a failure: nothing typed, the reason logged')
  assert(host.voice_note:view() == 'Voice input: no speech to text', 'and shown: the script\'s last word, not its name')
  -- refused by the agent: over at once
  host.voice_on, host.voice_req = true, 79
  assert(voice_on_opened(79, 0, 'no such command') and not host.voice_on)
  -- no agent: voice_toggle says so and starts nothing
  voice_toggle()
  assert(not host.voice_on, 'no agent: nothing starts')
  pasted:destroy()
  session_remove(s)
  print('voice OK')
end
gu_toggle()
gu_shutdown()
assert(hid_fake.closes == 2 and not hid_is_open(&host.dualsense.dev) and not hid_fake.watching, 'shutdown closes the controller and its arrival watch')
print('OK')
