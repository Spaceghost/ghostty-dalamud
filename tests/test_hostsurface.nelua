-- The standalone plugin's side of the core against a recording fake GuHostApi:
-- exports before init, refusals (legacy core, busy mutex) and their retries,
-- the single-init guard, registration and shutdown order, suspension while
-- the legacy core is loaded, the event queue, info bar visibility and failed
-- command retries, and links handed to the browser (ghostty.open_url) with an
-- older, smaller GuHostApi.
require 'core.host'
require 'string'
require 'stringbuilder'
require 'vector'
require 'arg'
require 'io'

local root: string = arg[1]
local scratch: string = arg[2]
local config = scratch .. '/config'

local calls: vector(string)
local fail_command: string       -- command_add refuses this name
local umbra_loaded: cint = 0
local dtr_last_text: string
local dtr_last_title: string

local function rec(what: string, arg1: cstring): void
  local sb: stringbuilder
  sb:write(what)
  if arg1 ~= nilptr then sb:write(' ', arg1) end
  calls:push(sb:promote())
end

local function reset_calls(): void
  for i = 0, < #calls do calls[i]:destroy() end
  calls:clear()
end

local function joined(): string
  local sb: stringbuilder
  for i = 0, < #calls do
    if i > 0 then sb:write('|') end
    sb:write(calls[i])
  end
  return sb:promote()
end

local function expect(want: string, why: string): void
  local got = joined()
  if got ~= want then
    io.stderr:write('expected: ', want, '\n     got: ', got, '\n')
    assert(false, why)
  end
  got:destroy()
  reset_calls()
end

local vote_logs: integer = 0 -- lua/vote.lua saying it cannot open the page
local warned: string -- the last warning
local function quiet(level: cint, msg: cstring): void
  if (@string)(msg):find('vote:', 1, true) > 0 then vote_logs = vote_logs + 1 end
  if level == LOG_WARN and (@string)(msg):find('cimgui', 1, true) == 0 then warned:destroy() warned = string.copy(msg) end
end
local open_ok: cint = 1
local function open_url(url: cstring): cint
  rec('open_url', url)
  return open_ok
end
local function consume(vk: cint): void end
local function command_add(name: cstring, help: cstring): cint
  assert(help ~= nilptr and #(@string)(help) > 0, 'help text')
  rec('add', name)
  return (@string)(name) == fail_command and 0 or 1
end
local function command_remove(name: cstring): cint rec('remove', name) return 1 end
local function dtr_set(title: cstring, text: cstring, tooltip: cstring, shown: cint): cint
  rec(shown ~= 0 and 'dtr shown' or 'dtr hidden', nilptr)
  dtr_last_text:destroy() dtr_last_text = string.copy(text)
  dtr_last_title:destroy() dtr_last_title = string.copy(title)
  return 1
end
local function dtr_remove(): void rec('dtr_remove', nilptr) end
local function set_ui_hide(mask: cint): void
  local sb: stringbuilder
  sb:writef('ui_hide %d', mask)
  calls:push(sb:promote())
end
local function plugin_loaded(name: cstring): cint
  assert((@string)(name) == 'Umbra')
  return umbra_loaded
end
local function ipc_register(): cint rec('ipc_register', nilptr) return 1 end
local function ipc_unregister(): void rec('ipc_unregister', nilptr) end

local api: GuHostApi = {
  size = #GuHostApi, log = quiet, consume_key = consume,
  command_add = command_add, command_remove = command_remove,
  dtr_set = dtr_set, dtr_remove = dtr_remove, set_ui_hide = set_ui_hide,
  plugin_loaded = plugin_loaded, ipc_register = ipc_register, ipc_unregister = ipc_unregister,
  open_url = open_url,
}
local info: GuInitInfo = {
  size = #GuInitInfo, host_kind = HOST_KIND_DALAMUD,
  install_dir = (@cstring)(root.data), config_dir = (@cstring)(config.data), configs_root = (@cstring)(scratch.data),
}

local REGISTERED <comptime> = 'ipc_register|add /term|add /tomestone|add /tome|ui_hide 14|dtr shown'
local UNREGISTERED <comptime> = 'ipc_unregister|remove /term|remove /tomestone|remove /tome|dtr_remove'

local function advance(ms: uint64): void procguard_fake.now_ms = procguard_fake.now_ms + ms end
local function status(): string
  local buf: [64]cchar
  local n = gu_status(&buf, 64)
  return string.copy(string{data=(@*[0]byte)(&buf), size=n})
end
local function lua(code: cstring): void
  assert(luaL_loadstring(policy.L, code) == LUA_OK and lua_pcall(policy.L, 0, 0, 0) == LUA_OK, code)
end

-- Every export is a safe no-op before init ------------------------------------------
do
  local s = status()
  assert(s == 'ghostty off', 'status before init')
  local w: cint, h: cint = 0, 0
  gu_popup_size(&w, &h)
  assert(w == 900 and h == 480, 'popup size defaults')
  gu_frame()
  gu_toggle()
  gu_popup_draw(nilptr, 0, 0, 10, 10, 0)
  gu_popup_reset()
  assert(gu_command('toggle') == 1)
  gu_event(GuEventKind.OpenConfig, 0, 0, 0, 0, nilptr)
  gu_shutdown()
  assert(#calls == 0 and not host.initialized and boot.state == HostState.Inactive)
  surface.widget_seen = false
end

-- Legacy core loaded: refused without registering anything, retried from gu_frame ----
do
  procguard_fake.legacy_loaded = true
  assert(gu_init_ex(&api, &info) == INIT_LEGACY)
  assert(boot.state == HostState.Pending and not host.initialized and #calls == 0, 'no callbacks while refused')
  advance(1000) gu_frame()
  advance(1000) gu_frame()
  assert(boot.state == HostState.Pending and #calls == 0, 'still refused while the legacy core is there')
  procguard_fake.legacy_loaded = false
  advance(1000) gu_frame()
  assert(boot.state == HostState.Pending, 'retries every 2 s, not every frame')
  advance(1000) gu_frame()
  assert(boot.state == HostState.Active and host.initialized, 'activated by the frame retry')
  expect(REGISTERED, 'registration order')
  assert(dtr_last_title == 'Ghostty' and #dtr_last_text > 0)
  assert(procguard_fake.acquired, 'holds the process mutex')

  -- the Lua side sees two homes and the host
  lua([[assert(GHOSTTY_PLUGIN_DIR == GHOSTTY_CONFIG_DIR and GHOSTTY_HOST == 'dalamud')
    local i = ghostty.host_info()
    assert(i.state == 'active' and i.host == 'dalamud' and i.commands['/term'] == true and i.dtr_shown)]])
  local pd: string = host.dir
  assert(pd == config, 'config dir')
end

-- Single-init guard: a second init changes nothing ------------------------------------
do
  local other: GuInitInfo = info
  other.config_dir = '/nonexistent'
  assert(gu_init_ex(&api, &other) == INIT_BUSY)
  assert(boot.state == HostState.Active and host.dir == config and #calls == 0)
end

-- The event queue ------------------------------------------------------------------------
do
  gu_event(GuEventKind.Chat, 0, 0, 0, 0, 'config')
  assert(not host.settings_open, 'handled on the next frame, not the caller thread')
  gu_frame()
  assert(host.settings_open, 'chat command ran')
  gu_event(GuEventKind.Chat, 0, 0, 0, 0, 'config')
  gu_event(GuEventKind.OpenConfig, 0, 0, 0, 0, nilptr)
  gu_frame()
  assert(host.settings_open, 'in order: closed by the command, reopened by /xlplugins Settings')

  -- info bar clicks go through CONFIG.host.dtr.on_click
  assert(not host.dropdown_open and not surface.popup_open)
  gu_event(GuEventKind.DtrClick, 0, 0, 100, 20, nilptr) -- left
  gu_event(GuEventKind.DtrClick, 1, 0, 100, 20, nilptr) -- right
  gu_frame()
  assert(host.dropdown_open and surface.popup_open and surface.last_action == 'popup')
  assert(surface.popup_x == 100 and surface.popup_y == 20, 'popup anchored at the click')
  local a = surface_click_action(0, 4) assert(a == 'window', 'shift+click') a:destroy()
  a = surface_click_action(0, 1) assert(a == 'world', 'ctrl+click') a:destroy()
  lua("CONFIG.host.dtr.on_click = function(button, mods) return button == 'left' and mods.alt and 'settings' or 'none' end")
  gu_event(GuEventKind.DtrClick, 0, 2, 0, 0, nilptr) -- alt+left
  gu_event(GuEventKind.DtrClick, 1, 0, 0, 0, nilptr)
  gu_frame()
  assert(not host.settings_open and surface.last_action == 'none', 'user policy decides')
  -- an init.lua from before CONFIG.host: the documented defaults
  lua('CONFIG.host = nil')
  a = surface_click_action(1, 0) assert(a == 'popup') a:destroy()
  a = surface_click_action(0, 4) assert(a == 'window') a:destroy()
  a = surface_click_action(0, 0) assert(a == 'toggle') a:destroy()
  assert(gu_command('reload') == 0) -- CONFIG.host back
  reset_calls()

  -- overflow: 32 queued, the rest dropped and counted
  umbra_loaded = 1
  for i = 1, 40 do gu_event(GuEventKind.PluginsChanged, 0, 0, 0, 0, nilptr) end
  assert(surface.events_dropped == 8, 'dropped count')
  gu_frame()
  assert(surface.umbra_loaded, 'plugins changed -> Umbra looked up')
  lua("assert(ghostty.host_info().umbra and ghostty.host_info().events_dropped == 8)")
  expect('', 'no host calls for queue handling')
end

-- Info bar entry: hidden while the Umbra widget polls, back 5 s after it stops --------------
do
  advance(2000) gu_frame() reset_calls()
  gu_frame() gu_frame()
  expect('', 'pushed only on change')
  local s = status() s:destroy() -- the widget polls
  gu_frame()
  expect('dtr hidden', 'auto mode steps aside for the widget')
  for i = 1, 4 do
    advance(1000)
    s = status() s:destroy()
    gu_frame()
  end
  expect('', 'still polled: stays hidden')
  advance(4000) gu_frame()
  expect('', 'within 5 s of the last poll')
  advance(1000) gu_frame()
  expect('dtr shown', 'widget gone for 5 s')
  host.status:destroy()
  host.status = string.copy('ghostty 3')
  gu_frame()
  expect('dtr shown', 'text change pushed')
  assert(dtr_last_text == 'ghostty 3')
  lua("CONFIG.host.dtr.mode = 'never'")
  gu_frame()
  expect('', 'config re-read on the guard period')
  advance(2000) gu_frame()
  expect('dtr hidden', 'never')
  lua("CONFIG.host.dtr.mode = 'auto'; CONFIG.host.keep_visible.gpose = false")
  advance(2000) gu_frame()
  expect('ui_hide 6|dtr shown', 'keep_visible and mode re-read')
end

-- Suspended while the legacy core is loaded ------------------------------------------------
do
  host.settings_open = false
  procguard_fake.legacy_loaded = true
  advance(2000) gu_frame()
  assert(boot.state == HostState.Suspended and host.initialized, 'suspended, sessions kept')
  expect('dtr shown', 'info bar says why')
  assert(dtr_last_text == 'ghostty: legacy core loaded')
  gu_event(GuEventKind.OpenConfig, 0, 0, 0, 0, nilptr)
  gu_frame()
  assert(not host.settings_open, 'UI events ignored while suspended')
  gu_event(GuEventKind.Chat, 0, 0, 0, 0, 'config')
  gu_frame()
  assert(host.settings_open, 'chat commands still run')
  lua("assert(ghostty.host_info().state == 'suspended')")
  procguard_fake.legacy_loaded = false
  advance(2000) gu_frame()
  assert(boot.state == HostState.Active, 'resumed')
  expect('dtr shown', 'status text back')
end

-- Links: only https, forwarded to the host; the vote page through lua/vote.lua ---------------------
do
  assert(url_is_https('https://spacegho.st/mods/ffxiv/term/vote/') and url_is_https('HTTPS://example.org') and url_is_https('https://a'))
  assert(not url_is_https('http://example.org'), 'plain http')
  assert(not url_is_https('https://') and not url_is_https('https:///etc/passwd'), 'no host')
  assert(not url_is_https('file:///C:/Windows/System32/calc.exe') and not url_is_https('javascript:alert(1)'), 'other schemes')
  assert(not url_is_https('') and not url_is_https('https:') and not url_is_https(' https://example.org'), 'nothing before the scheme')
  assert(not url_is_https('https://example.org/a b') and not url_is_https('https://example.org/\n'), 'whitespace')
  assert(not url_is_https('https://example.org/"x') and not url_is_https('https://example.org\\x'), 'quotes, backslashes')
  local nul: string = 'https://example.org\0.exe'
  assert(#nul == 24 and not url_is_https(nul), 'an embedded NUL')
  local sb: stringbuilder
  sb:write('https://example.org/')
  for i = #'https://example.org/', < URL_MAX do sb:write('a') end
  local long = sb:promote()
  assert(#long == URL_MAX and url_is_https(long), 'up to URL_MAX bytes')
  long = long .. 'a'
  assert(not url_is_https(long), 'not past it')

  reset_calls()
  lua([[assert(ghostty.open_url('https://example.org/vote/') == true)]])
  expect('open_url https://example.org/vote/', 'forwarded as given')
  lua([[local ok, why = ghostty.open_url('file:///etc/passwd') assert(ok == false and why:find('https'))
    assert(ghostty.open_url(nil) == false and ghostty.open_url({}) == false)]])
  expect('', 'refused links never reach the host')
  open_ok = 0
  lua([[local ok, why = ghostty.open_url('https://example.org/') assert(ok == false and why:find('could not'))]])
  expect('open_url https://example.org/', 'a host failure is reported back')
  open_ok = 1

  -- the settings window's button: the page opens, the badge goes
  lua("CONFIG.settings.values['vote.seen_version'] = nil") -- never opened
  settings_badge_refresh()
  assert(host.settings_badge, 'unseen ideas: the settings button wears its dot')
  lua([[local S, vote = CONFIG.settings, require('vote')
    assert(S.badge() and vote.open(S) and not S.badge())]])
  expect('open_url https://spacegho.st/mods/ffxiv/term/vote/', 'the vote page')
  settings_badge_refresh()
  assert(not host.settings_badge and vote_logs == 0)
end

-- Shutdown unregisters before the callbacks are forgotten ----------------------------------------
do
  gu_shutdown()
  expect(UNREGISTERED, 'shutdown order')
  assert(not host.initialized and boot.state == HostState.Inactive and host.api.log == nilptr)
  assert(not procguard_fake.acquired, 'mutex released')
  gu_event(GuEventKind.OpenConfig, 0, 0, 0, 0, nilptr) -- nobody is listening any more
  gu_frame()
  assert(#calls == 0)
end

-- Busy mutex, then init -> shutdown -> init again ------------------------------------------------
do
  procguard_fake.mutex_held = true
  assert(gu_init_ex(&api, &info) == INIT_BUSY and boot.state == HostState.Pending and #calls == 0)
  procguard_fake.mutex_held = false
  advance(2000) gu_frame()
  assert(boot.state == HostState.Active)
  expect(REGISTERED, 'second activation registers again')
  host.settings_open = false
  gu_event(GuEventKind.OpenConfig, 0, 0, 0, 0, nilptr)
  gu_frame()
  assert(host.settings_open, 'no stale events from the previous run; new ones work')
  gu_shutdown()
  expect(UNREGISTERED, 'second shutdown')
end

-- A command another plugin holds is retried every 5 s --------------------------------------------
do
  fail_command = '/tome'
  assert(gu_init_ex(&api, &info) == INIT_OK)
  expect(REGISTERED, 'first attempt includes the taken name')
  lua("assert(ghostty.host_info().commands['/tome'] == false)")
  advance(4000) gu_frame()
  expect('', 'not before 5 s')
  fail_command = ''
  advance(1000) gu_frame()
  expect('add /tome', 'retried')
  advance(5000) gu_frame()
  expect('', 'registered names are not added again')
  gu_shutdown()
  expect(UNREGISTERED, 'all three removed')
end

-- A shim from before open_url: its smaller GuHostApi leaves ghostty.open_url nil --------------------
do
  local old: GuHostApi = api
  old.size = (@usize)(&old.open_url) - (@usize)(&old) -- ends before open_url; fields past it are never read
  assert(gu_init_ex(&old, &info) == INIT_OK)
  expect(REGISTERED, 'an older shim registers the same')
  assert(host.api.open_url == nilptr, 'nothing copied past size')
  lua([[assert(ghostty.open_url == nil and ghostty.host_info)
    local S, vote = CONFIG.settings, require('vote')
    S.values[vote.KEY] = nil
    assert(vote.open(S) == false and not S.badge(), 'the button logs the link and clears the badge')]])
  expect('', 'nothing opened')
  assert(vote_logs == 1, 'logged once, with the link')
  gu_shutdown()
  expect(UNREGISTERED, 'shutdown')
end

-- Commands of their own: /window, /ask, /agent (CONFIG.host.verb_commands) -----------------------
-- A shim with command_add_tagged registers each with its tag; its handler
-- posts Chat with `a` = tag. The older shim above logged them once instead.
local tagged: [8]string
local tag_help: [8]string
local function command_add_tagged(name: cstring, help: cstring, tag: cint): cint
  assert(tag >= 1 and tag <= 8)
  tagged[tag - 1]:destroy() tagged[tag - 1] = string.copy(name)
  tag_help[tag - 1]:destroy() tag_help[tag - 1] = string.copy(help)
  rec('tagged', name)
  return 1
end
local function tag_of(name: string): cint
  for i = 0, < 8 do if tagged[i] == name then return i + 1 end end
  return 0
end
do
  local newer: GuHostApi = api
  newer.command_add_tagged = command_add_tagged
  assert(gu_init_ex(&newer, &info) == INIT_OK)
  local got = joined()
  ## for _, want in ipairs{'add /term', 'add /tomestone', 'add /tome', 'tagged /window', 'tagged /ask', 'tagged /agent'} do
    assert(got:find(#[want]#, 1, true) > 0, #[want]#)
  ## end
  got:destroy()
  reset_calls()
  local w, a, g = tag_of('/window'), tag_of('/ask'), tag_of('/agent')
  assert(w > 0 and a > 0 and g > 0 and w ~= a and a ~= g, 'distinct tags')
  assert(tag_help[w - 1]:find('pull [match|#wid] | run CMD', 1, true) > 0, 'help from lua/tooltips.lua')
  lua("assert(ghostty.host_info().commands['/window'] == true)")
  gu_event(GuEventKind.Chat, w, 0, 0, 0, 'desktop')
  gu_frame()
  assert(warned:find('window desktop: not available yet', 1, true) > 0, warned)
  gu_event(GuEventKind.Chat, w, 0, 0, 0, '')
  gu_frame()
  assert(warned:find('usage: /window pull', 1, true) == 1, warned)
  gu_event(GuEventKind.Chat, w, 0, 0, 0, 'run')
  gu_frame()
  assert(warned:find('usage: /window run', 1, true) == 1, warned)
  gu_event(GuEventKind.Chat, w, 0, 0, 0, 'pull Firefox')
  gu_frame()
  assert(warned:find('window pull: ', 1, true) == 1, 'the same path as /term window pull: ' .. warned)
  gu_event(GuEventKind.Chat, g, 0, 0, 0, 'status')
  gu_frame()
  assert(warned == 'usage: /agent ask [question]', warned)
  gu_event(GuEventKind.Chat, 0, 0, 0, 0, 'config')
  host.settings_open = false
  gu_frame()
  assert(host.settings_open, 'tag 0 is still a /term line')
  gu_shutdown()
  got = joined()
  ## for _, want in ipairs{'remove /term', 'remove /window', 'remove /ask', 'remove /agent'} do
    assert(got:find(#[want]#, 1, true) > 0, #[want]#)
  ## end
  got:destroy()
  reset_calls()
  for i = 0, < 8 do tagged[i]:destroy() tag_help[i]:destroy() end
end

-- gu_init (tests, plain embedding) without the surface callbacks registers nothing ----------------
do
  local plain: GuHostApi = { size = #GuHostApi, log = quiet }
  assert(gu_init(&plain, (@cstring)(config.data)) == INIT_OK)
  assert(boot.state == HostState.Active and #calls == 0)
  local w: cint, h: cint = 0, 0
  gu_popup_size(&w, &h)
  assert(w == 900 and h == 480)
  gu_shutdown()
end

print('OK')
