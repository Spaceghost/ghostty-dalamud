require 'core.mouse'
require 'core.termview'
require 'string'

local state: MouseReportState
local view: TermView
assert(view:init(100, 24))
local modes = '\27[?1002h\27[?1006h' -- Neovim: button-motion tracking, SGR coordinates
view:feed((@*[0]uint8)(modes.data), modes.size)
assert(view:mouse_tracking())
local out: [32]byte
local function report(batch: MouseReportBatch, col: integer, row: integer): string
  assert(batch.count == 1)
  local event = batch.events[0]
  local n = view:mouse_bytes(event.button, event.action, col, row, 0, &out)
  return string{data=(@*[0]byte)(&out), size=(@usize)(n)}
end

-- A tabline button needs both events, even when the cell never changes.
assert(report(mouse_report_frame(&state, 40, 0, true, 1, 1, true), 40, 0) == '\27[<0;41;1M')
assert(mouse_report_frame(&state, 40, 0, true, 0, 1, true).count == 0)
assert(report(mouse_report_frame(&state, 40, 0, true, 0, 0, true), 40, 0) == '\27[<0;41;1m')
assert(state.buttons == 0)

-- Drag ownership survives leaving the grid or another window covering it.
mouse_report_frame(&state, 3, 2, true, 1, 1, true)
assert(report(mouse_report_frame(&state, 9, 4, false, 0, 1, true), 9, 4) == '\27[<32;10;5M')
assert(report(mouse_report_frame(&state, 99, 23, false, 0, 0, true), 99, 23) == '\27[<0;100;24m')
-- Clicking elsewhere never manufactures a press/drag/release in this session.
assert(mouse_report_frame(&state, 3, 2, false, 1, 1, true).count == 0)
local hover = mouse_report_frame(&state, 3, 2, true, 0, 1, true)
assert(hover.events[0].button == 3)
assert(view:mouse_bytes(3, 2, 3, 2, 0, &out) == 0)

-- Right/middle clicks, and simultaneous ownership, retain their button identity.
for button = 1, < 3 do
  local bit = 1 << button
  local press = mouse_report_frame(&state, 4, 5, true, bit, bit, true)
  assert(press.count == 1 and press.events[0].button == button and press.events[0].action == 0)
  local release = mouse_report_frame(&state, 4, 5, false, 0, 0, true)
  assert(release.count == 1 and release.events[0].button == button and release.events[0].action == 1)
end
assert(mouse_report_frame(&state, 0, 0, true, 7, 7, true).count == 3)
assert(mouse_report_frame(&state, 0, 0, false, 0, 0, true).count == 3)

-- Shift-selection and disabled mouse modes report nothing. If Shift changes
-- during an application drag, release the application's owned button once.
assert(mouse_report_frame(&state, 1, 1, true, 1, 1, false).count == 0)
mouse_report_frame(&state, 1, 1, true, 1, 1, true)
assert(report(mouse_report_frame(&state, 1, 1, true, 0, 1, false), 1, 1) == '\27[<0;2;2m')
assert(mouse_report_frame(&state, 1, 1, true, 0, 0, false).count == 0)
view:destroy()
print('mouse reports: tabline press/release, drag ownership, buttons and selection OK')
