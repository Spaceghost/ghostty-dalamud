-- Real private bus: both orderly shutdown and a helper killed before it can clean up.
require 'agent.notification_process'
require 'arg'
## cemitdecl "\n#include <stdio.h>\n#include <string.h>\n#include <sys/prctl.h>\nstatic void notification_test_reaper(void) { prctl(PR_SET_CHILD_SUBREAPER,1,0,0,0); }\nstatic void notification_test_reap(int pid) { waitpid(pid,NULL,WNOHANG); }\nstatic int notification_test_child(int pid) {\n char path[128];snprintf(path,sizeof(path),\"/proc/%d/task/%d/children\",pid,pid);\n FILE *f=fopen(path,\"r\");if(!f)return -1;int child=-1;fscanf(f,\"%d\",&child);fclose(f);return child;\n}\nstatic int notification_test_alive(int pid) {\n char path[128],line[1024];snprintf(path,sizeof(path),\"/proc/%d/stat\",pid);\n FILE *f=fopen(path,\"r\");if(!f)return 0;char *s=fgets(line,sizeof(line),f);fclose(f);\n if(!s)return 0;char *end=strrchr(line,')');return end&&end[2]!='Z';\n}"
local function notification_test_reaper(): void <cimport, nodecl> end
local function notification_test_reap(pid: cint): void <cimport, nodecl> end
local function notification_test_child(pid: cint): cint <cimport, nodecl> end
local function notification_test_alive(pid: cint): cint <cimport, nodecl> end
local function kill(pid: cint, sig: cint): cint <cimport, nodecl> end
local function usleep(usec: cuint): cint <cimport, nodecl> end

assert(#arg >= 1)
-- The fixture reaps a crashed helper's orphan so container PID 1 need not do so.
notification_test_reaper()
for mode=1,2 do
  local process: NotificationProcess
  assert(process:open(arg[1]))
  for i=1,5000 do
    process:pump()
    if #process.address > 0 or process.ended then break end
    usleep(1000)
  end
  assert(#process.address > 0 and not process.ended)
  local child = notification_test_child(process.pid)
  assert(child > 0 and notification_test_alive(child) == 1)
  if mode == 2 then
    assert(kill(process.pid, 9) == 0)
    for i=1,5000 do
      process:pump()
      if process.ended then break end
      usleep(1000)
    end
    assert(process.ended)
  end
  process:close()
  assert(not process.active and #process.address == 0 and #process.events == 0)
  for i=1,1000 do
    if notification_test_alive(child) == 0 then break end
    usleep(1000)
  end
  assert(notification_test_alive(child) == 0)
  notification_test_reap(child)
end
print('notification process normal/crashed helper bus cleanup OK')
