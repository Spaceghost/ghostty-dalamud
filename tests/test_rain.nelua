-- Rain on world panels: the seeded simulation (determinism, drop counts, the
-- wiper's sweep and what it clears, the fade), lua/rain.lua (weather, force,
-- HUD panels), and the two drawing passes through a fake ImGui.
require 'core.policy'
require 'core.rain'
require 'core.app.rain'
require 'math'
require 'arg'

local function near(a: float64, b: float64, eps: float64): boolean return math.abs(a - b) < eps end

local function params(intensity: float32, wiper: RainWiper): RainParams
  return RainParams{
    intensity = intensity, max_drops = 90, size_min = 2.5, size_max = 7, trickle_speed = 70,
    period_light = 12, period_heavy = 6, continuous_at = 0.85, wiper = wiper, opacity = 0.85, fade = 3,
  }
end

local W: float32, H: float32 = 800, 500

-- The same seed and steps give the same drops; another seed does not.
do
  local prm = params(0.8, RainWiper.Back)
  local a: RainPanel, b: RainPanel, c: RainPanel
  a:init(3, 42) b:init(3, 42) c:init(3, 43)
  for i = 1, 600 do
    a:step(&prm, W, H, 1 / 60) b:step(&prm, W, H, 1 / 60) c:step(&prm, W, H, 1 / 60)
  end
  local same, differ = true, false
  for i = 0, < RAIN_MAX_DROPS do
    local da, db, dc = a.drops[i], b.drops[i], c.drops[i]
    if da.kind ~= db.kind or da.x ~= db.x or da.y ~= db.y or da.r ~= db.r then same = false end
    if da.kind ~= dc.kind or da.x ~= dc.x or da.y ~= dc.y then differ = true end
  end
  assert(same and a.angle == b.angle and a.live == b.live, 'deterministic for a seed')
  assert(differ, 'another seed rains differently')
  print('deterministic OK')
end

-- Drop counts stay within bounds at each intensity (no wiper: they settle).
do
  local levels: [4]float32 = { 0.1, 0.35, 0.7, 1.0 }
  local last = 0
  for li = 0, < 4 do
    local prm = params(levels[li], RainWiper.None)
    local p: RainPanel
    p:init(1, 7)
    local want = (@integer)(math.floor(90 * levels[li] + 0.5))
    for i = 1, 60 * 30 do
      p:step(&prm, W, H, 1 / 60)
      local n = p:count()
      assert(n == p.live, 'live count tracks the drops')
      assert(n >= 0 and n <= want and n <= RAIN_MAX_DROPS, 'within bounds')
    end
    assert(p.live >= want * 0.6, 'the glass fills toward the count for the intensity')
    assert(p.live >= last, 'more rain, more drops')
    last = p.live
  end
  local big = params(1, RainWiper.None)
  big.max_drops = 1000
  local p: RainPanel
  p:init(1, 7)
  for i = 1, 60 * 20 do p:step(&big, W, H, 1 / 60) end
  assert(p.live <= RAIN_MAX_DROPS, 'never past the fixed buffer')
  print('drop counts OK')
end

-- Drops trickle: some move down and leave the panel; merged drops grow.
do
  local prm = params(1, RainWiper.None)
  local p: RainPanel
  p:init(2, 99)
  local moved = false
  for i = 1, 60 * 30 do
    p:step(&prm, W, H, 1 / 60)
    for k = 0, < RAIN_MAX_DROPS do
      if p.drops[k].kind == 1 and p.drops[k].moving then moved = true end
    end
  end
  assert(moved, 'large drops trickle')
  print('trickle OK')
end

-- The wiper's arc: rests along the bottom, eases out to the far side and back.
do
  assert(rain_wiper_angle(0) == RAIN_WIPER_REST and rain_wiper_angle(1) == RAIN_WIPER_REST)
  assert(near(rain_wiper_angle(0.5), RAIN_WIPER_OUT, 1e-4), 'out at mid-sweep')
  local prev = rain_wiper_angle(0)
  for i = 1, 50 do
    local a = rain_wiper_angle(i / 100)
    assert(a >= prev, 'out')
    prev = a
  end
  for i = 51, 99 do
    local a = rain_wiper_angle(i / 100)
    assert(a <= prev, 'and back')
    prev = a
  end
  assert(rain_wiper_angle(0.05) - RAIN_WIPER_REST < rain_wiper_angle(0.25) - rain_wiper_angle(0.2), 'eased from rest')
  local prm = params(0.3, RainWiper.Back)
  local lp = rain_wiper_period(0.1, &prm)
  assert(lp >= 6 and lp <= 12, 'light rain: every 6 to 12 s')
  assert(rain_wiper_period(0.3, &prm) < lp, 'heavier, more often')
  assert(rain_wiper_period(0.9, &prm) == RAIN_SWEEP, 'heavy: continuous')

  -- over time: rests until due, sweeps once in RAIN_SWEEP, rests again
  local p: RainPanel
  p:init(5, 1)
  prm.fade = 0.05
  local steps_out = 0
  local max_angle: float32 = 0
  for i = 1, 60 * 30 do
    p:step(&prm, W, H, 1 / 60)
    if p.angle > RAIN_WIPER_REST then steps_out = steps_out + 1 end
    max_angle = math.max(max_angle, p.angle)
  end
  local period = rain_wiper_period(p.level, &prm)
  local sweeps = steps_out / (RAIN_SWEEP * 60)
  assert(max_angle > RAIN_WIPER_OUT - 0.05, 'reaches the far side')
  assert(sweeps > 30 / period - 1.5 and sweeps < 30 / period + 1.5, 'one sweep per period')
  print('wiper sweep OK')
end

-- Drops in the swept area are cleared as the blade passes, leaving smears;
-- drops outside it (top corners, past the arm) stay.
do
  local p: RainPanel
  p:init(6, 5)
  local px, py, len = rain_wiper_geom(W, H)
  local function put(p: *RainPanel, i: integer, x: float32, y: float32): void
    p.drops[i] = { kind = 1, x = x, y = y, r = 3, rmax = 3, age = 1 }
  end
  put(&p, 0, px + len * 0.6, py - 30)            -- just above the rest position, right
  put(&p, 1, px, py - len * 0.7)                 -- straight up
  put(&p, 2, px - len * 0.8, py - len * 0.3)     -- far left
  put(&p, 3, 4, 4)                               -- top-left corner: past the arm
  put(&p, 4, W - 4, 4)                           -- top-right corner
  put(&p, 5, px, py - len * 0.05)                -- inside the blade's start, by the pivot
  p.live = 6
  -- follow one sweep in frame steps, the blade clearing what it crosses
  local prev = rain_wiper_angle(0)
  local checked = false
  for i = 1, 84 do
    local a = rain_wiper_angle(i / 84)
    p:wipe(prev, a, W, H)
    prev = a
    if a > 1.2 and a < 2.0 and not checked then
      checked = true
      assert(p.drops[0].kind == 2, 'passed: wiped, now a smear')
      assert(p.drops[2].kind == 1, 'not reached yet: still there')
    end
  end
  assert(checked)
  assert(p.drops[1].kind == 2 and p.drops[2].kind == 2, 'swept area cleared')
  assert(p.drops[3].kind == 1 and p.drops[4].kind == 1, 'corners past the arm stay')
  assert(p.drops[5].kind == 1, 'short of the blade stays')
  assert(p.live == 3)
  -- the smears fade on their own
  local prm = params(1, RainWiper.None)
  for i = 1, 60 do p:step(&prm, W, H, 1 / 60) end
  for i = 0, < 3 do assert(p.drops[i].kind ~= 2, 'smear gone') end

  -- and through the stepping: a full glass in continuous rain is kept clear in the swept area
  local q: RainPanel
  q:init(9, 17)
  local heavy = params(1, RainWiper.Back)
  heavy.fade = 0.05
  for i = 1, 60 * 20 do q:step(&heavy, W, H, 1 / 60) end
  local inside, outside = 0, 0
  for k = 0, < RAIN_MAX_DROPS do
    local d = &q.drops[k]
    if d.kind == 1 then
      local dist = math.sqrt((d.x - px) ^ 2 + (d.y - py) ^ 2)
      if dist > len * 0.3 and dist < len * 0.9 and d.y < py - 20 then inside = inside + 1 else outside = outside + 1 end
    end
  end
  local nw: RainPanel
  nw:init(9, 17)
  local dry_wiper = params(1, RainWiper.None)
  dry_wiper.fade = 0.05
  for i = 1, 60 * 20 do nw:step(&dry_wiper, W, H, 1 / 60) end
  local inside_nw = 0
  for k = 0, < RAIN_MAX_DROPS do
    local d = &nw.drops[k]
    if d.kind == 1 and math.sqrt((d.x - px) ^ 2 + (d.y - py) ^ 2) > len * 0.3 and math.sqrt((d.x - px) ^ 2 + (d.y - py) ^ 2) < len * 0.9 and d.y < py - 20 then
      inside_nw = inside_nw + 1
    end
  end
  assert(inside < inside_nw, 'the wiper keeps its arc clearer than no wiper')
  print('wiper clears OK')
end

-- Not raining: nothing lands and the wiper rests.
do
  local prm = params(0, RainWiper.Back)
  local p: RainPanel
  p:init(7, 1)
  for i = 1, 600 do p:step(&prm, W, H, 1 / 60) end
  assert(p.live == 0 and p:count() == 0 and not p.wiping and p.angle == RAIN_WIPER_REST, 'dry')
  print('off when dry OK')
end

-- The fade: the level rises over `fade` seconds, falls again, and the glass is
-- clear once it is gone.
do
  local prm = params(1, RainWiper.Back)
  local p: RainPanel
  p:init(8, 3)
  for i = 1, 60 do p:step(&prm, W, H, 1 / 60) end
  assert(near(p.level, 1 / 3, 0.01), 'a third of the way after 1 s of 3')
  for i = 1, 180 do p:step(&prm, W, H, 1 / 60) end
  assert(p.level == 1, 'fully in')
  local full = p.live
  assert(full > 0)
  prm.intensity = 0
  for i = 1, 90 do p:step(&prm, W, H, 1 / 60) end
  assert(near(p.level, 0.5, 0.01) and p.live < full, 'fading out, drops evaporating')
  for i = 1, 120 do p:step(&prm, W, H, 1 / 60) end
  assert(p.level == 0 and p.live == 0 and p:count() == 0, 'gone')
  print('fade OK')
end

-- Drops leaving the glass: run-off at the bottom edge, and the wiper's fling.
do
  local prm = params(0.5, RainWiper.None)
  prm.fade = 0.01
  local p: RainPanel
  p:init(10, 3)
  p.level = 0.5
  p.drops[0] = { kind = 1, moving = true, x = 300, y = H - 2, r = 7, rmax = 7, age = 1, trail_y = H - 50 }
  p.live = 1
  local seen = false
  for i = 1, 30 do
    p:step(&prm, W, H, 1 / 60)
    for k = 0, < p.nemit do
      local e = p.emit[k]
      if not e.fling and near(e.v, H, 0.01) and e.dv > 0.9 and e.speed > 0 then seen = true end
    end
    if seen then break end
  end
  assert(seen and p.drops[0].kind ~= 1, 'a drop running off the bottom leaves as an emit')
  -- the collected water leaves the tip at a turn, heading down and outward
  local px, py, len = rain_wiper_geom(W, H)
  p.nemit = 0
  p.carried = 30
  p:fling(RAIN_WIPER_OUT, 1, W, H)
  assert(p.nemit == RAIN_MAX_FLING and p.carried == 0, 'a turn flings what the blade carried, capped')
  for k = 0, < p.nemit do
    local e = p.emit[k]
    assert(e.fling and e.u < px - len * 0.8 and e.dv > 0 and e.du < 0, 'off the tip, down and outward (left)')
  end
  -- through the stepping: continuous heavy rain flings at every turn
  local q: RainPanel
  q:init(11, 4)
  local heavy = params(1, RainWiper.Back)
  heavy.fade = 0.05
  local flung = 0
  for i = 1, 60 * 10 do
    q:step(&heavy, W, H, 1 / 60)
    for k = 0, < q.nemit do if q.emit[k].fling then flung = flung + 1 end end
  end
  assert(flung > 0, 'the wiper flings what it collects')
  print('shedding OK')
end

-- World droplets: a free fall lands when the kinematics say, a flung drop arcs,
-- the pool is capped, and a landing splashes then frees its slot.
do
  local pool: RainPool
  assert(pool:emit(256, 0, 10, 0, 0, 0, 0, 0, false))
  local t: float32 = 0
  while not pool.p[0].landed and t < 5 do pool:step(1 / 120, 10) t = t + 1 / 120 end
  assert(near(t, math.sqrt(2), 0.02) and pool.p[0].y == 0, 'free fall: 10 yalms at g = 10 takes sqrt(2) s, lands on the ground')
  local splash: float32 = 0
  while pool.live > 0 and splash < 2 do pool:step(1 / 120, 10) splash = splash + 1 / 120 end
  assert(pool.live == 0 and near(splash, RAIN_FALL_SPLASH, 0.02), 'splash, then the slot is free')

  assert(pool:emit(256, 0, 0, 0, 2, 3, 0, 0, true))
  local i = 0
  local x_top: float32, y_top: float32 = 0, 0
  t = 0
  while not pool.p[0].landed and t < 5 do
    pool:step(1 / 120, 10) t = t + 1 / 120
    if pool.p[0].y > y_top then x_top, y_top = pool.p[0].x, pool.p[0].y end
  end
  assert(near(t, 0.6, 0.02) and near(pool.p[0].x, 1.2, 0.05), 'fling: lands after 2 vy / g, vx t along')
  assert(near(y_top, 0.45, 0.02) and near(x_top, 0.6, 0.05), 'the top of the arc')
  pool:clear()

  for k = 1, 300 do pool:emit(256, 0, 5, 0, 0, 0, 0, 0, false) end
  assert(pool.live == RAIN_MAX_FALL, 'full at the pool size')
  pool:clear()
  for k = 1, 300 do pool:emit(50, 0, 5, 0, 0, 0, 0, 0, false) end
  assert(pool.live == 50, 'max_particles caps it lower')
  pool:clear()
  assert(pool:emit(256, 0, 5, 0, 0, 1, 0, -1000, false))
  for k = 1, 60 * 10 do pool:step(1 / 60, 10) end
  assert(pool.live == 0, 'no ground in reach: dropped after a while')
  print('world droplets OK')
end

-- lua/rain.lua: dry without weather, forced by /term rain, HUD panels stay dry.
do
  local root: string = arg[1]
  assert(policy_load(root), policy.error)
  local ok, prm = policy_rain_frame()
  assert(ok and prm.intensity == 0, 'no weather: dry')
  assert(prm.max_drops == 90 and prm.wiper == RainWiper.Back and near(prm.fade, 3, 1e-4), 'defaults')
  local err = policy_rain_command('on')
  assert(#err == 0)
  ok, prm = policy_rain_frame()
  assert(ok and near(prm.intensity, 0.7, 1e-4), 'forced on')
  err = policy_rain_command('bogus')
  assert(#err > 0, 'usage')
  err:destroy()
  local L = policy.L
  assert(luaL_loadstring(L, [[
    ghostty.env = function() return 43200, 0, 8 end
    CONFIG.rain.mode = 'auto'
    CONFIG.rain.wiper_style = 'front'
  ]]) == LUA_OK and lua_pcall(L, 0, 0, 0) == LUA_OK)
  ok, prm = policy_rain_frame()
  assert(ok and prm.intensity == 1 and prm.wiper == RainWiper.Front, 'showers: full rain')
  assert(luaL_loadstring(L, "ghostty.env = function() return 43200, 0, 0 end") == LUA_OK and lua_pcall(L, 0, 0, 0) == LUA_OK)
  ok, prm = policy_rain_frame()
  assert(prm.intensity == 0, 'no weather indoors: dry')
  assert(luaL_loadstring(L, "ghostty.env = function() return 43200, 0.4, 3 end") == LUA_OK and lua_pcall(L, 0, 0, 0) == LUA_OK)
  ok, prm = policy_rain_frame()
  assert(near(prm.intensity, 0.4, 1e-4), 'unlisted weather: the game\'s rain amount')
  assert(policy_rain_panel(4), 'world panels get rain')
  assert(luaL_loadstring(L, "require('world').anchors[4] = { kind = 'hud' }") == LUA_OK and lua_pcall(L, 0, 0, 0) == LUA_OK)
  assert(not policy_rain_panel(4), 'HUD panels stay dry')
  assert(luaL_loadstring(L, "require('world').anchors[4] = nil CONFIG.rain.wiper_style = 'back'") == LUA_OK and lua_pcall(L, 0, 0, 0) == LUA_OK)
  err = policy_rain_command('off')
  ok, prm = policy_rain_frame()
  assert(prm.intensity == 0, 'forced off')
  print('rain policy OK')
end

-- Drawing: one reserved batch per pass, all inside (about) the panel; nothing
-- when it is dry.
local reserved: integer = 0
local batches: integer = 0
local nvtx: integer = 0
local out_of_panel: integer = 0
local function fake_uv(out: *ImVec2): void $out = vec2(0.5, 0.5) end
local function fake_reserve(dl: *ImDrawList, idx: cint, vtx: cint): void
  assert(idx == vtx and vtx % 3 == 0, 'whole triangles')
  reserved = reserved + vtx
  batches = batches + 1
end
local function fake_vtx(dl: *ImDrawList, pos: ImVec2, uv: ImVec2, col: uint32): void
  nvtx = nvtx + 1
  if pos.x < 100 - 30 or pos.x > 100 + 800 + 30 or pos.y < 50 - 30 or pos.y > 50 + 500 + 30 then out_of_panel = out_of_panel + 1 end
end
local function fake_camera(cam: *GuCamera): cint
  $cam = { width = 1000, height = 500 }
  cam.m[0], cam.m[5], cam.m[11] = 1, 1, -1
  return 1
end
local viewport: ImGuiViewport
local function fake_viewport(): *ImGuiViewport return &viewport end
local function fake_bg(): *ImDrawList return nilptr end
do
  imgui.GetFontTexUvWhitePixel = fake_uv
  imgui.DrawListPrimReserve = fake_reserve
  imgui.DrawListPrimVtx = fake_vtx
  local pl: WorldPlacement = { z = -5, width = 800, height = 500, ppm = 300, opacity = 0.9, tint_r = 1, tint_g = 1, tint_b = 1 }
  local o = vec2(100, 50)
  local now: float64 = 100
  for i = 1, 60 do
    rain_panel_back(nilptr, o, &pl, 11, now, 1)
    rain_panel_front(nilptr, o, &pl, 11)
    now = now + 1 / 60
  end
  assert(reserved == 0 and nvtx == 0, 'forced off: nothing drawn')

  local err = policy_rain_command('on')
  for i = 1, 60 * 8 do
    reserved, batches, nvtx = 0, 0, 0
    rain_panel_back(nilptr, o, &pl, 11, now, 1)
    local back = batches
    rain_panel_front(nilptr, o, &pl, 11)
    assert(back <= 1 and batches - back <= 1, 'one batch per pass')
    assert(reserved == nvtx, 'reserved what was drawn')
    now = now + 1 / 60
  end
  assert(nvtx > 0 and out_of_panel == 0, 'drops and wiper drawn on the panel')
  -- the panel stands 5 yalms ahead of a camera looking down -Z: what ran off
  -- or was flung is falling in front of it, drawn on the background list
  assert(rain_pool.live > 0, 'drops fell off the panel into the world')
  imgui.GetMainViewport = fake_viewport
  imgui.GetBackgroundDrawList = fake_bg
  host.api.get_camera = fake_camera
  reserved, nvtx = 0, 0
  draw_rain_world(now)
  assert(reserved > 0 and reserved == nvtx, 'world droplets drawn')
  host.api.get_camera = nilptr
  -- a docked HUD panel next to it stays dry
  local L = policy.L
  assert(luaL_loadstring(L, "require('world').anchors[12] = { kind = 'hud' }") == LUA_OK and lua_pcall(L, 0, 0, 0) == LUA_OK)
  reserved = 0
  for i = 1, 60 do
    rain_panel_back(nilptr, o, &pl, 12, now, 1)
    rain_panel_front(nilptr, o, &pl, 12)
    now = now + 1 / 60
  end
  assert(reserved == 0, 'HUD panel: no rain')
  pl.hud = true
  for i = 1, 60 do rain_panel_back(nilptr, o, &pl, 11, now, 1) now = now + 1 / 60 end
  pl.hud = false
  err = policy_rain_command('auto')
  rain_reset()
  print('drawing OK')
end
-- Shelter: rain reaches a panel only where the sky does -----------------------------
-- A fake scene: a roof at y = 10 over everything west of x = 0, the ground at
-- y = 0, and a mezzanine floor at y = 3 east of x = 20. The player stands
-- under the roof throughout; only the panels' own positions matter.
local up_rays: integer, down_rays: integer = 0, 0
local function fake_raycast(ox: float32, oy: float32, oz: float32, dx: float32, dy: float32, dz: float32,
                            max: float32, hx: *float32, hy: *float32, hz: *float32): cint
  assert(dx == 0 and dz == 0 and (dy == 1 or dy == -1), 'rain casts straight up or down')
  local y: float32 = -1000
  if dy > 0 then
    up_rays = up_rays + 1
    if ox < 0 and oy < 10 then y = 10 end
  else
    down_rays = down_rays + 1
    y = (ox > 20 and oy >= 3) and 3 or 0
    if oy < y then y = -1000 end
  end
  if y < -999 or math.abs(y - oy) > max then return 0 end
  $hx, $hy, $hz = ox, y, oz
  return 1
end
local function fake_player(which: cint, id: uint64, out: *GuObject): cint
  $out = { found = 1, x = -30, y = 0, z = 0 } -- well under the roof
  return 1
end
local indoors: cint = 0
local function fake_indoor(): cint return indoors end
local function run_lua(code: cstring): void
  assert(luaL_loadstring(policy.L, code) == LUA_OK and lua_pcall(policy.L, 0, 0, 0) == LUA_OK, 'lua')
end
local function lua_kb(): float64
  assert(luaL_loadstring(policy.L, "return collectgarbage('count')") == LUA_OK and lua_pcall(policy.L, 0, 1, 0) == LUA_OK)
  local kb = lua_tonumberx(policy.L, -1, nilptr)
  lua_pop(policy.L, 1)
  return kb
end
do
  -- the record on its own: due, first answer taken whole, later ones eased, the blend
  local sh: RainShelter
  assert(sh:exposure() == 1 and sh:at_x(0.3) == 1, 'never cast: open sky')
  assert(sh:due(0, 0, 0, 0), 'never cast: due')
  local pts: [RAIN_SHELTER_N][3]float32 = { { -1, 2, 0 }, { 1, 2, 0 }, { 3, 2, 0 } }
  up_rays = 0
  sh:cast(fake_raycast, &pts, 10)
  assert(up_rays == RAIN_SHELTER_N, 'one ray per sample')
  assert(sh.open[0] == 0 and sh.open[1] == 1 and sh.open[2] == 1, 'the first answer is taken as it is')
  assert(near(sh:exposure(), 0.75, 1e-5) and sh:at_x(0) == 0 and near(sh:at_x(0.25), 0.5, 1e-5) and sh:at_x(0.75) == 1, 'blended across the width')
  assert(not sh:due(10.1, 1, 2, 0), 'cached while it stays put')
  assert(sh:due(10.26, 1, 2, 0), 'cast again after the period')
  assert(not sh:due(10.05, 3, 2, 0), 'a moved panel still waits the minimum gap')
  assert(sh:due(10.1, 3, 2, 0), 'then casts sooner than the period')
  assert(not sh:due(10.1, 1.1, 2, 0), 'a small move does not count')
  for i = 0, < RAIN_SHELTER_N do pts[i][0] = pts[i][0] - 10 end -- all under the roof now
  sh:cast(fake_raycast, &pts, 10.3)
  assert(sh.open[1] == 1 and sh.target[1] == 0, 'a later answer is only the target')
  for i = 1, 30 do sh:ease(1 / 60) end
  assert(sh.open[1] > 0.4 and sh.open[1] < 0.6, 'half way after half a second')
  for i = 1, 40 do sh:ease(1 / 60) end
  assert(sh:exposure() == 0, 'covered after about a second')
  print('shelter record OK')
end
do
  run_lua([[
    ghostty.env = function() return 43200, 0, 8 end -- showers
    ghostty.zone = function() return 132 end
    CONFIG.rain.mode = 'auto'
    CONFIG.rain.wiper_style = 'back'
  ]])
  rain_reset()
  host.api.raycast = fake_raycast
  host.api.get_object = fake_player
  host.api.indoor = fake_indoor
  local o = vec2(100, 50)
  local now: float64 = 1000
  -- 800 px at 300 px per yalm: 2.67 yalms wide, facing +Z, so right is +X
  local open_pl: WorldPlacement = { x = 5, y = 2, z = 0, width = 800, height = 500, ppm = 300, opacity = 0.9, tint_r = 1, tint_g = 1, tint_b = 1 }
  local roof_pl, half_pl, loft_pl = open_pl, open_pl, open_pl
  roof_pl.x = -8
  half_pl.x = -0.5  -- samples at x = -1.83, -0.5 and 0.83: only the right corner sees the sky
  loft_pl.x, loft_pl.y = 25, 5 -- above the mezzanine, the player a floor below

  -- (a) open sky over the panel, the player under the roof: it rains on it;
  -- (b) under the roof: nothing at all; (c) half under: the open side only
  local before = lua_kb()
  run_lua("collectgarbage('collect') collectgarbage('stop')")
  before = lua_kb()
  up_rays = 0
  for i = 1, 60 * 12 do
    rain_panel_back(nilptr, o, &open_pl, 21, now, 1)
    rain_panel_back(nilptr, o, &roof_pl, 22, now, 1)
    rain_panel_back(nilptr, o, &half_pl, 23, now, 1)
    assert(rain_rays_frame <= RAIN_RAYS_FRAME, 'ray budget per frame')
    local r = rain_panel_find(22)
    assert(r.level == 0 and r:count() == 0 and r.nemit == 0 and not r.wiping, 'under the roof: never a drop')
    now = now + 1 / 60
  end
  local grew = lua_kb() - before
  run_lua("collectgarbage('restart')")
  print('3 panels for 720 frames made KB', grew)
  assert(grew < 8, 'rain makes Lua garbage every frame')
  -- 12 s, 3 panels that stay put: one cast each per 0.25 s, not one per frame
  assert(up_rays == rain_rays_total and up_rays >= 3 * RAIN_SHELTER_N * 40 and up_rays <= 3 * RAIN_SHELTER_N * 50, 'casts are cached and throttled')
  local a, h = rain_panel_find(21), rain_panel_find(23)
  assert(near(a.level, 1, 1e-3) and a:count() > 10 and a.wiping, 'open sky: full rain')
  assert(near(h.shelter:exposure(), 0.25, 1e-5) and near(h.level, 0.25, 1e-3), 'half under: the exposed share')
  local wet_side, dry_side = 0, 0
  for k = 0, < RAIN_MAX_DROPS do
    if h.drops[k].kind == 1 then
      if h.drops[k].x < 380 then dry_side = dry_side + 1 else wet_side = wet_side + 1 end
    end
  end
  assert(wet_side > 2 and dry_side == 0, 'drops only where the sky reaches')
  print('shelter a, b, c OK')

  -- (e) what falls off lands on the first floor below it, not at the player's height
  rain_reset()
  for i = 1, 60 * 20 do rain_panel_back(nilptr, o, &loft_pl, 24, now, 1) now = now + 1 / 60 end
  local fell = 0
  for i = 0, < RAIN_MAX_FALL do
    if rain_pool.p[i].live then
      fell = fell + 1
      assert(rain_pool.p[i].ground == 3, 'the mezzanine catches it')
    end
  end
  assert(fell > 0 and down_rays > 0, 'drops fell off the loft panel')
  print('shelter e OK')

  -- (f) a pet panel carried indoors: exposure eases, the glass dries after it
  local pet = open_pl
  for i = 1, 60 * 6 do rain_panel_back(nilptr, o, &pet, 25, now, 1) now = now + 1 / 60 end
  local p = rain_panel_find(25)
  assert(p.level > 0.99 and p:count() > 10, 'wet outside')
  pet.x = -8
  rain_pool:clear()
  up_rays = 0
  for i = 1, 30 do rain_panel_back(nilptr, o, &pet, 25, now, 1) now = now + 1 / 60 end
  local e = p.shelter:exposure()
  assert(e > 0.3 and e < 0.7, 'half a second in: half way')
  assert(p:count() > 0, 'the glass is still wet')
  for i = 1, 60 do rain_panel_back(nilptr, o, &pet, 25, now, 1) now = now + 1 / 60 end
  assert(p.shelter:exposure() == 0 and p.level > 0.3 and p:count() > 0, 'sheltered, still drying')
  local shed_before = rain_pool.live
  for i = 1, 60 * 5 do rain_panel_back(nilptr, o, &pet, 25, now, 1) now = now + 1 / 60 end
  assert(p.level == 0 and p:count() == 0, 'dry in the end')
  assert(rain_pool.live <= shed_before, 'nothing shed once sheltered')
  -- a panel moving every frame (6 yalms a second, under the roof) casts at the
  -- minimum gap, not every frame
  up_rays = 0
  for i = 1, 60 do
    pet.x = pet.x - 0.1
    rain_panel_back(nilptr, o, &pet, 25, now, 1)
    now = now + 1 / 60
  end
  assert(up_rays >= RAIN_SHELTER_N * 8 and up_rays <= RAIN_SHELTER_N * 13, 'a moving panel is throttled')
  -- ten new panels in one frame share the frame's budget
  for id = 40, 49 do rain_panel_back(nilptr, o, &open_pl, id, now, 1) end
  assert(rain_rays_frame <= RAIN_RAYS_FRAME and rain_rays_frame > 0, 'the budget holds with many panels')
  assert(not rain_panel_find(49).shelter.known and rain_panel_find(49).level == 0, 'a panel waiting for its rays stays dry meanwhile')
  print('shelter f, throttle OK')

  -- (d) indoors by the game's word, or by the zone list: dry under open sky
  rain_reset()
  indoors = 1
  for i = 1, 120 do rain_panel_back(nilptr, o, &open_pl, 26, now, 1) now = now + 1 / 60 end
  assert(rain_panel_find(26).level == 0 and rain_rays_total == 0, 'a housing interior: no rain, no rays')
  indoors = 0
  run_lua("CONFIG.rain.indoor_zones[132] = true")
  for i = 1, 120 do rain_panel_back(nilptr, o, &open_pl, 26, now, 1) now = now + 1 / 60 end
  assert(rain_panel_find(26).level == 0, 'a listed zone: no rain')
  run_lua("CONFIG.rain.indoor_zones[132] = nil")
  -- the toggle off, and /term rain on: the weather alone, even under the roof
  run_lua("CONFIG.rain.shelter = false")
  for i = 1, 120 do rain_panel_back(nilptr, o, &roof_pl, 27, now, 1) now = now + 1 / 60 end
  assert(rain_panel_find(27).level > 0.5 and rain_rays_total == 0, 'shelter off: rain everywhere, no rays')
  run_lua("CONFIG.rain.shelter = true")
  -- dry weather: no rays either
  run_lua("ghostty.env = function() return 43200, 0, 1 end")
  rain_reset()
  for i = 1, 60 do rain_panel_back(nilptr, o, &open_pl, 28, now, 1) now = now + 1 / 60 end
  assert(rain_rays_total == 0, 'no rain, no rays')
  host.api.raycast, host.api.get_object, host.api.indoor = nilptr, nilptr, nilptr
  rain_reset()
  print('shelter d OK')
end
print('OK')
