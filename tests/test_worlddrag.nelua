-- Placing world panels by dragging: the cursor ray, poses from surface normals,
-- snapping and stretch-to-fit against a fake collision scene, the drag gesture,
-- and the drop turning any anchor into a world pin through lua/world.lua.
require 'core.world'
require 'tests.check'
require 'core.policy'
require 'string'
require 'math'
require 'arg'
require 'os'
require 'vector'

local function near(a: float32, b: float32, eps: float32): boolean return math.abs(a - b) < eps end

-- Cameras ---------------------------------------------------------------------------
-- Camera at (0, 1.6, 6) looking down -Z: clip x = x, clip y = y - 1.6, w = 6 - z.
local cam: GuCamera = { width = 1000, height = 500 }
cam.m[0] = 1
cam.m[5] = 1
cam.m[11] = -1
cam.m[13] = -1.6
cam.m[15] = 6

-- System.Numerics CreateLookAt * CreatePerspectiveFieldOfView (row vectors).
local function look_camera(ex: float32, ey: float32, ez: float32, tx: float32, ty: float32, tz: float32): GuCamera
  local zx, zy, zz = ex - tx, ey - ty, ez - tz
  local zl = math.sqrt(zx * zx + zy * zy + zz * zz)
  zx, zy, zz = zx / zl, zy / zl, zz / zl
  local xx, xy, xz = zz, (@float32)(0), -zx -- up x z
  local xl = math.sqrt(xx * xx + xz * xz)
  xx, xz = xx / xl, xz / xl
  local yx, yy, yz = zy * xz - zz * xy, zz * xx - zx * xz, zx * xy - zy * xx
  local view: [16]float32 = {
    xx, yx, zx, 0,
    xy, yy, zy, 0,
    xz, yz, zz, 0,
    -(xx * ex + xy * ey + xz * ez), -(yx * ex + yy * ey + yz * ez), -(zx * ex + zy * ey + zz * ez), 1,
  }
  local n: float32, f: float32 = 0.1, 1000
  local ys = 1 / math.tan(math.pi / 6)
  local proj: [16]float32 = { ys / 2, 0, 0, 0,  0, ys, 0, 0,  0, 0, f / (n - f), -1,  0, 0, n * f / (n - f), 0 }
  local c: GuCamera = { width = 1600, height = 800 }
  for i = 0, < 4 do
    for j = 0, < 4 do
      local s: float32 = 0
      for k = 0, < 4 do s = s + view[i * 4 + k] * proj[k * 4 + j] end
      c.m[i * 4 + j] = s
    end
  end
  return c
end

-- Cursor ray ------------------------------------------------------------------------
do
  local ok, ox, oy, oz, dx, dy, dz = world_cursor_ray(&cam, 500, 250)
  assert(ok and near(ox, 0, 1e-4) and near(oy, 1.6, 1e-4) and near(oz, 6, 1e-4), 'the ray starts at the camera')
  assert(near(dx, 0, 1e-5) and near(dy, 0, 1e-5) and near(dz, -1, 1e-5), 'screen centre: straight ahead')
  ok, ox, oy, oz, dx, dy, dz = world_cursor_ray(&cam, 1000, 0)
  local k = 1 / math.sqrt(3)
  assert(ok and near(dx, k, 1e-5) and near(dy, k, 1e-5) and near(dz, -k, 1e-5), 'top-right corner: 45 degrees right and up')

  local rc = look_camera(3, 4, 10, -1, 1, 0)
  ok, ox, oy, oz, dx, dy, dz = world_cursor_ray(&rc, 800, 400)
  local fl = math.sqrt(16 + 9 + 100)
  assert(ok and near(ox, 3, 1e-3) and near(oy, 4, 1e-3) and near(oz, 10, 1e-3), 'turned camera: starts at the eye')
  assert(near(dx, -4 / fl, 1e-4) and near(dy, -3 / fl, 1e-4) and near(dz, -10 / fl, 1e-4), 'turned camera: centre looks at the target')
  local pixels: [4]ImVec2 = { vec2(0, 0), vec2(1600, 800), vec2(123, 654), vec2(1400, 90) }
  for i = 0, < 4 do
    ok, ox, oy, oz, dx, dy, dz = world_cursor_ray(&rc, pixels[i].x, pixels[i].y)
    assert(ok and near(dx * dx + dy * dy + dz * dz, 1, 1e-4), 'unit direction')
    local ts: [2]float32 = { 2, 25 }
    for ti = 0, < 2 do
      local t = ts[ti]
      local pok, sx, sy = world_project(&rc, ox + dx * t, oy + dy * t, oz + dz * t)
      assert(pok and near(sx, pixels[i].x, 0.05) and near(sy, pixels[i].y, 0.05), 'points along the ray project back onto the cursor')
    end
  end
  print('cursor ray OK')
end

-- Axes and poses from normals ---------------------------------------------------------
do -- world_axes lays a panel out exactly as world_basis does, and n = right x up
  local pl: WorldPlacement = { yaw = 0.7, pitch = -0.4, width = 100, height = 50, ppm = 1 }
  local b = world_basis(pl)
  local a = world_axes(pl.yaw, pl.pitch)
  assert(near(a.rx, b.rx, 1e-5) and near(a.rz, b.rz, 1e-5) and near(a.ux, b.ux, 1e-5) and near(a.uy, b.uy, 1e-5) and near(a.uz, b.uz, 1e-5), 'same axes as world_basis')
  assert(near(a.ry * a.uz - a.rz * a.uy, a.nx, 1e-5) and near(a.rz * a.ux - a.rx * a.uz, a.ny, 1e-5) and near(a.rx * a.uy - a.ry * a.ux, a.nz, 1e-5), 'front normal is right x up')
end

-- Camera looking along (ax, az); the pose's front must be n and read upright.
local function check_pose(nx: float32, ny: float32, nz: float32, ax: float32, az: float32, what: string): (float32, float32)
  local l = math.sqrt(nx * nx + ny * ny + nz * nz)
  nx, ny, nz = nx / l, ny / l, nz / l
  local yaw, pitch = world_pose_from_normal(nx, ny, nz, ax, az)
  local a = world_axes(yaw, pitch)
  check(near(a.nx, nx, 1e-4) and near(a.ny, ny, 1e-4) and near(a.nz, nz, 1e-4), what, ': front faces the normal')
  local al = math.sqrt(ax * ax + az * az)
  check(a.uy + (a.ux * ax + a.uz * az) / al > 0, what, ': reads upright')
  return yaw, pitch
end

do
  local yaw, pitch = check_pose(0, 0, 1, 0, -1, 'wall facing the camera')
  assert(near(yaw, 0, 1e-4) and near(pitch, 0, 1e-4))
  yaw, pitch = check_pose(1, 0, 0, -1, 0, 'wall facing +X')
  assert(near(yaw, math.pi / 2, 1e-4) and near(pitch, 0, 1e-4))
  yaw, pitch = check_pose(0, 0, 1, 0.6, -1, 'wall seen at an angle')
  assert(near(yaw, 0, 1e-4) and near(pitch, 0, 1e-4), 'yaw comes from the wall, not the camera')
  yaw, pitch = check_pose(0, 1, 0, 0, -1, 'floor')
  assert(near(pitch, math.pi / 2, 1e-4), 'floor: lying flat')
  local a = world_axes(yaw, pitch)
  assert(near(a.uz, -1, 1e-4), 'floor: top edge away from the camera')
  yaw, pitch = check_pose(0, 1, 0, 1, 0, 'floor seen looking along +X')
  a = world_axes(yaw, pitch)
  assert(near(a.ux, 1, 1e-4), 'floor: top edge away whichever way the camera looks')
  yaw, pitch = check_pose(0, -1, 0, 0, -1, 'ceiling')
  assert(near(math.abs(pitch), math.pi / 2, 1e-4), 'ceiling: flat overhead')
  yaw, pitch = check_pose(0, math.sin(math.pi / 6), math.cos(math.pi / 6), 0, -1, 'slope facing the camera')
  assert(near(yaw, 0, 1e-4) and near(pitch, math.pi / 6, 1e-4), 'slope: pitched 30 degrees')
  yaw, pitch = check_pose(0, math.cos(0.17), -math.sin(0.17), 0, -1, 'desk tilted away')
  assert(math.abs(pitch) > math.pi / 2, 'tilted away: the upright of the two poses')
  check_pose(0.3, 0.9, 0.2, -0.5, -1, 'skewed slope')
  check_pose(-0.7, -0.4, 0.5, 0.7, -0.5, 'overhang')
  print('poses from normals OK')
end

do -- nearly level ground: the yaw follows the camera, not the slight tilt (no roll to undo it)
  local tilts: [4][3]float32 = { { 0.0087, 1, 0 }, { -0.035, 1, 0.01 }, { 0.1, 1, -0.12 }, { 0.12, -1, 0.05 } }
  local looks: [2][2]float32 = { { 0, -1 }, { 1, 0 } }
  for i = 0, < 4 do
    for j = 0, < 2 do
      local l = math.sqrt(tilts[i][0] ^ 2 + tilts[i][1] ^ 2 + tilts[i][2] ^ 2)
      local nx, ny, nz = tilts[i][0] / l, tilts[i][1] / l, tilts[i][2] / l
      local ax, az = looks[j][0], looks[j][1]
      local yaw, pitch = world_pose_from_normal(nx, ny, nz, ax, az)
      local a = world_axes(yaw, pitch)
      assert(a.nx * nx + a.ny * ny + a.nz * nz > math.cos(math.pi / 18), 'nearly level: front within the tilt of the normal')
      assert(a.ux * ax + a.uz * az > 0.99, 'nearly level: top edge straight away from the camera')
    end
  end
  -- just past 10 degrees the surface is a slope again and turns the panel to it
  local yaw, pitch = check_pose(math.sin(0.19), math.cos(0.19), 0, 0, -1, 'gentle sideways slope')
  assert(near(yaw, math.pi / 2, 1e-3), 'slope: yawed down it')
  print('nearly level poses OK')
end

-- Fake collision: axis-aligned boxes and one optional plane, hit from outside
-- only (like the game's one-sided collision).
local Box = @record{ x0: float32, y0: float32, z0: float32, x1: float32, y1: float32, z1: float32 }
local boxes: vector(Box)
local plane_on = false
local plane_nx: float32, plane_ny: float32, plane_nz: float32, plane_c: float32 = 0, 0, 0, 0
local casts = 0

local function slab(o: float32, d: float32, lo: float32, hi: float32, t0: *float32, t1: *float32): boolean
  if math.abs(d) < 1e-9 then return o >= lo and o <= hi end
  local a, b = (lo - o) / d, (hi - o) / d
  if a > b then a, b = b, a end
  if a > $t0 then $t0 = a end
  if b < $t1 then $t1 = b end
  return $t0 <= $t1
end

local function fake_cast(ox: float32, oy: float32, oz: float32, dx: float32, dy: float32, dz: float32,
                         max: float32, hx: *float32, hy: *float32, hz: *float32): cint
  casts = casts + 1
  local best: float32 = max
  local hit = false
  for i = 0, < #boxes do
    local bx = boxes[i]
    local t0: float32, t1: float32 = -1e30, 1e30
    if slab(ox, dx, bx.x0, bx.x1, &t0, &t1) and slab(oy, dy, bx.y0, bx.y1, &t0, &t1) and slab(oz, dz, bx.z0, bx.z1, &t0, &t1)
       and t0 >= 0 and t0 <= best then
      best, hit = t0, true
    end
  end
  if plane_on then
    local dn = plane_nx * dx + plane_ny * dy + plane_nz * dz
    if dn < -1e-6 then
      local t = (plane_c - (plane_nx * ox + plane_ny * oy + plane_nz * oz)) / dn
      if t >= 0 and t <= best then best, hit = t, true end
    end
  end
  if not hit then return 0 end
  $hx, $hy, $hz = ox + dx * best, oy + dy * best, oz + dz * best
  return 1
end

local function scene(): void
  boxes:clear()
  plane_on = false
end

local function unit(x: float32, y: float32, z: float32): (float32, float32, float32)
  local l = math.sqrt(x * x + y * y + z * z)
  return x / l, y / l, z / l
end

-- every corner of a pose at least `gap` in front of the plane n . p = c
local function corners_clear(p: WorldPlacement, nx: float32, ny: float32, nz: float32, c: float32, gap: float32): boolean
  local a = world_axes(p.yaw, p.pitch)
  local hw, hh = p.width / p.ppm * 0.5, p.height / p.ppm * 0.5
  for i = 0, < 4 do
    local sr: float32 = (i & 1) == 0 and hw or -hw
    local su: float32 = (i & 2) == 0 and hh or -hh
    local d = (p.x + a.rx * sr + a.ux * su) * nx + (p.y + a.ry * sr + a.uy * su) * ny + (p.z + a.rz * sr + a.uz * su) * nz - c
    if d < gap then return false end
  end
  return true
end

-- Snapping --------------------------------------------------------------------------
do
  -- a wall 5 yalms ahead of the camera at (0, 1.6, 6)
  scene()
  boxes:push({ -10, 0, -5.2, 10, 5, -5 })
  local s = world_snap(fake_cast, 0, 1.6, 6, 0, 0, -1, 80, 0.15)
  assert(s.ok and near(s.z, -5, 1e-4) and near(s.nz, 1, 1e-4), 'wall: hit and normal toward the camera')
  local pl: WorldPlacement = { x = 9, y = 9, z = 9, yaw = 2, pitch = 1, width = 1800, height = 1040, ppm = 640, curve = 9 }
  local p = world_snap_pose(pl, &s, 0, 6, 0.02)
  assert(near(p.x, 0, 1e-4) and near(p.y, 1.6, 1e-4) and near(p.z, -4.98, 1e-4), 'wall: centred on the hit, 2 cm off it')
  assert(near(p.yaw, 0, 1e-4) and near(p.pitch, 0, 1e-4) and p.curve == 0 and p.width == 1800, 'wall: flush, flat, same size')

  -- looking down 45 degrees at the floor
  scene()
  boxes:push({ -50, -1, -50, 50, 0, 50 })
  local dx, dy, dz = unit(0, -1, -1)
  s = world_snap(fake_cast, 0, 1.6, 6, dx, dy, dz, 80, 0.15)
  assert(s.ok and near(s.y, 0, 1e-3) and near(s.z, 4.4, 1e-3) and near(s.ny, 1, 1e-3), 'floor: hit and normal up')
  p = world_snap_pose(pl, &s, 0, 6, 0.02)
  local a = world_axes(p.yaw, p.pitch)
  assert(near(p.y, 0.02, 1e-3) and near(a.ny, 1, 1e-3) and a.uz < -0.99, 'floor: lying on it, top edge away from the camera')

  -- a 30 degree slope through the origin
  scene()
  plane_on = true
  plane_nx, plane_ny, plane_nz, plane_c = 0, math.sin(math.pi / 6), math.cos(math.pi / 6), 0
  s = world_snap(fake_cast, 0, 1.6, 6, 0, 0, -1, 80, 0.15)
  assert(s.ok and near(s.ny, 0.5, 1e-3) and near(s.nz, math.cos(math.pi / 6), 1e-3), 'slope: its normal')
  p = world_snap_pose(pl, &s, 0, 6, 0.02)
  assert(near(p.yaw, 0, 1e-3) and near(p.pitch, math.pi / 6, 1e-3), 'slope: pitched with it')

  -- a wall ending just right of the hit: probes falling off the edge retry the other side
  scene()
  boxes:push({ -10, 0, -5.2, 0.05, 5, -5 })
  s = world_snap(fake_cast, 0, 1.6, 6, 0, 0, -1, 80, 0.15)
  assert(s.ok and near(s.nz, 1, 1e-4), 'wall edge: normal from the side that is there')

  -- a far wall behind the edge does not count as the same surface
  boxes:push({ -10, 0, -30.2, 10, 5, -30 })
  s = world_snap(fake_cast, 0, 1.6, 6, 0, 0, -1, 80, 0.15)
  assert(s.ok and near(s.z, -5, 1e-4) and near(s.nz, 1, 1e-4), 'wall edge: ignores the far wall')

  -- grazing: a floor 20 and 30 yalms out, seen from 2.5 yalms up, is measured and lain on
  scene()
  boxes:push({ -100, -1, -100, 100, 0, 100 })
  local outs: [2]float32 = { 20, 30 }
  for i = 0, < 2 do
    dx, dy, dz = unit(0, -2.5, -outs[i])
    s = world_snap(fake_cast, 0, 2.5, 6, dx, dy, dz, 80, 0.15)
    assert(s.ok and near(s.z, 6 - outs[i], 1e-2) and near(s.ny, 1, 1e-3), 'grazing floor: normal up')
    p = world_snap_pose(pl, &s, 0, 6, 0.02)
    assert(corners_clear(p, 0, 1, 0, 0, 0.019), 'grazing floor: on it, not in it')
  end

  -- grazing: the side wall of a corridor 20 yalms down it
  boxes:push({ 2, 0, -100, 2.2, 10, 100 })
  dx, dy, dz = unit(2, 0, -20)
  s = world_snap(fake_cast, 0, 1.6, 6, dx, dy, dz, 80, 0.15)
  assert(s.ok and near(s.x, 2, 1e-3) and near(s.nx, -1, 1e-3), 'corridor wall: normal back into the corridor')
  p = world_snap_pose(pl, &s, 0, 6, 0.02)
  assert(near(p.pitch, 0, 1e-3) and corners_clear(p, -1, 0, 0, -2, 0.019), 'corridor wall: flat on it, not in it')

  -- grazing: a skewed slope 38 yalms up it
  scene()
  plane_on = true
  plane_nx, plane_ny, plane_nz = unit(0.4, 0.8, 0.45)
  plane_c = 0
  dx, dy, dz = unit(-20, (8 + 9) / 0.8 - 2.5, -26)
  s = world_snap(fake_cast, 0, 2.5, 6, dx, dy, dz, 80, 0.15)
  assert(s.ok and near(s.nx, plane_nx, 1e-3) and near(s.ny, plane_ny, 1e-3) and near(s.nz, plane_nz, 1e-3), 'grazing slope: its normal')
  p = world_snap_pose(pl, &s, 0, 6, 0.02)
  assert(corners_clear(p, plane_nx, plane_ny, plane_nz, 0, 0.019), 'grazing slope: on it, not in it')

  -- ground tilted under a degree or two: lies on it reading straight away, no edge sunk in
  plane_nx, plane_ny, plane_nz = unit(-0.035, 1, 0.01)
  dx, dy, dz = unit(0.7, -1, -1)
  s = world_snap(fake_cast, 0, 1.6, 6, dx, dy, dz, 80, 0.15)
  assert(s.ok and near(s.nx, plane_nx, 1e-3) and near(s.ny, plane_ny, 1e-3), 'tilted ground: its normal')
  p = world_snap_pose(pl, &s, 0, 6, 0.02)
  a = world_axes(p.yaw, p.pitch)
  local hx, _, hz = unit(s.x, 0, s.z - 6)
  assert(a.ux * hx + a.uz * hz > 0.99, 'tilted ground: top edge away from the camera')
  assert(corners_clear(p, plane_nx, plane_ny, plane_nz, 0, 0.019), 'tilted ground: no edge sunk in')

  -- a thin pole: no plane to lie flush on, no snap
  scene()
  boxes:push({ -0.02, 0, -5.02, 0.02, 5, -4.98 })
  dx, dy, dz = unit(0.2, 0, -1)
  s = world_snap(fake_cast, 0, 1.6, 6, 0, 0, -1, 80, 0.15)
  assert(not s.ok, 'pole: no plane to measure, no snap')
  s = world_snap(fake_cast, 0, 1.6, 6, dx, dy, dz, 80, 0.15)
  assert(not s.ok, 'nothing under the cursor: no snap')
  scene()
  s = world_snap(fake_cast, 0, 1.6, 6, 0, 0, -1, 80, 0.15)
  assert(not s.ok, 'empty scene: no snap')
  s = world_snap(nilptr, 0, 1.6, 6, 0, 0, -1, 80, 0.15)
  assert(not s.ok, 'no raycast from the shim: no snap')
  print('snap OK')
end

-- Stretch-to-fit ----------------------------------------------------------------------
local function snapped_table(ox: float32, oy: float32, oz: float32, tx: float32, ty: float32, tz: float32): (WorldSnap, WorldPlacement)
  local dx, dy, dz = unit(tx - ox, ty - oy, tz - oz)
  local s = world_snap(fake_cast, ox, oy, oz, dx, dy, dz, 80, 0.15)
  assert(s.ok and near(s.ny, 1, 1e-3), 'snapped onto the top')
  local pl: WorldPlacement = { width = 1800, height = 1040, ppm = 640 }
  return s, world_snap_pose(pl, &s, ox, oz, 0.02)
end

-- corners of a fitted pose, on the plane y = top
local function fit_corners_on(p: WorldPlacement, inside: function(x: float32, z: float32): boolean): boolean
  local a = world_axes(p.yaw, p.pitch)
  local hw, hh = p.width / p.ppm * 0.5, p.height / p.ppm * 0.5
  local cs: [4][2]float32 = { { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }
  for i = 0, < 4 do
    local x = p.x + a.rx * hw * cs[i][0] + a.ux * hh * cs[i][1]
    local z = p.z + a.rz * hw * cs[i][0] + a.uz * hh * cs[i][1]
    if not inside(x, z) then return false end
  end
  return true
end

do
  -- a table top x -1..1.5, z -3..-2 at y 1, over a big floor; camera above and in front
  scene()
  boxes:push({ -20, -1, -20, 20, 0, 20 })
  boxes:push({ -1, 0.9, -3, 1.5, 1, -2 })
  local s, pose = snapped_table(0, 3, 1, 0, 1, -2.5)
  casts = 0
  local fit = world_fit(fake_cast, &s, pose.yaw, pose.pitch, 3, 0.1, 0.05, 0.4, 0.05)
  print('table fit', fit.w, fit.h, 'shift', fit.cr, fit.cu, 'rays', casts)
  assert(fit.ok and fit.w > 2.2 and fit.w <= 2.4 + 1e-3 and fit.h > 0.7 and fit.h <= 0.9 + 1e-3, 'table: the top, less the margin')
  assert(near(fit.cr, 0.25, 0.06) and near(fit.cu, 0, 0.06), 'table: centred on the top, not the cursor')
  local fp = world_fit_pose(pose, &fit)
  assert(near(fp.width / fp.ppm, fit.w, 1e-3) and near(fp.height / fp.ppm, fit.h, 1e-3) and fp.ppm == pose.ppm, 'fit size in panel pixels')
  assert(near(fp.y, pose.y, 1e-4), 'still flush on the top')
  local function on_table(x: float32, z: float32): boolean return x >= -1 and x <= 1.5 and z >= -3 and z <= -2 end
  assert(fit_corners_on(fp, on_table), 'table: every corner on the top')

  -- clutter on the table stops it
  boxes:push({ 0.8, 1, -3, 1.5, 1.3, -2 })
  fit = world_fit(fake_cast, &s, pose.yaw, pose.pitch, 3, 0.1, 0.05, 0.4, 0.05)
  local fp2 = world_fit_pose(pose, &fit)
  local function clear_of_clutter(x: float32, z: float32): boolean return x >= -1 and x <= 0.8 and z >= -3 and z <= -2 end
  assert(fit.ok and fit.w < 1.8 and fit_corners_on(fp2, clear_of_clutter), 'clutter: stops short of it')

  -- an L-shaped top: growing along the cross overshoots, the edges pull it back
  scene()
  boxes:push({ -20, -1, -20, 20, 0, 20 })
  boxes:push({ -1, 0.9, -3, 1, 1, -2 })
  boxes:push({ -1, 0.9, -4, 0, 1, -3 })
  s, pose = snapped_table(-0.3, 3, 1, -0.3, 1, -2.8)
  fit = world_fit(fake_cast, &s, pose.yaw, pose.pitch, 3, 0.1, 0.05, 0.4, 0.05)
  local fp3 = world_fit_pose(pose, &fit)
  local function on_l(x: float32, z: float32): boolean
    return (x >= -1 and x <= 1 and z >= -3 and z <= -2) or (x >= -1 and x <= 0 and z >= -4 and z <= -3)
  end
  print('L fit', fit.w, fit.h)
  assert(fit.ok and fit_corners_on(fp3, on_l), 'L shape: the rectangle stays on the top')

  -- a floor going on forever: bounded by fit_max each way, and by the ray count
  scene()
  boxes:push({ -50, -1, -50, 50, 0, 50 })
  s, pose = snapped_table(0, 3, 4, 0, 0, 0)
  casts = 0
  fit = world_fit(fake_cast, &s, pose.yaw, pose.pitch, 3, 0.1, 0.05, 0.4, 0.05)
  print('open floor fit', fit.w, fit.h, 'rays', casts)
  assert(fit.ok and fit.w <= 6 and fit.w >= 5.8 and fit.h <= 6 and fit.h >= 5.8, 'open floor: at most fit_max each way')
  assert(casts < 400, 'open floor: a bounded number of rays')

  -- a surface smaller than fit_min either way: no fit
  scene()
  boxes:push({ -20, -1, -20, 20, 0, 20 })
  boxes:push({ -0.175, 0.9, -2.675, 0.175, 1, -2.325 })
  s, pose = snapped_table(0, 3, -2.5, 0, 1, -2.5) -- from straight above: the probes land on it
  fit = world_fit(fake_cast, &s, pose.yaw, pose.pitch, 3, 0.1, 0.05, 0.4, 0.05)
  assert(not fit.ok, 'too small to stretch over')
  local same = world_fit_pose(pose, &fit)
  assert(same.width == pose.width and same.x == pose.x, 'no fit: the pose is unchanged')

  -- a wall: fits its face, upright
  scene()
  boxes:push({ -2, 0, -5.2, 1, 3, -5 })
  local ws = world_snap(fake_cast, 0, 1.6, 6, 0, 0, -1, 80, 0.15)
  local wp = world_snap_pose(pose, &ws, 0, 6, 0.02)
  fit = world_fit(fake_cast, &ws, wp.yaw, wp.pitch, 3, 0.1, 0.05, 0.4, 0.05)
  -- 3 x 3 less the margin, and up to a step short at each edge
  assert(fit.ok and fit.w >= 2.7 - 1e-3 and fit.w <= 2.9 + 1e-3 and fit.h >= 2.7 - 1e-3 and fit.h <= 2.9 + 1e-3 and near(fit.cr, -0.5, 0.06) and near(fit.cu, -0.1, 0.06), 'wall: its face')
  print('stretch OK')
end

-- The drag gesture ------------------------------------------------------------------
local function over_panel(): WorldDragInput
  return WorldDragInput{
    enabled = true, hover_id = 7, hover_u = 300, hover_v = 200, hover_dist = 6, shown = true,
    wheel_step = 0.5, min_distance = 1, max_distance = 20,
  }
end

do
  local d: WorldDrag
  local inp = over_panel()
  inp.lmb_pressed, inp.lmb_down = true, true
  local st = world_drag_step(&d, inp)
  assert(not st.armed and not st.started and d.id == 0, 'no Alt: a press is the panel\'s, not a drag')

  inp = over_panel()
  inp.alt = true
  st = world_drag_step(&d, inp)
  assert(st.armed and not st.started and d.id == 0, 'Alt over a panel arms it')
  inp.over_window = true
  st = world_drag_step(&d, inp)
  assert(not st.armed, 'not over an ImGui window')
  inp.over_window, inp.enabled = false, false
  st = world_drag_step(&d, inp)
  assert(not st.armed, 'not when switched off')
  inp.enabled, inp.hover_id = true, 0
  inp.lmb_pressed, inp.lmb_down = true, true
  st = world_drag_step(&d, inp)
  assert(not st.armed and not st.started, 'Alt over nothing picks nothing up')

  inp = over_panel()
  inp.alt, inp.lmb_pressed, inp.lmb_down = true, true, true
  st = world_drag_step(&d, inp)
  assert(st.started and st.dragging and st.id == 7 and d.id == 7 and d.u == 300 and d.v == 200 and d.dist == 6, 'Alt + press picks it up where it is held')

  -- carrying: Alt may go, the wheel moves it along the ray within bounds
  inp = over_panel()
  inp.lmb_down, inp.hover_id, inp.wheel = true, 0, 2
  st = world_drag_step(&d, inp)
  assert(st.dragging and not st.armed and st.id == 7 and d.dist == 7, 'still carried without Alt; wheel pushes it out')
  inp.wheel = -30
  st = world_drag_step(&d, inp)
  assert(d.dist == 1, 'never nearer than min_distance')
  inp.wheel = 100
  st = world_drag_step(&d, inp)
  assert(d.dist == 20, 'never farther than max_distance')
  inp.wheel, inp.shift = 0, true
  st = world_drag_step(&d, inp)
  assert(st.snap and not st.fit, 'Shift snaps')
  inp.ctrl = true
  st = world_drag_step(&d, inp)
  assert(st.snap and st.fit, 'Shift + Ctrl stretches')
  inp.shift = false
  st = world_drag_step(&d, inp)
  assert(not st.snap and not st.fit, 'Ctrl alone does neither')

  -- letting go drops it with the modifiers held at that moment
  inp.lmb_down, inp.shift, inp.ctrl = false, true, true
  st = world_drag_step(&d, inp)
  assert(st.dropped and st.id == 7 and st.snap and st.fit and d.id == 0, 'release drops it (snapped and stretched)')
  st = world_drag_step(&d, over_panel())
  assert(not st.dropped and not st.dragging and st.id == 0, 'dropped once')

  -- the right button puts it back; so does the panel going away
  inp = over_panel()
  inp.alt, inp.lmb_pressed, inp.lmb_down = true, true, true
  world_drag_step(&d, inp)
  inp = over_panel()
  inp.lmb_down, inp.rmb_down = true, true
  st = world_drag_step(&d, inp)
  assert(st.cancelled and not st.dropped and st.id == 7 and d.id == 0, 'right button cancels')
  inp = over_panel()
  inp.alt, inp.lmb_pressed, inp.lmb_down = true, true, true
  world_drag_step(&d, inp)
  inp = over_panel()
  inp.lmb_down, inp.shown = true, false
  st = world_drag_step(&d, inp)
  assert(st.cancelled and d.id == 0, 'panel gone cancels')
  print('drag gesture OK')
end

-- Dragging one pet onto another: the swap gesture -------------------------------------
do
  -- the title strip: the band the buttons sit in, and nothing outside the panel
  assert(world_title_strip(1800, 900, 0) and world_title_strip(1800, 0, WORLD_BUTTON_PITCH - 1))
  assert(not world_title_strip(1800, 900, WORLD_BUTTON_PITCH) and not world_title_strip(1800, -1, 10)
    and not world_title_strip(1800, 1800, 10) and not world_title_strip(1800, 900, -1), 'only the strip')

  local function on_title(): WorldOrderDragInput
    return WorldOrderDragInput{ enabled = true, hover_id = 7, on_title = true, mx = 100, my = 40,
      shown = true, threshold = 6 }
  end
  local d: WorldOrderDrag
  local inp = on_title()
  local st = world_order_drag_step(&d, inp)
  assert(st.armed and not st.started and d.id == 0, 'hovering a pet\'s title arms it')
  inp.alt = true
  st = world_order_drag_step(&d, inp)
  assert(not st.armed, 'Alt belongs to carrying a panel into the world')
  inp.alt, inp.on_title = false, false
  st = world_order_drag_step(&d, inp)
  assert(not st.armed, 'the grid below the title is for selecting text')
  inp = on_title()
  inp.enabled = false
  st = world_order_drag_step(&d, inp)
  assert(not st.armed, 'a single pet has nothing to swap with')
  inp = on_title()
  inp.over_window = true
  st = world_order_drag_step(&d, inp)
  assert(not st.armed, 'not over an ImGui window')

  -- a press that goes nowhere stays a click: nothing is swapped
  inp = on_title()
  inp.lmb_pressed, inp.lmb_down = true, true
  st = world_order_drag_step(&d, inp)
  assert(st.started and st.dragging and st.id == 7 and d.id == 7 and not d.moved)
  inp = on_title()
  inp.lmb_down, inp.hover_id = true, 7
  inp.mx, inp.my = 102, 41
  st = world_order_drag_step(&d, inp)
  assert(st.dragging and not d.moved and st.over == 0, 'a couple of pixels is still a click')
  inp.lmb_down = false
  st = world_order_drag_step(&d, inp)
  assert(not st.swap and st.cancelled and d.id == 0, 'a click swaps nothing')

  -- dragged onto another pet: that one is highlighted and they swap on release
  inp = on_title()
  inp.lmb_pressed, inp.lmb_down = true, true
  world_order_drag_step(&d, inp)
  inp = on_title()
  inp.lmb_down, inp.mx, inp.my = true, 400, 300
  inp.hover_id = 9
  st = world_order_drag_step(&d, inp)
  assert(st.dragging and d.moved and st.over == 9 and st.id == 7, 'the pet under the pointer is the drop target')
  inp.hover_id = 0
  st = world_order_drag_step(&d, inp)
  assert(st.over == 0, 'over nothing: no highlight')
  inp.hover_id = 9
  world_order_drag_step(&d, inp)
  inp.lmb_down = false
  st = world_order_drag_step(&d, inp)
  assert(st.swap and st.id == 7 and st.over == 9 and not st.cancelled and d.id == 0, 'released on another pet: swap them')
  st = world_order_drag_step(&d, on_title())
  assert(not st.swap and st.id == 0, 'swapped once')

  -- dropped on itself, on nothing, on an ImGui window; cancelled by the right
  -- button, by Alt, and by the pet going away
  -- Nelua has no closures, so the gesture state is a parameter.
  local function grab(g: *WorldOrderDrag): void
    local i2 = on_title()
    i2.lmb_pressed, i2.lmb_down = true, true
    world_order_drag_step(g, i2)
    i2 = on_title()
    i2.lmb_down, i2.mx, i2.my = true, 400, 300
    i2.hover_id = 7
    world_order_drag_step(g, i2)
  end
  grab(&d)
  inp = on_title()
  inp.lmb_down, inp.hover_id = false, 7
  st = world_order_drag_step(&d, inp)
  assert(st.cancelled and not st.swap, 'dropped on itself: nothing')
  grab(&d)
  inp = on_title()
  inp.lmb_down, inp.rmb_down, inp.hover_id = true, true, 9
  st = world_order_drag_step(&d, inp)
  assert(st.cancelled and not st.swap and d.id == 0, 'the right button cancels')
  grab(&d)
  inp = on_title()
  inp.lmb_down, inp.alt, inp.hover_id = true, true, 9
  st = world_order_drag_step(&d, inp)
  assert(st.cancelled and d.id == 0, 'Alt takes over: cancelled')
  grab(&d)
  inp = on_title()
  inp.lmb_down, inp.shown, inp.hover_id = true, false, 9
  st = world_order_drag_step(&d, inp)
  assert(st.cancelled and d.id == 0, 'the pet went away: cancelled')
  print('order drag gesture OK')
end

-- The carried pose: the held pixel stays under the cursor -----------------------------
do
  local rc = look_camera(3, 4, 10, -1, 1, 0)
  local cursor = vec2(620, 300)
  local ok, ox, oy, oz, dx, dy, dz = world_cursor_ray(&rc, cursor.x, cursor.y)
  assert(ok)
  local pl: WorldPlacement = { x = 0, y = 1, z = 0, yaw = 2, pitch = 0.3, width = 1800, height = 1040, ppm = 640, curve = 9 }
  local p = world_drag_pose(pl, ox, oy, oz, dx, dy, dz, 5, 400, 300)
  local b = world_basis(p)
  local hok, hovered, u, v = world_hit(&rc, &b, cursor)
  assert(hok and hovered and near(u, 400, 1) and near(v, 300, 1), 'the grabbed pixel stays under the cursor')
  local gx, gy, gz = world_point(&b, 400, 300)
  assert(near(math.sqrt((gx - ox) ^ 2 + (gy - oy) ^ 2 + (gz - oz) ^ 2), 5, 1e-3), 'held at its distance from the camera')
  local fx, fz = math.sin(p.yaw), math.cos(p.yaw)
  local cx, cz = ox - gx, oz - gz
  assert((fx * cx + fz * cz) / math.sqrt(cx * cx + cz * cz) > 0.9999, 'turned to face the camera')
  assert(p.pitch == 0 and p.curve == 0 and p.width == 1800 and p.ppm == 640, 'upright and flat, same size')
  print('carried pose OK')
end

-- Dropping through lua/world.lua ------------------------------------------------------
local territory: uint32 = 132
local function fake_object(which: cint, id: uint64, out: *GuObject): cint
  $out = { x = 10, y = 0, z = 20, rotation = 0, entity_id = 7, territory = territory, found = 1 }
  return 1
end
world_host.get_object = fake_object

do
  local root: string = arg[1]
  assert(policy_load(root), policy.error)
  local t = world_read_tuning(policy.L)
  assert(t.drag and near(t.drag_offset, 0.02, 1e-5) and near(t.drag_fit_max, 3, 1e-5) and near(t.drag_wheel_step, 0.35, 1e-5), 'lua/world.lua drag tuning read')
  assert(lua_gettop(policy.L) == 0, 'tuning leaves the Lua stack balanced')

  local function lua_ok(code: string): boolean
    return luaL_loadstring(policy.L, code) == LUA_OK and lua_pcall(policy.L, 0, 0, 0) == LUA_OK
  end

  local pose: WorldPlacement = { x = 1, y = 2, z = 3, yaw = 0.5, pitch = 1.2, width = 1520, height = 880, ppm = 660, curve = 9 }
  -- a pet, a panel following you and one over your target all become world pins
  assert(#policy_world_command(5, 'pet') == 0)
  assert(#policy_world_command(6, 'me') == 0)
  assert(not world_lua_walkable(policy.L, 5), 'a pet is not walkable before')
  local e = policy_world_drop(5, pose, 0, 0)
  assert(#e == 0, e)
  e = policy_world_drop(6, pose, 0, 0)
  assert(#e == 0, e)
  local pok, p = policy_world_place(5, 1, false)
  assert(pok and near(p.x, 1, 1e-4) and near(p.y, 2, 1e-4) and near(p.z, 3, 1e-4) and near(p.yaw, 0.5, 1e-4) and near(p.pitch, 1.2, 1e-4), 'dropped where it was let go')
  assert(p.width == 1520 and p.height == 880 and p.ppm == 660 and p.curve == 0, 'same size in the world, flat')
  assert(lua_ok('local a = CONFIG.world.anchors assert(a[5].kind == "world" and a[5].zone == 132 and a[6].kind == "world")'), 'anchors are world pins in this zone')
  assert(world_lua_walkable(policy.L, 5) and world_lua_walkable(policy.L, 6), 'world pins are walkable')
  pok = policy_world_place(6, 1, false)
  assert(pok, 'a follower stays where it was dropped')

  -- stretched: the size in yalms is kept, the pixel density follows
  assert(#policy_world_command(8, 'here') == 0)
  e = policy_world_drop(8, pose, 1.2, 0.6)
  assert(#e == 0, e)
  pok, p = policy_world_place(8, 1, false)
  assert(pok and near(p.width / p.ppm, 1.2, 1e-3) and near(p.height / p.ppm, 0.6, 1e-3) and p.width >= 600 and p.height >= 320, 'stretched to 1.2 x 0.6 yalms')
  e = policy_world_drop(8, pose, 0.3, 0.2)
  assert(#e == 0, e)
  pok, p = policy_world_place(8, 1, false)
  assert(pok and near(p.width / p.ppm, 0.3, 1e-3) and near(p.height / p.ppm, 0.2, 1e-3), 'a small surface: denser pixels, same world size')

  -- persisted like any world pin (pitch included)
  local entries: vector(LayoutEntry)
  entries:push(LayoutEntry{ id = 5, agent = 9001, view = 'world', font_scale = 0 })
  policy_world_save(&entries)
  entries:destroy()
  assert(lua_ok('local s = dofile(GHOSTTY_PLUGIN_DIR .. "/world-state.lua")[9001] assert(s.kind == "world" and s.zone == 132 and math.abs(s.pitch - 1.2) < 1e-4)'), 'saved as a world pin')
  local state = root .. '/world-state.lua'
  os.remove(state)
  state:destroy()

  -- another zone hides it; unknown terminals report an error
  territory = 133
  pok = policy_world_place(5, 1, false)
  assert(not pok, 'pinned to the zone it was dropped in')
  e = policy_world_drop(99, pose, 0, 0)
  assert(#e > 0, 'unknown terminal: error')
  e:destroy()
  assert(lua_gettop(policy.L) == 0, 'drop leaves the Lua stack balanced')
  print('drop OK')
end
