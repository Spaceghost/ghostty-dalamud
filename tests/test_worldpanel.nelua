-- Clicked world panels: the presented pose, title buttons, the wake fade, the
-- walk-up state machine, and their tuning in lua/world.lua.
require 'core.world'
require 'core.policy'
require 'core.app.worldview'
require 'core.app.commands' -- /term pin
require 'core.app.cursor'
require 'string'
require 'math'
require 'arg'

local function near(a: float32, b: float32, eps: float32): boolean return math.abs(a - b) < eps end
local function dist3(ax: float32, ay: float32, az: float32, bx: float32, by: float32, bz: float32): float32
  return math.sqrt((ax - bx) ^ 2 + (ay - by) ^ 2 + (az - bz) ^ 2)
end

-- Camera at (0, 1.6, 6) looking down -Z: w = 6 - z.
local cam: GuCamera = { width = 1000, height = 500 }
cam.m[0] = 1
cam.m[5] = 1
cam.m[11] = -1
cam.m[13] = -1.6
cam.m[15] = 6

do
  local ok, cx, cy, cz = world_camera_position(&cam)
  assert(ok and near(cx, 0, 1e-4) and near(cy, 1.6, 1e-4) and near(cz, 6, 1e-4), 'camera position from the view-projection matrix')
  print('camera position OK')
end

-- Presented pose ------------------------------------------------------------------
local function camera_present(occ_depth: float32): WorldPresent
  -- goal 1.6 yalms in front of the camera at the character's eye height
  return WorldPresent{
    vx = 0, vy = 1.6, vz = 6, gx = 0, gy = 1.6, gz = 4.4,
    cam_x = 0, cam_y = 1.6, cam_z = 6,
    fraction = 0.4, min_distance = 1.2, curve_relax = 0.5, margin = 0.35, occ_depth = occ_depth,
  }
end

local function faces(p: WorldPlacement, x: float32, z: float32): float32
  local dx, dz = x - p.x, z - p.z
  local l = math.sqrt(dx * dx + dz * dz)
  return (math.sin(p.yaw) * dx + math.cos(p.yaw) * dz) / l
end

local function bulge(p: WorldPlacement): float32
  return p.curve * (1 - math.cos(p.width * 0.5 / p.ppm / p.curve))
end

do
  local placed: WorldPlacement = { x = 1.5, y = 1.8, z = -2, yaw = 0.6, pitch = 0.2, width = 1800, height = 1040, ppm = 640, curve = 3, opacity = 0.9 }
  -- character at z = 2 (well in front of the panel)
  local pr = camera_present(world_depth(&cam, 0, 0.8, 2))
  local same = world_present_pose(&cam, placed, &pr, 0)
  assert(same.x == placed.x and same.z == placed.z and same.yaw == placed.yaw, 'blend 0 is the placement')
  local p = world_present_pose(&cam, placed, &pr, 1)
  print('presented', p.x, p.y, p.z, 'yaw', p.yaw, 'curve', p.curve)
  assert(dist3(p.x, p.y, p.z, 0, 1.6, 6) < dist3(placed.x, placed.y, placed.z, 0, 1.6, 6) - 1, 'presented pose is nearer the camera')
  assert(faces(p, 0, 6) > 0.999, 'presented pose faces the camera')
  assert(near(p.pitch, 0, 1e-4), 'presented pose stands upright')
  assert(p.curve > placed.curve, 'presented pose is flatter')
  assert(p.width == placed.width and p.ppm == placed.ppm, 'size is untouched')
  assert(world_depth(&cam, p.x, p.y, p.z) - bulge(p) >= pr.occ_depth + pr.margin - 0.01, 'stays behind the character')
  -- halfway through the ease it is halfway there
  local h = world_present_pose(&cam, placed, &pr, 0.5)
  assert(near(h.z, (placed.z + p.z) * 0.5, 0.01), 'blend moves linearly between the poses')

  -- a character nearer the camera stops the panel at its depth
  local pr2 = camera_present(world_depth(&cam, 0, 0.8, 1))
  local q = world_present_pose(&cam, placed, &pr2, 1)
  print('held behind the character at depth', world_depth(&cam, q.x, q.y, q.z), 'character', pr2.occ_depth)
  assert(q.z < p.z - 0.05, 'moves less when the character is in the way')
  assert(world_depth(&cam, q.x, q.y, q.z) - bulge(placed) >= pr2.occ_depth + pr2.margin - 0.01, 'never crosses the character depth')
  assert(q.z > placed.z + 0.1, 'still floats part of the way')

  -- a panel already in front of the character does not come any nearer, but turns
  local front: WorldPlacement = placed
  front.z = 3.5
  local r = world_present_pose(&cam, front, &pr, 1)
  assert(r.x == front.x and r.y == front.y and r.z == front.z, 'in front of the character: stays put')
  assert(faces(r, 0, 6) > 0.999, 'in front of the character: still turns to the camera')

  -- never nearer the camera than min_distance
  local close: WorldPlacement = { x = 0, y = 1.6, z = 4, yaw = 0, width = 900, height = 500, ppm = 640 }
  local pr3 = camera_present(0)
  pr3.fraction = 1
  pr3.min_distance = 1.9
  local c = world_present_pose(&cam, close, &pr3, 1)
  assert(dist3(c.x, c.y, c.z, 0, 1.6, 6) >= 1.9 - 0.01 and c.z > close.z, 'min distance to the camera')
  print('present camera OK')
end

-- walk-up: the goal is the spot the character walks to, 1.8 yalms before the panel
do
  local placed: WorldPlacement = { x = 0, y = 1.8, z = -2, yaw = math.pi, width = 1800, height = 1040, ppm = 640 }
  local pr: WorldPresent = {
    vx = 0, vy = 1.6, vz = -0.2, gx = 0, gy = 1.6, gz = -0.2,
    cam_x = 0, cam_y = 1.6, cam_z = 6,
    fraction = 0.4, min_distance = 1.2, curve_relax = 0.5, margin = 0.35, occ_depth = world_depth(&cam, 0, 0.8, 3),
  }
  local p = world_present_pose(&cam, placed, &pr, 1)
  print('walk-up presented', p.x, p.y, p.z, 'yaw', p.yaw)
  assert(p.z > placed.z + 0.5, 'floats toward the approach point')
  assert(dist3(p.x, p.y, p.z, 0, 1.6, -0.2) >= 1.2 - 0.01, 'never nearer where the character will stand than min_distance')
  assert(faces(p, 0, -0.2) > 0.999, 'turns to face the character (it was facing away)')
  print('present walk-up OK')
end

-- Ease ------------------------------------------------------------------------------
do
  local function run(fps: integer, seconds: float32, target: float32, x0: float32): float32
    local x, v = x0, (@float32)(0)
    local frames = (@integer)(seconds * fps + 0.5)
    for _ = 1, frames do
      local nx, nv = world_ease(x, v, target, (@float32)(1.0 / fps), 0.35)
      assert(nx <= 1.0001 and nx >= -0.0001, 'critically damped: no overshoot')
      if target > x0 then assert(nx >= x - 1e-6, 'monotonic toward the target') end
      x, v = nx, nv
    end
    return x
  end
  local early = run(60, 0.1, 1, 0)
  assert(early > 0.2 and early < 0.9, 'eases in, not a jump')
  assert(run(60, 0.35, 1, 0) > 0.97, 'settles in about 0.35 s')
  assert(math.abs(run(30, 0.2, 1, 0) - run(120, 0.2, 1, 0)) < 0.002, 'same motion at any frame rate')
  assert(run(60, 0.35, 0, 1) < 0.03 and run(60, 0.8, 0, 1) == 0, 'floats back and comes to rest')
  print('ease OK')
end

-- Title buttons -------------------------------------------------------------------
do
  local w: float32 = 1800
  assert(world_title_button(w, 1790, 10) == WORLD_BUTTON_CLOSE)
  assert(world_title_button(w, 1750, 10) == WORLD_BUTTON_FULL)
  assert(world_title_button(w, 1720, 10) == WORLD_BUTTON_POPIN)
  assert(world_title_button(w, 1680, 10) == WORLD_BUTTON_PET, 'pin <-> pet next to pop-in')
  assert(world_title_button(w, 1650, 10) == WORLD_BUTTON_OCCLUDED, 'keep running left of it')
  assert(world_title_button(w, 1610, 10) == WORLD_BUTTON_NONE, 'nothing left of the buttons')
  assert(world_title_button(w, 1790, 40) == WORLD_BUTTON_NONE, 'below the title row')
  assert(world_title_button(w, 1790, -1) == WORLD_BUTTON_NONE, 'above the panel')
  assert(world_title_button(w, 1801, 10) == WORLD_BUTTON_NONE, 'right of the panel')
  -- each drawn square sits inside its own hit column, clear of its neighbours
  for b = WORLD_BUTTON_CLOSE, WORLD_BUTTON_OCCLUDED do
    local x = world_title_button_x(w, b)
    assert(world_title_button(w, x + 1, 5) == b and world_title_button(w, x + 25, 25) == b, 'square hits its own button')
    assert(world_title_button(w, x + 13, 13) == b, 'square centre hits its own button')
  end
  assert(world_title_button_x(w, WORLD_BUTTON_CLOSE) == w - 30 and world_title_button_x(w, WORLD_BUTTON_POPIN) == w - 98, 'existing buttons keep their places')
  assert(world_title_button_x(w, WORLD_BUTTON_PET) == w - 132 and WORLD_BUTTON_COUNT == 5)
  print('title buttons OK')
end

-- Wake fade ---------------------------------------------------------------------
do
  assert(world_wake_fade(0, 50, 0.25) == 1, 'never slept: fully shown')
  assert(world_wake_fade(10, 10, 0.25) == 0, 'just woke: hidden')
  assert(near(world_wake_fade(10, 10.125, 0.25), 0.5, 1e-3), 'halfway at 0.125 s')
  assert(world_wake_fade(10, 10.25, 0.25) == 1 and world_wake_fade(10, 12, 0.25) == 1, 'fully in after 0.25 s')
  local last: float32 = 0
  for k = 0, 25 do
    local f = world_wake_fade(10, 10 + k * 0.01, 0.25)
    assert(f >= last, 'fades in monotonically')
    last = f
  end
  print('wake fade OK')
end

-- Walk-up state machine -----------------------------------------------------------
local function walk_input(now: float64, x: float32, z: float32, rotation: float32): WorldWalkInput
  return WorldWalkInput{
    now = now, dt = 1.0 / 60, focus_id = 7, found = true,
    x = x, z = z, rotation = rotation,
    approach = 1.8, max_seconds = 3, turn_speed = 8, stuck_seconds = 0.5,
  }
end

do -- turn first, then walk, then arrive and let go
  local w: WorldWalk
  world_walk_start(&w, 7, 0, 0, 0, 0, 10)
  local x: float32, z: float32, rot: float32 = 0, 0, math.pi / 2
  local now: float64 = 0
  local st = world_walk_step(&w, walk_input(now, x, z, rot))
  assert(st.turn and not st.hold, 'facing away: turn before walking')
  local held_frames, released = 0, false
  for _ = 1, 400 do
    now = now + 1.0 / 60
    if st.turn then rot = st.rotation end
    if st.hold then
      held_frames = held_frames + 1
      x, z = x + math.sin(rot) * 0.1, z + math.cos(rot) * 0.1
    end
    st = world_walk_step(&w, walk_input(now, x, z, rot))
    if st.release then released = true break end
  end
  print('walked to', x, z, 'in', now, 's')
  assert(held_frames > 0 and released and w.id == 0 and w.ended == WORLD_WALK_ARRIVED, 'arrives and releases the key')
  assert(math.sqrt(x * x + (10 - z) ^ 2) <= 1.8 + 0.11, 'stops within the approach distance')
end

-- one walk already under way (facing the panel, key held)
local function walking(w: *WorldWalk): void
  world_walk_start(w, 7, 0, 0, 0, 0, 10)
  local st = world_walk_step(w, walk_input(0, 0, 0, 0))
  assert(st.hold, 'facing the panel: walks at once')
end

do
  local w: WorldWalk
  walking(&w)
  local inp = walk_input(0.1, 0, 0.3, 0)
  inp.user_input = true
  local st = world_walk_step(&w, inp)
  assert(st.release and not st.hold and w.ended == WORLD_WALK_USER_INPUT, 'player input stops it')
  st = world_walk_step(&w, walk_input(0.2, 0, 0.3, 0))
  assert(not st.hold and not st.release and not st.turn, 'stays stopped (never walks back)')

  walking(&w)
  inp = walk_input(0.1, 0, 0.3, 0)
  inp.focus_id = 8
  st = world_walk_step(&w, inp)
  assert(st.release and w.ended == WORLD_WALK_FOCUS_LOST, 'losing focus stops it')

  walking(&w)
  inp = walk_input(0.1, 0, 0.3, 0)
  inp.in_combat = true
  st = world_walk_step(&w, inp)
  assert(st.release and w.ended == WORLD_WALK_COMBAT, 'combat stops it')

  walking(&w)
  inp = walk_input(0.1, 0, 0.3, 0)
  inp.mounted = true
  st = world_walk_step(&w, inp)
  assert(st.release and w.ended == WORLD_WALK_MOUNTED, 'mounting stops it')

  -- blocked by a wall: no ground covered for 0.5 s
  walking(&w)
  st = world_walk_step(&w, walk_input(0.4, 0, 0, 0))
  assert(st.hold, 'not stuck yet at 0.4 s')
  st = world_walk_step(&w, walk_input(0.6, 0, 0, 0))
  assert(st.release and w.ended == WORLD_WALK_STUCK, 'stuck against a wall stops it')

  -- slow progress that never arrives
  walking(&w)
  local t: float64 = 0
  local zz: float32 = 0
  repeat
    t = t + 0.1
    zz = zz + 0.06
    st = world_walk_step(&w, walk_input(t, 0, zz, 0))
  until not st.hold
  assert(st.release and w.ended == WORLD_WALK_TIMEOUT and t > 3 and t < 3.2, 'gives up after max_seconds')

  -- moving away (e.g. camera-relative movement)
  walking(&w)
  st = world_walk_step(&w, walk_input(0.1, 0, -1.2, 0))
  assert(st.release and w.ended == WORLD_WALK_WRONG_WAY, 'going the wrong way stops it')

  -- already there: nothing to hold, nothing to release
  world_walk_start(&w, 7, 0, 0, 9, 0, 10)
  st = world_walk_step(&w, walk_input(0, 0, 9, 0))
  assert(not st.hold and not st.release and w.ended == WORLD_WALK_ARRIVED, 'already close enough')

  -- cancelling reports whether the key was down
  walking(&w)
  assert(world_walk_stop(&w, WORLD_WALK_CANCELLED) and w.id == 0 and w.ended == WORLD_WALK_CANCELLED, 'cancel while holding releases')
  assert(not world_walk_stop(&w, WORLD_WALK_CANCELLED), 'cancel when idle does nothing')
  print('walk OK')
end

-- Tuning and walkability from lua/world.lua ---------------------------------------
do
  local d = world_read_tuning(nilptr)
  assert(d.present and near(d.present_fraction, 0.4, 1e-4) and near(d.walk_approach, 1.8, 1e-4), 'defaults without Lua')
  local function fake_object(which: cint, id: uint64, out: *GuObject): cint
    $out = { x = 10, y = 0, z = 20, rotation = 0, entity_id = 7, territory = 132, found = 1 }
    return 1
  end
  world_host.get_object = fake_object
  local root: string = arg[1]
  assert(policy_load(root), policy.error)
  local t = world_read_tuning(policy.L)
  assert(not t.present and t.walk and near(t.full_screen, 0.62, 1e-4) and near(t.present_ease, 0.35, 1e-4) and near(t.present_min_distance, 1.2, 1e-4)
    and near(t.walk_max_seconds, 3, 1e-4), 'lua/world.lua tuning read (single click does not float by default)')
  assert(luaL_loadstring(policy.L, 'CONFIG.world.present.fraction = 0.6 CONFIG.world.walk.enabled = false') == LUA_OK and lua_pcall(policy.L, 0, 0, 0) == LUA_OK)
  t = world_read_tuning(policy.L)
  assert(near(t.present_fraction, 0.6, 1e-4) and not t.walk, 'changed settings are read the next frame')
  assert(lua_gettop(policy.L) == 0, 'reading tuning leaves the Lua stack balanced')
  local e = policy_world_command(1, 'here')
  assert(#e == 0, e)
  e = policy_world_command(2, 'pet')
  assert(#e == 0, e)
  e = policy_world_command(3, 'me')
  assert(#e == 0, e)
  assert(world_lua_walkable(policy.L, 1), 'a pin in the world is walkable')
  assert(not world_lua_walkable(policy.L, 2), 'a pet moves with you: not walkable')
  assert(not world_lua_walkable(policy.L, 3), 'a panel following you: not walkable')
  assert(not world_lua_walkable(policy.L, 99), 'unknown terminal: not walkable')
  assert(lua_gettop(policy.L) == 0, 'walkable leaves the Lua stack balanced')
  print('tuning OK')
end

-- Steering through the game's walk input: no turning, the direction is
-- relative to the reference heading (character facing or camera).
do
  local w: WorldWalk
  world_walk_start(&w, 7, 0, 0, 0, 0, 10) -- panel straight ahead along +Z
  local inp = walk_input(0, 0, 0, 0)
  inp.turn_speed = 0
  local st = world_walk_step(&w, inp)
  assert(st.hold and not st.turn, 'steering mode sets off at once without turning')
  local ok, left, fwd = world_walk_steer(&w, 0, 0, 0)
  assert(ok and math.abs(left) < 1e-4 and math.abs(fwd - 1) < 1e-4, 'facing the panel: straight forward')
  ok, left, fwd = world_walk_steer(&w, 0, 0, (@float32)(math.pi / 2)) -- facing +X
  assert(ok and math.abs(left + 1) < 1e-4 and math.abs(fwd) < 1e-4, 'panel to the side: strafe toward it')
  print('walk steer OK')
end

-- lua/world.lua per frame: no garbage -----------------------------------------------
-- Three pets placed for 600 frames with the collector stopped: the placement
-- tables, the player, the light and the pet order are all reused.
do
  local function fake_env(day: *float32, rain: *float32, weather: *uint8): cint
    $day = 19 * 3600 $rain = 0.5 $weather = 7
    return 1
  end
  world_host.get_environment = fake_env
  local code: cstring = [[
    local w = CONFIG.world
    for id = 201, 203 do assert(w.command(id, 'pet') == nil) end
    for f = 1, 5 do for id = 201, 203 do assert(w.place(id, 500 + f / 60, id == 202)) end end
    collectgarbage('collect')
    collectgarbage('stop')
    local before = collectgarbage('count')
    for f = 1, 600 do
      local t = 501 + f / 60
      for id = 201, 203 do assert(w.place(id, t, false)) end
    end
    local grew = collectgarbage('count') - before
    collectgarbage('restart')
    print('placing 3 pets for 600 frames made KB', grew)
    assert(grew < 64, 'placing pets makes garbage every frame')
    -- and with one focused: the others line up beside it
    for f = 1, 5 do for id = 201, 203 do assert(w.place(id, 511 + f / 60, id == 202)) end end
    collectgarbage('collect')
    collectgarbage('stop')
    before = collectgarbage('count')
    for f = 1, 600 do
      local t = 512 + f / 60
      for id = 201, 203 do assert(w.place(id, t, id == 202)) end
    end
    grew = collectgarbage('count') - before
    collectgarbage('restart')
    for id = 201, 203 do w.forget(id) end
    print('placing 3 lined-up pets for 600 frames made KB', grew)
    assert(grew < 64, 'lining pets up makes garbage every frame')
  ]]
  assert(luaL_loadstring(policy.L, code) == LUA_OK, 'load')
  if lua_pcall(policy.L, 0, 0, 0) ~= LUA_OK then
    print(lua_tolstring(policy.L, -1, nilptr))
    assert(false, 'pets without garbage')
  end
  world_host.get_environment = nilptr
  print('world place garbage OK')
end

-- lua/world.lua persistence: written only when changed, through a swap, and
-- without a pet's spring position or values that would not load back.
do
  local code: cstring = [[
    local w = CONFIG.world
    local path = (GHOSTTY_PLUGIN_DIR or '.') .. '/world-state.lua'
    local real_open = io.open
    local keep = nil -- other tests' saved layout, put back afterwards
    local f = real_open(path, 'r')
    if f then keep = f:read('a') f:close() end
    assert(w.command(301, 'pet') == nil)
    assert(w.command(302, 'here') == nil)
    w.place(301, 700, true)
    w.place(301, 700.1, true)
    assert(w.anchors[301].x, 'the pet has a spring position')
    local list = { { id = 301, agent = 9301, view = 'world', font_scale = 0 }, { id = 302, agent = 9302, view = 'world', font_scale = 0 } }
    local writes = 0
    io.open = function(p, mode)
      if mode == 'w' then writes = writes + 1 end
      return real_open(p, mode)
    end
    w.save_state(list)
    w.save_state(list)
    io.open = real_open
    assert(writes == 1, 'an unchanged layout is not written again')
    f = real_open(path, 'r')
    local text = f:read('a')
    f:close()
    local pet = text:match('%[9301%] = {[^\n]*')
    local pin = text:match('%[9302%] = {[^\n]*')
    assert(pet and not pet:find('[{,] x = ') and not pet:find('[{,] z = ') and not pet:find('faced'), 'no pet spring state saved: ' .. tostring(pet))
    assert(pin and pin:find('[{,] x = ') and pin:find('[{,] z = '), 'a pin keeps its position: ' .. tostring(pin))
    assert(not real_open(path .. '.tmp', 'r'), 'the swap file is gone')
    w.anchors[302].x = 1 / 0
    w.anchors[302].y = 0 / 0
    w.save_state(list)
    local chunk, err = loadfile(path)
    assert(chunk, err)
    local saved = chunk()
    assert(saved[9302] and saved[9302].z and saved[9302].x == nil, 'inf and nan are left out')
    -- a failed write (disk full) leaves the saved file alone
    f = real_open(path, 'r')
    local good = f:read('a') f:close()
    w.anchors[302].z = 5
    io.open = function(p, mode)
      local rf = real_open(p, mode)
      if mode ~= 'w' or not rf then return rf end
      return {
        write = function(_, s) rf:write(s:sub(1, 8)) return nil, 'No space left on device' end,
        close = function() return rf:close() end,
      }
    end
    w.save_state(list)
    io.open = real_open
    f = real_open(path, 'r')
    local after = f:read('a')
    f:close()
    assert(after == good, 'a short write does not replace the saved state')
    assert(not real_open(path .. '.tmp', 'r'), 'the short swap file is removed')
    w.save_state(list)
    f = real_open(path, 'r')
    after = f:read('a')
    f:close()
    assert(after ~= good and loadfile(path), 'the next good save still writes')
    w.forget(301)
    w.forget(302)
    w._last_saved = nil
    if keep then
      f = real_open(path, 'w') f:write(keep) f:close()
    else
      os.remove(path)
    end
  ]]
  assert(luaL_loadstring(policy.L, code) == LUA_OK, 'load')
  if lua_pcall(policy.L, 0, 0, 0) ~= LUA_OK then
    print(lua_tolstring(policy.L, -1, nilptr))
    assert(false, 'world state persistence')
  end
  print('world state save OK')
end

-- CONFIG.world_pins ---------------------------------------------------------------
-- Not before a character is loaded (retried once a second); a pin that cannot
-- be placed (no target) is dropped without its freed session ending up in the
-- world, and the pins after it still go in.
do
  local function no_player(which: cint, id: uint64, out: *GuObject): cint
    $out = {}
    return 1
  end
  local function player_only(which: cint, id: uint64, out: *GuObject): cint
    $out = {}
    if which == WORLD_PLAYER then $out = { x = 10, y = 0, z = 20, rotation = 0, entity_id = 7, territory = 132, found = 1 } end
    return 1
  end
  host.api.get_object = no_player
  world_host.get_object = no_player
  assert(luaL_loadstring(policy.L, "CONFIG.world_pins = { 'me', 'target', 'me' }") == LUA_OK and lua_pcall(policy.L, 0, 0, 0) == LUA_OK)
  policy_refresh()
  assert(#policy.world_pins == 3 and #policy.profiles > 0)
  apply_world_pins(100)
  assert(not host.world_pins_done and #host.sessions == 0 and #host.world == 0, 'title screen: no sessions, tried again later')
  host.api.get_object = player_only
  world_host.get_object = player_only
  apply_world_pins(100.5)
  assert(#host.sessions == 0, 'retried once a second')
  apply_world_pins(101)
  assert(#host.world == 2 and #host.sessions == 2 and host.world_pins_done, 'the target pin is dropped, the ones around it kept')
  assert(host.world[0] == host.sessions[0] and host.world[1] == host.sessions[1] and host.world_visible, 'the kept pins are the live sessions, shown')
  local pok = policy_world_place(host.world[1].id, 0, false)
  assert(pok, 'the pin after the dropped one is placed')
  print('world pins OK')
end

-- draw_world on a fake ImGui ------------------------------------------------------
-- A reversed-Z game camera behind the player at (10, 0, 20), looking along +Z
-- (as in tests/test_depthpass.nelua); panels pinned in front of the player.
local MAX_CMDS <comptime> = 4096
local MAX_VERTS <comptime> = 400000
local cmds: [MAX_CMDS]ImDrawCmd
local verts: [MAX_VERTS]ImDrawVert
local dl: ImDrawList
local viewport: ImGuiViewport = { Size = { 2560, 1440 } }
local io_state: ImGuiIO
local now: float64 = 200
local mouse_at: ImVec2 = { -5000, -5000 }
local texts, focus_nil_calls, frame_count, diag_lines, diag_drawing = 0, 0, 0, 0, 0

local function reset_list(): void
  cmds[0] = { ClipRect = { 0, 0, 2560, 1440 } }
  dl.CmdBuffer = { Size = 1, Capacity = MAX_CMDS, Data = (@*[0]ImDrawCmd)(&cmds) }
  dl.VtxBuffer = { Size = 0, Capacity = MAX_VERTS, Data = (@*[0]ImDrawVert)(&verts) }
end
local function push_vert(p: ImVec2, col: uint32): void
  assert(dl.VtxBuffer.Size < MAX_VERTS)
  verts[dl.VtxBuffer.Size] = { pos = p, col = col }
  dl.VtxBuffer.Size = dl.VtxBuffer.Size + 1
  cmds[dl.CmdBuffer.Size - 1].ElemCount = cmds[dl.CmdBuffer.Size - 1].ElemCount + 1
end
local function quad(a: ImVec2, b: ImVec2, col: uint32): void
  push_vert(a, col) push_vert(vec2(b.x, a.y), col) push_vert(b, col) push_vert(vec2(a.x, b.y), col)
end
local function fake_rect_filled(l: *ImDrawList, a: ImVec2, b: ImVec2, col: uint32, rounding: float32, flags: cint): void quad(a, b, col) end
local function fake_rect(l: *ImDrawList, a: ImVec2, b: ImVec2, col: uint32, rounding: float32, flags: cint, th: float32): void quad(a, b, col) end
local function fake_line(l: *ImDrawList, a: ImVec2, b: ImVec2, col: uint32, th: float32): void quad(a, b, col) end
local function fake_triangle(l: *ImDrawList, a: ImVec2, b: ImVec2, c: ImVec2, col: uint32): void
  push_vert(a, col) push_vert(b, col) push_vert(c, col)
end
local function fake_text(l: *ImDrawList, font: *ImFont, size: float32, pos: ImVec2, col: uint32, tb: cstring, te: cstring, ww: float32, clip: *ImVec4): void
  texts = texts + 1
  quad(pos, vec2(pos.x + 8, pos.y + 16), col)
end
local function fake_prim_reserve(l: *ImDrawList, idx: cint, vtx: cint): void end
local function fake_prim_vtx(l: *ImDrawList, pos: ImVec2, uv: ImVec2, col: uint32): void push_vert(pos, col) end
local function fake_uv(out: *ImVec2): void $out = vec2(0, 0) end
local function fake_push_clip(l: *ImDrawList, a: ImVec2, b: ImVec2, intersect: boolean): void end
local function fake_pop_clip(l: *ImDrawList): void end
local function fake_calc(pOut: *ImVec2, font: *ImFont, size: float32, mw: float32, ww: float32, tb: cstring, te: cstring, rem: *cstring): void
  $pOut = vec2(8, 16)
end
local function fake_bg(): *ImDrawList return &dl end
local function fake_viewport(): *ImGuiViewport return &viewport end
local function fake_mouse(out: *ImVec2): void $out = mouse_at end
local function fake_false_flags(flags: cint): boolean return false end
local function fake_want(want: boolean): void end
local want_mouse = false
local function fake_want_mouse(want: boolean): void if want then want_mouse = true end end
local function fake_font(): *ImFont return nilptr end
local function fake_font_size(): float32 return 16 end
local function fake_time(): float64 return now end
local function fake_io(): *ImGuiIO return &io_state end
local function fake_clicked(button: cint, rep: boolean): boolean return false end
local function fake_focus_nil(): void focus_nil_calls = focus_nil_calls + 1 end
local function fake_frame_count(): cint return frame_count end
local function fake_key_down(key: cint): boolean return false end
local function fake_key_pressed(key: cint, rep: boolean): boolean return false end
local function fake_set_clipboard(text: cstring): void end
-- ImGui's AddCallback: a command of its own (reusing an empty last one), then a fresh one
local function fake_callback(l: *ImDrawList, cb: pointer, data: pointer): void
  assert(l.CmdBuffer.Size + 2 <= MAX_CMDS)
  local c = &cmds[l.CmdBuffer.Size - 1]
  if c.ElemCount ~= 0 or c.UserCallback ~= nilptr then
    cmds[l.CmdBuffer.Size] = { ClipRect = c.ClipRect }
    l.CmdBuffer.Size = l.CmdBuffer.Size + 1
    c = &cmds[l.CmdBuffer.Size - 1]
  end
  c.UserCallback, c.UserCallbackData = cb, data
  cmds[l.CmdBuffer.Size] = { ClipRect = c.ClipRect }
  l.CmdBuffer.Size = l.CmdBuffer.Size + 1
end

local function resolver(name: cstring): pointer
  local n: string = name
  if n == 'ImDrawList_AddRectFilled' then return (@pointer)(fake_rect_filled) end
  if n == 'ImDrawList_AddRect' then return (@pointer)(fake_rect) end
  if n == 'ImDrawList_AddLine' then return (@pointer)(fake_line) end
  if n == 'ImDrawList_AddTriangleFilled' then return (@pointer)(fake_triangle) end
  if n == 'ImDrawList_AddText_FontPtr' then return (@pointer)(fake_text) end
  if n == 'ImDrawList_PrimReserve' then return (@pointer)(fake_prim_reserve) end
  if n == 'ImDrawList_PrimVtx' then return (@pointer)(fake_prim_vtx) end
  if n == 'igGetFontTexUvWhitePixel' then return (@pointer)(fake_uv) end
  if n == 'ImDrawList_PushClipRect' then return (@pointer)(fake_push_clip) end
  if n == 'ImDrawList_PopClipRect' then return (@pointer)(fake_pop_clip) end
  if n == 'ImFont_CalcTextSizeA' then return (@pointer)(fake_calc) end
  if n == 'igGetBackgroundDrawList_Nil' then return (@pointer)(fake_bg) end
  if n == 'igGetMainViewport' then return (@pointer)(fake_viewport) end
  if n == 'igGetMousePos' then return (@pointer)(fake_mouse) end
  if n == 'igIsWindowHovered' then return (@pointer)(fake_false_flags) end
  if n == 'igSetNextFrameWantCaptureMouse' then return (@pointer)(fake_want_mouse) end
  if n == 'igSetNextFrameWantCaptureKeyboard' then return (@pointer)(fake_want) end
  if n == 'igGetFont' then return (@pointer)(fake_font) end
  if n == 'igGetFontSize' then return (@pointer)(fake_font_size) end
  if n == 'igGetTime' then return (@pointer)(fake_time) end
  if n == 'igGetIO' then return (@pointer)(fake_io) end
  if n == 'igIsMouseClicked' then return (@pointer)(fake_clicked) end
  if n == 'igSetWindowFocus_Nil' then return (@pointer)(fake_focus_nil) end
  if n == 'igGetFrameCount' then return (@pointer)(fake_frame_count) end
  if n == 'igIsKeyDown' then return (@pointer)(fake_key_down) end
  if n == 'igIsKeyPressed' then return (@pointer)(fake_key_pressed) end
  if n == 'igSetClipboardText' then return (@pointer)(fake_set_clipboard) end
  if n == 'ImDrawList_AddCallback' then return (@pointer)(fake_callback) end
  return nilptr
end

local function fake_camera(c: *GuCamera): cint
  -- reversed Z, infinite far plane, near 0.1, FoV 0.78, eye at (10, 1.7, 15)
  $c = { width = 2560, height = 1440 }
  local f = 1 / math.tan(0.78 / 2)
  local a = f * 1440 / 2560
  c.m[0] = -a
  c.m[5] = f
  c.m[11] = 1
  c.m[12] = 10 * a
  c.m[13] = -1.7 * f
  c.m[15] = -15
  c.m[14] = 0.1
  return 1
end

-- Pets with a real camera: none placed between the camera and the player, and
-- ghostty.camera()'s three values all read (one truncated read broke every pet).
do
  world_host.get_camera = fake_camera
  local code: cstring = [[
    local w = CONFIG.world
    local cx, _, cz = ghostty.camera()
    assert(cx and cz, 'the fake camera is seen')
    local back = math.atan(-cx, -cz)
    for id = 301, 305 do assert(w.command(id, 'pet') == nil) end
    for f = 1, 240 do for id = 301, 305 do assert(w.place(id, 700 + f / 60, false)) end end
    local p = ghostty.player()
    for id = 301, 305 do
      local a = w.anchors[id]
      local rel = math.abs((math.atan(a.px - p.x, a.pz - p.z) - back + math.pi) % (2 * math.pi) - math.pi)
      assert(rel >= w.pet.camera_clear - 1e-3, 'a pet sits between the camera and the player')
    end
    for id = 301, 305 do w.forget(id) end
  ]]
  assert(luaL_loadstring(policy.L, code) == LUA_OK, 'load')
  if lua_pcall(policy.L, 0, 0, 0) ~= LUA_OK then
    print(lua_tolstring(policy.L, -1, nilptr))
    assert(false, 'pets clear of the camera line')
  end
  world_host.get_camera = nilptr
  print('pets clear of the camera OK')
end

-- Focusing a pet lines the others up beside it in the pet order, clear of the
-- camera's line, smaller; they go back to their slots when focus leaves. The
-- order is changed with `order` and kept in the saved state.
do
  world_host.get_camera = fake_camera
  local code: cstring = [[
    local w = CONFIG.world
    local cx, _, cz = ghostty.camera()
    local back = math.atan(-cx, -cz)
    local ids = { 401, 402, 403, 404 }
    for _, id in ipairs(ids) do assert(w.command(id, 'pet') == nil) end
    local t = 900
    local outs = {}
    local function settle(focus_id, frames)
      for _ = 1, frames do
        t = t + 1 / 60
        for _, id in ipairs(ids) do outs[id] = assert(w.place(id, t, id == focus_id)) end
      end
    end
    local p = ghostty.player()
    local function ang(id) local a = w.anchors[id] return math.atan(a.px - p.x, a.pz - p.z) end
    local function dist(id) local a = w.anchors[id] return math.sqrt((a.px - p.x) ^ 2 + (a.pz - p.z) ^ 2) end
    local function rel(id, to) return (ang(id) - to + math.pi) % (2 * math.pi) - math.pi end
    settle(nil, 300)
    local slot = {}
    for _, id in ipairs(ids) do slot[id] = { w.anchors[id].px, w.anchors[id].pz } end
    local base_ppy = outs[401].pixels_per_yalm
    assert(outs[401].order_next and not outs[404].order_next and outs[404].order_prev, 'arrows where there is a neighbour')

    -- a focused pet: the ones before it to its left, the ones after it to its
    -- right, further out (or a tier up) the further away in the order; smaller,
    -- clear of each other, the camera's line and the cone behind you
    local function check_row(fid)
      settle(fid, 300)
      local af, fo = ang(fid), w.anchors[fid].order
      for _, id in ipairs(ids) do
        local a, o = w.anchors[id], outs[id]
        assert(math.abs(rel(id, back)) >= w.pet.camera_clear - 1e-3, 'a pet sits between the camera and the player')
        assert(math.abs(rel(id, math.pi)) >= w.pet.behind_clear - 1e-3, 'a pet sits behind the player')
        if id ~= fid then
          if a.order < fo then assert(rel(id, af) > 0.05, 'before the focused one: on its left')
          else assert(rel(id, af) < -0.05, 'after the focused one: on its right') end
          assert(o.pixels_per_yalm > base_ppy * 1.2, 'lined-up pets are smaller')
          assert(math.abs(o.width - outs[fid].width) < 1e-6, 'shrinking keeps the terminal grid')
          assert(dist(id) >= dist(fid) - 0.05, 'the row runs through the focused pet')
          for _, jd in ipairs(ids) do
            local b = w.anchors[jd]
            if jd ~= fid and jd ~= id and (a.order < fo) == (b.order < fo) and math.abs(outs[jd].y - o.y) < 1e-3
               and math.abs(b.order - fo) > math.abs(a.order - fo) then
              assert(math.abs(rel(jd, af)) > math.abs(rel(id, af)), 'further in the order: further out')
            end
          end
        end
        for _, jd in ipairs(ids) do
          if jd ~= id then
            local q = outs[jd]
            local sep = math.sqrt((o.x - q.x) ^ 2 + (o.z - q.z) ^ 2)
            local hh = o.height / o.pixels_per_yalm / 2 + q.height / q.pixels_per_yalm / 2
            assert(sep >= w.anchors[id].phw + w.anchors[jd].phw - 1e-3 or math.abs(o.y - q.y) >= hh - 0.03, 'lined-up pets overlap')
          end
        end
      end
      assert(math.abs(outs[fid].pixels_per_yalm - base_ppy) < 0.5, 'the focused pet keeps its size')
    end
    check_row(402)
    check_row(401)
    check_row(404)

    -- focus leaves: back to the slots, full size
    settle(nil, 400)
    for _, id in ipairs(ids) do
      local a = w.anchors[id]
      assert(math.sqrt((a.px - slot[id][1]) ^ 2 + (a.pz - slot[id][2]) ^ 2) < 0.05, 'back in its slot')
      assert(math.abs(outs[id].pixels_per_yalm - base_ppy) < 1e-3, 'back to full size')
    end

    -- the order: swap 401 right, past 402; the slots follow it
    assert(w.command(401, 'order right') == nil)
    assert(w.anchors[401].order > w.anchors[402].order, 'swapped with its neighbour')
    settle(nil, 400)
    local function near_slot(id, other)
      local a = w.anchors[id]
      return math.sqrt((a.px - slot[other][1]) ^ 2 + (a.pz - slot[other][2]) ^ 2) < 0.05
    end
    assert(near_slot(401, 402) and near_slot(402, 401), 'the swapped pets trade slots')
    assert(w.command(404, 'order first') == nil and w.command(404, 'order left') == nil, 'first, then left of first: stays first')
    assert(w.anchors[404].order < w.anchors[402].order, 'order first')
    assert(w.command(404, 'order 3') == nil)
    assert(w.command(404, 'order sideways') ~= nil, 'usage')
    assert(w.command(999, 'order left') ~= nil, 'not a world terminal')
    assert(w.command(405, 'here') == nil and w.command(405, 'order left') ~= nil, 'a pin has no place in the order')
    w.forget(405)
    -- pin <-> pet keeps its place in the order
    local o3 = w.anchors[403].order
    assert(w.toggle(403, 1, 2, 3, 0) == nil and w.anchors[403].kind == 'world' and w.anchors[403].order == o3)
    assert(w.toggle(403) == nil and w.anchors[403].kind == 'pet' and w.anchors[403].order == o3, 'pin <-> pet keeps the order')
    -- saved with the pet; the row and the scale are not
    local list = {}
    for i, id in ipairs(ids) do list[i] = { id = id, agent = 9400 + i, view = 'world', font_scale = 0 } end
    settle(402, 30)
    w.save_state(list)
    local saved = assert(w._last_saved)
    assert(saved:find('order = ' .. w.anchors[401].order, 1, true), 'the order is saved')
    assert(not saved:find('lu_', 1, true) and not saved:find('ls =', 1, true) and not saved:find('phw', 1, true), 'the row is not saved')
    os.remove((GHOSTTY_PLUGIN_DIR or '.') .. '/world-state.lua')
    w._last_saved = nil
    for _, id in ipairs(ids) do w.forget(id) end
  ]]
  assert(luaL_loadstring(policy.L, code) == LUA_OK, 'load')
  if lua_pcall(policy.L, 0, 0, 0) ~= LUA_OK then
    print(lua_tolstring(policy.L, -1, nilptr))
    assert(false, 'pets line up beside a focused one')
  end
  world_host.get_camera = nilptr
  print('pet lineup and order OK')
end

-- The arrows' hit areas and the draw-list reorder ------------------------------------
do
  assert(world_order_button(1000, 600, 10, 300, true, true) == WORLD_BUTTON_ORDER_PREV, 'left arrow')
  assert(world_order_button(1000, 600, 990, 300, true, true) == WORLD_BUTTON_ORDER_NEXT, 'right arrow')
  assert(world_order_button(1000, 600, 10, 300, false, true) == WORLD_BUTTON_NONE, 'no neighbour before: no arrow')
  assert(world_order_button(1000, 600, 10, 100, true, true) == WORLD_BUTTON_NONE, 'only halfway down')
  assert(world_order_button(1000, 600, 500, 300, true, true) == WORLD_BUTTON_NONE, 'not in the middle')
  local c: [6]ImDrawCmd
  for i = 0, < 6 do c[i].ElemCount = i end
  local v: ImVector_ImDrawCmd = { Size = 6, Capacity = 6, Data = (@*[0]ImDrawCmd)(&c) }
  world_cmds_to_front(&v, 2)
  assert(c[0].ElemCount == 2 and c[1].ElemCount == 3 and c[3].ElemCount == 5 and c[4].ElemCount == 0 and c[5].ElemCount == 1, 'rotated, order kept')
  world_cmds_to_front(&v, 0)
  world_cmds_to_front(&v, 6)
  assert(c[0].ElemCount == 2 and c[5].ElemCount == 1, 'nothing to move')
  print('order arrows and draw-list reorder OK')
end
local function game_player(which: cint, id: uint64, out: *GuObject): cint
  $out = {}
  if which == WORLD_PLAYER then
    $out = { x = 10, y = 0, z = 20, rotation = 0, entity_id = 7, territory = 132, found = 1, height = 1.7, hitbox_radius = 0.5 }
  end
  return 1
end
local cam_h: float32, cam_v: float32, cam_d: float32 = 0, 0.3, 2
local function fake_get_cam_state(h: *float32, v: *float32, d: *float32, dmin: *float32): cint
  $h, $v, $d, $dmin = cam_h, cam_v, cam_d, 1.5
  return 1
end
local function fake_set_cam_state(h: float32, v: float32, d: float32): cint
  cam_h, cam_v, cam_d = h, v, d
  return 1
end
local function capture_log(level: cint, msg: cstring): void
  local m: string = msg
  if m:find('panels:', 1, true) > 0 then
    diag_lines = diag_lines + 1
    if m:find('drawing at', 1, true) > 0 then diag_drawing = diag_drawing + 1 end
  end
end

local keys_held = false -- W A S D as the fake keyboard holds them
local function fake_keys(): boolean return keys_held end

local function world_frame(press: boolean): void
  reset_list()
  now = now + 1.0 / 60
  frame_count = frame_count + 1
  host.lmb_pressed, host.lmb_down = press, press
  draw_world(now)
end

-- panel pixel (u, v) of terminal `id` on the screen
local function panel_screen(id: integer, u: float32, v: float32): ImVec2
  local ok, pl = policy_world_place(id, now, host.world_focus == id)
  assert(ok)
  local b = world_basis(pl)
  local x, y, z = world_point(&b, u, v)
  local cam: GuCamera
  fake_camera(&cam)
  local pok, sx, sy = world_project(&cam, x, y, z)
  assert(pok)
  return vec2(sx, sy)
end

local function new_panel(pin: string): *Session
  local s = session_new(0, 80, 24)
  assert(s ~= nilptr)
  local e = policy_world_command(s.id, pin)
  assert(#e == 0, e)
  s.appear = 1
  host.world:push(s)
  return s
end

-- Resize test helpers (file scope: Nelua functions do not close over locals)
local game: GuCamera
local L, R, T, B = WORLD_GRIP_LEFT, WORLD_GRIP_RIGHT, WORLD_GRIP_TOP, WORLD_GRIP_BOTTOM
local function held_frame(): void
  reset_list()
  now = now + 1.0 / 60
  frame_count = frame_count + 1
  host.lmb_pressed, host.lmb_down = false, true
  want_mouse = false
  draw_world(now)
end
local function place(id: integer): WorldPlacement
  local ok, pl = policy_world_place(id, now, host.world_focus == id)
  assert(ok)
  return pl
end
-- panel pixel (u, v) of a pose on the screen
local function screen_of(pl: WorldPlacement, u: float32, v: float32): ImVec2
  local b = world_basis(pl)
  local x, y, z = world_point(&b, u, v)
  local ok, sx, sy = world_project(&game, x, y, z)
  assert(ok)
  return vec2(sx, sy)
end
local function apart(a: ImVec2, b: ImVec2): float32 return math.sqrt((a.x - b.x) ^ 2 + (a.y - b.y) ^ 2) end

-- the grip across the right edge at mid height, in screen pixels: how thick,
-- and how far it reaches out past the edge
local function band(id: integer): (float32, float32)
  local pl = place(id)
  local b = world_basis(pl)
  local e, inner = screen_of(pl, pl.width, pl.height * 0.5), screen_of(pl, pl.width - 100, pl.height * 0.5)
  local dx, dy = e.x - inner.x, e.y - inner.y
  local l = math.sqrt(dx * dx + dy * dy)
  dx, dy = dx / l, dy / l
  local n, reach = 0, (@float32)(-1e9)
  for k = -240, 240 do
    local t = (@float32)(k) * 0.25
    local uok, _, mu, mv = world_hit(&game, &b, vec2(e.x + dx * t, e.y + dy * t))
    if uok and world_grip_at(&game, &b, pl.width, pl.height, mu, mv) & R ~= 0 then
      n = n + 1
      reach = math.max(reach, t)
    end
  end
  return n * 0.25, reach
end
-- a fake ImGui context for the cursor rule: our window, a popup of it, another plugin's
local cursor_ctx: ImGuiContext
local cursor_ours: ImGuiWindow
local cursor_popup: ImGuiWindow
local cursor_other: ImGuiWindow
local function fake_ctx(): *ImGuiContext return &cursor_ctx end

do
  while #host.world > 0 do close_terminal(host.world[0]) end
  assert(#host.sessions == 0)
  assert(imgui_bind(resolver, nilptr) > 0)
  host.api.log = capture_log
  host.api.get_camera = fake_camera
  host.api.get_object = game_player
  world_host.get_object = game_player
  host.api.get_camera_state = fake_get_cam_state
  host.api.set_camera_state = fake_set_cam_state
  assert(luaL_loadstring(policy.L, "CONFIG.world.occlusion = 'off'") == LUA_OK and lua_pcall(policy.L, 0, 0, 0) == LUA_OK)
  policy_refresh()
  host.world_visible, host.world_rez, host.world_last_time = true, 1, now

  -- Camera ------------------------------------------------------------------------
  -- closing the full-screen panel (the last one) still gives the zoom back
  host.world_full_id = 0
  host.cam_saved_d = 12
  host.cam_active = true
  for _ = 1, 120 do world_frame(false) end
  assert(not host.cam_restore and host.cam_saved_d == 0 and near(cam_d, 12, 0.06), 'zoom restored with no panels left')
  -- steering toward a panel: turning the camera yourself takes it over
  cam_h, cam_d = 0, 5
  host.cam_target_h, host.cam_target_v, host.cam_target_d = 1.2, 0.3, 5
  host.cam_active = true
  world_frame(false)
  world_frame(false)
  assert(host.cam_active and cam_h > 0.1, 'eases toward the panel')
  cam_h = cam_h - 0.4
  local held = cam_h
  world_frame(false)
  assert(not host.cam_active and cam_h == held, 'turning the camera yourself takes it over')
  host.cam_active = true
  for _ = 1, 240 do world_frame(false) end
  assert(not host.cam_active and near(cam_h, 1.2, 0.02), 'left alone, it arrives')
  print('world camera OK')

  -- Clicks: an unfocused panel only takes focus ---------------------------------------
  local s = new_panel('here')
  diag_lines, diag_drawing = 0, 0
  world_frame(false)
  mouse_at = panel_screen(s.id, 400, 300)
  host.world_focus = 0
  world_frame(true)
  assert(host.world_focus == s.id and focus_nil_calls == 1, 'a click focuses the panel and takes focus from ImGui windows')
  assert(not s.sel.dragging, 'the focusing press does not start a selection')
  world_frame(false)
  now = now + 0.5 -- not a double click
  world_frame(true)
  assert(s.sel.dragging, 'a press on the focused panel selects')
  world_frame(false)
  assert(not s.sel.dragging)
  host.world_focus = 0
  now = now + 0.5
  mouse_at = panel_screen(s.id, 1790, 1030)
  world_frame(true)
  assert(host.world_drag_id == s.id and host.world_focus == s.id, 'the grip of an unfocused panel resizes at once, and focuses it')
  world_frame(false)
  assert(host.world_drag_id == 0 and host.walk.id == 0, 'released: done, and no walk-up')
  mouse_at = vec2(-5000, -5000)
  print('world clicks OK')

  -- Pin <-> pet: the title button next to pop-in ------------------------------------------
  do
    local function anchor_kind(id: integer): string
      local L = policy.L
      lua_getglobal(L, 'require') lua_pushstring(L, 'world')
      assert(lua_pcall(L, 1, 1, 0) == LUA_OK)
      lua_getfield(L, -1, 'anchors') lua_rawgeti(L, -1, id)
      local kind: string = 'none'
      if lua_type(L, -1) == LUA_TTABLE then
        lua_getfield(L, -1, 'kind')
        kind = string.copy(lua_tolstring(L, -1, nilptr))
      end
      lua_settop(L, 0)
      return kind
    end
    host.world_focus = s.id
    world_frame(false)
    local ok0, pl0 = policy_world_place(s.id, now, true)
    assert(ok0 and not pl0.pet and anchor_kind(s.id) == 'world')
    -- a click on it: the pin becomes a pet (the paw)
    now = now + 0.5
    mouse_at = panel_screen(s.id, world_title_button_x(pl0.width, WORLD_BUTTON_PET) + 13, 13)
    world_frame(true)
    world_frame(false)
    assert(anchor_kind(s.id) == 'pet' and host.world_pet_toggle_id == 0, 'the paw makes it a pet')
    assert(host.walk.id == 0, 'a title button walks nowhere')
    for _ = 1, 30 do world_frame(false) end -- the pet floats to its place beside you
    local ok1, pl1 = policy_world_place(s.id, now, true)
    assert(ok1 and pl1.pet and s.posed, 'a pet, shown')
    local px, py, pz, pyaw = s.pose_x, s.pose_y, s.pose_z, s.pose_yaw
    -- and again: the pet is pinned right where it is shown, facing the same way (the pin)
    now = now + 0.5
    mouse_at = panel_screen(s.id, world_title_button_x(pl1.width, WORLD_BUTTON_PET) + 13, 13)
    px, py, pz, pyaw = s.pose_x, s.pose_y, s.pose_z, s.pose_yaw
    world_frame(true)
    assert(anchor_kind(s.id) == 'world', 'the pin pins it')
    local ok2, pl2 = policy_world_place(s.id, now, true)
    assert(ok2 and not pl2.pet and near(pl2.x, px, 0.05) and near(pl2.y, py, 0.05) and near(pl2.z, pz, 0.05) and near(pl2.yaw, pyaw, 0.01),
      'pinned at the pose it was shown at')
    world_frame(false)
    -- /term pin toggle does the same for the focused panel
    host.world_focus = s.id
    assert(run_command('pin toggle') == 0 and anchor_kind(s.id) == 'pet', '/term pin toggle')
    assert(run_command('pin here') == 0 and anchor_kind(s.id) == 'world', '/term pin here on a focused world terminal')
    host.world_focus = 0
    assert(run_command('pin toggle') == 4, 'nothing focused: nothing to toggle')
    mouse_at = vec2(-5000, -5000)
    print('world pin <-> pet OK')
  end


  -- The log: one line while nothing changes -------------------------------------------
  for _ = 1, 10 do world_frame(false) end
  assert(diag_lines == 1 and diag_drawing == 1, 'the world summary is logged once, with the first drawn panel')

  -- Tuning: read from Lua twice a second, not every frame -----------------------------
  local function set_walk(on: boolean): void
    assert(luaL_loadstring(policy.L, on and 'CONFIG.world.walk.enabled = true' or 'CONFIG.world.walk.enabled = false') == LUA_OK
      and lua_pcall(policy.L, 0, 0, 0) == LUA_OK)
  end
  set_walk(not host.world_tuning.walk)
  local want = not host.world_tuning.walk
  local read_frames = 0
  while host.world_tuning.walk ~= want do
    world_frame(false)
    read_frames = read_frames + 1
    assert(read_frames <= 31, 'a settings change applies within half a second')
  end
  set_walk(not want)
  world_frame(false)
  assert(host.world_tuning.walk == want, 'not read again the very next frame')
  now = now + 0.5
  world_frame(false)
  assert(host.world_tuning.walk ~= want, 'read again half a second later')
  print('world tuning OK')

  local keep_lines, keep_drawing = diag_lines, diag_drawing -- the summary lines below are not the ones counted
  -- Pet order: the arrows on a hovered pet's edges, and /term order ----------------------
  do
    local function order_of(id: integer): integer
      local L = policy.L
      lua_getglobal(L, 'require') lua_pushstring(L, 'world')
      assert(lua_pcall(L, 1, 1, 0) == LUA_OK)
      lua_getfield(L, -1, 'anchors') lua_rawgeti(L, -1, id)
      lua_getfield(L, -1, 'order')
      local o = lua_tointegerx(L, -1, nilptr)
      lua_settop(L, 0)
      return o
    end
    local pa = new_panel('pet')
    local pb = new_panel('pet')
    host.world_focus = 0
    for _ = 1, 120 do world_frame(false) end
    assert(order_of(pa.id) < order_of(pb.id), 'new pets join the order at the end')
    local oka, pla = policy_world_place(pa.id, now, false)
    assert(oka and pla.order_next and not pla.order_prev, 'the first pet: an arrow to the next only')
    -- a click on its right arrow: it swaps with the next one (and takes focus, but walks nowhere)
    now = now + 0.5
    mouse_at = panel_screen(pa.id, pla.width - 2 - WORLD_ORDER_W * 0.5, pla.height * 0.5)
    world_frame(false)
    world_frame(true)
    assert(order_of(pa.id) > order_of(pb.id) and host.world_order_id == 0, 'the right arrow moves it after its neighbour')
    assert(host.world_focus == pa.id and host.walk.id == 0, 'an arrow focuses, walks nowhere')
    world_frame(false)
    mouse_at = vec2(-5000, -5000)
    -- /term order on the focused pet
    assert(run_command('order left') == 0 and order_of(pa.id) < order_of(pb.id), '/term order left')
    assert(run_command('order last') == 0 and order_of(pa.id) > order_of(pb.id), '/term order last')
    assert(run_command('order sideways') == 4, 'a bad /term order')
    host.world_focus = s.id
    assert(run_command('order left') == 4, 'a pin has no place in the order')
    host.world_focus = 0
    assert(run_command('order left') == 5, 'nothing focused')
    close_terminal(pa)
    close_terminal(pb)
    print('world pet order OK')
  end

  -- Under the other plugins' overlays: what Umbra drew into the background
  -- list before us ends up after everything of ours -------------------------------------
  do
    host.world_focus = s.id
    reset_list()
    cmds[0].ClipRect = { 1, 2, 3, 4 } -- "Umbra's toolbar"
    quad(vec2(0, 0), vec2(2560, 40), 0xff00ff00_u32)
    host.world_tuning.under_ui = true
    local base = world_under_ui_begin()
    assert(base == 1 and dl.CmdBuffer.Size == 3 and cmds[1].UserCallback == (@pointer)(IMDRAW_CALLBACK_RESET), 'a fresh command of ours')
    now = now + 1.0 / 60
    draw_world(now)
    local ours: cint = 0
    for i = 1, < dl.CmdBuffer.Size do ours = ours + cmds[i].ElemCount end
    assert(ours > 0, 'the panel drew')
    world_under_ui_end(base)
    local n = dl.CmdBuffer.Size
    assert(cmds[0].UserCallback == (@pointer)(IMDRAW_CALLBACK_RESET), 'ours first')
    assert(cmds[n - 3].ClipRect.x == 1 and cmds[n - 3].ElemCount == 4, 'Umbra\'s command after all of ours')
    assert(cmds[n - 2].UserCallback == (@pointer)(IMDRAW_CALLBACK_RESET) and cmds[n - 1].ElemCount == 0 and cmds[n - 1].UserCallback == nilptr,
      'a fresh last command for whoever draws next')
    local after: cint = 0
    for i = 0, < n - 3 do after = after + cmds[i].ElemCount end
    assert(after == ours, 'nothing of ours lost')
    -- nothing drawn before us: nothing to go under
    reset_list()
    assert(world_under_ui_begin() == -1 and dl.CmdBuffer.Size == 1)
    world_under_ui_end(-1)
    -- turned off
    quad(vec2(0, 0), vec2(10, 10), 0xff00ff00_u32)
    host.world_tuning.under_ui = false
    assert(world_under_ui_begin() == -1 and dl.CmdBuffer.Size == 1, 'CONFIG.world.under_ui = false')
    assert(luaL_loadstring(policy.L, 'CONFIG.world.under_ui = false') == LUA_OK and lua_pcall(policy.L, 0, 0, 0) == LUA_OK)
    assert(not world_read_tuning(policy.L).under_ui, 'under_ui read from lua/world.lua')
    assert(luaL_loadstring(policy.L, 'CONFIG.world.under_ui = true') == LUA_OK and lua_pcall(policy.L, 0, 0, 0) == LUA_OK)
    assert(world_read_tuning(policy.L).under_ui)
    host.world_tuning.under_ui = true
    host.world_focus = 0
    print('world under other overlays OK')
  end
  diag_lines, diag_drawing = keep_lines, keep_drawing

  -- Level of detail: text too small to read is not drawn -----------------------------
  host.world_focus = 0
  local far = new_panel('at 0 60 1.7')
  world_frame(false)
  assert(diag_lines == 2, 'a new panel logs a new summary')
  assert(far.cell_h > 0, 'drawn once to measure its cells')
  local e = policy_world_command(far.id, 'hide')
  e:destroy()
  texts = 0
  world_frame(false)
  local near_only = texts
  assert(near_only > 0, 'the near panel draws its text')
  e = policy_world_command(far.id, 'hide off')
  e:destroy()
  texts = 0
  world_frame(false)
  assert(texts == near_only, 'the far panel draws no text')
  host.world_focus = far.id
  texts = 0
  world_frame(false)
  assert(texts > near_only, 'the far panel draws its text while focused')
  host.world_focus = 0
  print('world level of detail OK')

  -- Walking: WASD typed into a focused terminal is text, not the player walking ------
  local real_keys = world_movement_keys
  world_movement_keys = fake_keys
  keys_held = true
  host.world_focus = s.id
  host.drop_focus, host.walk_user_moved = false, false
  host.terminal_focused = true
  world_walk_start(&host.walk, s.id, now, 10, 20, 10, 40)
  world_frame(false)
  assert(host.walk.id == s.id, 'keys held while a terminal has focus: still walking')
  host.terminal_focused = false
  world_walk_start(&host.walk, s.id, now, 10, 20, 10, 40)
  world_frame(false)
  assert(host.walk.id == 0 and host.walk.ended == WORLD_WALK_USER_INPUT, 'keys held with no terminal focused: the player moved, the walk ends')
  keys_held = false
  world_movement_keys = real_keys
  host.world_focus = 0
  print('world walk keys OK')

  -- Sleeping unseen ------------------------------------------------------------------
  s.kind = TransportKind.Agent
  s.agent = &host.agent
  s.agent_id = 77
  s.exited, s.awaiting_open, s.run_occluded = false, false, false
  s.last_seen = now - 5
  sleep_unseen(now)
  assert(not s.sleeping, 'unseen for 5 s: still running (a camera turn does not rebuild it)')
  s.last_seen = now - 31
  s:feed_text('\27[?1049h')
  sleep_unseen(now)
  assert(not s.sleeping, 'a full-screen program stays awake: a replay would lose its modes')
  s:feed_text('\27[?1049l')
  sleep_unseen(now)
  assert(s.sleeping, 'unseen for 30 s: sleeps')
  print('world sleep OK')

  -- Tooltips: a title button hovered in world space explains itself after a moment --
  do
    while #host.world > 0 do close_terminal(host.world[0]) end
    local t = new_panel('here')
    world_frame(false)
    local ok, pl = policy_world_place(t.id, now, false)
    assert(ok)
    local function tip_text(): string
      return string{data = (@*[0]byte)(&tooltip_last), size = (@usize)(tooltip_last_len)}
    end
    local function hover(id: integer, u: float32, v: float32, frames: integer): integer
      local before = tooltip_shown
      for _ = 1, frames do
        mouse_at = panel_screen(id, u, v)
        world_frame(false)
      end
      return tooltip_shown - before
    end
    assert(hover(t.id, pl.width - 30 + 13, 17, 20) == 0, 'not before the delay')
    assert(hover(t.id, pl.width - 30 + 13, 17, 20) > 0 and tip_text() == 'Close this screen', 'close: ' .. tip_text())
    assert(hover(t.id, world_title_button_x(pl.width, WORLD_BUTTON_OCCLUDED) + 13, 17, 40) > 0 and tip_text():find('Sleeps while nobody sees it', 1, true) == 1, tip_text())
    assert(hover(t.id, world_title_button_x(pl.width, WORLD_BUTTON_PET) + 13, 17, 40) > 0 and tip_text() == 'Let it float beside you as a pet', 'pin: ' .. tip_text())
    assert(hover(t.id, 400, 300, 40) == 0, 'the terminal itself shows none')
    close_terminal(t)
    print('world tooltips OK')
  end

  -- Resizing by the edges (core/app/resize.nelua) --------------------------------------
  do
    while #host.world > 0 do close_terminal(host.world[0]) end
    host.world_focus = 0
    mouse_at = vec2(-5000, -5000)
    fake_camera(&game)
    local near_p, far_p = new_panel('here'), new_panel('at 0 40 1.7')
    world_frame(false)
    local near_px, near_out = band(near_p.id)
    local far_px, far_out = band(far_p.id)
    assert(near_px >= 12 and near_px <= 16 and far_px >= 12 and far_px <= 16, 'the grip is about 14 screen pixels thick near and far')
    assert(math.abs(near_px - far_px) < 1.5 and near_out >= 5 and far_out >= 5, 'the same on screen, reaching past the edge')
    -- far away the old 28 panel pixels were under 2 screen pixels
    local far_b = world_basis(place(far_p.id))
    assert(world_grip_scale(&game, &far_b, 1800, 1040, R) * 28 < 2)
    close_terminal(near_p)
    close_terminal(far_p)
    print('world grip size OK')

    -- each edge and corner of a pin: a press resizes at once, the grabbed edge
    -- follows the cursor and the opposite one stays put
    local modes: [8]integer = { L, R, T, B, L | T, R | T, L | B, R | B }
    for i = 0, < 8 do
      local m = modes[i]
      host.world_focus = 0
      local p = new_panel('here')
      world_frame(false)
      local pl = place(p.id)
      local w, h = pl.width, pl.height
      -- just inside the edge; the top right corner just outside (the title buttons are inside)
      local gu: float32 = (m & L ~= 0) and 4 or ((m & R ~= 0) and w - 4 or w * 0.4)
      local gv: float32 = (m & T ~= 0) and 4 or ((m & B ~= 0) and h - 4 or h * 0.5)
      if m == R | T then gu, gv = w + 5, -5 end
      local fu: float32 = (m & R ~= 0) and 0 or ((m & L ~= 0) and w or w * 0.5)
      local fv: float32 = (m & B ~= 0) and 0 or ((m & T ~= 0) and h or h * 0.5)
      local fixed = screen_of(pl, fu, fv)
      now = now + 1
      mouse_at = screen_of(pl, gu, gv)
      world_frame(true)
      assert(host.world_drag_id == p.id and host.world_focus == p.id, 'a press on the grip resizes (and focuses) at once')
      local du: float32 = (m & L ~= 0) and -240 or ((m & R ~= 0) and 240 or 0)
      local dv: float32 = (m & T ~= 0) and -160 or ((m & B ~= 0) and 160 or 0)
      for k = 1, 4 do
        mouse_at = screen_of(pl, gu + du * k / 4, gv + dv * k / 4)
        held_frame()
        assert(want_mouse, 'the mouse is ours while resizing')
      end
      held_frame()
      local pl2 = place(p.id)
      assert(near(pl2.width, w + math.abs(du), 1) and near(pl2.height, h + math.abs(dv), 1), 'the edge moved as far as the cursor')
      local fu2: float32 = (m & R ~= 0) and 0 or ((m & L ~= 0) and pl2.width or pl2.width * 0.5)
      local fv2: float32 = (m & B ~= 0) and 0 or ((m & T ~= 0) and pl2.height or pl2.height * 0.5)
      assert(apart(screen_of(pl2, fu2, fv2), fixed) < 1, 'the opposite edge stays within a pixel')
      world_frame(false)
      assert(host.world_drag_id == 0, 'released: done')
      close_terminal(p)
    end
    print('world resize edges and corners OK')

    -- Alt + press on a grip still picks the panel up
    do
      host.world_focus = 0
      local p = new_panel('here')
      world_frame(false)
      local pl = place(p.id)
      now = now + 1
      mouse_at = screen_of(pl, pl.width - 4, pl.height * 0.5)
      io_state.KeyAlt = true
      world_frame(true)
      assert(host.drag.id == p.id and host.world_drag_id == 0, 'Alt: carried, not resized')
      world_frame(false)
      io_state.KeyAlt = false
      assert(host.drag.id == 0 and host.world_drag_id == 0)
      local pl2 = place(p.id)
      assert(near(pl2.width, pl.width, 0.01) and near(pl2.height, pl.height, 0.01), 'the size is kept')
      close_terminal(p)
      print('world resize Alt moves OK')
    end

    -- released anywhere: off the panel, or with the panel gone from view
    do
      host.world_focus = 0
      local p = new_panel('here')
      world_frame(false)
      local pl = place(p.id)
      now = now + 1
      mouse_at = screen_of(pl, pl.width - 4, pl.height * 0.5)
      world_frame(true)
      assert(host.world_drag_id == p.id)
      mouse_at = vec2(2550, 20)
      held_frame()
      assert(host.world_drag_id == p.id and want_mouse, 'held off the panel: still resizing, the mouse still ours')
      world_frame(false)
      assert(host.world_drag_id == 0, 'let go off the panel: done')
      now = now + 1
      mouse_at = screen_of(place(p.id), place(p.id).width - 4, place(p.id).height * 0.5)
      world_frame(true)
      assert(host.world_drag_id == p.id)
      local e = policy_world_command(p.id, 'hide')
      e:destroy()
      held_frame()
      world_frame(false)
      assert(host.world_drag_id == 0, 'let go with the panel hidden: done')
      close_terminal(p)
      print('world resize release OK')
    end

    -- a pet grows about its centre, the grabbed edge still under the cursor
    -- (a pet faces your character, so it may be seen from behind: the cursor
    -- is aimed by projecting the panel, never by screen arithmetic)
    do
      host.world_focus = 0
      local p = new_panel('pet')
      for _ = 1, 60 do world_frame(false) end
      local pl = place(p.id)
      local grab = screen_of(pl, pl.width - 4, pl.height * 0.5)
      local target = screen_of(pl, pl.width + 140, pl.height * 0.5)
      now = now + 1
      mouse_at = grab
      world_frame(true)
      assert(host.world_drag_id == p.id, 'a pet resizes without focus too')
      for k = 1, 150 do
        local t = (@float32)(math.min(k, 30)) / 30
        mouse_at = vec2(grab.x + (target.x - grab.x) * t, grab.y + (target.y - grab.y) * t)
        held_frame()
      end
      local pl2 = place(p.id)
      local e1 = panel_screen(p.id, pl2.width, pl2.height * 0.5)
      local e2 = panel_screen(p.id, 0, pl2.height * 0.5)
      assert(pl2.width > pl.width + 100 and near(pl2.height, pl.height, 0.01), 'wider, same height')
      -- across the edge only: a pet bobs up and down while it is held
      assert(math.min(math.abs(e1.x - mouse_at.x), math.abs(e2.x - mouse_at.x)) < 6, 'the grabbed edge ends up under the cursor')
      world_frame(false)
      close_terminal(p)
      print('world resize pet OK')
    end

    -- a HUD panel keeps its opposite edge on the screen; the size stays in its terms
    do
      world_host.get_camera = fake_camera
      host.world_focus = 0
      local p = new_panel('hud 0.5 0.5 1.6 0.5')
      world_frame(false)
      local pl = place(p.id)
      local right = screen_of(pl, pl.width, pl.height * 0.5)
      local grab = screen_of(pl, 4, pl.height * 0.5)
      local target = screen_of(pl, -120, pl.height * 0.5)
      now = now + 1
      mouse_at = grab
      world_frame(true)
      assert(host.world_drag_id == p.id, 'a HUD panel resizes without focus')
      for k = 1, 12 do
        local t = (@float32)(math.min(k, 6)) / 6
        mouse_at = vec2(grab.x + (target.x - grab.x) * t, grab.y + (target.y - grab.y) * t)
        held_frame()
      end
      local pl2 = place(p.id)
      local right2 = screen_of(pl2, pl2.width, pl2.height * 0.5)
      world_frame(false)
      -- the cursor went from 4 pixels inside the edge to 120 outside it
      assert(near(pl2.width, pl.width + 124, 2), 'the left edge followed the cursor')
      assert(math.abs(right2.x - right.x) < 1, 'the right edge stays')
      assert(near(pl2.ppm, pl.ppm, pl.ppm * 1e-3), 'the same screen pixels per panel pixel')
      close_terminal(p)
      world_host.get_camera = nilptr
      print('world resize HUD OK')
    end

    -- the game keeps its own cursor over ghostty UI (core/app/cursor.nelua)
    do
      cursor_ours.Name = '##ghostty_dropdown'
      cursor_popup.Name = '##Combo_00'
      cursor_popup.RootWindowPopupTree = &cursor_ours
      cursor_other.Name = 'Some other plugin'
      imgui_int_bound = true
      imgui_int.GetCurrentContext = fake_ctx
      local function frame_flag(): boolean
        world_frame(false)
        cursor_frame(cursor_over_ours())
        return io_state.ConfigFlags & ImGuiConfigFlags_NoMouseCursorChange ~= 0
      end
      io_state.ConfigFlags = 0
      host.world_focus = 0
      local p = new_panel('here')
      world_frame(false)
      mouse_at = panel_screen(p.id, 400, 300)
      assert(frame_flag(), 'over a world panel: the game cursor stays')
      mouse_at = vec2(-5000, -5000)
      assert(not frame_flag(), 'off it: cleared again')
      cursor_ctx.HoveredWindow = &cursor_ours
      assert(frame_flag(), 'over one of our windows')
      cursor_ctx.HoveredWindow = &cursor_popup
      assert(frame_flag(), 'over a popup of our window')
      cursor_ctx.HoveredWindow = &cursor_other
      assert(not frame_flag(), 'over another plugin\'s window: left alone')
      cursor_ctx.HoveredWindow = nilptr
      io_state.ConfigFlags = ImGuiConfigFlags_NoMouseCursorChange -- set by someone else
      mouse_at = panel_screen(p.id, 400, 300)
      assert(frame_flag())
      mouse_at = vec2(-5000, -5000)
      assert(frame_flag(), 'a flag we did not set is not ours to clear')
      io_state.ConfigFlags = 0
      close_terminal(p)
      imgui_int.GetCurrentContext = nilptr
      print('world cursor OK')
    end
  end
end
