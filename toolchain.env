# Pinned toolchain and vendor revisions. tools/fetch-vendor.sh checks these out.
NELUA_REPOSITORY=https://github.com/Spaceghost/nelua-lang
NELUA_COMMIT=b0cbfdb86959b7e5d94943729016d8cc4c4cc115
GHOSTTY_REPOSITORY=https://github.com/ghostty-org/ghostty
GHOSTTY_COMMIT=f9a3f24a56bf05f70894e1a084809d4fffadf420
CIMGUI_REPOSITORY=https://github.com/goatcorp/gc-cimgui
CIMGUI_COMMIT=ecd32e56fe2f1d9072e01a090bc447b4f932e5d4
UMBRA_DIST_REPOSITORY=https://github.com/una-xiv/umbra-dist
UMBRA_DIST_COMMIT=6e8ad7b6dde6e33bedc9c31300284cf06e7e7573
LUA_VERSION=5.4.8
LUA_URL=https://www.lua.org/ftp/lua-5.4.8.tar.gz
LUA_SHA256=4f18ddae154e793e46eeab727c59ef1c0c0c2b744e7b94219710d76f530629ae
# stb_truetype (public domain / MIT): the core rasterizes fallback glyphs with it (core/glyphfb.nelua)
STB_TRUETYPE_URL=https://raw.githubusercontent.com/nothings/stb/2c980bb59875b0d32144a71867fbdebb2f77cd20/stb_truetype.h
STB_TRUETYPE_SHA256=ecd30b05e0dd4fea3a13c26810dd9e1992dc379049482c393d5a19e6b5090aab
# Noto Emoji (monochrome, SIL OFL 1.1): the emoji of the fallback glyph chain,
# committed as fonts/NotoEmoji[wght].ttf. Pinned so the committed file can be
# checked against upstream: curl the URL and compare the sha256 (fonts/README.md).
NOTO_EMOJI_VERSION=3.002
NOTO_EMOJI_URL=https://raw.githubusercontent.com/google/fonts/b979dba422e445492b0eb9951ac52ee0b4d648c3/ofl/notoemoji/NotoEmoji%5Bwght%5D.ttf
NOTO_EMOJI_SHA256=de6c18832938afc99caf132b39d6a30a19bac7f2e812e28db2535b4608d27551
ZIG_VERSION=0.16.0
DOTNET_CHANNEL=10.0
# Immutable reference bundle, verified as a Git blob before extraction
# (tools/fetch-dalamud.py); the floating latest.zip is deliberately not used.
DALAMUD_DISTRIB_URL=https://raw.githubusercontent.com/goatcorp/dalamud-distrib/46833da369fb1fec8942fe2a108e866b69cf6ce3/latest.zip
DALAMUD_DISTRIB_BLOB_SHA1=f8c81f20cb85b20c551a1d19a834430156863fa9
# Zig release tarballs for tools/ci/run.sh (checksums from ziglang.org/download/index.json).
ZIG_URL_BASE=https://ziglang.org/download
ZIG_SHA256_X86_64_LINUX=70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00
ZIG_SHA256_AARCH64_LINUX=ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17
# Dalamud reference assemblies pinned for CI (tools/ci/run.sh): latest.zip at a
# commit of goatcorp/dalamud-distrib, its sha256, and the API level it must carry.
DALAMUD_DISTRIB_COMMIT=46833da369fb1fec8942fe2a108e866b69cf6ce3
DALAMUD_DISTRIB_SHA256=a6c716b81daeb4fc348b076b63fe1cb584a731c781dbdaf3e6c58c1fbc33a827
DALAMUD_API_LEVEL=15
# Wayland SDK for agent/capture_wayland.nelua (headers only; the agent links the
# system's libwlroots/libwayland-server/libxkbcommon/libpixman at runtime).
# Fedora 44 -devel RPMs from Koji by NVR, sha256-pinned; tools/fetch-vendor.sh
# extracts their usr/include into vendor/wayland-sdk/include. Versions must
# match the runtime libraries (wlroots 0.20.2, wayland 1.26.0, xkbcommon 1.13.1,
# pixman 0.46.2); wayland-protocols supplies the *-enum.h headers wlroots includes;
# libxcb and xcb-util-wm supply the xcb headers <wlr/xwayland.h> includes (Xwayland).
WAYLAND_SDK_URL_BASE=https://kojipkgs.fedoraproject.org/packages
WAYLAND_SDK_RPMS="\
wlroots/0.20.2/1.fc44/x86_64/wlroots-devel-0.20.2-1.fc44.x86_64.rpm:4c811fd27af6b27fc9fd9449fccc96b27969db31aac7879870f6e7c005d0dba0 \
wayland/1.26.0/1.fc44/x86_64/wayland-devel-1.26.0-1.fc44.x86_64.rpm:a99f4b5b3b5b0240e0456ad813d7902bf811faab42162dc21ab94156b7bd8253 \
wayland-protocols/1.48/1.fc44/noarch/wayland-protocols-devel-1.48-1.fc44.noarch.rpm:06a51da7df0299f2073048c1cc7a9a5d7b83a6163ffcefaabee4abd94e082721 \
pixman/0.46.2/3.fc44/x86_64/pixman-devel-0.46.2-3.fc44.x86_64.rpm:52e3122c068639b27d5e3a06e37b9cbd6bfabf66f7bccabd6090e42a9d85f5c5 \
libxkbcommon/1.13.1/2.fc44/x86_64/libxkbcommon-devel-1.13.1-2.fc44.x86_64.rpm:d35aaf2cba4113d5171ee771383e386aff2a788812b7b52600dbb6931e299118 \
libdrm/2.4.134/1.fc44/x86_64/libdrm-devel-2.4.134-1.fc44.x86_64.rpm:af3967fcd6a26e4a4eaf86aa78d7d2dcad016bd722a706e9a6ec5a42accb478d \
libxcb/1.17.0/7.fc44/x86_64/libxcb-devel-1.17.0-7.fc44.x86_64.rpm:6093175589a520aa46fdb9416730f1e24d875b2d96663afcbc9f9c825dcbb2d0 \
xcb-util-wm/0.4.2/9.fc44/x86_64/xcb-util-wm-devel-0.4.2-9.fc44.x86_64.rpm:6637cfe71c31ac0d4d75f473607b05dfc0ebfdaed5fc7f71b077632325d82f08"

# ---------------------------------------------------------------------------
# Rust staticlib crates/ghostty-iroh (docs/IROH.md). OPTIONAL: nothing here is
# used unless IROH=1 and the crate is present, and nothing below has been built
# or run -- these are the pins the crate is to be built with, not evidence that
# it builds. docs/iroh-build-wiring.md.
# ---------------------------------------------------------------------------
# Fedora 44 packages, pinned by exact NEVR like BUILD_PKGS_PINNED and installed
# into the build container by the same install_pinned. Fedora ships the
# cross std (rust-std-static-x86_64-pc-windows-gnu), so no rustup is needed.
# Observed available via `dnf repoquery` in fedora:ghostty-build on 2026-09-22;
# not installed there yet.
RUST_VERSION=1.98.1
RUST_PKGS_PINNED="\
rust-1.98.1-1.fc44 \
cargo-1.98.1-1.fc44 \
rust-std-static-x86_64-pc-windows-gnu-1.98.1-1.fc44"
RUST_WINDOWS_TARGET=x86_64-pc-windows-gnu
# The crate's own pin, for a reader who expects every revision to be in this
# file. The authority is crates/ghostty-iroh/Cargo.lock, which the build uses
# with --locked; this records which iroh release that lock is built around.
# Empty until the crate lands.
IROH_VERSION=
# The dependency tree, `cargo vendor`-ed once and published as a single
# sha256-pinned tarball -- the LUA_URL/LUA_SHA256 idiom, for the same reason:
# the build must not reach the network. tools/fetch-vendor.sh unpacks it into
# vendor/cargo, which is the shared Incus cache volume inside the build
# container and is deliberately NOT part of the rsynced source
# (tools/build-remote.sh push_source), so the large tree never crosses the
# wire on every build. Empty = not published yet; fetch-vendor.sh skips it and
# a cargo build would resolve online and say so.
CARGO_VENDOR_URL=
CARGO_VENDOR_SHA256=

# ---------------------------------------------------------------------------
# Incus build container (tools/build-container.sh, tools/build-remote.sh).
# Heavy builds run in a container, never on the gaming PC. docs/BUILDING.md.
# ---------------------------------------------------------------------------
# The base image, pinned by fingerprint so a fresh create is the same on every
# Incus host. images.linuxcontainers.org expires old serials: when the pull
# fails, the script falls back to BUILD_IMAGE_ALIAS and says so, and the new
# fingerprint (incus image info images:fedora/44) belongs back here.
BUILD_IMAGE=3f7fb84b7c9a3274d5a19606a9002bff59edc7166e762546d6a1adf9248871b4
BUILD_IMAGE_ALIAS=fedora/44
BUILD_IMAGE_REMOTE=images
BUILD_IMAGE_DESC="Fedora 44 amd64 (20260918_20:33)"
# The Incus remote that hosts the build container. Every machine names its own
# remotes, so this is a placeholder: set BUILD_REMOTE_NAME to yours, in the
# environment or in an untracked build.env beside this file (docs/BUILDING.md).
# `local` means the Incus daemon on this machine.
BUILD_REMOTE_NAME=build
BUILD_CONTAINER=ghostty-build
BUILD_CACHE_VOLUME=ghostty-cache
BUILD_CONTAINER_CPU=8
BUILD_CONTAINER_MEMORY=32GiB
# Fixed paths inside the container. They are part of every sccache key
# (the preprocessed source carries absolute paths), so they must not depend on
# the host, the user or the worktree name.
BUILD_CONTAINER_DIR=/build/ghostty-dalamud
BUILD_CONTAINER_CACHE=/cache
# Packages whose ABI the agent binary inherits: it is built here and run on the
# gaming PC, so these must match what Fedora 44 has there (toolchain.env's
# wayland-sdk headers pin the same versions). Exact NEVR; if Fedora has retired
# the build, the script installs the bare name and warns.
BUILD_PKGS_PINNED="\
wlroots-0.20.2-1.fc44 \
libwayland-server-1.26.0-1.fc44 \
libxkbcommon-1.13.1-2.fc44 \
pixman-0.46.2-3.fc44 \
zig-0.16.0-1.fc44 \
dotnet-sdk-10.0-10.0.111-1.fc44"
# Build tools; they do not reach the shipped binaries' ABI, so they track the
# image's repositories.
BUILD_PKGS="xorg-x11-server-Xwayland librsvg2-tools gcc make git curl tar xz zstd unzip rsync python3 rpm cpio findutils diffutils which jq sccache procps-ng yad gtk3 libunwind-devel"
